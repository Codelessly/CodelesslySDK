{
 "ops": [
  {
   "op": "roots",
   "roots": [
    "c"
   ]
  },
  {
   "op": "set",
   "id": "c",
   "node": {
    "type": "canvas",
    "slots": {
     "body": "p"
    },
    "layout": {
     "width": 390,
     "height": 760
    }
   }
  },
  {
   "op": "vars",
   "scope": "c",
   "set": {
    "moved": {
     "type": "boolean",
     "value": false
    }
   }
  },
  {
   "op": "set",
   "id": "p",
   "node": {
    "type": "column",
    "children": [
     "card",
     "state"
    ],
    "layout": {
     "width": {
      "fill": 390
     },
     "height": {
      "fill": 760
     },
     "padding": 16
    },
    "props": {
     "spacing": 12,
     "crossAxisAlignment": "start"
    },
    "decoration": {
     "fills": [
      {
       "color": "#FFFFFFFF"
      }
     ]
    }
   }
  },
  {
   "op": "set",
   "id": "card",
   "node": {
    "type": "box",
    "layout": {
     "width": 160,
     "height": 60
    },
    "decoration": {
     "fills": [
      {
       "color": "#FFE0E7FF"
      }
     ],
     "radius": 8
    },
    "actions": [
     {
      "trigger": {
       "type": "dragEnd"
      },
      "actions": [
       {
        "type": "setVariable",
        "variable": "moved",
        "value": "true"
       }
      ]
     }
    ]
   }
  },
  {
   "op": "set",
   "id": "state",
   "node": {
    "type": "text",
    "layout": {
     "width": {
      "hug": 200
     },
     "height": {
      "hug": 24
     }
    },
    "props": {
     "text": "In To do",
     "style": {
      "fontSize": 18,
      "color": "#FF111827"
     }
    },
    "bind": {
     "props.text": "${= moved ? 'In Doing' : 'In To do'}"
    }
   }
  }
 ]
}