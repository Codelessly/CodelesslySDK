{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "column2"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "stretch",
    "mainAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2",
    "text3",
    "slider1",
    "text4",
    "divider1",
    "column3",
    "divider2",
    "row2",
    "text7"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Blog migration plan",
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    }
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF6B7280"
    },
    "text": "${statusText}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF111827"
    },
    "text": "Progress (%)"
   }
  },
  "slider1": {
   "type": "slider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "min": 0,
    "max": 100
   },
   "bind": {
    "props.value": "${progress}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "progress",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF6B7280"
    },
    "text": "Time elapsed: ${elapsed}s"
   }
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "column3": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "children": [
    "listView1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 8
   },
   "bind": {
    "data": "${steps}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "start"
   },
   "children": [
    "icon1",
    "column4"
   ]
  },
  "icon1": {
   "type": "icon",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "circle"
   }
  },
  "column4": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "stretch",
    "mainAxisAlignment": "start"
   },
   "children": [
    "text5",
    "text6"
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${item.name}",
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    }
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF6B7280"
    },
    "text": "${item.desc}"
   }
  },
  "divider2": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "spaceBetween"
   },
   "children": [
    "filledButton1",
    "outlinedButton1"
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Start migration"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "start_migration"
      }
     ]
    }
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${pauseLabel}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "toggle_pause"
      }
     ]
    }
   ]
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${summaryText}",
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    }
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "statusText",
    "type": "text",
    "value": "Ready to start. 6 steps, about 2 seconds each."
   },
   {
    "name": "progress",
    "type": "integer",
    "value": 0
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "pauseLabel",
    "type": "text",
    "value": "Pause"
   },
   {
    "name": "summaryText",
    "type": "text",
    "value": ""
   },
   {
    "name": "steps",
    "type": "list",
    "value": [
     {
      "name": "1. Back up current blog",
      "desc": "Export posts, media and settings as a safe archive.",
      "icon": "folder"
     },
     {
      "name": "2. Export content",
      "desc": "Convert posts and pages to portable Markdown.",
      "icon": "download"
     },
     {
      "name": "3. Set up new platform",
      "desc": "Create the new site, theme and domain settings.",
      "icon": "settings"
     },
     {
      "name": "4. Import posts and media",
      "desc": "Upload content, images and comments.",
      "icon": "upload"
     },
     {
      "name": "5. Redirect old URLs",
      "desc": "Add 301 redirects so links and SEO are preserved.",
      "icon": "share"
     },
     {
      "name": "6. Test and go live",
      "desc": "Check links, feeds and layout, then switch DNS.",
      "icon": "check"
     }
    ]
   }
  ]
 }
}