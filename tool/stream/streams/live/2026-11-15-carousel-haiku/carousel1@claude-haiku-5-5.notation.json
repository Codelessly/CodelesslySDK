{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "Carousel1",
    "column2"
   ]
  },
  "Carousel1": {
   "type": "Carousel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "i",
    "arrows": true,
    "dots": true
   },
   "bind": {
    "props.items": "${shoes}",
    "visible": "${= open==false}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "bind": {
    "visible": "${= open==true}"
   },
   "children": [
    "row1",
    "Media1",
    "text2",
    "Paragraph1",
    "text3",
    "text4",
    "segmentedButton1",
    "filledButton1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "textButton1",
    "text1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Back to carousel"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "${= shoes[i].name}"
   }
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "height": 180,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "kind": "shoe"
   },
   "bind": {
    "props.tone": "${= shoes[i].tone}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "${= shoes[i].name}"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.text": "${= shoes[i].detail}. Cushioned comfort for long runs, with a breathable upper and a durable outsole."
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= shoes[i].price}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11.5,
     "fontWeight": 600,
     "height": 1.3,
     "color": "#FF4B5563"
    },
    "text": "Choose a size"
   }
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "segments": [
     {
      "value": "7",
      "label": "7"
     },
     {
      "value": "8",
      "label": "8"
     },
     {
      "value": "9",
      "label": "9"
     },
     {
      "value": "10",
      "label": "10"
     },
     {
      "value": "11",
      "label": "11"
     },
     {
      "value": "12",
      "label": "12"
     }
    ]
   },
   "bind": {
    "props.selected": "${= [size]}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${result[0]}"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Add to bag"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "addToBag"
      },
      {
       "type": "showToast",
       "message": "Added to bag"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "i",
    "type": "integer",
    "value": 0
   },
   {
    "name": "open",
    "type": "boolean",
    "value": false
   },
   {
    "name": "size",
    "type": "text",
    "value": ""
   },
   {
    "name": "shoes",
    "type": "list",
    "value": [
     {
      "name": "Ridge Runner",
      "detail": "Trail, cushioned",
      "price": "$129",
      "rating": 4.6,
      "kind": "shoe",
      "tone": "sand"
     },
     {
      "name": "Velo Flex",
      "detail": "Road, lightweight",
      "price": "$110",
      "rating": 4.4,
      "kind": "shoe",
      "tone": "sky"
     },
     {
      "name": "Stride Pro",
      "detail": "Daily trainer",
      "price": "$118",
      "rating": 4.7,
      "kind": "shoe",
      "tone": "mint"
     },
     {
      "name": "Summit Grip",
      "detail": "Trail, stable",
      "price": "$139",
      "rating": 4.5,
      "kind": "shoe",
      "tone": "slate"
     },
     {
      "name": "Apex Air",
      "detail": "Tempo, responsive",
      "price": "$125",
      "rating": 4.3,
      "kind": "shoe",
      "tone": "rose"
     },
     {
      "name": "Carbon Glide",
      "detail": "Race day, light",
      "price": "$165",
      "rating": 4.8,
      "kind": "shoe",
      "tone": "lilac"
     }
    ]
   }
  ]
 }
}