{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Delete 214 old files?",
    "subtitle": "Shared Drive / Archive / 2019",
    "icon": "delete_outline",
    "status": "Waiting",
    "tone": "danger"
   },
   "children": [
    "Paragraph1",
    "Details1",
    "Disclosure1",
    "row1",
    "Receipt1",
    "Receipt2"
   ]
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Permanently delete 214 files, all older than 2020, from Shared Drive / Archive / 2019. This frees 3.2 GB and cannot be undone.",
    "strong": true
   },
   "bind": {
    "visible": "${= decision==\"\"}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Folder\",\"Shared Drive / Archive / 2019\"],[\"Files\",\"214\"],[\"Space freed\",\"3.2 GB\"],[\"Undo\",\"Not possible\"]]}",
    "visible": "${= decision==\"\"}"
   }
  },
  "Disclosure1": {
   "type": "Disclosure",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Show the first five files",
    "note": "…and 209 more",
    "lines": [
     "Q1-2019-budget.xlsx",
     "meeting-notes-2018-03.docx",
     "old-logo-draft-v2.png",
     "onboarding-2017.pdf",
     "team-photo-2016.jpg"
    ],
    "icon": "description"
   },
   "bind": {
    "visible": "${= decision==\"\"}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= decision==\"\"}"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Deny",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "denied"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Approve",
    "tone": "danger"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "approved"
      },
      {
       "type": "componentEvent",
       "event": "delete_archive"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Approved",
    "message": "214 files deleted from Shared Drive / Archive / 2019, freeing 3.2 GB.",
    "tone": "danger",
    "icon": "delete_outline"
   },
   "bind": {
    "visible": "${= decision==\"approved\"}"
   }
  },
  "Receipt2": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Denied",
    "message": "Nothing was deleted. The 214 files in Shared Drive / Archive / 2019 are unchanged.",
    "tone": "neutral",
    "icon": "block"
   },
   "bind": {
    "visible": "${= decision==\"denied\"}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "decision",
    "type": "text",
    "value": ""
   }
  ]
 }
}