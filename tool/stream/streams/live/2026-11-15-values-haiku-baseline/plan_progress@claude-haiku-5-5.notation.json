{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= running}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= elapsed+1}"
      }
     ]
    },
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 2000,
      "when": "${= running && done<6}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= done+1}"
      }
     ]
    }
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Blog migration",
    "subtitle": "Six steps, one after another",
    "icon": "swap_horiz",
    "status": "Ready"
   },
   "children": [
    "listView1",
    "text1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${steps}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "PlanStep1"
   ]
  },
  "PlanStep1": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.title": "${= done=0}",
    "props.running": "${running}"
   }
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Back up your content, set up the new host, import posts, move media, redirect old URLs, run final checks."
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "running",
    "type": "boolean",
    "value": false
   },
   {
    "name": "done",
    "type": "integer",
    "value": 0
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "steps",
    "type": "list",
    "value": [
     "Back up your content",
     "Set up the new host",
     "Import posts",
     "Move media",
     "Redirect old URLs",
     "Final checks"
    ]
   }
  ]
 }
}