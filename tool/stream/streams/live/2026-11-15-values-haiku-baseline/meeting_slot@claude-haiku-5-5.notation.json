{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Schedule a meeting",
    "subtitle": "30 minutes with Priya, Marcus and Elena",
    "icon": "event",
    "status": "Next week",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "DayPicker1",
    "SectionLabel2",
    "ChoiceChips1",
    "SectionLabel3",
    "Details1",
    "ActionButton1",
    "Receipt1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Day",
    "note": "Next week"
   },
   "bind": {
    "visible": "${= !booked}"
   }
  },
  "DayPicker1": {
   "type": "DayPicker",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "day",
    "days": [
     "Mon 16",
     "Tue 17",
     "Wed 18",
     "Thu 19",
     "Fri 20"
    ]
   },
   "bind": {
    "visible": "${= !booked}"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Start time",
    "note": "30 minutes"
   },
   "bind": {
    "visible": "${= !booked}"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "slot"
   },
   "bind": {
    "props.options": "${= [\"09:00\",\"10:00\",\"11:00\",\"13:00\",\"14:00\",\"15:00\"]}",
    "props.disabled": "${= (day==\"Mon 16\"?[\"10:00\",\"13:00\"]:(day==\"Tue 17\"?[\"09:00\",\"14:00\"]:(day==\"Wed 18\"?[\"11:00\",\"15:00\"]:(day==\"Thu 19\"?[\"09:00\",\"10:00\",\"13:00\"]:[\"11:00\",\"14:00\"]))))}",
    "visible": "${= !booked}"
   }
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Attendees",
    "note": "3 people"
   },
   "bind": {
    "visible": "${= !booked}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "rows": [
     [
      "Priya",
      "Required"
     ],
     [
      "Marcus",
      "Required"
     ],
     [
      "Elena",
      "Required"
     ]
    ]
   },
   "bind": {
    "visible": "${= !booked}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Confirm",
    "tone": "primary",
    "icon": "check"
   },
   "bind": {
    "props.enabled": "${= slot!=\"\"}",
    "visible": "${= !booked}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "booked",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Meeting booked",
    "message": "30 minutes with Priya, Marcus and Elena",
    "codeLabel": "Time",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.code": "${day} Nov, ${slot} to ${slot}",
    "visible": "${= booked}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "day",
    "type": "text",
    "value": "Mon 16"
   },
   {
    "name": "slot",
    "type": "text",
    "value": ""
   },
   {
    "name": "booked",
    "type": "boolean",
    "value": false
   }
  ]
 }
}