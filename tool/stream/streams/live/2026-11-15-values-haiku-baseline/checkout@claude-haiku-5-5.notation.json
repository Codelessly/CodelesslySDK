{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Checkout",
    "subtitle": "Step 1 of 3",
    "icon": "shopping_bag",
    "status": "Cart"
   },
   "children": [
    "SectionLabel1",
    "listView1",
    "Details1",
    "ActionButton1",
    "SectionLabel2",
    "InputField1",
    "InputField2",
    "InputField3",
    "InputField4",
    "InputField5",
    "row1",
    "SectionLabel3",
    "OptionList1",
    "Details2",
    "row2",
    "Receipt1",
    "Details3"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Your cart",
    "note": "3 items"
   },
   "bind": {
    "visible": "${= step==1}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${qty}",
    "visible": "${= step==1}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "CartLine1"
   ]
  },
  "CartLine1": {
   "type": "CartLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.title": "${item.name}",
    "props.detail": "Unit $${item.price}",
    "props.qty": "${item.qty}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "qty",
       "value": "${= updateWhere(qty,x=>x.id==item.id,x=>with(x,\"qty\",result))}"
      }
     ]
    }
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Subtotal\",money((sum(qty,x=>x.price*x.qty)),\"$\",2)]]}",
    "visible": "${= step==1}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Continue to shipping",
    "tone": "primary",
    "icon": "arrow_forward"
   },
   "bind": {
    "visible": "${= step==1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Shipping",
    "note": "Step 2 of 3"
   },
   "bind": {
    "visible": "${= step==2}"
   }
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Full name",
    "placeholder": "Jane Doe",
    "value": "name"
   },
   "bind": {
    "visible": "${= step==2}"
   }
  },
  "InputField2": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Address",
    "placeholder": "1 Main Street",
    "value": "address"
   },
   "bind": {
    "visible": "${= step==2}"
   }
  },
  "InputField3": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "City",
    "placeholder": "Springfield",
    "value": "city"
   },
   "bind": {
    "visible": "${= step==2}"
   }
  },
  "InputField4": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Postcode",
    "placeholder": "12345",
    "value": "postcode"
   },
   "bind": {
    "visible": "${= step==2}"
   }
  },
  "InputField5": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Email",
    "placeholder": "you@example.com",
    "value": "email"
   },
   "bind": {
    "props.error": "${= (email!=\"\" && !contains(email,\"@\"))?\"Enter a valid email\":(email==\"\"?\"Email is required\":\"\")}",
    "visible": "${= step==2}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step==2}"
   },
   "children": [
    "ActionButton2",
    "ActionButton3"
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "ActionButton3": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Continue",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= name!=\"\" && address!=\"\" && city!=\"\" && postcode!=\"\" && contains(email,\"@\")}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Delivery",
    "note": "Step 3 of 3"
   },
   "bind": {
    "visible": "${= step==3}"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Delivery method",
    "value": "delivery",
    "options": [
     "standard",
     "express"
    ],
    "details": [
     "3 to 5 working days",
     "Next working day"
    ],
    "prices": [
     "$4.00",
     "$12.00"
    ]
   },
   "bind": {
    "visible": "${= step==3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "delivery",
       "value": "${= result}"
      }
     ]
    }
   ]
  },
  "Details2": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Subtotal\",money((sum(qty,x=>x.price*x.qty)),\"$\",2)],[\"Delivery\",money(delivery==\"express\"?12:4,\"$\",2)],[\"Total\",money((sum(qty,x=>x.price*x.qty))+(delivery==\"express\"?12:4),\"$\",2)]]}",
    "visible": "${= step==3}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step==3}"
   },
   "children": [
    "ActionButton4",
    "ActionButton5"
   ]
  },
  "ActionButton4": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "ActionButton5": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Place order",
    "tone": "primary"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 4}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Order placed",
    "codeLabel": "Order number",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.message": "Thanks ${name}, a confirmation was sent to ${email}.",
    "props.code": "${orderNo}",
    "visible": "${= step==4}"
   }
  },
  "Details3": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Name\",name],[\"Email\",email],[\"Total paid\",money((sum(qty,x=>x.price*x.qty))+(delivery==\"express\"?12:4),\"$\",2)]]}",
    "visible": "${= step==4}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "step",
    "type": "integer",
    "value": 1
   },
   {
    "name": "qty",
    "type": "list",
    "value": [
     {
      "id": "beans",
      "name": "Espresso beans",
      "price": 24,
      "qty": 1
     },
     {
      "id": "mug",
      "name": "Ceramic mug",
      "price": 12,
      "qty": 2
     },
     {
      "id": "tote",
      "name": "Canvas tote",
      "price": 18,
      "qty": 1
     }
    ]
   },
   {
    "name": "name",
    "type": "text",
    "value": ""
   },
   {
    "name": "address",
    "type": "text",
    "value": ""
   },
   {
    "name": "city",
    "type": "text",
    "value": ""
   },
   {
    "name": "postcode",
    "type": "text",
    "value": ""
   },
   {
    "name": "email",
    "type": "text",
    "value": ""
   },
   {
    "name": "delivery",
    "type": "text",
    "value": "standard"
   },
   {
    "name": "orderNo",
    "type": "text",
    "value": "KB-20417"
   }
  ]
 }
}