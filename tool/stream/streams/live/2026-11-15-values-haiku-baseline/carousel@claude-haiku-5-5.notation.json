{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "ChatCard1"
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Running shoes",
    "subtitle": "Swipe or step through",
    "icon": "directions_run",
    "status": "Shop"
   },
   "children": [
    "Carousel1",
    "text1",
    "text2",
    "Paragraph1",
    "SectionLabel1",
    "ChoiceChips1",
    "text3",
    "row1"
   ]
  },
  "Carousel1": {
   "type": "Carousel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "open",
    "dots": true,
    "arrows": true,
    "counter": true,
    "height": 260
   },
   "bind": {
    "props.items": "${shoes}",
    "visible": "${= open==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= open}"
      }
     ]
    }
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "letterSpacing": -0.2,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${= shoes[open-1].name}"
   },
   "bind": {
    "visible": "${= open>0}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "$${= shoes[open-1].price}"
   },
   "bind": {
    "visible": "${= open>0}"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.text": "${= shoes[open-1].desc ? shoes[open-1].detail : shoes[open-1].detail}",
    "visible": "${= open>0}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Size",
    "note": "pick one"
   },
   "bind": {
    "visible": "${= open>0}"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "size",
    "options": [
     "7",
     "8",
     "9",
     "10",
     "11",
     "12"
    ],
    "disabled": [
     "8"
    ],
    "columns": 3
   },
   "bind": {
    "visible": "${= open>0}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Size ${size}"
   },
   "bind": {
    "visible": "${= (open>0) && (size!=\"\")}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= open>0}"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet",
    "icon": "arrow_back"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Add to bag",
    "tone": "primary",
    "icon": "shopping_bag"
   },
   "bind": {
    "props.enabled": "${= size!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "bag",
       "value": "${= bag+1}"
      },
      {
       "type": "showToast",
       "message": "Added to bag"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "page",
    "type": "integer",
    "value": 0
   },
   {
    "name": "open",
    "type": "integer",
    "value": 0
   },
   {
    "name": "size",
    "type": "text",
    "value": ""
   },
   {
    "name": "bag",
    "type": "integer",
    "value": 0
   },
   {
    "name": "shoes",
    "type": "list",
    "value": [
     {
      "id": 1,
      "name": "Aero Runner",
      "price": 120,
      "rating": 4.8,
      "kind": "shoe",
      "tone": "sand",
      "detail": "Lightweight daily trainer"
     },
     {
      "id": 2,
      "name": "Trail Scout",
      "price": 135,
      "rating": 4.6,
      "kind": "shoe",
      "tone": "mint",
      "detail": "Grippy trail outsole"
     },
     {
      "id": 3,
      "name": "Tempo Flash",
      "price": 150,
      "rating": 4.7,
      "kind": "shoe",
      "tone": "sky",
      "detail": "A snappy plate and a low stack for intervals and race day.",
      "desc": true
     },
     {
      "id": 4,
      "name": "Cloud Stride",
      "price": 140,
      "rating": 4.5,
      "kind": "shoe",
      "tone": "lilac",
      "detail": "Soft cushioned long-run comfort"
     },
     {
      "id": 5,
      "name": "Daybreak 2",
      "price": 95,
      "rating": 4.4,
      "kind": "shoe",
      "tone": "rose",
      "detail": "Affordable everyday runner"
     },
     {
      "id": 6,
      "name": "Night Owl",
      "price": 125,
      "rating": 4.6,
      "kind": "shoe",
      "tone": "slate",
      "detail": "Reflective panels for night runs"
     }
    ]
   }
  ]
 }
}