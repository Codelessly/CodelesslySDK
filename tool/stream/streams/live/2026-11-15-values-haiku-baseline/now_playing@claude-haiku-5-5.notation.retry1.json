{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= playing}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= min(elapsed+1,tracks[idx].len)}"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "row1",
    "progressBar1",
    "row2",
    "row3",
    "outlinedButton1",
    "text5",
    "listView1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "Media1",
    "column2"
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "width": 64,
    "height": 64
   },
   "props": {
    "kind": "train",
    "tone": "dusk"
   },
   "decoration": {
    "radius": 8
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "${= tracks[idx].title}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= tracks[idx].artist}"
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "max": 1,
    "borderRadius": 2,
    "color": "#FF2563EB",
    "backgroundColor": "#FFE5E7EB"
   },
   "bind": {
    "props.value": "${elapsed}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text3",
    "text4"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "${= formatTime(elapsed)}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "-${= formatTime(tracks[idx].len-elapsed)}"
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "center",
    "spacing": 20,
    "crossAxisAlignment": "center"
   },
   "children": [
    "iconButton1",
    "iconButton2",
    "iconButton3"
   ]
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_previous"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "iconButton2": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.icon": "${= playing?'pause':'play_arrow'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "playing",
       "value": "${= !playing}"
      }
     ]
    }
   ]
  },
  "iconButton3": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_next"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "idx",
       "value": "${= min(idx+1,4)}"
      },
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= liked?'Liked':'Like'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "liked",
       "value": "${= !liked}"
      }
     ]
    }
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Up next"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8
   },
   "children": [
    "listView2"
   ]
  },
  "listView2": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 8
   },
   "bind": {
    "data": "${tracks}"
   },
   "children": [
    "listView2Item"
   ]
  },
  "listView2Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row4"
   ]
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= item.title!=tracks[idx].title}"
   },
   "children": [
    "Media2",
    "column3",
    "text8"
   ]
  },
  "Media2": {
   "type": "Media",
   "layout": {
    "width": 40,
    "height": 40
   },
   "props": {
    "kind": "train"
   },
   "decoration": {
    "radius": 6
   },
   "bind": {
    "props.tone": "${item.tone}"
   }
  },
  "column3": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "text6",
    "text7"
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item.title}"
   }
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${item.artist}"
   }
  },
  "text8": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "${= formatTime(item.len)}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "elapsed",
    "type": "integer",
    "value": 74
   },
   {
    "name": "playing",
    "type": "boolean",
    "value": true
   },
   {
    "name": "liked",
    "type": "boolean",
    "value": false
   },
   {
    "name": "idx",
    "type": "integer",
    "value": 0
   },
   {
    "name": "tracks",
    "type": "list",
    "value": [
     {
      "title": "Midnight City",
      "artist": "M83",
      "len": 243,
      "tone": "dusk"
     },
     {
      "title": "Golden Hour",
      "artist": "JVKE",
      "len": 209,
      "tone": "sand"
     },
     {
      "title": "Ocean Eyes",
      "artist": "Billie Eilish",
      "len": 200,
      "tone": "sky"
     },
     {
      "title": "Electric Feel",
      "artist": "MGMT",
      "len": 229,
      "tone": "mint"
     },
     {
      "title": "Dreams",
      "artist": "Fleetwood Mac",
      "len": 257,
      "tone": "rose"
     }
    ]
   }
  ]
 }
}