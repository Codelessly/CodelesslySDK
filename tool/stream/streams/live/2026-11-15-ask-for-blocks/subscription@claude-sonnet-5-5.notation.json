{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Pro plan",
    "subtitle": "Renews in 3 days",
    "icon": "workspace_premium",
    "status": "Active",
    "tone": "accent"
   },
   "children": [
    "Details1",
    "SectionLabel1",
    "ProgressLine1",
    "ProgressLine2",
    "switch1",
    "Callout1",
    "row1"
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Plan\",\"Pro\"],[\"Price\",annual?\"$288 / year\":\"$29 / month\"],[\"Next renewal\",\"In 3 days\"]]}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Usage",
    "note": "this period"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Storage"
   },
   "bind": {
    "props.detail": "${storageUsed} of ${storageTotal} GB",
    "props.value": "${= storageUsed/storageTotal}"
   }
  },
  "ProgressLine2": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Seats"
   },
   "bind": {
    "props.detail": "${seatsUsed} of ${seatsTotal}",
    "props.value": "${= seatsUsed/seatsTotal}"
   }
  },
  "switch1": {
   "type": "switch",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Switch to annual billing"
   },
   "bind": {
    "props.value": "${annual}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "annual",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "You save $60 a year",
    "message": "Annual is $288 instead of $348 billed monthly.",
    "tone": "good",
    "icon": "savings"
   },
   "bind": {
    "visible": "${= annual}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Manage plan",
    "tone": "primary"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "manage"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Cancel renewal",
    "tone": "danger"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "cancelRenewal"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "annual",
    "type": "boolean",
    "value": false
   },
   {
    "name": "storageUsed",
    "type": "integer",
    "value": 68
   },
   {
    "name": "storageTotal",
    "type": "integer",
    "value": 100
   },
   {
    "name": "seatsUsed",
    "type": "integer",
    "value": 7
   },
   {
    "name": "seatsTotal",
    "type": "integer",
    "value": 10
   }
  ]
 }
}