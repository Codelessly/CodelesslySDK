{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Expense report",
    "subtitle": "4 expenses awaiting approval",
    "icon": "receipt_long",
    "status": "Pending",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "listView1",
    "Details1",
    "ActionButton1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Expenses",
    "note": "4 items"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${rows}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "column1"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "row1",
    "row2",
    "row4"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item.merchant}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "$${item.amount}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text3",
    "row3"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${item.category} · ${item.date}"
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 20,
    "padding": [
     8,
     0,
     8,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#1AEA580C"
     }
    ],
    "strokes": [
     {
      "color": "#47EA580C"
     }
    ],
    "radius": 5
   },
   "bind": {
    "visible": "${= item.receipt==false}"
   },
   "children": [
    "text4"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Missing receipt",
    "style": {
     "fontSize": 11,
     "fontWeight": 500,
     "color": "#FFEA580C"
    }
   }
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "choiceChip1",
    "choiceChip2"
   ]
  },
  "choiceChip1": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Approve"
   },
   "bind": {
    "props.selected": "${= contains(approved,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "approved",
       "value": "${= append(without(approved,item.id),item.id)}"
      },
      {
       "type": "setVariable",
       "variable": "rejected",
       "value": "${= without(rejected,item.id)}"
      }
     ]
    }
   ]
  },
  "choiceChip2": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Reject"
   },
   "bind": {
    "props.selected": "${= contains(rejected,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "rejected",
       "value": "${= append(without(rejected,item.id),item.id)}"
      },
      {
       "type": "setVariable",
       "variable": "approved",
       "value": "${= without(approved,item.id)}"
      }
     ]
    }
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Approved total\",money(sum(filter(rows,r=>contains(approved,r.id)),r=>r.amount),\"$\",2)],[\"Rejected\",money(sum(filter(rows,r=>contains(rejected,r.id)),r=>r.amount),\"$\",2)]]}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Submit decisions",
    "tone": "primary",
    "icon": "send"
   },
   "bind": {
    "props.enabled": "${= length(approved)+length(rejected)==4}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "submitDecisions"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "approved",
    "type": "list",
    "value": []
   },
   {
    "name": "rejected",
    "type": "list",
    "value": []
   },
   {
    "name": "rows",
    "type": "list",
    "value": [
     {
      "id": 1,
      "merchant": "Blue Bottle Coffee",
      "category": "Meals",
      "date": "Mar 3",
      "amount": 14.5,
      "receipt": true
     },
     {
      "id": 2,
      "merchant": "Delta Airlines",
      "category": "Travel",
      "date": "Mar 4",
      "amount": 386.2,
      "receipt": true
     },
     {
      "id": 3,
      "merchant": "Hilton Garden Inn",
      "category": "Lodging",
      "date": "Mar 4",
      "amount": 212.0,
      "receipt": false
     },
     {
      "id": 4,
      "merchant": "Uber",
      "category": "Transport",
      "date": "Mar 5",
      "amount": 32.75,
      "receipt": true
     }
    ]
   }
  ]
 }
}