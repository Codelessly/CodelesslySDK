ion==\"approved\")} approved · {count(items,x=>x.decision==\"rejected\")} rejected\" amount:=money(sum(filter(items,x=>x.decision==\"approved\"),x=>x.amount),\"$\",2) cta:\"Submit\" enabled:=count(items,x=>x.decision!=\"\")==length(items) -> submitted=true; emit submit items\n  if submitted\n    Receipt \"Report submitted\" \"Your decisions have been sent.\" tone:good icon:\"check\"","usage":{"input_tokens":9121,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":821,"service_tier":"standard","inference_geo":"global","speed":"standard","output_tokens_details":{"thinking_tokens":0}},"ttftMs":982,"totalMs":5043}}
