{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= playing && pos<total}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pos",
       "value": "${= pos+1}"
      }
     ]
    }
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Now playing",
    "subtitle": "Midnight Drive Radio",
    "icon": "music_note",
    "status": "Playing",
    "tone": "accent"
   },
   "children": [
    "row1",
    "ProgressLine1",
    "row2",
    "SectionLabel1",
    "listView1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 14,
    "crossAxisAlignment": "center"
   },
   "children": [
    "Media1",
    "column1",
    "iconButton1"
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "width": 96,
    "height": 96
   },
   "props": {
    "kind": "lagoon",
    "tone": "dusk"
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2",
    "text3"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 19,
     "fontWeight": 700,
     "fontFamily": "Inter Display",
     "letterSpacing": -0.3,
     "height": 1.2,
     "color": "#FF111827"
    },
    "text": "City Lights at Dawn"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Aurora Vale"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Album: Glass Horizons"
   }
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "favorite"
   },
   "bind": {
    "props.icon": "${= liked?\"favorite\":\"favorite_border\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "liked",
       "value": "${= !liked}"
      }
     ]
    }
   ]
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= floor(pos/60)}:${= pos%60<10?'0':''}${= pos%60}",
    "props.detail": "-${= floor((total-pos)/60)}:${= (total-pos)%60<10?'0':''}${= (total-pos)%60}",
    "props.value": "${= pos/total}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "spacing": 20
   },
   "children": [
    "iconButton2",
    "iconButton3",
    "iconButton4"
   ]
  },
  "iconButton2": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_previous"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pos",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "iconButton3": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "pause_circle"
   },
   "bind": {
    "props.icon": "${= playing?\"pause_circle\":\"play_circle\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "playing",
       "value": "${= !playing}"
      }
     ]
    }
   ]
  },
  "iconButton4": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_next"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pos",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Up next",
    "note": "3 tracks"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${queue}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "listTile1"
   ]
  },
  "listTile1": {
   "type": "listTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "slots": {
    "trailing": "row3"
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "constraints": {
     "maxWidth": 150
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "column2",
    "text6"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "text4",
    "text5"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "fontFamily": "Inter",
     "letterSpacing": -0.1,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${item.title}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "${item.artist}"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "fontFamily": "Inter",
     "height": 1.35,
     "color": "#FF6B7280"
    },
    "text": "${item.time}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "playing",
    "type": "boolean",
    "value": true
   },
   {
    "name": "liked",
    "type": "boolean",
    "value": false
   },
   {
    "name": "pos",
    "type": "integer",
    "value": 94
   },
   {
    "name": "total",
    "type": "integer",
    "value": 227
   },
   {
    "name": "queue",
    "type": "list",
    "value": [
     {
      "title": "Neon Skyline",
      "artist": "Vela",
      "time": "3:42"
     },
     {
      "title": "Afterglow",
      "artist": "The Lanterns",
      "time": "4:05"
     },
     {
      "title": "Slow Highway",
      "artist": "Mira Kole",
      "time": "3:18"
     }
    ]
   }
  ]
 }
}