{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text1",
    "textField1",
    "textField2",
    "segmentedButton1",
    "textField3",
    "row1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Email to landlord"
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "To",
     "hintText": "landlord@example.com"
    }
   },
   "bind": {
    "props.initialValue": "${to}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField2": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Subject",
     "hintText": "Heating not working"
    }
   },
   "bind": {
    "props.initialValue": "${subject}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "subject",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.selected": "${= tone items:[\"Polite\",\"Firm\"]}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${= tone==\"Firm\"?\"Hello,\\n\\nThe heating in my flat has not worked for over a week. This is a serious problem and I need it repaired as soon as possible. Please confirm when someone will attend.\\n\\nRegards\":\"Hello,\\n\\nI hope you are well. The heating in my flat stopped working about a week ago and I would be grateful if you could arrange a repair when convenient. Please let me know when someone can attend.\\n\\nThank you,\"}"
      }
     ]
    }
   ]
  },
  "textField3": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Body",
     "hintText": "Write your message"
    }
   },
   "bind": {
    "props.initialValue": "${body}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "end",
    "crossAxisAlignment": "center"
   },
   "children": [
    "textButton1",
    "filledButton1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Discard"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "subject",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "body",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "sendEmail"
      },
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF15803D"
    },
    "text": "Sent to ${to}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": ""
   },
   {
    "name": "subject",
    "type": "text",
    "value": ""
   },
   {
    "name": "body",
    "type": "text",
    "value": "Hello,\n\nI hope you are well. The heating in my flat stopped working about a week ago and I would be grateful if you could arrange a repair when convenient. Please let me know when someone can attend.\n\nThank you,"
   },
   {
    "name": "sent",
    "type": "boolean",
    "value": false
   },
   {
    "name": "tone",
    "type": "text",
    "value": "Polite"
   }
  ]
 }
}