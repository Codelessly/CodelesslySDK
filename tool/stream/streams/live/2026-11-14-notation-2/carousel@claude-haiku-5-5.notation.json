      "image": {
       "url": "https://placehold.co/320x200?text=Shoe",
       "fit": "cover"
      }
     }
    ]
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    },
    "text": "${= descriptions[picked]}"
   }
