     "hug": 0
    }
   },
   "props": {
    "label": "Prev"
   },
   "bind": {
    "props.enabled": "${= page>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= page-1}"
      },
      {
       "type": "setVariable",
       "variable": "rows",
