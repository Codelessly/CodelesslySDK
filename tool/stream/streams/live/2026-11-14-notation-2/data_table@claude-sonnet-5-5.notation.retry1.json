   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Invoices"
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Search customer",
     "hintText": "Type a name"
    }
   },
   "bind": {
    "props.initialValue": "${q}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "q",
       "value": "${result}"
      }
     ]
    },
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "total",
       "value": "${= count(filter(invoices,(status==\"All\"||status==it.status)&&contains(lower(it.customer),lower(q))))}"
      },
      {
       "type": "setVariable",
       "variable": "rows",
       "value": "${= slice(sortBy(filter(invoices,(status==\"All\"||status==it.status)&&contains(lower(it.customer),lower(q))),sortKey,sortDir),page*5,page*5+5)}"
      }
     ]
    }
   ]
  },
  "segmentedButton1": {
