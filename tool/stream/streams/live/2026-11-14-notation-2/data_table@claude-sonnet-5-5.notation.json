    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Status"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= sortKey==\"status\"&&sortDir==\"asc\"?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
