   "props": {
    "label": "No."
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= sortKey==\"id\"&&sortDir==\"asc\"?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
       "variable": "sortKey",
       "value": "id"
      }
     ]
    }
   ]
  },
  "textButton2": {
   "type": "textButton",
