      "color": "#FFE8EAF6"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "bind": {
    "visible": "${= count(sel)>0}"
   },
   "children": [
    "row4",
    "filledButton1"
   ]
