  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send reminders"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "remind",
       "value": "${sel}"
      },
      {
       "type": "showToast",
       "message": "Reminders sent"
      }
     ]
    }
   ]
  }
 },
