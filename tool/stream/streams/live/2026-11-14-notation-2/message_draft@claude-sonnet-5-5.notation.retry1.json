{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "row1",
    "segmentedButton1",
    "textField1",
    "textField2",
    "textField3",
    "text2",
    "row2",
    "row3",
    "text4",
    "text5",
    "text6",
    "row4",
    "outlinedButton1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= status==\"draft\"}"
   },
   "children": [
    "text1",
    "badge1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Email draft"
   }
  },
  "badge1": {
   "type": "badge",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "backgroundColor": "#FFDBEAFE",
    "textColor": "#FF1D4ED8",
    "label": "Draft"
   }
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.selected": "${= tone items:[\"polite\",\"firm\"]}",
    "visible": "${= status==\"draft\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${= tone==\"polite\"?\"Hi,\\n\\nI hope you're well. The heating in my flat has stopped working, and with the colder weather it's becoming difficult to stay comfortable. Could you please arrange for someone to take a look as soon as possible?\\n\\nI'm happy to give access at a time that suits. Thank you for your help.\\n\\nKind regards\":\"Hello,\\n\\nThe heating in my flat is broken and has not been working. This is a repair you are responsible for, and it needs to be fixed urgently. Please confirm within 48 hours when an engineer will attend.\\n\\nIf I don't hear back, I will have to consider my options and escalate the matter.\\n\\nRegards\"}"
      }
     ]
    }
   ]
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "To",
     "hintText": "landlord@example.com"
    }
   },
   "bind": {
    "props.initialValue": "${to}",
    "visible": "${= status==\"draft\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField2": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Subject"
    }
   },
   "bind": {
    "props.initialValue": "${subject}",
    "visible": "${= status==\"draft\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "subject",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField3": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Body"
    }
   },
   "bind": {
    "props.initialValue": "${= body lines:8}",
    "visible": "${= status==\"draft\"}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FFB91C1C"
    },
    "text": "Add a recipient and a subject to send."
   },
   "bind": {
    "visible": "${= (status==\"draft\") && (to==\"\"||subject==\"\")}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "end",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= status==\"draft\"}"
   },
   "children": [
    "textButton1",
    "filledButton1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Discard"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "status",
       "value": "discarded"
      },
      {
       "type": "componentEvent",
       "event": "discard"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": ""
   },
   "bind": {
    "props.enabled": "${= to!=}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "status",
       "value": "sent"
      },
      {
       "type": "componentEvent",
       "event": "send"
      },
      {
       "type": "showToast",
       "message": "Email sent"
      }
     ]
    }
   ]
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= status==\"sent\"}"
   },
   "children": [
    "icon1",
    "text3",
    "badge2"
   ]
  },
  "icon1": {
   "type": "icon",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "check_circle"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Sent"
   }
  },
  "badge2": {
   "type": "badge",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "backgroundColor": "#FFDCFCE7",
    "textColor": "#FF15803D",
    "label": "Sent"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "${subject}"
   },
   "bind": {
    "visible": "${= status==\"sent\"}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "To: ${to}"
   },
   "bind": {
    "visible": "${= status==\"sent\"}"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    },
    "text": "${body}"
   },
   "bind": {
    "visible": "${= status==\"sent\"}"
   }
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= status==\"discarded\"}"
   },
   "children": [
    "text7",
    "badge3"
   ]
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Draft discarded"
   }
  },
  "badge3": {
   "type": "badge",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "backgroundColor": "#FFF3F4F6",
    "textColor": "#FF374151",
    "label": "Discarded"
   }
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Restore draft"
   },
   "bind": {
    "visible": "${= status==\"discarded\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "status",
       "value": "draft"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": "landlord@example.com"
   },
   {
    "name": "subject",
    "type": "text",
    "value": "Heating not working in my flat"
   },
   {
    "name": "tone",
    "type": "text",
    "value": "polite"
   },
   {
    "name": "body",
    "type": "text",
    "value": "Hi,\n\nI hope you're well. The heating in my flat has stopped working, and with the colder weather it's becoming difficult to stay comfortable. Could you please arrange for someone to take a look as soon as possible?\n\nI'm happy to give access at a time that suits. Thank you for your help.\n\nKind regards"
   },
   {
    "name": "status",
    "type": "text",
    "value": "draft"
   }
  ]
 }
}