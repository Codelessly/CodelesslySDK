{"meta":{"ui":"plan_progress","model":"claude-haiku-5-5","form":"notation","turn":"generate","prompt":"Show the plan for migrating my blog as steps: six steps with a short description each. A start button runs them one after another (a second or two each) with a spinner on the running step, ticks on the finished ones, a progress bar and the time elapsed, a pause button, and a summary when all are done.","text":"Card gap:12 pad:16\n  Text.title \"Blog migration\"\n  Row between\n    Text.muted \"Elapsed: {elapsed}s\"\n    Badge.info \"{status}\"\n  Progress =progress\n  Row gap:8\n    Button.primary \"Start\" -> status=\"running\"; emit start\n    Button.secondary \"Pause\" -> status=\"paused\"; emit pause\n  List gap:8\n    ListTile\n      Row gap:8\n        if done1\n          Icon \"check\"\n        if !done1\n          CircularProgressIndicator\n        Text.strong \"1. Back up the current blog\"\n      Text.muted \"Export all posts, pages and media to a safe archive.\"\n    ListTile\n      Row gap:8\n        if done2\n          Icon \"check\"\n        if !done2\n          CircularProgressIndicator\n        Text.strong \"2. Export content\"\n      Text.muted \"Convert posts and comments into a portable format.\"\n    ListTile\n      Row gap:8\n        if done3\n          Icon \"check\"\n        if !done3\n          CircularProgressIndicator\n        Text.strong \"3. Set up the new host\"\n      Text.muted \"Provision hosting, domain and the blog software.\"\n    ListTile\n      Row gap:8\n        if done4\n          Icon \"check\"\n        if !done4\n          CircularProgressIndicator\n        Text.strong \"4. Import content\"\n      Text.muted \"Load posts, pages, media and comments into the new site.\"\n    ListTile\n      Row gap:8\n        if done5\n          Icon \"check\"\n        if !done5\n          CircularProgressIndicator\n        Text.strong \"5. Redirects and SEO\"\n      Text.muted \"Map old URLs to new ones so search rankings are kept.\"\n    ListTile\n      Row gap:8\n        if done6\n          Icon \"check\"\n        if !done6\n          CircularProgressIndicator\n        Text.strong \"6. Switch DNS and verify\"\n      Text.muted \"Point the domain at the new site and check every page.\"\n  if allDone\n    Card gap:4\n      Text.success \"Migration complete\"\n      Text.body \"All 6 steps finished in {elapsed}s.\"","usage":{"input_tokens":1702,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":701,"service_tier":"standard","inference_geo":"global","speed":"standard","output_tokens_details":{"thinking_tokens":0}},"ttftMs":473,"totalMs":3003}}
