    "visible": "${= step>=6}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= false}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
