   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "1. Heat the oven to 220°C. Toss potatoes with oil, oregano and salt on a large tray."
   }
  },
  "Paragraph2": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "2. Nestle the chicken among the potatoes, skin side up, and roast for 20 minutes."
   }
  },
  "Paragraph3": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "3. Add lemon wedges and garlic, then roast 15 minutes more until golden."
   }
  },
  "Paragraph4": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "4. Rest for 5 minutes, spoon over the pan juices and serve."
   }
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Cooking started",
    "message": "Oven on at 220°C. Follow the four steps above.",
    "tone": "good"
   },
   "bind": {
    "visible": "${= started}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
