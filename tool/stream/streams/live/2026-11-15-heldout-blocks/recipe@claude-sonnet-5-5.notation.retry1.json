   },
   "bind": {
    "props.note": "${= length(have)} of 6 ticked"
   }
  },
  "Checklist1": {
   "type": "Checklist",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Gather",
    "value": "have"
   },
   "bind": {
    "props.items": "${= [round(servings*0.5,1)+\" kg chicken thighs\",servings*0.5+\" lemons\",round(servings*0.75,1)+\" tbsp olive oil\",servings*200+\" g baby potatoes\",servings+\" garlic cloves\",round(servings*0.5,1)+\" tsp dried oregano\"]}"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Method",
    "note": "4 steps"
   }
  },
  "Steps1": {
   "type": "Steps",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "steps": [
     "Prep",
     "Roast",
     "Add lemon",
     "Rest"
    ],
    "current": 1
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
