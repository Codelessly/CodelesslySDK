   "props": {
    "label": "Start cooking",
    "tone": "primary",
    "icon": "play_arrow"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "started",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "startCooking"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "servings",
    "type": "integer",
    "value": 4
   },
   {
    "name": "have",
    "type": "list",
    "value": []
   },
   {
    "name": "started",
    "type": "boolean",
    "value": false
   }
  ]
 }
