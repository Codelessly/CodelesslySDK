{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Schedule meeting",
    "subtitle": "30 minutes with your team",
    "icon": "event",
    "status": "Draft",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "DayPicker1",
    "SectionLabel2",
    "ChoiceChips1",
    "SectionLabel3",
    "Details1",
    "TotalBar1",
    "Receipt1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Day",
    "note": "Next week"
   },
   "bind": {
    "visible": "${= !done}"
   }
  },
  "DayPicker1": {
   "type": "DayPicker",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "day",
    "days": [
     "Mon 16",
     "Tue 17",
     "Wed 18",
     "Thu 19",
     "Fri 20"
    ]
   },
   "bind": {
    "visible": "${= !done}"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Free time slots",
    "note": "30 min"
   },
   "bind": {
    "visible": "${= (!done) && (day!=\"\")}"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "slot",
    "options": [
     "09:00",
     "09:30",
     "10:00",
     "10:30",
     "11:00",
     "13:00",
     "13:30",
     "14:00",
     "15:00"
    ],
    "disabled": [
     "09:30",
     "10:30",
     "13:00",
     "15:00"
    ],
    "columns": 3
   },
   "bind": {
    "visible": "${= (!done) && (day!=\"\")}"
   }
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Attendees",
    "note": "3 colleagues"
   },
   "bind": {
    "visible": "${= !done}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icons": [
     "person",
     "person",
     "person"
    ]
   },
   "bind": {
    "props.rows": "${= [[\"Maya Chen\",\"Accepted\"],[\"Luis Ortega\",\"Pending\"],[\"Priya Nair\",\"Pending\"]]}",
    "visible": "${= !done}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Meeting time",
    "note": "30 minutes, 3 colleagues",
    "cta": "Confirm"
   },
   "bind": {
    "props.amount": "${= (day!=\"\"&&slot!=\"\")?(day+\", \"+slot):\"Pick a time\"}",
    "props.enabled": "${= day!=\"\"&&slot!=\"\"}",
    "visible": "${= !done}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= true}"
      },
      {
       "type": "showToast",
       "message": "Meeting booked"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Meeting booked",
    "message": "30 minutes with Maya, Luis and Priya. Invitations are sent.",
    "codeLabel": "Booked time",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.code": "${= day+\", \"+slot}",
    "visible": "${= done}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "day",
    "type": "text",
    "value": ""
   },
   {
    "name": "slot",
    "type": "text",
    "value": ""
   },
   {
    "name": "done",
    "type": "boolean",
    "value": false
   }
  ]
 }
}