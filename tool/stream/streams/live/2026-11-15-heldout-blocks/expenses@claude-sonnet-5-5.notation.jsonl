{"meta":{"ui":"expenses","model":"claude-sonnet-5-5","form":"notation","designSystem":"cards","turn":"generate","prompt":"I have four expenses waiting for my approval from one report. Show them in a card with merchant, category, date and amount, flag the one missing a receipt, let me approve or reject each, and show the approved total and a submit button.","text":"state items=[{\"id\":1,\"merchant\":\"Delta Airlines\",\"cat\":\"Travel\",\"date\":\"Mar 3\",\"amt\":412.5,\"receipt\":true,\"status\":\"pending\"},{\"id\":2,\"merchant\":\"Blue Bottle Coffee\",\"cat\":\"Meals\",\"date\":\"Mar 4\",\"amt\":18.75,\"receipt\":true,\"status\":\"pending\"},{\"id\":3,\"merchant\":\"Marriott Downtown\",\"cat\":\"Lodging\",\"date\":\"Mar 5\",\"amt\":289,\"receipt\":false,\"status\":\"pending\"},{\"id\":4,\"merchant\":\"Uber\",\"cat\":\"Transport\",\"date\":\"Mar 6\",\"amt\":34.2,\"receipt\":true,\"status\":\"pending\"}]\nstate submitted=false\nChatCard \"Expense approvals\" \"Report #2041 · 4 expenses\" icon:\"receipt_long\" status:\"{count(items,x=>x.status=='pending')} pending\" tone:accent w:390\n  if !submitted\n    SectionLabel \"Expenses\" \"{length(items)} items\"\n    each e in items\n      Box pad:12 radius:12 gap:8 fill:=e.status==\"approved\"?\"#FFE8F5EC\":(e.status==\"rejected\"?\"#FFFBE9E9\":\"#FFF6F7F9\")\n        Row between middle\n          Column gap:2\n            Text.strong \"{e.merchant}\"\n            Text.caption \"{e.cat} · {e.date}\"\n          Text.strong \"{money(e.amt,'$',2)}\"\n        if !e.receipt\n          Callout \"Missing receipt\" \"Attach a receipt before approving.\" tone:warn icon:\"warning\"\n        Row gap:10\n          ActionButton \"Approve\" tone:good enabled:=e.receipt&&e.status!=\"approved\" -> items=updateWhere(items,x=>x.id==e.id,x=>with(x,\"status\",\"approved\"))\n          ActionButton \"Reject\" tone:danger enabled:=e.status!=\"rejected\" -> items=updateWhere(items,x=>x.id==e.id,x=>with(x,\"status\",\"rejected\"))\n    TotalBar