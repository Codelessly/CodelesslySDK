{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "row1",
    "text2",
    "text3",
    "text4",
    "outlinedButton1",
    "text5",
    "outlinedButton2",
    "text6",
    "textField1",
    "textField2",
    "segmentedButton1",
    "textField3",
    "text7",
    "row2"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= sent}"
   },
   "children": [
    "icon1",
    "text1"
   ]
  },
  "icon1": {
   "type": "icon",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "check_circle"
   }
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Email sent"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "To: ${to}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "${subject}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    },
    "text": "${body}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Edit again"
   },
   "bind": {
    "visible": "${= sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Draft discarded"
   },
   "bind": {
    "visible": "${= !sent && discarded}"
   }
  },
  "outlinedButton2": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Restore draft"
   },
   "bind": {
    "visible": "${= !sent && discarded}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "discarded",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Draft email"
   },
   "bind": {
    "visible": "${= !sent && !discarded}"
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "To",
     "hintText": "landlord@example.com"
    }
   },
   "bind": {
    "props.initialValue": "${to}",
    "visible": "${= !sent && !discarded}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField2": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Subject"
    }
   },
   "bind": {
    "props.initialValue": "${subject}",
    "visible": "${= !sent && !discarded}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "subject",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "segments": [
     {
      "value": "Polite",
      "label": "Polite"
     },
     {
      "value": "Firm",
      "label": "Firm"
     }
    ]
   },
   "bind": {
    "props.selected": "${= [tone]}",
    "visible": "${= !sent && !discarded}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "tone",
       "value": "${result[0]}"
      }
     ]
    },
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${= tone==\"Firm\"?\"Hello,\\n\\nThe heating in my apartment has stopped working. This is a repair issue that needs urgent attention, especially in the current cold weather. Please arrange a repair within the next 48 hours and confirm the date and time in writing.\\n\\nIf it is not resolved promptly, I will have to consider my options under my tenancy agreement.\\n\\nRegards\":\"Hi,\\n\\nI hope you're well. The heating in my apartment has stopped working, and with the colder weather it's becoming difficult to stay comfortable at home. Could you please arrange for someone to take a look as soon as possible?\\n\\nI'm happy to provide access at a time that suits. Thank you for your help.\\n\\nKind regards\"}"
      }
     ]
    }
   ]
  },
  "textField3": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Message"
    },
    "maxLines": 10
   },
   "bind": {
    "props.initialValue": "${body}",
    "visible": "${= !sent && !discarded}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FFB91C1C"
    },
    "text": "Add a recipient and a subject to send."
   },
   "bind": {
    "visible": "${= (!sent && !discarded) && (to==\"\" || subject==\"\")}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "end",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= !sent && !discarded}"
   },
   "children": [
    "textButton1",
    "filledButton1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Discard"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "discarded",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "discard"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send"
   },
   "bind": {
    "props.enabled": "${= to!=\"\"&&subject!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "send"
      },
      {
       "type": "showToast",
       "message": "Email sent"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": "landlord@example.com"
   },
   {
    "name": "subject",
    "type": "text",
    "value": "Heating not working in my apartment"
   },
   {
    "name": "tone",
    "type": "text",
    "value": "Polite"
   },
   {
    "name": "sent",
    "type": "boolean",
    "value": false
   },
   {
    "name": "discarded",
    "type": "boolean",
    "value": false
   },
   {
    "name": "body",
    "type": "text",
    "value": "Hi,\n\nI hope you're well. The heating in my apartment has stopped working, and with the colder weather it's becoming difficult to stay comfortable at home. Could you please arrange for someone to take a look as soon as possible?\n\nI'm happy to provide access at a time that suits. Thank you for your help.\n\nKind regards"
   }
  ]
 }
}