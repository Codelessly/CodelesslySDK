   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= has(sel,item)?without(sel,item):append(sel,item)}"
      }
     ]
    }
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
