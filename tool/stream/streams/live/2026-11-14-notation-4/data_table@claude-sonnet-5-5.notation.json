    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Prev"
   },
   "bind": {
    "props.enabled": "${= page>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= page-1}"
      }
     ]
    }
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "Page ${= page+1} of ${= max(1,ceil(len(filterRows(rows,status,q))/5))}"
   }
  },
  "outlinedButton2": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Next"
   },
   "bind": {
    "props.enabled": "${= (page+1)*5<len(filterRows(rows,status,q))}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= page+1}"
      }
     ]
    }
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 10,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFE8EAF6"
     }
    ],
    "radius": 8
   },
   "bind": {
    "visible": "${= len(sel)>0}"
   },
   "children": [
    "row4"
   ]
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text7",
    "filledButton1"
