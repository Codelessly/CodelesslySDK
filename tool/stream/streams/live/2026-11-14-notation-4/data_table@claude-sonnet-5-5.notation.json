    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF111827"
    },
    "text": "${item.no}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "flex": 1,
    "squeezable": true,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF111827"
    },
    "text": "${item.customer}"
   }
