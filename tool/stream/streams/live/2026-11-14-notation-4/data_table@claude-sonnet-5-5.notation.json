  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Invoices"
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Search customer"
    }
   },
   "bind": {
    "props.initialValue": "${q}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "q",
       "value": "${result}"
      }
     ]
    },
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "segments": [
     {
      "value": "All",
      "label": "All"
     },
     {
      "value": "Paid",
      "label": "Paid"
     },
     {
      "value": "Pending",
      "label": "Pending"
     },
     {
      "value": "Overdue",
      "label": "Overdue"
     }
    ]
   },
   "bind": {
    "props.selected": "${= [status]}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "status",
       "value": "${result[0]}"
      }
     ]
    },
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "center"
   },
   "children": [
    "checkbox1",
    "textButton1",
    "textButton2",
    "textButton3",
    "textButton4",
    "textButton5"
   ]
  },
  "checkbox1": {
   "type": "checkbox",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= all(pageRows,sel)?without(sel,pageRows):union(sel,pageRows)}"
      }
     ]
    }
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "No"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= (sortKey==\"no\"&&sortDir==\"asc\")?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
       "variable": "sortKey",
       "value": "no"
      }
     ]
    }
   ]
  },
  "textButton2": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Customer"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= (sortKey==\"customer\"&&sortDir==\"asc\")?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
       "variable": "sortKey",
       "value": "customer"
      }
     ]
    }
   ]
  },
  "textButton3": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Date"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= (sortKey==\"date\"&&sortDir==\"asc\")?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
       "variable": "sortKey",
       "value": "date"
      }
     ]
    }
   ]
  },
  "textButton4": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Amount"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= (sortKey==\"amount\"&&sortDir==\"asc\")?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
       "variable": "sortKey",
       "value": "amount"
      }
     ]
    }
   ]
  },
  "textButton5": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Status"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sortDir",
       "value": "${= (sortKey==\"status\"&&sortDir==\"asc\")?\"desc\":\"asc\"}"
      },
      {
       "type": "setVariable",
       "variable": "sortKey",
       "value": "status"
      }
     ]
    }
   ]
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false
   },
   "bind": {
    "data": "${= slice(sortBy(filterRows(rows,status,q),sortKey,sortDir),page*5,page*5+5)}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row2"
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "center"
   },
   "children": [
    "checkbox2",
    "text2",
    "text3",
    "text4",
    "text5",
    "badge1",
    "badge2",
    "badge3"
   ]
  },
  "checkbox2": {
   "type": "checkbox",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
