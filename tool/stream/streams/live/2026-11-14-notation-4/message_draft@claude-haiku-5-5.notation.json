{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text1",
    "textField1",
    "textField2",
    "segmentedButton1",
    "textField3",
    "text2",
    "text3",
    "row1",
    "badge1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Email to landlord"
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "To",
     "hintText": "landlord@example.com"
    }
   },
   "bind": {
    "props.initialValue": "${to}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField2": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Subject",
     "hintText": "Heating repair needed"
    }
   },
   "bind": {
    "props.initialValue": "${subject}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "subject",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "segments": [
     {
      "value": "Polite",
      "label": "Polite"
     },
     {
      "value": "Firm",
      "label": "Firm"
     }
    ]
   },
   "bind": {
    "props.selected": "${= [tone]}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "tone",
       "value": "${result[0]}"
      }
     ]
    },
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "tone"
      }
     ]
    }
   ]
  },
  "textField3": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Body"
    }
   },
   "bind": {
    "props.initialValue": "${body}",
    "visible": "${= tone==\"Polite\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "Hi, I hope you are well. The heating in my flat has stopped working and it is getting cold. Could you arrange a repair at your earliest convenience? Thank you."
   },
   "bind": {
    "visible": "${= tone==\"Polite\"}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "The heating in my flat has been broken for several days. This needs fixing urgently. Please arrange a repair within 48 hours and confirm when someone will attend."
   },
   "bind": {
    "visible": "${= tone==\"Firm\"}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "end",
    "crossAxisAlignment": "center"
   },
   "children": [
    "textButton1",
    "filledButton1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Discard"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "discard"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "send"
      },
      {
       "type": "showToast",
       "message": "Email sent"
      }
     ]
    }
   ]
  },
  "badge1": {
   "type": "badge",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "backgroundColor": "#FFDCFCE7",
    "textColor": "#FF15803D",
    "label": "Sent"
   },
   "bind": {
    "visible": "${= sent}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": ""
   },
   {
    "name": "subject",
    "type": "text",
    "value": ""
   },
   {
    "name": "tone",
    "type": "text",
    "value": ""
   },
   {
    "name": "body",
    "type": "text",
    "value": ""
   }
  ]
 }
}