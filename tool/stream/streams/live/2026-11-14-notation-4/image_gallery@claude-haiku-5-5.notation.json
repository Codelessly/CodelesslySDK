   "props": {
    "spacing": 8,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "listView1",
    "spacer1",
    "spacer2"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false
   },
   "bind": {
    "data": "${photos}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "column2"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 0,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "{item.c}"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
