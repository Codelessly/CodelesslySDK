       "value": "${= index}"
      },
      {
       "type": "componentEvent",
       "event": "open_photo"
      }
     ]
    }
   ],
   "children": [
    "text2"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF6B7280"
    },
    "text": "${item.caption}"
   }
  },
  "spacer1": {
   "type": "spacer",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "spacer2": {
   "type": "spacer",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  }
 },
