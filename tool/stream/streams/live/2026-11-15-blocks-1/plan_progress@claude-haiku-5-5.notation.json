{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= running}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= elapsed+1}"
      },
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= min(done+(elapsed%2==1?0:0),6)}"
      }
     ]
    },
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1500,
      "when": "${= running}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= min(done+1,6)}"
      },
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= done+1<6}"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "text1",
    "column2",
    "ProgressLine1",
    "row1",
    "Callout1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "Blog migration plan"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "children": [
    "listView1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 8
   },
   "bind": {
    "data": "${steps}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "PlanStep1"
   ]
  },
  "PlanStep1": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "detail": "",
    "index": 0
   },
   "bind": {
    "props.title": "${item}",
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Progress"
   },
   "bind": {
    "props.detail": "${elapsed} s elapsed",
    "props.value": "${= done/6}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= done<6}"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Pause"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Migration complete"
   },
   "bind": {
    "props.message": "All six steps finished in ${elapsed} s. Your blog is live on the new platform.",
    "visible": "${= done==6}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "done",
    "type": "integer",
    "value": 0
   },
   {
    "name": "running",
    "type": "boolean",
    "value": false
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "steps",
    "type": "list",
    "value": [
     "Export posts from the old CMS",
     "Map categories and tags",
     "Move images to new storage",
     "Rewrite internal links",
     "Set up redirects for old URLs",
     "Verify pages and publish"
    ]
   }
  ]
 }
}