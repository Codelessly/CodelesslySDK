{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": 390,
    "padding": 16,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "Carousel1",
    "column2"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "row2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "Running shoes"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 20,
    "padding": [
     8,
     0,
     8,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#1A2563EB"
     }
    ],
    "strokes": [
     {
      "color": "#472563EB"
     }
    ],
    "radius": 5
   },
   "children": [
    "text2"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Bag ${bag}",
    "style": {
     "fontSize": 11,
     "fontWeight": 500,
     "color": "#FF2563EB"
    }
   }
  },
  "Carousel1": {
   "type": "Carousel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "i",
    "count": 6,
    "kind": "shoe"
   },
   "bind": {
    "props.thumbs": "${= map(items,x=>x.tone)}",
    "visible": "${= sel<0}"
   },
   "children": [
    "ProductTile1"
   ]
  },
  "ProductTile1": {
   "type": "ProductTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "kind": "shoe"
   },
   "bind": {
    "props.name": "${= items[i].name}",
    "props.detail": "Rated ${= items[i].rating}",
    "props.price": "${= money(items[i].price,\"$\",0)}",
    "props.rating": "${= items[i].rating}",
    "props.tone": "${= items[i].tone}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= i}"
      },
      {
       "type": "setVariable",
       "variable": "size",
       "value": ""
      }
     ]
    }
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "bind": {
    "visible": "${= sel>=0}"
   },
   "children": [
    "textButton1",
    "Media1",
    "row3",
    "text5",
    "text6",
    "text7",
    "ChoiceChips1",
    "filledButton1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "← Back to carousel"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= -1}"
      }
     ]
    }
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "height": 160,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "kind": "shoe"
   },
   "bind": {
    "props.tone": "${= items[sel].tone}"
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text3",
    "text4"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "${= items[sel].name}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= money(items[sel].price,\"$\",0)}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Rating ${= items[sel].rating} ★"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${= items[sel].desc}",
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    }
   }
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11.5,
     "fontWeight": 600,
     "height": 1.3,
     "color": "#FF4B5563"
    },
    "text": "Size"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "size",
    "options": [
     "7",
     "8",
     "9",
     "10",
     "11",
     "12"
    ],
    "columns": 6
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Add to bag"
   },
   "bind": {
    "props.enabled": "${= size!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "bag",
       "value": "${= bag+1}"
      },
      {
       "type": "showToast",
       "message": "Added to bag"
      },
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= -1}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "items",
    "type": "list",
    "value": [
     {
      "id": 1,
      "name": "Aero Runner",
      "price": 120,
      "rating": 4.8,
      "tone": "sky",
      "desc": "Lightweight daily trainer with a breathable mesh upper."
     },
     {
      "id": 2,
      "name": "Trail Blazer",
      "price": 140,
      "rating": 4.6,
      "tone": "mint",
      "desc": "Grippy outsole built for muddy trails and rocky climbs."
     },
     {
      "id": 3,
      "name": "Cloud Stride",
      "price": 130,
      "rating": 4.7,
      "tone": "lilac",
      "desc": "Soft cushioning for long easy miles."
     },
     {
      "id": 4,
      "name": "Sprint Pro",
      "price": 160,
      "rating": 4.9,
      "tone": "rose",
      "desc": "Responsive race shoe with a carbon plate."
     },
     {
      "id": 5,
      "name": "Daily Mile",
      "price": 99,
      "rating": 4.3,
      "tone": "sand",
      "desc": "Durable, comfortable and made for everyday runs."
     },
     {
      "id": 6,
      "name": "Night Owl",
      "price": 135,
      "rating": 4.5,
      "tone": "slate",
      "desc": "Reflective details for early and late runs."
     }
    ]
   },
   {
    "name": "i",
    "type": "integer",
    "value": 0
   },
   {
    "name": "sel",
    "type": "integer",
    "value": -1
   },
   {
    "name": "size",
    "type": "text",
    "value": ""
   },
   {
    "name": "bag",
    "type": "integer",
    "value": 0
   }
  ]
 }
}