{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": 390,
    "padding": 12,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "InputField1",
    "Segments1",
    "TableHeader1",
    "listView1",
    "Pager1",
    "TotalBar1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "Invoices"
   }
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Search customer",
    "placeholder": "Type a name",
    "value": "q",
    "icon": "search_rounded"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "filter",
    "options": [
     "All",
     "Paid",
     "Due",
     "Overdue"
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "desc": "desc",
    "columns": [
     "Number",
     "Customer",
     "Date",
     "Amount",
     "Status"
    ],
    "keys": [
     "id",
     "customer",
     "date",
     "amount",
     "status"
    ],
    "selectable": true
   },
   "bind": {
    "props.checked": "${= length(picked)>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onToggleAll"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= length(picked)>0?[]:map(slice(desc?sortByDesc(filter(rows,r=>(filter==\"All\"||r.status==filter)&&contains(lower(r.customer),lower(q))),x=>x[sort]):sortBy(filter(rows,r=>(filter==\"All\"||r.status==filter)&&contains(lower(r.customer),lower(q))),x=>x[sort]),page*5,page*5+5),r=>r.id)}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 10
   },
   "bind": {
    "data": "${= slice(desc?sortByDesc(filter(rows,r=>(filter==\"All\"||r.status==filter)&&contains(lower(r.customer),lower(q))),x=>x[sort]):sortBy(filter(rows,r=>(filter==\"All\"||r.status==filter)&&contains(lower(r.customer),lower(q))),x=>x[sort]),page*5,page*5+5)}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "selectable": true
   },
   "bind": {
    "props.cells": "${= [item.id,item.customer,item.date,money(item.amount,\"$\",0)]}",
    "props.badge": "${item.status}",
    "props.checked": "${= contains(picked,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= contains(picked,item.id)?without(picked,item.id):append(picked,item.id)}"
      }
     ]
    }
   ]
  },
  "Pager1": {
   "type": "Pager",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "page"
   },
   "bind": {
    "props.count": "${= max(1,ceil(length(filter(rows,r=>(filter==\"All\"||r.status==filter)&&contains(lower(r.customer),lower(q))))/5))}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "note": "Total of ticked invoices",
    "cta": "Send reminders"
   },
   "bind": {
    "props.label": "${= length(picked)} selected",
    "props.amount": "${= money(sum(filter(rows,r=>contains(picked,r.id)),r=>r.amount),\"$\",0)}",
    "visible": "${= length(picked)>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "remind",
       "value": "${picked}"
      },
      {
       "type": "showToast",
       "message": "Reminders sent"
      }
     ]
    }
   ]
  }
 },
 "variables": {
