{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Product dashboard",
    "subtitle": "This month",
    "icon": "insights",
    "status": "Live",
    "tone": "accent"
   },
   "children": [
    "Segments1",
    "grid1",
    "ChartCard1",
    "ChartCard2",
    "SectionLabel1",
    "TableHeader1",
    "listView1",
    "listView2"
   ]
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "range",
    "options": [
     "7 days",
     "30 days",
     "90 days"
    ]
   }
  },
  "grid1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "start"
   },
   "children": [
    "grid1Row1",
    "grid1Row2"
   ]
  },
  "grid1Row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "StatTile1",
    "StatTile2"
   ]
  },
  "StatTile1": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Revenue",
    "note": "vs previous",
    "icon": "payments"
   },
   "bind": {
    "props.value": "${= data[range].rev}",
    "props.delta": "${= data[range].revd}"
   }
  },
  "StatTile2": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Sign-ups",
    "note": "new accounts",
    "icon": "person_add"
   },
   "bind": {
    "props.value": "${= data[range].su}",
    "props.delta": "${= data[range].sud}"
   }
  },
  "grid1Row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "StatTile3",
    "StatTile4"
   ]
  },
  "StatTile3": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Churn",
    "note": "monthly",
    "invert": true,
    "icon": "trending_down"
   },
   "bind": {
    "props.value": "${= data[range].ch}",
    "props.delta": "${= data[range].chd}"
   }
  },
  "StatTile4": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Active users",
    "note": "unique",
    "icon": "groups"
   },
   "bind": {
    "props.value": "${= data[range].au}",
    "props.delta": "${= data[range].aud}"
   }
  },
  "ChartCard1": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Revenue",
    "kind": "line"
   },
   "bind": {
    "props.value": "${= data[range].rev}",
    "props.values": "${= data[range].line}",
    "props.labels": "${= data[range].labels}",
    "props.delta": "${= data[range].revd}"
   }
  },
  "ChartCard2": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Sign-ups by channel",
    "labels": [
     "Organic",
     "Paid",
     "Referral",
     "Social"
    ],
    "kind": "bars"
   },
   "bind": {
    "props.value": "${= data[range].su}",
    "props.values": "${= data[range].bars}",
    "props.delta": "${= data[range].sud}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Top plans",
    "note": "tap a title to sort"
   }
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "desc": "desc",
    "columns": [
     "Plan",
     "Subs",
     "Revenue"
    ],
    "keys": [
     "plan",
     "subs",
     "revenue"
    ]
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= sortByDesc(plans,x=>x[sort])}",
    "visible": "${= desc}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.cells": "${= [item.plan,item.subs,money(item.revenue,\"$\",0)]}"
   }
  },
  "listView2": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= sortBy(plans,x=>x[sort])}",
    "visible": "${= !desc}"
   },
   "children": [
    "listView2Item"
   ]
  },
  "listView2Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow2"
   ]
  },
  "TableRow2": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.cells": "${= [item.plan,item.subs,money(item.revenue,\"$\",0)]}"
   }
  }
 },
