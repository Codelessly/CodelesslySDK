{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "Steps1",
    "OptionList1",
    "OptionList2",
    "OptionList3",
    "row1",
    "Recommendation1",
    "ActionButton2"
   ]
  },
  "Steps1": {
   "type": "Steps",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "steps": [
     "Use",
     "Detail",
     "Budget",
     "Pick"
    ]
   },
   "bind": {
    "props.current": "${= step+1}"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "What will you use it for?",
    "value": "use",
    "options": [
     "Office and browsing",
     "Creative work",
     "Gaming",
     "Travel and school"
    ]
   },
   "bind": {
    "visible": "${= step==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "OptionList2": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "What matters most?",
    "value": "detail",
    "options": [
     "Battery life",
     "Raw speed",
     "Screen quality",
     "Light weight"
    ]
   },
   "bind": {
    "visible": "${= step==1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "OptionList3": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "What is your budget?",
    "value": "budget",
    "options": [
     "Under $700",
     "$700 to $1200",
     "Over $1200"
    ]
   },
   "bind": {
    "visible": "${= step==2}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step==2}"
   },
   "children": [
    "ActionButton1"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "Recommendation1": {
   "type": "Recommendation",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Your laptop: Aero 14",
    "why": "Light, quick and with a battery that lasts a full day.",
    "reasons": [
     "Fits your use and budget",
     "Strong battery for travel",
     "Light enough to carry daily"
    ],
    "eyebrow": "Best match"
   },
   "bind": {
    "visible": "${= step==3}"
   }
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start over",
    "tone": "primary"
   },
   "bind": {
    "visible": "${= step==3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "use",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "detail",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "budget",
       "value": ""
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "use",
    "type": "text",
    "value": ""
   },
   {
    "name": "step",
    "type": "integer",
    "value": 0
   },
   {
    "name": "detail",
    "type": "text",
    "value": ""
   },
   {
    "name": "budget",
    "type": "text",
    "value": ""
   }
  ]
 }
}