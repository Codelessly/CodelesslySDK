{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Book a table",
    "subtitle": "Pick a day, party size and time",
    "icon": "calendar_month",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "DayPicker1",
    "SectionLabel2",
    "Counter1",
    "SectionLabel3",
    "ChoiceChips1",
    "TotalBar1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Day",
    "note": "Next 7 days"
   }
  },
  "DayPicker1": {
   "type": "DayPicker",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "day",
    "days": [
     "Mon 1",
     "Tue 2",
     "Wed 3",
     "Thu 4",
     "Fri 5",
     "Sat 6",
     "Sun 7"
    ]
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Party size"
   }
  },
  "Counter1": {
   "type": "Counter",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Guests",
    "detail": "How many people",
    "value": "party",
    "min": 1,
    "max": 8,
    "step": 1
   }
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Time",
    "note": "Some slots are full"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "time",
    "columns": 3,
    "options": [
     "18:00",
     "18:30",
     "19:00",
     "19:30",
     "20:00",
     "20:30"
    ]
   },
   "bind": {
    "props.disabled": "${= day==\"Mon 1\"?[\"18:30\",\"20:00\"]:day==\"Sat 6\"?[\"18:00\",\"18:30\",\"19:00\",\"19:30\"]:party>4?[\"19:00\",\"19:30\"]:[]}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Your booking",
    "cta": "Confirm"
   },
   "bind": {
    "props.note": "${day}, ${party} guests",
    "props.amount": "${= time==\"\" ? \"Pick a time\" : time}",
    "props.enabled": "${= time!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "confirm"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "day",
    "type": "text",
    "value": ""
   },
   {
    "name": "party",
    "type": "decimal",
    "value": 0
   },
   {
    "name": "time",
    "type": "text",
    "value": ""
   }
  ]
 }
}