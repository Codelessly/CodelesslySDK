{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": 390,
    "padding": 16,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "Carousel1",
    "text1"
   ]
  },
  "Carousel1": {
   "type": "Carousel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "i",
    "count": 6,
    "kind": "shoe"
   },
   "bind": {
    "props.thumbs": "${= map(items,x=>x.tone)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "i",
       "value": "${= i}"
      }
     ]
    }
   ],
   "children": [
    "ProductTile1"
   ]
  },
  "ProductTile1": {
   "type": "ProductTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "detail": "Running shoe",
    "kind": "shoe"
   },
   "bind": {
    "props.name": "${= items[i].name}",
    "props.price": "${= items[i].price}",
    "props.rating": "${= items[i].rating}",
    "props.tone": "${= items[i].tone}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pick",
       "value": "${= i+1}"
      }
     ]
    }
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Tap a shoe to see details"
   }
  }
 },
