   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Prep the tray",
    "detail": "Heat oven to 220°C. Halve potatoes and toss with oil, salt and pepper.",
    "index": 0
   },
   "bind": {
    "props.current": "${= 0}"
   }
  },
  "PlanStep2": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Season the chicken",
    "detail": "Rub thighs with garlic, thyme, lemon zest and juice.",
    "index": 1
   },
   "bind": {
    "props.current": "${= 0}"
   }
  },
  "PlanStep3": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Roast",
    "detail": "Nestle chicken among potatoes, add lemon halves, roast 35 minutes.",
    "index": 2
   },
   "bind": {
    "props.current": "${= 0}"
   }
  },
  "PlanStep4": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Rest and serve",
    "detail": "Rest 5 minutes, spoon over pan juices and serve.",
    "index": 3,
    "last": true
   },
   "bind": {
    "props.current": "${= 0}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
