  "StatTile1": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Total time",
    "value": "45 min",
    "icon": "schedule"
   }
  },
  "StatTile2": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Difficulty",
    "value": "Easy",
    "icon": "restaurant"
   }
  },
  "Counter1": {
   "type": "Counter",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Servings",
    "detail": "People at the table",
    "value": "servings",
    "min": 1,
    "max": 12
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Ingredients"
   },
   "bind": {
    "props.note": "${servings} servings"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Chicken thighs\",fixed(servings*2,0)+\" pieces\"],[\"Baby potatoes\",fixed(servings*150,0)+\" g\"],[\"Lemons\",fixed(servings*0.5,1)],[\"Garlic\",fixed(servings*2,0)+\" cloves\"],[\"Olive oil\",fixed(servings*1,0)+\" tbsp\"],[\"Fresh thyme\",fixed(servings*2,0)+\" sprigs\"]]}"
   }
  },
  "Checklist1": {
   "type": "Checklist",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Tick off as you gather",
    "value": "gathered",
    "items": [
     "Chicken thighs",
     "Baby potatoes",
     "Lemons",
     "Garlic",
     "Olive oil",
     "Fresh thyme"
    ]
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
