       "value": "${servings}"
      },
      {
       "type": "showToast",
       "message": "Let's cook!"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "servings",
    "type": "decimal",
    "value": 0
   },
   {
    "name": "gathered",
    "type": "list",
    "value": []
   }
  ]
 }
}