  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Lemon chicken traybake",
    "subtitle": "Weeknight dinner · 45 min · Easy",
    "icon": "restaurant",
    "status": "Easy",
    "tone": "good"
   },
   "children": [
    "Media1",
    "row1",
    "Counter1",
    "SectionLabel1",
    "Details1",
    "Checklist1",
    "SectionLabel2",
    "PlanStep1",
    "PlanStep2",
    "PlanStep3",
    "PlanStep4",
    "ActionButton1"
   ]
