{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Where is your package?",
    "subtitle": "Wireless headphones · Order #48213",
    "icon": "local_shipping",
    "status": "In transit",
    "tone": "accent"
   },
   "children": [
    "Details1",
    "SectionLabel1",
    "Steps1",
    "Callout1",
    "SectionLabel2",
    "InputField1",
    "ActionButton1",
    "Callout2",
    "ActionButton2"
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Item\",\"Wireless headphones, black\"],[\"Carrier\",\"UPS Ground\"],[\"Tracking number\",\"1Z 999 AA1 01 2345 6784\"],[\"Estimated delivery\",\"Thursday, May 16\"]]}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Shipment progress",
    "note": "Stage 3 of 5"
   }
  },
  "Steps1": {
   "type": "Steps",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "steps": [
     "Order placed",
     "Packed",
     "In transit",
     "Out for delivery",
     "Delivered"
    ]
   },
   "bind": {
    "props.current": "${stage}"
   }
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Now: In transit",
    "message": "Left the Chicago, IL hub this morning. Next stop: your local facility.",
    "tone": "accent",
    "icon": "local_shipping"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Delivery instructions",
    "note": "Optional"
   }
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Instructions for the driver",
    "placeholder": "e.g. Leave at the side door",
    "value": "note",
    "lines": 3
   },
   "bind": {
    "visible": "${= !saved}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Save instructions",
    "tone": "primary",
    "icon": "edit_note"
   },
   "bind": {
    "props.enabled": "${= length(note)>0}",
    "visible": "${= !saved}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "saved",
       "value": "${= true}"
      },
      {
       "type": "showToast",
       "message": "Instructions saved"
      }
     ]
    }
   ]
  },
  "Callout2": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Instructions saved",
    "tone": "good",
    "icon": "check_circle"
   },
   "bind": {
    "props.message": "${note}",
    "visible": "${= saved}"
   }
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Edit instructions",
    "tone": "quiet"
   },
   "bind": {
    "visible": "${= saved}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "saved",
       "value": "${= false}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "stage",
    "type": "integer",
    "value": 3
   },
   {
    "name": "note",
    "type": "text",
    "value": ""
   },
   {
    "name": "saved",
    "type": "boolean",
    "value": false
   }
  ]
 }
}