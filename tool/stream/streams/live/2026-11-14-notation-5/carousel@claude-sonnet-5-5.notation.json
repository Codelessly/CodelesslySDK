   "decoration": {
    "radius": 5,
    "fills": [
     {
      "color": "#00000000"
     }
    ]
   },
   "bind": {
    "decoration.fills[0].color": "${= item==i?\"#FF3366CC\":\"#FFCCCCCC\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "i",
       "value": "${= item}"
      }
     ]
    }
   ]
  },
