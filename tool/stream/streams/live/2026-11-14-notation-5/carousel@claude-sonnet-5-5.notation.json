    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "$${= shoes[i].price}"
   }
  },
  "row3": {
