      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "detail",
       "value": "${= false}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "shoes",
    "type": "list",
    "value": [
     {
      "id": 0,
      "name": "Aero Runner",
      "price": 120,
      "rating": 4.8,
      "desc": "Lightweight daily trainer with responsive foam for smooth miles."
     },
     {
      "id": 1,
      "name": "Trail Blazer",
      "price": 135,
      "rating": 4.6,
      "desc": "Grippy outsole and rock plate built for rough trails."
     },
     {
      "id": 2,
      "name": "Cloud Strider",
      "price": 150,
      "rating": 4.9,
      "desc": "Max cushioning for long recovery runs."
     },
     {
      "id": 3,
      "name": "Swift Racer",
      "price": 170,
      "rating": 4.7,
      "desc": "Carbon-plated racing shoe for personal bests."
     },
     {
      "id": 4,
      "name": "Urban Pacer",
      "price": 110,
      "rating": 4.4,
      "desc": "Versatile city shoe with breathable knit upper."
     },
     {
      "id": 5,
