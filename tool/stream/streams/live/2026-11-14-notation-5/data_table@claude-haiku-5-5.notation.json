   {
    "name": "sortCol",
    "type": "text",
    "value": "date"
   },
   {
    "name": "sortDesc",
    "type": "boolean",
    "value": true
   },
   {
    "name": "statusFilter",
    "type": "text",
    "value": "All"
   },
   {
    "name": "search",
    "type": "text",
    "value": ""
   },
   {
    "name": "page",
    "type": "integer",
    "value": 0
   },
   {
    "name": "picked",
    "type": "list",
    "value": []
   },
   {
    "name": "pageSize",
    "type": "integer",
    "value": 5
   },
   {
    "name": "visible",
    "type": "text",
    "value": "sortByDesc(filter(invoices,r=>(statusFilter==\"All\"||r.status==statusFilter)&&(search==\"\"||contains(lower(r.customer),lower(search)))),r=>r[sortCol])"
   },
   {
    "name": "pageRows",
    "type": "text",
    "value": "slice(visible,page*pageSize,min(length(visible),page*pageSize+pageSize))"
   },
   {
    "name": "pickedRows",
    "type": "text",
    "value": "filter(invoices,r=>any(picked,p=>p==r.id))"
   },
   {
    "name": "allOnPage",
    "type": "text",
    "value": "length(pageRows)>0&&all(pageRows,r=>any(picked,p=>p==r.id))"
   }
  ]
 }
}