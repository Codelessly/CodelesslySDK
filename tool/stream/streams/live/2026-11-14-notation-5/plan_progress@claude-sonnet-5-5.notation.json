{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text1",
    "progressBar1",
    "row1",
    "divider1",
    "listView1",
    "divider2",
    "filledButton1",
    "filledButton2",
    "outlinedButton1",
    "column3"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Blog migration plan"
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.value": "${= done/6}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text2",
    "text3"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "${done} of 6 steps done"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "Elapsed: ${elapsed}s"
   }
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false
   },
   "bind": {
    "data": "${steps}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row2"
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "icon1",
    "circularProgressIndicator1",
    "icon2",
    "column2"
   ]
  },
  "icon1": {
   "type": "icon",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "check_circle"
   },
   "bind": {
    "visible": "${= item.i<done}"
   }
  },
  "circularProgressIndicator1": {
   "type": "circularProgressIndicator",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "visible": "${= item.i==done && running}"
   }
  },
  "icon2": {
   "type": "icon",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "radio_button_unchecked"
   },
   "bind": {
    "visible": "${= item.i>done || (item.i==done && !running)}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "text4",
    "text5"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "${item.name}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "color": "#FF111827"
    },
    "text": "${item.desc}"
   }
  },
  "divider2": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Start migration"
   },
   "bind": {
    "visible": "${= done<6 && !running && done==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "start"
      }
     ]
    }
   ]
  },
  "filledButton2": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Resume"
   },
   "bind": {
    "visible": "${= done<6 && !running && done>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "start"
      }
     ]
    }
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Pause"
   },
   "bind": {
    "visible": "${= done<6 && running}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= false}"
      },
      {
       "type": "componentEvent",
       "event": "pause"
      }
     ]
    }
   ]
  },
  "column3": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "bind": {
    "visible": "${= done==6}"
   },
   "children": [
    "text6",
    "text7",
    "text8"
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Migration complete"
   }
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    },
    "text": "All 6 steps finished in ${elapsed} seconds."
   }
  },
  "text8": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF15803D"
    },
    "text": "Your blog is live on the new host."
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "done",
    "type": "integer",
    "value": 0
   },
   {
    "name": "running",
    "type": "boolean",
    "value": false
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "steps",
    "type": "list",
    "value": [
     {
      "i": 0,
      "name": "Back up your content",
      "desc": "Export posts, pages and settings."
     },
     {
      "i": 1,
      "name": "Set up the new host",
      "desc": "Create the site and install the theme."
     },
     {
      "i": 2,
      "name": "Import posts",
      "desc": "Copy articles, tags and categories."
     },
     {
      "i": 3,
      "name": "Move media",
      "desc": "Upload images and fix their links."
     },
     {
      "i": 4,
      "name": "Redirect old URLs",
      "desc": "Map old addresses to the new ones."
     },
     {
      "i": 5,
      "name": "Final checks",
      "desc": "Test links, feeds and the DNS switch."
     }
    ]
   }
  ]
 }
}