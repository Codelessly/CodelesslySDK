{"meta":{"ui":"order_summary","model":"claude-haiku-5-5","form":"notation","turn":"generate","prompt":"Show my grocery order as an inline card before you place it: five line items with a picture placeholder, price and a quantity I can raise or lower (removing at zero), a promo code field that takes SAVE10, the subtotal, delivery and total kept up to date, and confirm and cancel buttons that tell you what I decided.","text":"Card w:390 gap:12 pad:16\n  Text.heading \"Your grocery order\"\n  state cart=[{\"id\":1,\"name\":\"Bananas\",\"price\":2.5,\"qty\":2},{\"id\":2,\"name\":\"Whole milk 1 L\",\"price\":1.8,\"qty\":1},{\"id\":3,\"name\":\"Sourdough loaf\",\"price\":4.2,\"qty\":1},{\"id\":4,\"name\":\"Free-range eggs\",\"price\":3.6,\"qty\":2},{\"id\":5,\"name\":\"Cheddar 250 g\",\"price\":3.9,\"qty\":1}]\n  state promo=\"\"\n  state applied=false\n  state promoError=false\n  each row in cart\n    Row gap:12 middle\n      Box w:56 h:56 fill:#FFE5E7EB radius:8 center\n        Icon \"image\"\n      Column gap:2 grow\n        Text.strong \"{row.name}\"\n        Text.muted \"{money(row.price,\"$\",2)} each\"\n      Row gap:4 middle\n        IconButton \"remove\" -> cart=coalesce(updateWhere(cart,r=>r.id==row.id,r=>with(r,\"qty\",row.qty-1)),cart); cart=removeWhere(cart,r=>r.qty<=0)\n        Text.strong \"{row.qty}\"\n        IconButton \"add\" -> cart=updateWhere(cart,r=>r.id==row.id,r=>with(r,\"qty\",row.qty+1))\n  Divider\n  Row gap:8 middle\n    Input \"Promo code\" \"Enter code\" =promo grow\n    Button.outline \"Apply\" -> applied=trim(upper(promo))==\"SAVE10\"; promoError=trim(upper(promo))!=\"SAVE10\"\n  if promoError\n    Text.danger \"That code isn't valid.\"\n  if applied\n    Text.success \"SAVE10 applied: 10% off\"\n  state subtotal=sum(cart,r=>r.price*r.qty)\n  state discount=applied?subtotal*0.1:0\n  state delivery=subtotal-discount>=35?0:4.99\n  Row between\n    Text \"Subtotal\"\n    Text \"{money(subtotal,\"$\",2)}\"\n  if applied\n    Row between\n      Text.success \"Discount\"\n      Text.success \"-{money(discount,\"$\",2)}\"\n  Row between\n    Text \"Delivery\"\n    Text \"{money(delivery,\"$\",2)}\"\n  Row between\n    Text.title \"Total\"\n    Text.title \"{money(subtotal-discount+delivery,\"$\",2)}\"\n  Row gap:8\n    Button \"Confirm order\" grow -> emit confirmOrder; toast \"Order confirmed\"\n    Button.ghost \"Cancel\" -> emit cancelOrder; toast \"Order cancelled\"","usage":{"input_tokens":2390,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":923,"service_tier":"standard","inference_geo":"global","speed":"standard","output_tokens_details":{"thinking_tokens":0}},"ttftMs":477,"totalMs":3766}}
