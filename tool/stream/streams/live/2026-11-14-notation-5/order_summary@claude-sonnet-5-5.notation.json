    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "${= money(item.price,'$',2)}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
