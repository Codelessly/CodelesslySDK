  },
  "text11": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF15803D"
    },
    "text": "-${= money(sum(items,i=>i.price*i.qty)*0.1,'$',2)}"
   }
