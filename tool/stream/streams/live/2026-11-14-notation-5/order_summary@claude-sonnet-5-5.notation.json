   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Apply"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "applied",
       "value": "${= upper(trim(promo))==\"SAVE10\"}"
      },
      {
       "type": "showToast",
       "message": "applied?\"Applied\":\"Promo code applied or invalid\""
      }
     ]
    }
   ]
