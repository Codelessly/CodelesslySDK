   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "textField1",
    "outlinedButton1"
   ]
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Promo code",
     "hintText": "SAVE10"
    }
   },
   "bind": {
    "props.initialValue": "${promo}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "promo",
       "value": "${result}"
      }
     ]
    }
   ]
  },
