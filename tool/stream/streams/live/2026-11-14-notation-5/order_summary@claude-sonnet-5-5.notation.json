    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Subtotal",
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    }
   }
  },
  "text9": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
