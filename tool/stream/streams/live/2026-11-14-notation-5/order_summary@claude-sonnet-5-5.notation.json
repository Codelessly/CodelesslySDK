   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "${= money(sum(items,i=>i.price*i.qty)*(applied&&upper(trim(promo))=='SAVE10'?0.9:1)+(sum(items,i=>i.price*i.qty)>=30||length(items)==0?0:4.99),'$',2)}"
   }
  },
  "row8": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
