    "icon": "image"
   }
  },
  "column3": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text3",
    "text4"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "${item.name}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
