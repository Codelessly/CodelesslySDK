    "visible": "${= applied && upper(trim(promo))==\"SAVE10\"}"
   },
   "children": [
    "text10",
    "text11"
   ]
  },
  "text10": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF15803D"
    },
