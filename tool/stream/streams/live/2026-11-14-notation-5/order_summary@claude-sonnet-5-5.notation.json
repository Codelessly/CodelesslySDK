    "text": "${= sum(items,i=>i.price*i.qty)>=30||length(items)==0?'Free':'$4.99'}",
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    }
   }
  },
  "row7": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text14",
    "text15"
   ]
  },
  "text14": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Total"
   }
  },
