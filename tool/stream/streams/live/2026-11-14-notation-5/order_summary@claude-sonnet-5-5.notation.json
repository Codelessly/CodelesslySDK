   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "column2",
    "column3",
    "row2"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": 48,
    "height": 48
