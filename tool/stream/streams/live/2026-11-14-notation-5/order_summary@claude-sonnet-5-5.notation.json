    "spacing": 4,
    "crossAxisAlignment": "center"
   },
   "children": [
    "iconButton1",
    "text5",
    "iconButton2"
   ]
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "remove"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= item.qty<=1?removeWhere(items,r=>r.id==item.id):updateWhere(items,r=>r.id==item.id,r=>with(r,\"qty\",r.qty-1))}"
      }
     ]
    }
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "${item.qty}"
   }
  },
  "iconButton2": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "add"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= updateWhere(items,r=>r.id==item.id,r=>with(r,\"qty\",r.qty+1))}"
      }
     ]
    }
   ]
  },
