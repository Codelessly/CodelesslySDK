    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF15803D"
    },
    "text": "SAVE10 applied: 10% off"
   },
   "bind": {
    "visible": "${= applied}"
   }
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF6B7280"
    },
    "text": "Press Apply to check your code"
   },
   "bind": {
    "visible": "${= upper(trim(promo))!=\"SAVE10\" && trim(promo)!=\"\"}"
   }
  },
  "divider2": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
