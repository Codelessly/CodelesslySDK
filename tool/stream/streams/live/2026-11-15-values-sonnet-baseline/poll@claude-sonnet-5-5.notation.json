{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Team poll",
    "subtitle": "Where should we go for lunch on Friday?",
    "icon": "poll",
    "tone": "accent"
   },
   "bind": {
    "props.status": "${= voted ? 'Voted' : 'Open'}"
   },
   "children": [
    "OptionList1",
    "ActionButton1",
    "SectionLabel1",
    "listView1",
    "TotalBar1"
   ]
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Pick one",
    "value": "choice",
    "options": [
     "Pho Saigon",
     "Taqueria Luz",
     "Green Bowl",
     "Napoli Pizza"
    ]
   },
   "bind": {
    "visible": "${= !voted}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Vote",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= choice!=\"\"}",
    "visible": "${= !voted}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "votes",
       "value": "${= [votes[0]+(choice==\"Pho Saigon\"?1:0),votes[1]+(choice==\"Taqueria Luz\"?1:0),votes[2]+(choice==\"Green Bowl\"?1:0),votes[3]+(choice==\"Napoli Pizza\"?1:0)]}"
      },
      {
       "type": "setVariable",
       "variable": "voted",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Results"
   },
   "bind": {
    "props.note": "${= sum(votes,x=>x)} votes",
    "visible": "${= voted}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= range(4)}",
    "visible": "${= voted}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "column1"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "progressBar1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${= names[item]}${= names[item]==choice ? ' (your vote)' : ''}",
    "style": {
     "fontWeight": 600
    }
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${= round(votes[item]*100/sum(votes,x=>x),0)}%",
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    }
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "max": 1,
    "borderRadius": 2,
    "color": "#FF2563EB",
    "backgroundColor": "#FFE5E7EB"
   },
   "bind": {
    "props.value": "${= votes[item]/sum(votes,x=>x)}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Total votes",
    "note": "Thanks for voting",
    "cta": "Done"
   },
   "bind": {
    "props.amount": "${= sum(votes,x=>x)}",
    "props.enabled": "${= false}",
    "visible": "${= voted}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "names",
    "type": "list",
    "value": [
     "Pho Saigon",
     "Taqueria Luz",
     "Green Bowl",
     "Napoli Pizza"
    ]
   },
   {
    "name": "votes",
    "type": "list",
    "value": [
     5,
     8,
     3,
     6
    ]
   },
   {
    "name": "choice",
    "type": "text",
    "value": ""
   },
   {
    "name": "voted",
    "type": "boolean",
    "value": false
   }
  ]
 }
}