{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Invoices",
    "subtitle": "12 found",
    "icon": "receipt_long",
    "status": "Open",
    "tone": "accent"
   },
   "children": [
    "InputField1",
    "Segments1",
    "WideScroll1",
    "Pager1",
    "TotalBar1"
   ]
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Search customer",
    "placeholder": "Type a name",
    "value": "q",
    "icon": "search_rounded"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "status",
    "options": [
     "All",
     "Paid",
     "Due",
     "Overdue"
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "WideScroll1": {
   "type": "WideScroll",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "width": 520
   },
   "children": [
    "TableHeader1",
    "listView1"
   ]
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "columns": [
     "#",
     "Customer",
     "Date",
     "Amount",
     "Status"
    ],
    "keys": [
     "num",
     "cust",
     "d",
     "amt",
     "st"
    ],
    "selectable": true
   },
   "bind": {
    "props.desc": "${desc}",
    "props.checked": "${= length(picked)>0 && all(take(slice(desc?sortByDesc(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]):sortBy(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]),page*5,page*5+5),5),r=>contains(picked,r.id))}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onToggleAll"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= all(slice(desc?sortByDesc(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]):sortBy(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]),page*5,page*5+5),r=>contains(picked,r.id))?[]:map(slice(desc?sortByDesc(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]):sortBy(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]),page*5,page*5+5),r=>r.id)}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= slice(desc?sortByDesc(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]):sortBy(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))),r=>r[sort]),page*5,page*5+5)}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "selectable": true
   },
   "bind": {
    "props.cells": "${= [item.num,item.cust,item.date,money(item.amt,\"$\",0)]}",
    "props.badge": "${item.st}",
    "props.checked": "${= contains(picked,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= contains(picked,item.id)?without(picked,item.id):append(picked,item.id)}"
      }
     ]
    }
   ]
  },
  "Pager1": {
   "type": "Pager",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Page",
    "value": "page"
   },
   "bind": {
    "props.count": "${= max(1,ceil(length(filter(rows,r=>(status==\"All\"||r.st==status)&&contains(lower(r.cust),lower(q))))/5))}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "note": "Total of ticked invoices",
    "cta": "Send reminders",
    "icon": "send"
   },
   "bind": {
    "props.label": "${= length(picked)} selected",
    "props.amount": "${= money(sum(filter(rows,r=>contains(picked,r.id)),r=>r.amt),\"$\",0)}",
    "visible": "${= length(picked)>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "remind",
       "value": "${picked}"
      },
      {
       "type": "showToast",
       "message": "Reminders sent"
      }
     ]
    }
   ]
  }
 },
