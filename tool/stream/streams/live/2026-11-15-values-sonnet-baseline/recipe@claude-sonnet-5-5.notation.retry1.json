{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Lemon chicken traybake",
    "subtitle": "Weeknight dinner",
    "icon": "restaurant",
    "status": "Easy",
    "tone": "good"
   },
   "children": [
    "Details1",
    "Counter1",
    "SectionLabel1",
    "Checklist1",
    "SectionLabel2",
    "Paragraph1",
    "Paragraph2",
    "Paragraph3",
    "Paragraph4",
    "ActionButton1"
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Time\",\"45 minutes\"],[\"Difficulty\",\"Easy\"],[\"Serves\",\"{servings}\"]]}"
   }
  },
  "Counter1": {
   "type": "Counter",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Servings",
    "detail": "Scales the amounts",
    "value": "servings",
    "min": 2,
    "max": 8,
    "step": 1
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Ingredients"
   },
   "bind": {
    "props.note": "${= 6-length(ticked)} left"
   }
  },
  "Checklist1": {
   "type": "Checklist",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Tick off as you go",
    "value": "ticked"
   },
   "bind": {
    "props.items": "${= [\"Chicken thighs, \"+round(800*servings/4,0)+\" g\",\"Baby potatoes, \"+round(600*servings/4,0)+\" g\",\"Lemons, \"+round(2*servings/4,1),\"Olive oil, \"+round(4*servings/4,1)+\" tbsp\",\"Garlic cloves, \"+round(4*servings/4,1),\"Dried oregano, \"+round(2*servings/4,1)+\" tsp\"]}"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Method",
    "note": "4 steps"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "1. Heat the oven to 220C"
   }
  },
  "Paragraph2": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "2. Toss everything in the oil, lemon and oregano"
   }
  },
  "Paragraph3": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "3. Roast 35 minutes, turning once"
   }
  },
  "Paragraph4": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "4. Rest 5 minutes and serve"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start cooking",
    "tone": "primary",
    "icon": "play_arrow"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "startCooking",
       "value": "${servings}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "servings",
    "type": "integer",
    "value": 4
   },
   {
    "name": "ticked",
    "type": "list",
    "value": []
   }
  ]
 }
}