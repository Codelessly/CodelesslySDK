{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Expense approvals",
    "subtitle": "Report with 4 expenses",
    "icon": "receipt_long",
    "status": "Pending",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "listView1",
    "TotalBar1",
    "Receipt1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Expenses"
   },
   "bind": {
    "props.note": "${= count(items,x=>x.d=='approved')} of 4 approved",
    "visible": "${= !submitted}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${items}",
    "visible": "${= !submitted}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "column1"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "row1",
    "text3",
    "Callout1",
    "row2",
    "text4"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item.merchant}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= money(item.amount,'$',2)}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${item.cat} · ${item.date}"
   }
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "No receipt attached",
    "message": "Consider rejecting or requesting one.",
    "tone": "warn",
    "icon": "warning"
   },
   "bind": {
    "visible": "${= !item.receipt}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Approve",
    "tone": "good",
    "icon": "check"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= updateWhere(items,y=>y.id==item.id,y=>with(y,\"d\",\"approved\"))}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Reject",
    "tone": "danger",
    "icon": "close"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= updateWhere(items,y=>y.id==item.id,y=>with(y,\"d\",\"rejected\"))}"
      }
     ]
    }
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Marked ${item.d}"
   },
   "bind": {
    "visible": "${= item.d!=\"\"}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Approved total",
    "cta": "Submit"
   },
   "bind": {
    "props.note": "${= count(items,x=>x.d=='approved')} of 4 approved",
    "props.amount": "${= money(sum(filter(items,x=>x.d=='approved'),x=>x.amount),\"$\",2)}",
    "visible": "${= !submitted}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "submitted",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Submitted",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.message": "${= count(items,x=>x.d=='approved')} of 4 approved, total ${= money(sum(filter(items,x=>x.d=='approved'),x=>x.amount),'$',2)}",
    "visible": "${= submitted}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "items",
    "type": "list",
    "value": [
     {
      "id": 1,
      "merchant": "Delta Air Lines",
      "cat": "Travel",
      "date": "Nov 3",
      "amount": 412.6,
      "receipt": true,
      "d": ""
     },
     {
      "id": 2,
      "merchant": "Blue Bottle Coffee",
      "cat": "Meals",
      "date": "Nov 4",
      "amount": 18.4,
      "receipt": true,
      "d": ""
     },
     {
      "id": 3,
      "merchant": "Uber",
      "cat": "Transport",
      "date": "Nov 5",
      "amount": 36.25,
      "receipt": false,
      "d": ""
     },
     {
      "id": 4,
      "merchant": "WeWork day pass",
      "cat": "Office",
      "date": "Nov 6",
      "amount": 45.0,
      "receipt": true,
      "d": ""
     }
    ]
   },
   {
    "name": "submitted",
    "type": "boolean",
    "value": false
   }
  ]
 }
}