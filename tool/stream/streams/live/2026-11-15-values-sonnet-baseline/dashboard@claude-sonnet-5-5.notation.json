{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Product performance",
    "subtitle": "Key metrics for the selected period",
    "icon": "insights",
    "status": "Live",
    "tone": "accent"
   },
   "children": [
    "Segments1",
    "grid1",
    "ChartCard1",
    "ChartCard2",
    "SectionLabel1",
    "WideScroll1"
   ]
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "range",
    "options": [
     "7 days",
     "30 days",
     "90 days"
    ]
   }
  },
  "grid1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "start"
   },
   "children": [
    "grid1Row1",
    "grid1Row2"
   ]
  },
  "grid1Row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "StatTile1",
    "StatTile2"
   ]
  },
  "StatTile1": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Revenue",
    "note": "vs previous period",
    "icon": "payments"
   },
   "bind": {
    "props.value": "${= range==\"7 days\"?\"$18.4k\":range==\"30 days\"?\"$78.9k\":\"$221k\"}",
    "props.delta": "${= range==\"7 days\"?\"+4.1%\":range==\"30 days\"?\"+8.5%\":\"+15.3%\"}"
   }
  },
  "StatTile2": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Sign-ups",
    "note": "new accounts",
    "icon": "person_add"
   },
   "bind": {
    "props.value": "${= range==\"7 days\"?\"312\":range==\"30 days\"?\"1,340\":\"3,905\"}",
    "props.delta": "${= range==\"7 days\"?\"+6.0%\":range==\"30 days\"?\"+11.2%\":\"+9.8%\"}"
   }
  },
  "grid1Row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "StatTile3",
    "StatTile4"
   ]
  },
  "StatTile3": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Churn",
    "note": "lost customers",
    "invert": true,
    "icon": "trending_down"
   },
   "bind": {
    "props.value": "${= range==\"7 days\"?\"2.9%\":range==\"30 days\"?\"3.1%\":\"3.4%\"}",
    "props.delta": "${= range==\"7 days\"?\"-0.2%\":range==\"30 days\"?\"+0.4%\":\"-0.6%\"}"
   }
  },
  "StatTile4": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Active users",
    "note": "in period",
    "icon": "group"
   },
   "bind": {
    "props.value": "${= range==\"7 days\"?\"13,870\":\"14,260\"}",
    "props.delta": "${= range==\"7 days\"?\"+1.4%\":range==\"30 days\"?\"+6.3%\":\"+12.1%\"}"
   }
  },
  "ChartCard1": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Revenue",
    "kind": "line"
   },
   "bind": {
    "props.value": "${= range==\"7 days\"?\"$18.4k\":range==\"30 days\"?\"$78.9k\":\"$221k\"}",
    "props.delta": "${= range==\"7 days\"?\"+4.1%\":range==\"30 days\"?\"+8.5%\":\"+15.3%\"}",
    "props.values": "${= range==\"7 days\"?[2.4,2.6,2.5,2.7,2.6,2.8,2.8]:range==\"30 days\"?[16.2,18.5,19.1,20.4,22.0,23.1,24.3]:[52,58,61,67,72,79,86]}",
    "props.labels": "${= range==\"7 days\"?[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\",\"Sun\"]:range==\"30 days\"?[\"W1\",\"W2\",\"W3\",\"W4\",\"W5\",\"W6\",\"W7\"]:[\"W2\",\"W4\",\"W6\",\"W8\",\"W10\",\"W12\",\"W13\"]}"
   }
  },
  "ChartCard2": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Sign-ups by channel",
    "kind": "bars",
    "labels": [
     "Organic",
     "Paid",
     "Referral",
     "Social",
     "Email"
    ]
   },
   "bind": {
    "props.value": "${= range==\"7 days\"?\"312\":range==\"30 days\"?\"1,340\":\"3,905\"}",
    "props.values": "${= range==\"7 days\"?[128,84,52,31,17]:range==\"30 days\"?[540,372,218,134,76]:[1580,1010,640,420,255]}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Top plans",
    "note": "tap a column to sort"
   }
  },
  "WideScroll1": {
   "type": "WideScroll",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "width": 460
   },
   "children": [
    "TableHeader1",
    "listView1"
   ]
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "columns": [
     "Plan",
     "Subs",
     "Revenue",
     "Churn"
    ],
    "keys": [
     "name",
     "subs",
     "revenue",
     "churn"
    ]
   },
   "bind": {
    "props.desc": "${desc}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= desc?sortByDesc(plans,x=>x[sort]):sortBy(plans,x=>x[sort])}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.cells": "${= [item.name,item.subs,money(item.revenue,\"$\",0),item.churn+\"%\"]}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "range",
    "type": "text",
    "value": "30 days"
   },
   {
    "name": "sort",
    "type": "text",
    "value": "revenue"
   },
   {
    "name": "desc",
    "type": "boolean",
    "value": true
   },
   {
    "name": "plans",
    "type": "list",
    "value": [
     {
      "name": "Pro",
      "subs": 1340,
      "revenue": 38900,
      "churn": 2.1
     },
     {
      "name": "Team",
      "subs": 412,
      "revenue": 24700,
      "churn": 1.4
     },
     {
      "name": "Starter",
      "subs": 2980,
      "revenue": 8900,
      "churn": 5.2
     },
     {
      "name": "Business",
      "subs": 96,
      "revenue": 4800,
      "churn": 0.9
     },
     {
      "name": "Student",
      "subs": 640,
      "revenue": 1600,
      "churn": 6.8
     }
    ]
   }
  ]
 }
}