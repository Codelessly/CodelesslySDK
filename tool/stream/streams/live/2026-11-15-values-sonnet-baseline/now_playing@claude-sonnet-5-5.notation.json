{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= playing}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pos",
       "value": "${= min(pos+1,tracks[idx].len)}"
      }
     ]
    }
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Now playing",
    "subtitle": "Music",
    "icon": "music_note",
    "status": "Live"
   },
   "children": [
    "row1",
    "ProgressLine1",
    "row2",
    "row3",
    "SectionLabel1",
    "listView1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 14,
    "crossAxisAlignment": "center"
   },
   "children": [
    "Media1",
    "column1"
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "width": 96,
    "height": 96
   },
   "props": {
    "kind": "skyline",
    "tone": "night"
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2",
    "text3"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 19,
     "fontWeight": 700,
     "fontFamily": "Inter Display",
     "letterSpacing": -0.3,
     "height": 1.2,
     "color": "#FF111827"
    },
    "text": "${= tracks[idx].title}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= tracks[idx].artist}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "${= formatDate(today(),'MMM d')}"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= floor(pos/60)}:${= pos%60<10?'0':''}${= pos%60}",
    "props.detail": "-${= floor((tracks[idx].len-pos)/60)}:${= (tracks[idx].len-pos)%60<10?'0':''}${= (tracks[idx].len-pos)%60}",
    "props.value": "${= pos/tracks[idx].len}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "center",
    "spacing": 16,
    "crossAxisAlignment": "center"
   },
   "children": [
    "iconButton1",
    "iconButton2",
    "iconButton3",
    "iconButton4"
   ]
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_previous"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pos",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "iconButton2": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "pause"
   },
   "bind": {
    "visible": "${= !(!playing)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "playing",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "iconButton3": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "play_arrow"
   },
   "bind": {
    "visible": "${= !(playing)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "playing",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "iconButton4": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_next"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "idx",
       "value": "${= (idx+1)%length(tracks)}"
      },
      {
       "type": "setVariable",
       "variable": "pos",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "children": [
    "outlinedButton1",
    "filledButton1"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Like"
   },
   "bind": {
    "visible": "${= !liked}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "liked",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "tonal": true,
    "label": "Liked"
   },
   "bind": {
    "visible": "${liked}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "liked",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Up next",
    "note": "3 tracks"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= slice(tracks,idx+1,idx+4)}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row4"
   ]
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "column2",
    "text6"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "text4",
    "text5"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "fontFamily": "Inter",
     "letterSpacing": -0.1,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${item.title}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "fontFamily": "Inter",
     "height": 1.35,
     "color": "#FF6B7280"
    },
    "text": "${item.artist}"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "fontFamily": "Inter",
     "height": 1.35,
     "color": "#FF6B7280"
    },
    "text": "${= floor(item.len/60)}:${= item.len%60<10?'0':''}${= item.len%60}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "tracks",
    "type": "list",
    "value": [
     {
      "title": "Midnight City",
      "artist": "M83",
      "len": 243
     },
     {
      "title": "Golden Hour",
      "artist": "JVKE",
      "len": 209
     },
     {
      "title": "Ocean Eyes",
      "artist": "Billie Eilish",
      "len": 200
     },
     {
      "title": "Electric Feel",
      "artist": "MGMT",
      "len": 229
     },
     {
      "title": "Dreams",
      "artist": "Fleetwood Mac",
      "len": 257
     }
    ]
   },
   {
    "name": "idx",
    "type": "integer",
    "value": 0
   },
   {
    "name": "pos",
    "type": "integer",
    "value": 74
   },
   {
    "name": "playing",
    "type": "boolean",
    "value": true
   },
   {
    "name": "liked",
    "type": "boolean",
    "value": false
   }
  ]
 }
}