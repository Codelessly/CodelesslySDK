   "type": "PlaceRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "name": "Bean There",
    "detail": "Coffee shop",
    "index": 1,
    "rating": "4.8",
    "distance": "0.2 mi",
    "hours": "7:00 – 18:00"
   },
   "bind": {
    "props.selected": "${= pick==1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pick",
