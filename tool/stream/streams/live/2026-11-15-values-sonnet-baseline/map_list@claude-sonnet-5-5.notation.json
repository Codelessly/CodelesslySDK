    "title": "Coffee near you",
    "subtitle": "5 shops within 0.6 mi",
    "icon": "local_cafe",
    "status": "Open now",
    "tone": "accent"
   },
   "children": [
    "MapPanel1",
    "SectionLabel1",
    "PlaceRow1",
    "PlaceRow2",
    "PlaceRow3",
    "PlaceRow4",
    "PlaceRow5"
   ]
  },
  "MapPanel1": {
   "type": "MapPanel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 178.0
   },
   "props": {
    "value": "pick",
    "count": 5
   }
  },
