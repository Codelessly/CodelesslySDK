{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Review config.yaml",
    "subtitle": "Three proposed changes",
    "icon": "description",
    "status": "Pending"
   },
   "children": [
    "SectionLabel1",
    "DiffHunk1",
    "DiffHunk2",
    "DiffHunk3",
    "ActionButton1",
    "Receipt1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Changes"
   },
   "bind": {
    "props.note": "${= (h1!=\"\"?1:0)+(h2!=\"\"?1:0)+(h3!=\"\"?1:0)} of 3 decided · ${= (h1==\"keep\"?1:0)+(h2==\"keep\"?1:0)+(h3==\"keep\"?1:0)} kept",
    "visible": "${= !applied}"
   }
  },
  "DiffHunk1": {
   "type": "DiffHunk",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Server port",
    "detail": "@@ -4,2 +4,2 @@",
    "value": "h1",
    "start": 4,
    "lines": [
     "-port: 8080",
     "+port: 9090"
    ]
   },
   "bind": {
    "visible": "${= !applied}"
   }
  },
  "DiffHunk2": {
   "type": "DiffHunk",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Logging",
    "detail": "@@ -12,4 +12,4 @@",
    "value": "h2",
    "start": 12,
    "lines": [
     "-level: debug",
     "-file: /tmp/app.log",
     "+level: warn",
     "+file: /var/log/app.log"
    ]
   },
   "bind": {
    "visible": "${= !applied}"
   }
  },
  "DiffHunk3": {
   "type": "DiffHunk",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Cache",
    "detail": "@@ -20,0 +20,3 @@",
    "value": "h3",
    "start": 20,
    "lines": [
     "+enabled: true",
     "+ttl: 300"
    ]
   },
   "bind": {
    "visible": "${= !applied}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Apply changes",
    "tone": "primary",
    "icon": "check"
   },
   "bind": {
    "props.enabled": "${= h1!=\"\"&&h2!=\"\"&&h3!=\"\"}",
    "visible": "${= !applied}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "applied",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Changes applied",
    "tone": "good"
   },
   "bind": {
    "props.message": "${= (h1==\"keep\"?1:0)+(h2==\"keep\"?1:0)+(h3==\"keep\"?1:0)} hunks kept, ${= (h1==\"discard\"?1:0)+(h2==\"discard\"?1:0)+(h3==\"discard\"?1:0)} discarded.",
    "visible": "${= applied}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "h1",
    "type": "text",
    "value": ""
   },
   {
    "name": "h2",
    "type": "text",
    "value": ""
   },
   {
    "name": "h3",
    "type": "text",
    "value": ""
   },
   {
    "name": "applied",
    "type": "boolean",
    "value": false
   }
  ]
 }
}