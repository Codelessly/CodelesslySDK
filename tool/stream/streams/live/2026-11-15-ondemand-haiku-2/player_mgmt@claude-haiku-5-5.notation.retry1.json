{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= playing}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "t",
       "value": "${= min(t+1,229)}"
      }
     ]
    }
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Now listening",
    "subtitle": "Electric Feel",
    "icon": "music_note"
   },
   "bind": {
    "props.status": "${= playing?\"playing\":\"paused\"}"
   },
   "children": [
    "NowPlaying1"
   ]
  },
  "NowPlaying1": {
   "type": "NowPlaying",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "playing": "playing",
    "title": "Electric Feel",
    "artist": "MGMT",
    "kind": "vinyl",
    "tone": "mint",
    "length": 229
   },
   "bind": {
    "props.elapsed": "${t}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onSkip"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "i",
       "value": "${= result==\"next\"?i+1:i-1}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "t",
    "type": "integer",
    "value": 65
   },
   {
    "name": "playing",
    "type": "boolean",
    "value": false
   },
   {
    "name": "i",
    "type": "integer",
    "value": 0
   }
  ]
 }
}