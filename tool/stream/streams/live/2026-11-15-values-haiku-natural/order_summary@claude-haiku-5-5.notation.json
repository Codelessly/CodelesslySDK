{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Your grocery order",
    "subtitle": "5 items",
    "icon": "shopping_cart",
    "status": "Before you place it",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "listView1",
    "divider1",
    "row3",
    "Details1",
    "TotalBar1",
    "row4",
    "Receipt1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Items"
   },
   "bind": {
    "props.note": "${= (sum(map(items, i => i.qty)))} items"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${items}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "children": [
    "Media1",
    "column1",
    "row2"
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "height": 44,
    "width": 44
   },
   "bind": {
    "props.kind": "${item.kind}"
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "fontFamily": "Inter",
     "letterSpacing": -0.1,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${item.name}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "fontFamily": "Inter",
     "height": 1.35,
     "color": "#FF6B7280"
    },
    "text": "${item.detail} · ${= money(item.price,\"$\",2)}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "center"
   },
   "children": [
    "iconButton1",
    "text3",
    "iconButton2"
   ]
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "remove"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= setAt(items,index,with(item,\"qty\",item.qty - (1)))}"
      },
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= (item.qty <= 0) ? (removeWhere(items, x => x.id == item.id)) : items}"
      }
     ]
    }
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "x${item.qty}"
   }
  },
  "iconButton2": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "add"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "items",
       "value": "${= setAt(items,index,with(item,\"qty\",item.qty + (1)))}"
      }
     ]
    }
   ]
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "InputField1",
    "text4"
   ]
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Promo code",
    "placeholder": "SAVE10",
    "value": "promo"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "applied",
       "value": "${= (trim(upper(promo)) == \"SAVE10\")}"
      }
     ]
    }
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "fontFamily": "Inter",
     "height": 1.35,
     "color": "#FF6B7280"
    },
    "text": "${= applied ? \"10% off applied\" : \"\"}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [\"Subtotal\",\"{money((sum(map(items, i => i.qty * i.price))),\"$\",2)}\"]}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Total",
    "cta": "Place order"
   },
   "bind": {
    "props.note": "${= (sum(map(items, i => i.qty)))} items",
    "props.amount": "${= money(((sum(map(items, i => i.qty * i.price))) - (applied ? (sum(map(items, i => i.qty * i.price))) * 0.10 : 0) + delivery),\"$\",2)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "placed"
      }
     ]
    }
   ]
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Cancel",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "cancelled"
      },
      {
       "type": "showToast",
       "message": "Order cancelled"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Confirm",
    "tone": "primary"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "confirmed"
      },
      {
       "type": "componentEvent",
       "event": "confirm_order"
      },
      {
       "type": "showToast",
       "message": "Order confirmed"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.title": "${= decision == \"confirmed\" ? \"Order confirmed\" : \"Order cancelled\"}",
    "props.message": "${= decision == \"confirmed\" ? \"You decided to place this order.\" : \"You decided not to place this order.\"}",
    "props.tone": "${= decision == \"confirmed\" ? \"good\" : \"neutral\"}",
    "props.icon": "${= decision == \"confirmed\" ? \"check\" : \"close\"}",
    "visible": "${= decision != \"\"}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "items",
    "type": "list",
    "value": [
     {
      "id": 1,
      "name": "Bananas",
      "detail": "1 kg",
      "price": 2.5,
      "qty": 1,
      "kind": "banana"
     },
     {
      "id": 2,
      "name": "Whole milk",
      "detail": "2 L",
      "price": 3.2,
      "qty": 2,
      "kind": "milk"
     },
     {
      "id": 3,
      "name": "Sourdough loaf",
      "detail": "Bakery",
      "price": 4.5,
      "qty": 1,
      "kind": "bread"
     },
     {
      "id": 4,
      "name": "Free-range eggs",
      "detail": "12 pack",
      "price": 5.0,
      "qty": 1,
      "kind": "eggs"
     },
     {
      "id": 5,
      "name": "Cheddar",
      "detail": "400 g",
      "price": 7.0,
      "qty": 1,
      "kind": "cheese"
     }
    ]
   },
   {
    "name": "promo",
    "type": "text",
    "value": ""
   },
   {
    "name": "applied",
    "type": "boolean",
    "value": false
   },
   {
    "name": "decision",
    "type": "text",
    "value": ""
   },
   {
    "name": "delivery",
    "type": "decimal",
    "value": 4.99
   }
  ]
 }
}