{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Expense report",
    "subtitle": "Four expenses awaiting approval",
    "icon": "receipt_long",
    "status": "Pending"
   },
   "children": [
    "Receipt1",
    "listView1",
    "divider1",
    "row3",
    "ActionButton1"
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Submitted",
    "tone": "good",
    "icon": "check_circle"
   },
   "bind": {
    "props.message": "${= (length((filter(expenses, e => e.status == \"approved\"))))} expenses approved for $${= fixed((sum((filter(expenses, e => e.status == \"approved\")), e => e.amount)),2)}",
    "visible": "${= submitted}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${expenses}",
    "visible": "${= !submitted}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "column1",
    "column2"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2",
    "text3"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item.merchant}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${item.category} · ${item.date}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FFDC2626"
    },
    "text": "No receipt attached"
   },
   "bind": {
    "visible": "${= !item.receipt}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "end"
   },
   "children": [
    "text4",
    "row2"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= money(item.amount,\"$\",2)}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "center"
   },
   "children": [
    "outlinedButton1",
    "textButton1"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Approve"
   },
   "bind": {
    "props.enabled": "${= item.status != \"approved\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "expenses",
       "value": "${= updateWhere(expenses, x => x.id == item.id, x => with(x, \"status\", \"approved\"))}"
      }
     ]
    }
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Reject"
   },
   "bind": {
    "props.enabled": "${= item.status != \"rejected\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "expenses",
       "value": "${= updateWhere(expenses, x => x.id == item.id, x => with(x, \"status\", \"rejected\"))}"
      }
     ]
    }
   ]
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "visible": "${= !submitted}"
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= !submitted}"
   },
   "children": [
    "text5",
    "text6"
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= (length((filter(expenses, e => e.status == \"approved\"))))} of 4 approved"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "$${= fixed((sum((filter(expenses, e => e.status == \"approved\")), e => e.amount)),2)}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Submit",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= (length(filter(expenses, e => e.status != \"pending\"))) == 4}",
    "visible": "${= !submitted}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "submitted",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "submitExpenses",
       "value": "${= (length((filter(expenses, e => e.status == \"approved\"))))}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "expenses",
    "type": "list",
    "value": [
     {
      "id": 1,
      "merchant": "Delta Air Lines",
      "category": "Travel",
      "date": "Nov 3",
      "amount": 412.6,
      "receipt": true,
      "status": "pending"
     },
     {
      "id": 2,
      "merchant": "Blue Bottle Coffee",
      "category": "Meals",
      "date": "Nov 4",
      "amount": 18.4,
      "receipt": true,
      "status": "pending"
     },
     {
      "id": 3,
      "merchant": "Uber",
      "category": "Transport",
      "date": "Nov 5",
      "amount": 36.25,
      "receipt": false,
      "status": "pending"
     },
     {
      "id": 4,
      "merchant": "WeWork day pass",
      "category": "Office",
      "date": "Nov 6",
      "amount": 45.0,
      "receipt": true,
      "status": "pending"
     }
    ]
   },
   {
    "name": "submitted",
    "type": "boolean",
    "value": false
   }
  ]
 }
}