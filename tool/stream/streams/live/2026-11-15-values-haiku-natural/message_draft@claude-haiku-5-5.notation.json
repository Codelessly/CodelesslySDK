{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "Card1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "Card1": {
   "type": "Card",
   "props": {
    "width": 390,
    "gap": 12,
    "pad": 16
   },
   "children": [
    "text1",
    "row1",
    "textField1",
    "textField2",
    "text3",
    "row2",
    "text4",
    "text5",
    "text6"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "New email"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "text2",
    "Segments1"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Tone"
   }
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "tone",
    "options": [
     "Polite",
     "Firm"
    ]
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "To"
    }
   },
   "bind": {
    "props.initialValue": "${to}",
    "visible": "${= !sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField2": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Subject"
    }
   },
   "bind": {
    "props.initialValue": "${subject}",
    "visible": "${= !sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "subject",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= (\"Dear Mr. Alvarez,\\n\\nThe heating in apartment 4B has not been working for several days. \" + (tone == \"Polite\" ? \"Could you please arrange for someone to take a look this week?\" : \"Please confirm by Thursday when a repair will be carried out.\") + \"\\n\\nThank you,\\nAlex\")}"
   },
   "bind": {
    "visible": "${= !sent}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= !sent}"
   },
   "children": [
    "outlinedButton1",
    "spacer1",
    "filledButton1"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Discard"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "subject",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "tone",
       "value": "Polite"
      }
     ]
    }
   ]
  },
  "spacer1": {
   "type": "spacer",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send"
   },
   "bind": {
    "props.enabled": "${canSend}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "send"
      }
     ]
    }
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "Sent to ${to}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${subject}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= (\"Dear Mr. Alvarez,\\n\\nThe heating in apartment 4B has not been working for several days. \" + (tone == \"Polite\" ? \"Could you please arrange for someone to take a look this week?\" : \"Please confirm by Thursday when a repair will be carried out.\") + \"\\n\\nThank you,\\nAlex\")}"
   },
   "bind": {
    "visible": "${= sent}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": "landlord@example.com"
   },
   {
    "name": "subject",
    "type": "text",
    "value": "Heating not working in apartment 4B"
   },
   {
    "name": "tone",
    "type": "text",
    "value": "Polite"
   },
   {
    "name": "sent",
    "type": "boolean",
    "value": false
   },
   {
    "name": "canSend",
    "type": "text",
    "value": "to != \"\" and subject != \"\""
   }
  ]
 }
}