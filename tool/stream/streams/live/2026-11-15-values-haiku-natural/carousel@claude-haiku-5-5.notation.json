{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "text1",
    "Carousel1",
    "PageDots1",
    "text2",
    "row1",
    "Media1",
    "text4",
    "text5",
    "Paragraph1",
    "Paragraph2",
    "SectionLabel1",
    "ChoiceChips1",
    "text6",
    "ActionButton1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "Running shoes"
   },
   "bind": {
    "visible": "${= !open}"
   }
  },
  "Carousel1": {
   "type": "Carousel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "i"
   },
   "bind": {
    "props.items": "${shoes}",
    "visible": "${= !open}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "PageDots1": {
   "type": "PageDots",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 22.0
   },
   "props": {
    "value": "i"
   },
   "bind": {
    "props.count": "${= length(shoes)}",
    "visible": "${= !open}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= i+1} of ${= length(shoes)}"
   },
   "bind": {
    "visible": "${= !open}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= open}"
   },
   "children": [
    "textButton1",
    "text3"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Back to shoes"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= false}"
      },
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= i+1} of ${= length(shoes)}"
   }
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "height": 160,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "kind": "shoe"
   },
   "bind": {
    "props.tone": "${= shoes[i].tone}",
    "visible": "${= open}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "letterSpacing": -0.2,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${= shoes[i].name}"
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= money(shoes[i].price,\"$\",0)}"
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.text": "${= shoes[i].detail}",
    "visible": "${= open}"
   }
  },
  "Paragraph2": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "A snappy plate and a low stack for intervals and race day."
   },
   "bind": {
    "visible": "${= (open) && (shoes[i].id==\"tempo\")}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Size",
    "note": "pick one"
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "size",
    "options": [
     "7",
     "8",
     "9",
     "10",
     "11",
     "12"
    ],
    "disabled": [
     "8"
    ],
    "columns": 3
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Size ${size}"
   },
   "bind": {
    "visible": "${= (open) && (size!=0)}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Add to bag",
    "tone": "primary",
    "icon": "shopping_bag"
   },
   "bind": {
    "props.enabled": "${= size!=0}",
    "visible": "${= open}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "addToBag"
      },
      {
       "type": "showToast",
       "message": "Added to bag"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "shoes",
    "type": "list",
    "value": [
     {
      "id": "aero",
      "name": "Aero Runner",
      "price": 120,
      "rating": 4.8,
      "kind": "shoe",
      "tone": "sand",
      "detail": "Light daily trainer"
     },
     {
      "id": "trail",
      "name": "Trail Scout",
      "price": 135,
      "rating": 4.6,
      "kind": "shoe",
      "tone": "mint",
      "detail": "Grip for rough ground"
     },
     {
      "id": "tempo",
      "name": "Tempo Flash",
      "price": 150,
      "rating": 4.7,
      "kind": "shoe",
      "tone": "sky",
      "detail": "A snappy plate and a low stack for intervals and race day."
     },
     {
      "id": "cloud",
      "name": "Cloud Stride",
      "price": 140,
      "rating": 4.5,
      "kind": "shoe",
      "tone": "lilac",
      "detail": "Soft cushioning for long miles"
     },
     {
      "id": "day",
      "name": "Daybreak 2",
      "price": 95,
      "rating": 4.4,
      "kind": "shoe",
      "tone": "rose",
      "detail": "An easy everyday shoe"
     },
     {
      "id": "owl",
      "name": "Night Owl",
      "price": 125,
      "rating": 4.6,
      "kind": "shoe",
      "tone": "slate",
      "detail": "Reflective details for evening runs"
     }
    ]
   },
   {
    "name": "i",
    "type": "integer",
    "value": 0
   },
   {
    "name": "open",
    "type": "boolean",
    "value": false
   },
   {
    "name": "size",
    "type": "integer",
    "value": 0
   },
   {
    "name": "sold",
    "type": "list",
    "value": [
     8
    ]
   }
  ]
 }
}