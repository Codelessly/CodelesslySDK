      "date": "May 15",
      "amount": 975,
      "status": "Due"
     },
     {
      "id": "1006",
      "customer": "Stark Ltd",
      "date": "May 16",
      "amount": 3100,
      "status": "Overdue"
     },
     {
      "id": "1007",
      "customer": "Wayne Co",
