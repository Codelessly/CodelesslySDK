{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Invoices",
    "subtitle": "12 invoices",
    "icon": "receipt_long",
    "status": "12 total"
   },
   "children": [
    "row1",
    "InputField1",
    "WideScroll1",
    "Pager1",
    "TotalBar1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "Segments1"
   ]
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "filter",
    "options": [
     "All",
     "Paid",
     "Due",
     "Overdue"
    ]
   }
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Search customer",
    "placeholder": "Type a name",
    "value": "query"
   }
  },
  "WideScroll1": {
   "type": "WideScroll",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "width": 390
   },
   "children": [
    "TableHeader1",
    "listView1"
   ]
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "columns": [
     "Number",
     "Customer",
     "Date",
     "Amount",
     "Status"
    ],
    "keys": [
     "id",
     "customer",
     "date",
     "amount",
     "status"
    ],
    "selectable": true
   },
   "bind": {
    "props.desc": "${desc}",
    "props.checked": "${= length(picked)==length((slice((desc ? sortByDesc((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort]) : sortBy((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort])), page * 5, page * 5 + 5)))}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onToggleAll"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= length(picked)==length((slice((desc ? sortByDesc((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort]) : sortBy((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort])), page * 5, page * 5 + 5)))?[]:map((slice((desc ? sortByDesc((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort]) : sortBy((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort])), page * 5, page * 5 + 5)),r=>r.id)}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= (slice((desc ? sortByDesc((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort]) : sortBy((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort])), page * 5, page * 5 + 5))}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "selectable": true
   },
   "bind": {
    "props.cells": "${= [item.id,item.customer,item.date,money(item.amount,\"$\",0)]}",
    "props.badge": "${item.status}",
    "props.checked": "${= contains(picked,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= contains(picked,item.id)?without(picked,item.id):append(picked,item.id)}"
      }
     ]
    }
   ]
  },
  "Pager1": {
   "type": "Pager",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "page"
   },
   "bind": {
    "props.count": "${= (max(1, ceil(length((desc ? sortByDesc((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort]) : sortBy((filter(rows, r => (filter == \"All\" || r.status == filter) && (query == \"\" || contains(lower(r.customer), lower(query))))), r => r[sort]))) / 5)))}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "cta": "Send reminders",
    "icon": "mail"
   },
   "bind": {
    "props.label": "${= length(picked)} selected",
    "props.note": "Total ${= money((sum(filter(rows, r => contains(picked, r.id)), r => r.amount)),\"$\",0)}",
    "props.amount": "${= money((sum(filter(rows, r => contains(picked, r.id)), r => r.amount)),\"$\",0)}",
    "visible": "${= length(picked) > 0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "remind",
       "value": "${picked}"
      },
      {
       "type": "showToast",
       "message": "Reminders sent"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "rows",
    "type": "list",
    "value": [
     {
