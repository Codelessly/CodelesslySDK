{"meta":{"ui":"checkout","model":"claude-haiku-5-5","form":"notation","designSystem":"cards","turn":"generate","prompt":"Build a small checkout in three steps. Step 1, my cart: Espresso beans $24 x1, Ceramic mug $12 x2, Canvas tote $18 x1, with quantities I can change and the subtotal. Step 2, shipping: name, address, city, postcode and email, all required, with a message under a field that is empty or an email without an @. Step 3, payment summary: a choice of Standard delivery ($4, 3 to 5 working days) or Express ($12, next working day) that changes the total, subtotal plus delivery. Then a confirmation with an order number, my name, my email and the total I paid. I can go back a step without losing what I typed.","text":"state step=1\nstate items=[{\"id\":\"beans\",\"name\":\"Espresso beans\",\"price\":24,\"qty\":1},{\"id\":\"mug\",\"name\":\"Ceramic mug\",\"price\":12,\"qty\":2},{\"id\":\"tote\",\"name\":\"Canvas tote\",\"price\":18,\"qty\":1}]\nstate name=\"\"\nstate address=\"\"\nstate city=\"\"\nstate postcode=\"\"\nstate email=\"\"\nstate delivery=\"Standard\"\nlet subtotal = sum(map(items, i => i.qty * i.price))\nlet shipping = delivery == \"Express\" ? 12 : 4\nlet total = subtotal + shipping\nlet nameErr = trim(name) == \"\" ? \"Name is required\" : \"\"\nlet addrErr = trim(address) == \"\" ? \"Address is required\" : \"\"\nlet cityErr = trim(city) == \"\" ? \"City is required\" : \"\"\nlet postErr = trim(postcode) == \"\" ? \"Postcode is required\" : \"\"\nlet emailErr = trim(email) == \"\" ? \"Email is required\" : (contains(email, \"@\") ? \"\" : \"Enter a valid email\")\nlet shipValid = nameErr == \"\" and addrErr == \"\" and cityErr == \"\" and postErr == \"\" and emailErr == \"\"\nlet orderNo = \"ORD-\" + replace(upper(name), \" \", \"\") + \"-\" + round(total, 0)\nCard w:390 gap:12 pad:16\n  Row between\n    Text.heading \"Checkout\"\n    Text.muted \"Step {step} of 3\"\n  Progress =step\n  if step == 1\n    Text.title \"Your cart\"\n    each item in items\n      Row between\n        Column\n          Text.strong \"{item.name}\"\n          Text.muted \"${item.price} each\"\n        Row gap:8\n          IconButton \"remove\" -> items = updateWhere(items, x => x.id == item.id, x => with(x, \"qty\", max(0, x.qty - 1)))\n          Text.strong \"{item.qty}\"\n          IconButton \"add\" -> items = updateWhere(items, x => x.id == item.id, x => with(x, \"qty\", x.qty + 1))\n    Divider\n    Row between\n      Text.strong \"Subtotal\"\n      Text.strong \"${fixed(subtotal, 2)}\"\n    Button \"Continue to shipping\" enabled:{length(items) > 0} -> step = 2\n  if step == 2\n    Text.title \"Shipping\"\n    InputField \"Full name\" \"Jane Doe\" =name error:{nameErr}\n    InputField \"Address\" \"12 High Street\" =address error:{addrErr}\n    InputField \"City\" \"London\" =city error:{cityErr}\n    InputField \"Postcode\" \"SW1A 1AA\" =postcode error:{postErr}\n    InputField \"Email\" \"you@example.com\" =email error:{emailErr}\n    Row gap:8\n      Button.outline \"Back\" -> step = 1\n      Button \"Continue\" enabled:{shipValid} -> step = 3\n  if step == 3\n    Text.title \"Payment summary\"\n    OptionList \"Delivery\" =delivery options:[\"Standard\",\"Express\"] details:[\"3 to 5 working days\",\"Next working day\"] prices:[\"$4\",\"$12\"] -> step = 3\n    Details rows:[[\"Subtotal\", \"${fixed(subtotal, 2)}\"],[\"Delivery\", \"${fixed(shipping, 2)}\"],[\"Total\", \"${fixed(total, 2)}\"]]\n    Row gap:8\n      Button.outline \"Back\" -> step = 2\n      Button \"Place order\" -> step = 4\n  if step == 4\n    Receipt \"Order confirmed\" \"Thanks {name}. A confirmation is on its way to {email}.\" code:{orderNo} codeLabel:\"Order number\" tone:good\n    Details rows:[[\"Name\", \"{name}\"],[\"Email\", \"{email}\"],[\"Total paid\", \"${fixed(total, 2)}\"]]","usage":{"input_tokens":9434,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":1270,"service_tier":"standard","inference_geo":"global","speed":"standard","output_tokens_details":{"thinking_tokens":0}},"ttftMs":588,"totalMs":4720}}
