{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Delete 214 old files?",
    "subtitle": "Shared Drive / Archive / 2019",
    "icon": "delete_outline",
    "status": "Needs approval",
    "tone": "danger"
   },
   "children": [
    "Paragraph1",
    "Details1",
    "Callout1",
    "Disclosure1",
    "row1",
    "Receipt1"
   ]
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "This will permanently delete 214 files, all older than 2020, from Shared Drive / Archive / 2019. It frees 3.2 GB."
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Folder\",\"Shared Drive / Archive / 2019\"],[\"Files\",\"214, all older than 2020\"],[\"Space freed\",\"3.2 GB\"],[\"Undoable\",\"No\"]]}"
   }
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "This cannot be undone",
    "message": "Deleted files cannot be recovered after you approve.",
    "icon": "danger"
   }
  },
  "Disclosure1": {
   "type": "Disclosure",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Show the first five files",
    "note": "…and 209 more",
    "lines": [
     "Q1-2019-budget.xlsx",
     "meeting-notes-2018-03.docx",
     "old-logo-draft-v2.png",
     "onboarding-2017.pdf",
     "team-photo-2016.jpg"
    ]
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= decision==\"\"}"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Deny",
    "icon": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "Denied"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Approve",
    "icon": "danger"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "decision",
       "value": "Approved"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "check"
   },
   "bind": {
    "props.title": "${decision}",
    "props.message": "${= decision == \"Approved\" ? \"214 files are being deleted from Shared Drive / Archive / 2019.\" : \"No files were deleted.\"}",
    "props.tone": "${= decision==\"Approved\"?\"good\":\"neutral\"}",
    "visible": "${= decision!=\"\"}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "decision",
    "type": "text",
    "value": ""
   }
  ]
 }
}