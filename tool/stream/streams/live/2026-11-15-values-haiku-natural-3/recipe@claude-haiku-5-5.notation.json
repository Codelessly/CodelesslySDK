{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Lemon chicken traybake",
    "subtitle": "Weeknight · Easy · 45 min",
    "icon": "restaurant",
    "status": "Easy",
    "tone": "accent"
   },
   "children": [
    "row1",
    "SectionLabel1",
    "Checklist1",
    "SectionLabel2",
    "Steps1",
    "Paragraph1",
    "ActionButton1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "Counter1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "Servings"
   }
  },
  "Counter1": {
   "type": "Counter",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Serves",
    "value": "servings",
    "min": 2,
    "max": 8,
    "step": 1
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Ingredients"
   },
   "bind": {
    "props.note": "for ${servings}"
   }
  },
  "Checklist1": {
   "type": "Checklist",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Shopping list",
    "value": "ticked"
   },
   "bind": {
    "props.items": "${= [(\"Chicken thighs — \" + (fixed(800*servings/4,0)) + \" g\"), (\"Baby potatoes — \" + (fixed(600*servings/4,0)) + \" g\"), (\"Lemons — \" + (fixed(2*servings/4,0))), (\"Olive oil — \" + (fixed(4*servings/4,0)) + \" tbsp\"), (\"Garlic cloves — \" + (fixed(4*servings/4,0))), (\"Dried oregano — \" + (fixed(2*servings/4,0)) + \" tsp\")]}"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Method",
    "note": "4 steps"
   }
  },
  "Steps1": {
   "type": "Steps",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "steps": [
     "Heat the oven",
     "Toss",
     "Roast",
     "Rest"
    ]
   },
   "bind": {
    "props.current": "${= length(ticked)}"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Heat the oven to 220C. Toss everything in the oil, lemon and oregano. Roast 35 minutes, turning once. Rest 5 minutes and serve."
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start cooking",
    "tone": "primary",
    "icon": "play_arrow"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "start_cooking"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "servings",
    "type": "integer",
    "value": 4
   },
   {
    "name": "ticked",
    "type": "list",
    "value": []
   }
  ]
 }
}