{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Invoices",
    "subtitle": "12 invoices, May",
    "icon": "receipt_long",
    "status": "Live"
   },
   "children": [
    "textField1",
    "Segments1",
    "TableHeader1",
    "listView1",
    "Pager1",
    "TotalBar1"
   ]
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Search customer",
     "hintText": "Type a name"
    }
   },
   "bind": {
    "props.initialValue": "${q}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "q",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "status",
    "options": [
     "All",
     "Paid",
     "Due",
     "Overdue"
    ]
   }
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "columns": [
     "#",
     "Customer",
     "Date",
     "Amount",
     "Status"
    ],
    "keys": [
     "id",
     "customer",
     "day",
     "amount",
     "status"
    ],
    "selectable": true
   },
   "bind": {
    "props.desc": "${desc}",
    "props.checked": "${= length(picked)>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onToggleAll"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= []}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= (slice((desc ? sortByDesc((filter(rowsAll, r => (status==\"All\" || r.status==status) && (q==\"\" || contains(lower(r.customer), lower(q))))), r => r.day) : sortBy((filter(rowsAll, r => (status==\"All\" || r.status==status) && (q==\"\" || contains(lower(r.customer), lower(q))))), r => r.day)), page*5, page*5+5))}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "selectable": true
   },
   "bind": {
    "props.cells": "${= [item.id,item.customer,item.date,money(item.amount,\"$\",0)]}",
    "props.badge": "${item.status}",
    "props.checked": "${= contains(picked,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= contains(picked,item.id) ? without(picked,item.id) : append(picked,item.id)}"
      }
     ]
    }
   ]
  },
  "Pager1": {
   "type": "Pager",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Page",
    "value": "page"
   },
   "bind": {
    "props.count": "${= ceil(length((desc ? sortByDesc((filter(rowsAll, r => (status==\"All\" || r.status==status) && (q==\"\" || contains(lower(r.customer), lower(q))))), r => r.day) : sortBy((filter(rowsAll, r => (status==\"All\" || r.status==status) && (q==\"\" || contains(lower(r.customer), lower(q))))), r => r.day)))/5)}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "note": "Total of ticked amounts",
    "cta": "Send reminders",
    "icon": "mail"
   },
   "bind": {
    "props.label": "${= length(picked)} selected",
    "props.amount": "${= money(sum(filter(rowsAll, r => contains(picked,r.id)), r => r.amount),\"$\",0)}",
    "visible": "${= length(picked)>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "remind",
       "value": "${picked}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "q",
    "type": "text",
    "value": ""
   },
   {
    "name": "status",
    "type": "text",
    "value": ""
   },
   {
    "name": "sort",
    "type": "text",
    "value": "date"
   },
   {
    "name": "desc",
    "type": "boolean",
    "value": false
   },
   {
    "name": "page",
    "type": "integer",
    "value": 0
   },
   {
    "name": "picked",
    "type": "list",
    "value": []
   },
   {
    "name": "rowsAll",
    "type": "list",
    "value": [
     {
      "id": "1001",
      "customer": "Acme Corp",
      "date": "May 02",
      "day": 2,
      "amount": 1200,
      "status": "Paid"
     },
     {
      "id": "1002",
      "customer": "Globex",
      "date": "May 05",
      "day": 5,
      "amount": 860,
      "status": "Due"
     },
     {
      "id": "1003",
      "customer": "Initech",
      "date": "May 09",
      "day": 9,
      "amount": 430,
      "status": "Overdue"
     },
     {
      "id": "1004",
      "customer": "Umbrella",
      "date": "May 12",
      "day": 12,
      "amount": 2250,
      "status": "Paid"
     },
     {
      "id": "1005",
      "customer": "Hooli",
      "date": "May 15",
      "day": 15,
      "amount": 975,
      "status": "Due"
     },
     {
      "id": "1006",
      "customer": "Stark Ltd",
      "date": "May 16",
      "day": 16,
      "amount": 3100,
      "status": "Overdue"
     },
     {
      "id": "1007",
      "customer": "Wayne Co",
      "date": "May 18",
      "day": 18,
      "amount": 640,
      "status": "Paid"
     },
     {
      "id": "1008",
      "customer": "Wonka",
      "date": "May 20",
      "day": 20,
      "amount": 1480,
      "status": "Due"
     },
     {
      "id": "1009",
      "customer": "Soylent",
      "date": "May 22",
      "day": 22,
      "amount": 300,
      "status": "Overdue"
     },
     {
      "id": "1010",
      "customer": "Cyberdyne",
      "date": "May 24",
      "day": 24,
      "amount": 5200,
      "status": "Paid"
     },
     {
      "id": "1011",
      "customer": "Tyrell",
      "date": "May 27",
      "day": 27,
      "amount": 760,
      "status": "Due"
     },
     {
      "id": "1012",
      "customer": "Aperture",
      "date": "May 29",
      "day": 29,
      "amount": 1890,
      "status": "Paid"
     }
    ]
   }
  ]
 }
}