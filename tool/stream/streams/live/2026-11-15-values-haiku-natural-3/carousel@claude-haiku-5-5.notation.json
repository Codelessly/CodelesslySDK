{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "Carousel1",
    "row1",
    "Media1",
    "text3",
    "text4",
    "text5",
    "row2",
    "text6",
    "filledButton1",
    "textButton1"
   ]
  },
  "Carousel1": {
   "type": "Carousel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "i",
    "peek": 0.86,
    "dots": true,
    "arrows": true,
    "counter": true,
    "thumbs": true,
    "height": 260
   },
   "bind": {
    "props.items": "${shoes}",
    "visible": "${= !open}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= open}"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "${= shoes[i].name}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "$${= shoes[i].price}"
   }
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "height": 180,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "kind": "shoe",
    "tone": "sand"
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= shoes[i].detail}"
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "A snappy plate and a low stack for intervals and race day."
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Size"
   },
   "bind": {
    "visible": "${= open}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= open}"
   },
   "children": [
    "choiceChip1",
    "choiceChip2",
    "choiceChip3",
    "choiceChip4",
    "choiceChip5",
    "choiceChip6"
   ]
  },
  "choiceChip1": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "7"
   },
   "bind": {
    "props.isEnabled": "${= !contains(sold,7)}",
    "props.selected": "${= size==7}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 7}"
      }
     ]
    }
   ]
  },
  "choiceChip2": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "8"
   },
   "bind": {
    "props.isEnabled": "${= !contains(sold,8)}",
    "props.selected": "${= size==8}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 8}"
      }
     ]
    }
   ]
  },
  "choiceChip3": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "9"
   },
   "bind": {
    "props.isEnabled": "${= !contains(sold,9)}",
    "props.selected": "${= size==9}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 9}"
      }
     ]
    }
   ]
  },
  "choiceChip4": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "10"
   },
   "bind": {
    "props.isEnabled": "${= !contains(sold,10)}",
    "props.selected": "${= size==10}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 10}"
      }
     ]
    }
   ]
  },
  "choiceChip5": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "11"
   },
   "bind": {
    "props.isEnabled": "${= !contains(sold,11)}",
    "props.selected": "${= size==11}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 11}"
      }
     ]
    }
   ]
  },
  "choiceChip6": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "12"
   },
   "bind": {
    "props.isEnabled": "${= !contains(sold,12)}",
    "props.selected": "${= size==12}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "size",
       "value": "${= 12}"
      }
     ]
    }
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "Size ${size}"
   },
   "bind": {
    "visible": "${= (open) && (size>0)}"
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Add to bag"
   },
   "bind": {
    "props.enabled": "${= size>0}",
    "visible": "${= open}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "bag",
       "value": "${= bag + (1)}"
      },
      {
       "type": "showToast",
       "message": "Added to bag"
      }
     ]
    }
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Back to carousel"
   },
   "bind": {
    "visible": "${= open}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "open",
       "value": "${= false}"
      }
     ]
    }
   ]
  }
 },
