{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Find your laptop",
    "subtitle": "Three quick questions",
    "icon": "laptop_mac",
    "status": "Step 1 of 3",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "Paragraph1",
    "OptionList1",
    "SectionLabel2",
    "Paragraph2",
    "OptionList2",
    "OptionList3",
    "ActionButton1",
    "SectionLabel3",
    "Paragraph3",
    "OptionList4",
    "ActionButton2",
    "Callout1",
    "Details1",
    "ActionButton3"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Question 1 of 3",
    "note": "Use"
   },
   "bind": {
    "visible": "${= step == 1}"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "What will you use it for?"
   },
   "bind": {
    "visible": "${= step == 1}"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "use",
    "options": [
     "School or study",
     "Work and office",
     "Gaming",
     "Creative projects"
    ]
   },
   "bind": {
    "visible": "${= step == 1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Question 2 of 3",
    "note": "Focus"
   },
   "bind": {
    "visible": "${= step == 2}"
   }
  },
  "Paragraph2": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.text": "${= (use == \"Gaming\" ? \"What do you play?\" : \"What matters most?\")}",
    "visible": "${= step == 2}"
   }
  },
  "OptionList2": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "play",
    "options": [
     "Competitive esports",
     "Big open-world titles"
    ]
   },
   "bind": {
    "visible": "${= (step == 2) && (use == \"Gaming\")}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "OptionList3": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "matters",
    "options": [
     "All-day battery",
     "A big screen and keyboard",
     "As light as possible"
    ]
   },
   "bind": {
    "visible": "${= (step == 2) && (use != \"Gaming\")}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "bind": {
    "visible": "${= step == 2}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Question 3 of 3",
    "note": "Budget"
   },
   "bind": {
    "visible": "${= step == 3}"
   }
  },
  "Paragraph3": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "What is your budget?"
   },
   "bind": {
    "visible": "${= step == 3}"
   }
  },
  "OptionList4": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "budget",
    "options": [
     "Under $800",
     "$800 to $1,500",
     "Over $1,500"
    ]
   },
   "bind": {
    "visible": "${= step == 3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 4}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "bind": {
    "visible": "${= step == 3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "message": "Based on your answers, this is the best fit.",
    "tone": "good",
    "icon": "check_circle"
   },
   "bind": {
    "props.title": "Our pick: ${= (use == \"Gaming\" ? \"Volt 16 Gaming\" : (use == \"Creative projects\" ? \"Studio 14 Pro\" : (budget == \"Under $800\" ? \"Slate 13\" : \"Aero 14\")))}",
    "visible": "${= step == 4}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Use\", use],[\"Focus\", coalesce(play, matters)],[\"Budget\", budget],[\"Price\", (use == \"Gaming\" ? \"$1,399\" : (use == \"Creative projects\" ? \"$1,799\" : (budget == \"Under $800\" ? \"$649\" : \"$1,099\")))]]}",
    "visible": "${= step == 4}"
   }
  },
  "ActionButton3": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start over",
    "tone": "primary"
   },
   "bind": {
    "visible": "${= step == 4}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "use",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "play",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "matters",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "budget",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "use",
    "type": "text",
    "value": ""
   },
   {
    "name": "play",
    "type": "text",
    "value": ""
   },
   {
    "name": "matters",
    "type": "text",
    "value": ""
   },
   {
    "name": "budget",
    "type": "text",
    "value": ""
   },
   {
    "name": "step",
    "type": "integer",
    "value": 1
   }
  ]
 }
}