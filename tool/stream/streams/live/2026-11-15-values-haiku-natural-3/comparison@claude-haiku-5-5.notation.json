{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Compare phone plans",
    "subtitle": "Lite vs Max",
    "icon": "compare_arrows",
    "status": "Choose"
   },
   "children": [
    "ComparisonTable1",
    "Callout1",
    "Receipt1"
   ]
  },
  "ComparisonTable1": {
   "type": "ComparisonTable",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "names": [
     "Lite",
     "Max"
    ],
    "prices": [
     "$25/mo",
     "$45/mo"
    ],
    "notes": [
     "10 GB data, 500 min",
     "Unlimited data and calls"
    ],
    "pick": "Lite",
    "rows": [
     [
      "Price",
      "$25/mo",
      "$45/mo",
      1
     ],
     [
      "Data",
      "10 GB",
      "Unlimited",
      "2"
     ],
     [
      "Calls",
      "500 min",
      "Unlimited",
      "2"
     ],
     [
      "Roaming",
      "Not included",
      "EU and US",
      2
     ],
     [
      "Contract",
      "Monthly",
      "24 months",
      1
     ],
     [
      "Extras",
      "None",
      "Streaming and 5G",
      2
     ]
    ],
    "cta": "Choose"
   },
   "bind": {
    "visible": "${= pick==\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChoose"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pick",
       "value": "${= result}"
      }
     ]
    }
   ]
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Recommendation",
    "message": "Max wins 4 of the 6 rows and costs $20 more per month. Lite suits light, home-based use.",
    "tone": "accent",
    "icon": "star"
   },
   "bind": {
    "visible": "${= pick==\"\"}"
   }
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Plan chosen",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.message": "You picked the ${pick} plan.",
    "visible": "${= pick!=\"\"}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "pick",
    "type": "text",
    "value": ""
   }
  ]
 }
}