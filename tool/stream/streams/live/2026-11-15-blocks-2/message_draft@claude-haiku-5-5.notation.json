{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": 390,
    "padding": 16,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "ChatCard1",
    "ChatCard2"
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "New email",
    "subtitle": "Edit before sending",
    "icon": "mail",
    "status": "Draft",
    "tone": "accent"
   },
   "bind": {
    "visible": "${= sent==false}"
   },
   "children": [
    "InputField1",
    "InputField2",
    "Segments1",
    "InputField3",
    "row1"
   ]
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "To",
    "placeholder": "landlord@example.com",
    "value": "to"
   }
  },
  "InputField2": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Subject",
    "placeholder": "Subject",
    "value": "subject"
   }
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "tone",
    "options": [
     "Polite",
     "Firm"
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${= tone==\"Firm\"?\"Hello,\\n\\nThe heating in my flat has been broken for several days. I need it repaired immediately. Please confirm when this will be fixed.\\n\\nRegards,\":\"Hello,\\n\\nThe heating in my flat has stopped working. Could you arrange a repair as soon as possible?\\n\\nThank you,\"}"
      }
     ]
    }
   ]
  },
  "InputField3": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Message",
    "placeholder": "Write your message",
    "value": "body",
    "lines": 8
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Discard",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "subject",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "body",
       "value": ""
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Send",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= to!=\"\"&&subject!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= true}"
      },
      {
       "type": "showToast",
       "message": "Email sent"
      }
     ]
    }
   ]
  },
  "ChatCard2": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Email sent",
    "icon": "check_circle",
    "status": "Sent",
    "tone": "good"
   },
   "bind": {
    "props.subtitle": "To ${to}",
    "visible": "${= sent==true}"
   },
   "children": [
    "Paragraph1"
   ]
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.text": "Your message about the heating was sent to ${to}."
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "tone",
    "type": "text",
    "value": "polite"
   },
   {
    "name": "to",
    "type": "text",
    "value": "landlord@example.com"
   },
   {
    "name": "subject",
    "type": "text",
    "value": "Heating not working"
   },
   {
    "name": "body",
    "type": "text",
    "value": "Hello,\n\nThe heating in my flat has stopped working. Could you arrange a repair as soon as possible?\n\nThank you,"
   },
   {
    "name": "sent",
    "type": "boolean",
    "value": false
   }
  ]
 }
}