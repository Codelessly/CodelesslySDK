{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Book a table",
    "subtitle": "Trattoria Verde",
    "icon": "restaurant",
    "status": "Open"
   },
   "children": [
    "SectionLabel1",
    "DayPicker1",
    "SectionLabel2",
    "Counter1",
    "SectionLabel3",
    "ChoiceChips1",
    "TotalBar1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Date",
    "note": "next 7 days"
   }
  },
  "DayPicker1": {
   "type": "DayPicker",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "day",
    "days": [
     "Mon 9",
     "Tue 10",
     "Wed 11",
     "Thu 12",
     "Fri 13",
     "Sat 14",
     "Sun 15"
    ]
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Party size",
    "note": "1 to 8"
   }
  },
  "Counter1": {
   "type": "Counter",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Guests",
    "detail": "people",
    "value": "party",
    "min": 1,
    "max": 8
   }
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Time",
    "note": "available slots"
   },
   "bind": {
    "visible": "${= day!=\"\"}"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "time",
    "columns": 4,
    "options": [
     "17:30",
     "18:00",
     "18:30",
     "19:00",
     "19:30",
     "20:00",
     "20:30",
     "21:00"
    ]
   },
   "bind": {
    "props.disabled": "${= party>=6?[\"18:00\",\"19:00\",\"20:00\"]:(contains([\"Sat 14\",\"Sun 15\"],day)?[\"18:30\",\"19:30\",\"20:30\"]:[\"20:00\",\"21:00\"])}",
    "visible": "${= day!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "time",
       "value": "${= result}"
      }
     ]
    }
   ]
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Confirm",
    "cta": "Confirm"
   },
   "bind": {
    "props.note": "a table for ${party}",
    "props.amount": "${day}, ${time}",
    "props.enabled": "${= day!=\"\"&&time!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "book",
       "value": "day party time"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "day",
    "type": "text",
    "value": ""
   },
   {
    "name": "party",
    "type": "integer",
    "value": 1
   },
   {
    "name": "time",
    "type": "text",
    "value": ""
   }
  ]
 }
}