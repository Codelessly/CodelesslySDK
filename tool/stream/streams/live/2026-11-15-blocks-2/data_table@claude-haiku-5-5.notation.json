      "date": "2024-05-17",
      "amount": 455,
      "status": "Paid"
     },
     {
      "no": "INV-1048",
      "customer": "Keystone Builders",
      "date": "2024-05-20",
      "amount": 6900,
      "status": "Due"
     },
     {
      "no": "INV-1049",
      "customer": "Acme Logistics",
      "date": "2024-05-23",
      "amount": 1130,
      "status": "Paid"
     },
     {
      "no": "INV-1050",
      "customer": "Summit Dental",
      "date": "2024-05-25",
