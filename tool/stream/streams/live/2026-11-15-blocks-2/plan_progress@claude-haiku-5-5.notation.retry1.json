{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= elapsed+1}"
      }
     ]
    },
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= running}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= min(6,done+1)}"
      },
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= done<5}"
      }
     ]
    }
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Blog migration",
    "subtitle": "Six steps, run one after another",
    "icon": "swap_horiz",
    "status": "Ready"
   },
   "children": [
    "listView1",
    "ProgressLine1",
    "row1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${steps}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "PlanStep1"
   ]
  },
  "PlanStep1": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.title": "${item.title}",
    "props.detail": "${item.detail}",
    "props.index": "${item.i}",
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Progress",
    "detail": ""
   },
   "bind": {
    "props.value": "${= done/6}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start",
    "tone": "primary",
    "icon": "play_arrow"
   },
   "bind": {
    "props.enabled": "${= !running}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= true}"
      },
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Pause",
    "tone": "quiet",
    "icon": "pause"
   },
   "bind": {
    "props.enabled": "${running}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= false}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "running",
    "type": "boolean",
    "value": false
   },
   {
    "name": "done",
    "type": "integer",
    "value": 0
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "steps",
    "type": "list",
    "value": [
     {
      "i": 0,
      "title": "Export posts",
      "detail": "Download all posts and drafts from the old platform."
     },
     {
      "i": 1,
      "title": "Convert format",
      "detail": "Turn HTML content into Markdown with metadata."
     },
     {
      "i": 2,
      "title": "Move media",
      "detail": "Copy images and attachments to the new storage."
     },
     {
      "i": 3,
      "title": "Fix links",
      "detail": "Rewrite internal URLs and set up redirects."
     },
     {
      "i": 4,
      "title": "Restore comments",
      "detail": "Import comments and map them to their posts."
     },
     {
      "i": 5,
      "title": "Verify and switch DNS",
      "detail": "Check every page, then point the domain at the new site."
     }
    ]
   }
  ]
 }
}