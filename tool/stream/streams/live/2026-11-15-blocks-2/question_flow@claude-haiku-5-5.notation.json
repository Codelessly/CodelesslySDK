{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Find your laptop",
    "subtitle": "Three quick questions",
    "icon": "laptop_mac",
    "status": "Step 1 of 3"
   },
   "children": [
    "Steps1",
    "OptionList1",
    "ActionButton1",
    "OptionList2",
    "row1",
    "OptionList3",
    "row2",
    "Recommendation1",
    "Receipt1",
    "ActionButton6"
   ]
  },
  "Steps1": {
   "type": "Steps",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "steps": [
     "Use",
     "Detail",
     "Budget"
    ]
   },
   "bind": {
    "props.current": "${= step+1}"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "What will you use it for?",
    "value": "use",
    "options": [
     "Writing and browsing",
     "Photo and video editing",
     "Gaming",
     "Coding"
    ]
   },
   "bind": {
    "visible": "${= step==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Next",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= use!=\"\"}",
    "visible": "${= step==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "OptionList2": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "What matters most?",
    "value": "detail",
    "options": [
     "Battery life",
     "Raw performance",
     "Lightweight",
     "Screen quality"
    ]
   },
   "bind": {
    "visible": "${= step==1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step==1}"
   },
   "children": [
    "ActionButton2",
    "ActionButton3"
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "ActionButton3": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Next",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= detail!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "OptionList3": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "What is your budget?",
    "value": "budget",
    "options": [
     "Under $800",
     "$800 to $1,500",
     "Over $1,500"
    ]
   },
   "bind": {
    "visible": "${= step==2}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step==2}"
   },
   "children": [
    "ActionButton4",
    "ActionButton5"
   ]
  },
  "ActionButton4": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "ActionButton5": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "See my pick",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= budget!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "Recommendation1": {
   "type": "Recommendation",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Your pick: a 14-inch laptop",
    "why": "Matches what you use it for, what matters most, and your budget.",
    "eyebrow": "Best match",
    "kind": "mountain"
   },
   "bind": {
    "props.reasons": "${= [\"Fits your use: \"+use,\"Priority: \"+detail,\"Within \"+budget]}",
    "visible": "${= step==3}"
   }
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Start over",
    "message": "Answer the questions again to compare other options.",
    "tone": "neutral",
    "icon": "refresh"
   },
   "bind": {
    "visible": "${= step==3}"
   }
  },
  "ActionButton6": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start over",
    "tone": "quiet",
    "icon": "refresh"
   },
   "bind": {
    "visible": "${= step==3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "use",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "detail",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "budget",
       "value": ""
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "use",
    "type": "text",
    "value": ""
   },
   {
    "name": "step",
    "type": "integer",
    "value": 0
   },
   {
    "name": "detail",
    "type": "text",
    "value": ""
   },
   {
    "name": "budget",
    "type": "text",
    "value": ""
   }
  ]
 }
}