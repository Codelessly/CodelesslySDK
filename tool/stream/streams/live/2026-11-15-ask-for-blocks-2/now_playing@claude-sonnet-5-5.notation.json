{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= playing}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= elapsed<length_s?elapsed+1:0}"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "ChatCard1"
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Now playing",
    "subtitle": "Midnight Drive · Neon Atlas",
    "icon": "music_note",
    "tone": "accent"
   },
   "bind": {
    "props.status": "${= playing ? 'Playing' : 'Paused'}"
   },
   "children": [
    "Media1",
    "row1",
    "ProgressLine1",
    "row2",
    "SectionLabel1",
    "listView1"
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "height": 180,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "kind": "skyline",
    "tone": "night"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "column2",
    "iconButton1"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 19,
     "fontWeight": 700,
     "fontFamily": "Inter Display",
     "letterSpacing": -0.3,
     "height": 1.2,
     "color": "#FF111827"
    },
    "text": "${= tracks[current].title}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= tracks[current].artist}"
   }
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.icon": "${= liked ? 'favorite' : 'favorite_border'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "liked",
       "value": "${= !liked}"
      }
     ]
    }
   ]
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= fixed(floor(elapsed/60),0)}:${= elapsed%60<10?'0':''}${= elapsed%60}",
    "props.detail": "-${= floor((length_s-elapsed)/60)}:${= (length_s-elapsed)%60<10?'0':''}${= (length_s-elapsed)%60}",
    "props.value": "${= elapsed/length_s}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "spacing": 16
   },
   "children": [
    "iconButton2",
    "iconButton3",
    "iconButton4"
   ]
  },
  "iconButton2": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_previous"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "current",
       "value": "${= (current+2)%3}"
      },
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "iconButton3": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "size": 48
   },
   "bind": {
    "props.icon": "${= playing ? 'pause_circle' : 'play_circle'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "playing",
       "value": "${= !playing}"
      }
     ]
    }
   ]
  },
  "iconButton4": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "skip_next"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "current",
       "value": "${= (current+1)%3}"
      },
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Up next",
    "note": "3 tracks"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${queue}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "listTile1"
   ]
  },
  "listTile1": {
   "type": "listTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "play",
       "value": "${item.id}"
      }
     ]
    }
   ],
   "slots": {
    "title": "text3",
    "trailing": "text4"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${item.title}",
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    }
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "${item.artist} · ${item.time}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "liked",
    "type": "boolean",
    "value": false
   },
   {
    "name": "current",
    "type": "integer",
    "value": 0
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 84
   },
   {
    "name": "playing",
    "type": "boolean",
    "value": true
   },
   {
    "name": "length_s",
    "type": "integer",
    "value": 214
   },
   {
    "name": "tracks",
    "type": "list",
    "value": [
     {
      "title": "Midnight Drive",
      "artist": "Neon Atlas"
     },
     {
      "title": "Glass Rivers",
      "artist": "Hollow Pines"
     },
     {
      "title": "Afterglow",
      "artist": "Lune"
     }
    ]
   },
   {
    "name": "queue",
    "type": "list",
    "value": [
     {
      "id": 1,
      "title": "Glass Rivers",
      "artist": "Hollow Pines",
      "time": "3:42"
     },
     {
      "id": 2,
      "title": "Afterglow",
      "artist": "Lune",
      "time": "4:05"
     },
     {
      "id": 3,
      "title": "Paper Satellites",
      "artist": "Neon Atlas",
      "time": "2:58"
     }
    ]
   }
  ]
 }
}