{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Team lunch",
    "subtitle": "Friday",
    "icon": "restaurant",
    "status": "Poll open"
   },
   "children": [
    "Paragraph1",
    "OptionList1",
    "listView1",
    "text3"
   ]
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Where should we go for lunch on Friday?"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "myVote",
    "options": [
     "Pizza",
     "Sushi",
     "Tacos",
     "Salad bar"
    ]
   },
   "bind": {
    "visible": "${= myVote==\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "votes",
       "value": "${= with(votes,result,votes[result]+1)}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= [\"Pizza\",\"Sushi\",\"Tacos\",\"Salad bar\"]}",
    "visible": "${= myVote!=\"\"}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "ProgressLine1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item}${= item==myVote?' (your vote)':''}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= round(votes[item]*100/max((sum([\"Pizza\",\"Sushi\",\"Tacos\",\"Salad bar\"],k=>votes[k])),1),0)}%"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": ""
   },
   "bind": {
    "props.value": "${= votes[item]/max((sum([\"Pizza\",\"Sushi\",\"Tacos\",\"Salad bar\"],k=>votes[k])),1)}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= (sum([\"Pizza\",\"Sushi\",\"Tacos\",\"Salad bar\"],k=>votes[k]))} votes in total"
   },
   "bind": {
    "visible": "${= myVote!=\"\"}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "votes",
    "type": "map",
    "value": {
     "Pizza": 0,
     "Sushi": 0,
     "Tacos": 0,
     "Salad bar": 0
    }
   },
   {
    "name": "myVote",
    "type": "text",
    "value": ""
   }
  ]
 }
}