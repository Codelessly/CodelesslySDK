{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Schedule a 30-minute meeting",
    "subtitle": "Next week",
    "icon": "event",
    "status": "Pick a day",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "DayPicker1",
    "SectionLabel2",
    "ChoiceChips1",
    "SectionLabel3",
    "Details1",
    "TotalBar1",
    "Receipt1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Day",
    "note": "Next week"
   }
  },
  "DayPicker1": {
   "type": "DayPicker",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "day",
    "days": [
     "Mon 14",
     "Tue 15",
     "Wed 16",
     "Thu 17",
     "Fri 18"
    ]
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Time",
    "note": "30 minutes"
   },
   "bind": {
    "visible": "${= day!=\"\"}"
   }
  },
  "ChoiceChips1": {
   "type": "ChoiceChips",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "time",
    "options": [
     "9:00",
     "9:30",
     "10:00",
     "10:30",
     "11:00",
     "11:30",
     "14:00",
     "14:30",
     "15:00",
     "15:30"
    ],
    "disabled": [
     "10:00",
     "14:30"
    ],
    "columns": 4
   },
   "bind": {
    "visible": "${= day!=\"\"}"
   }
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Attendees",
    "note": "3 colleagues"
   },
   "bind": {
    "visible": "${= (day!=\"\") && (time!=\"\")}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "rows": [
     [
      "Priya Shah",
      "Required"
     ],
     [
      "Marco Lentz",
      "Required"
     ],
     [
      "Jun Okafor",
      "Optional"
     ]
    ]
   },
   "bind": {
    "visible": "${= (day!=\"\") && (time!=\"\")}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Meeting",
    "cta": "Confirm",
    "icon": "check"
   },
   "bind": {
    "props.note": "${day} at ${time}, 30 minutes",
    "props.amount": "${time}",
    "props.enabled": "${= time!=\"\"}",
    "visible": "${= (day!=\"\") && (time!=\"\")}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "booked",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Meeting booked",
    "tone": "good",
    "icon": "check_circle"
   },
   "bind": {
    "props.message": "${day} at ${time}. Invites are on their way to everyone.",
    "visible": "${= booked}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "day",
    "type": "text",
    "value": ""
   },
   {
    "name": "time",
    "type": "text",
    "value": ""
   },
   {
    "name": "booked",
    "type": "boolean",
    "value": false
   }
  ]
 }
}