{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Expense report",
    "subtitle": "Four expenses awaiting approval",
    "icon": "receipt_long",
    "status": "Pending",
    "tone": "accent"
   },
   "children": [
    "listView1",
    "Details1",
    "ActionButton1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${expenses}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "column1",
    "column2"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2",
    "Callout1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item.merchant}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${item.category} · ${item.date}"
   }
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Missing receipt",
    "message": "Attach a receipt before approving.",
    "tone": "warn",
    "icon": "warning_amber_rounded"
   },
   "bind": {
    "visible": "${= item.receipt==false}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "end"
   },
   "children": [
    "text3",
    "row2"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= money(item.amount,\"$\",2)}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "center"
   },
   "children": [
    "choiceChip1",
    "choiceChip2"
   ]
  },
  "choiceChip1": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Approve"
   },
   "bind": {
    "props.selected": "${= item.ok==true}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "expenses",
       "value": "${= updateWhere(expenses,x=>x.id==item.id,x=>with(x,\"ok\",true))}"
      }
     ]
    }
   ]
  },
  "choiceChip2": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Reject"
   },
   "bind": {
    "props.selected": "${= item.ok==false}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "expenses",
       "value": "${= updateWhere(expenses,x=>x.id==item.id,x=>with(x,\"ok\",false))}"
      }
     ]
    }
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Approved total\",money(sum(filter(expenses,x=>x.ok==true),x=>x.amount),\"$\",2)],[\"Pending items\",string(count(expenses,x=>x.ok==null))]]}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Submit report",
    "tone": "primary",
    "icon": "send_rounded"
   },
   "bind": {
    "props.enabled": "${= count(expenses,x=>x.ok==null)==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "submit"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "expenses",
    "type": "list",
    "value": [
     {
      "id": 1,
      "merchant": "Delta Airlines",
      "category": "Travel",
      "date": "Mar 3",
      "amount": 412.8,
      "receipt": true,
      "ok": true
     },
     {
      "id": 2,
      "merchant": "Marriott Hotel",
      "category": "Lodging",
      "date": "Mar 4",
      "amount": 268.5,
      "receipt": true,
      "ok": true
     },
     {
      "id": 3,
      "merchant": "Uber",
      "category": "Ground transport",
      "date": "Mar 4",
      "amount": 46.2,
      "receipt": false,
      "ok": true
     },
     {
      "id": 4,
      "merchant": "Client dinner",
      "category": "Meals",
      "date": "Mar 5",
      "amount": 128.4,
      "receipt": true,
      "ok": true
     }
    ]
   }
  ]
 }
}