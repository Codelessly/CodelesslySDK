{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text1",
    "badge1",
    "text2",
    "textField1",
    "textField2",
    "segmentedButton1",
    "textField3",
    "row1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF111827"
    },
    "text": "Email to landlord"
   }
  },
  "badge1": {
   "type": "badge",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "backgroundColor": "#FFDCFCE7",
    "textColor": "#FF15803D",
    "label": "Sent"
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "color": "#FF374151"
    },
    "text": "Your email to ${to} has been sent."
   },
   "bind": {
    "visible": "${= sent}"
   }
  },
  "textField1": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "To"
    }
   },
   "bind": {
    "props.initialValue": "${to}",
    "visible": "${= !sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "textField2": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Subject"
    }
   },
   "bind": {
    "props.initialValue": "${subject}",
    "visible": "${= !sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "subject",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "segmentedButton1": {
   "type": "segmentedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.selected": "${= tone items:[\"polite\",\"firm\"]}",
    "visible": "${= !sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${= tone==\"firm\"?\"Hello,\\n\\nThe heating in my flat has been broken for some time and still has not been repaired. I need this fixed urgently. Please confirm when a repair will take place.\\n\\nRegards,\":\"Hello,\\n\\nThe heating in my flat has stopped working. Could you arrange for it to be repaired as soon as possible?\\n\\nThank you,\"}"
      }
     ]
    }
   ]
  },
  "textField3": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "decoration": {
     "labelText": "Body"
    }
   },
   "bind": {
    "props.initialValue": "${body}",
    "visible": "${= !sent}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "body",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "end",
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= !sent}"
   },
   "children": [
    "textButton1",
    "filledButton1"
   ]
  },
  "textButton1": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Discard"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "to",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "subject",
       "value": ""
      },
      {
       "type": "setVariable",
       "variable": "body",
       "value": ""
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send"
   },
   "bind": {
    "props.enabled": "${= to!=\"\"&&subject!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= true}"
      },
      {
       "type": "componentEvent",
       "event": "send"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": "landlord@example.com"
   },
   {
    "name": "subject",
    "type": "text",
    "value": "Heating not working"
   },
   {
    "name": "tone",
    "type": "text",
    "value": "polite"
   },
   {
    "name": "sent",
    "type": "boolean",
    "value": false
   },
   {
    "name": "body",
    "type": "text",
    "value": "Hello,\n\nThe heating in my flat has stopped working. Could you arrange for it to be repaired as soon as possible?\n\nThank you,"
   }
  ]
 }
}