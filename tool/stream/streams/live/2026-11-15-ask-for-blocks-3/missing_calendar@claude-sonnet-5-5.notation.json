 "variables": {
  "screen": [
   {
    "name": "sel",
    "type": "integer",
    "value": 12
   },
   {
    "name": "booked",
    "type": "list",
    "value": [
     3,
     4,
     5,
     18,
     19,
     24
    ]
   },
   {
    "name": "events",
    "type": "list",
    "value": [
     2,
     12,
     17,
     26,
     30
    ]
   }
  ]
 }
