    "props.rows": "${= [[\"Selected\",(\"Nov \" + (sel) + \", 2026\")],[\"Status\",contains(booked,sel)?\"Booked\":\"Available\"],[\"Events\",contains(events,sel)?\"1 event\":\"None\"]]}"
