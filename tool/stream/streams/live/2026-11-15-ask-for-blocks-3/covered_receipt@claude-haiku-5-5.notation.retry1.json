    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Margherita pizza\",money(18,\"$\",2)],[\"Caesar salad\",money(9,\"$\",2)],[\"Sparkling water\",money(4,\"$\",2)],[\"Subtotal\",money(31,\"$\",2)],[\"Tax (8%)\",money(2.48,\"$\",2)]]}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
