{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Today's medications",
    "subtitle": "3 doses scheduled",
    "icon": "medication",
    "status": "1 of 3 taken",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "ProgressLine1",
    "listView1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Schedule"
   },
   "bind": {
    "props.note": "${= count(doses,d=>d.status==\"taken\")} taken · ${= count(doses,d=>d.status==\"missed\")} missed"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Doses taken"
   },
   "bind": {
    "props.detail": "${= count(doses,d=>d.status==\"taken\")} of ${= length(doses)}",
    "props.value": "${= count(doses,d=>d.status==\"taken\")/length(doses)}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${doses}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "column1"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 18
   },
   "children": [
    "row1",
    "row5",
    "Callout1",
    "ActionButton3"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "Media1",
    "column2",
    "row2",
    "row3",
    "row4"
   ]
  },
  "Media1": {
   "type": "Media",
   "layout": {
    "width": 56,
    "height": 56
   },
   "props": {
    "round": true
   },
   "bind": {
    "props.kind": "${item.kind}",
    "props.tone": "${item.tone}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2",
    "text3"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 10.5,
     "fontWeight": 700,
     "fontFamily": "Inter",
     "letterSpacing": 0.9,
     "height": 1.2,
     "color": "#FF6B7280"
    },
    "text": "${item.slot} · ${item.time}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "fontFamily": "Inter",
     "letterSpacing": -0.1,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${item.name}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "fontFamily": "Inter",
     "height": 1.35,
     "color": "#FF6B7280"
    },
    "text": "${item.how}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 20,
    "padding": [
     8,
     0,
     8,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#1A16A34A"
     }
    ],
    "strokes": [
     {
      "color": "#4716A34A"
     }
    ],
    "radius": 5
   },
   "bind": {
    "visible": "${= item.status==\"taken\"}"
   },
   "children": [
    "text4"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Taken",
    "style": {
     "fontSize": 11,
     "fontWeight": 500,
     "color": "#FF16A34A"
    }
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 20,
    "padding": [
     8,
     0,
     8,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#1ADC2626"
     }
    ],
    "strokes": [
     {
      "color": "#47DC2626"
     }
    ],
    "radius": 5
   },
   "bind": {
    "visible": "${= item.status==\"missed\"}"
   },
   "children": [
    "text5"
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Missed",
    "style": {
     "fontSize": 11,
     "fontWeight": 500,
     "color": "#FFDC2626"
    }
   }
  },
  "row4": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 20,
    "padding": [
     8,
     0,
     8,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#1AEA580C"
     }
    ],
    "strokes": [
     {
      "color": "#47EA580C"
     }
    ],
    "radius": 5
   },
   "bind": {
    "visible": "${= item.status==\"pending\"}"
   },
   "children": [
    "text6"
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Due",
    "style": {
     "fontSize": 11,
     "fontWeight": 500,
     "color": "#FFEA580C"
    }
   }
  },
  "row5": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= item.status==\"pending\"}"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Mark taken",
    "tone": "good",
    "icon": "check"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "doses",
       "value": "${= updateWhere(doses,x=>x.id==item.id,x=>with(x,\"status\",\"taken\"))}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Skip",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "doses",
       "value": "${= updateWhere(doses,x=>x.id==item.id,x=>with(x,\"status\",\"missed\"))}"
      }
     ]
    }
   ]
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Dose missed",
    "message": "Take it now if it is under 4 hours late, otherwise skip it.",
    "tone": "warn"
   },
   "bind": {
    "visible": "${= item.status==\"missed\"}"
   }
  },
  "ActionButton3": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Take now",
    "tone": "primary"
   },
   "bind": {
    "visible": "${= item.status==\"missed\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "doses",
       "value": "${= updateWhere(doses,x=>x.id==item.id,x=>with(x,\"status\",\"taken\"))}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "doses",
    "type": "list",
    "value": [
     {
      "id": 1,
      "slot": "Morning",
      "time": "8:00 AM",
      "name": "Metformin 500 mg",
      "how": "1 tablet with breakfast",
      "kind": "box",
      "tone": "sky",
      "status": "taken"
     },
     {
      "id": 2,
      "slot": "Afternoon",
      "time": "1:00 PM",
      "name": "Lisinopril 10 mg",
      "how": "1 tablet with water, before lunch",
      "kind": "box",
      "tone": "rose",
      "status": "missed"
     },
     {
      "id": 3,
      "slot": "Evening",
      "time": "8:00 PM",
      "name": "Atorvastatin 20 mg",
      "how": "1 tablet after dinner",
      "kind": "box",
      "tone": "mint",
      "status": "pending"
     }
    ]
   }
  ]
 }
}