{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "New email",
    "subtitle": "To Mr Alvarez",
    "icon": "mail",
    "status": "Draft"
   },
   "children": [
    "SectionLabel1",
    "InputField1",
    "InputField2",
    "SectionLabel2",
    "Segments1",
    "SectionLabel3",
    "InputField3",
    "row1",
    "Receipt1",
    "Details1",
    "Paragraph1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Recipient"
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "To",
    "placeholder": "landlord@example.com",
    "value": "to"
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "InputField2": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Subject",
    "placeholder": "Subject",
    "value": "subject"
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Tone"
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "Segments1": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "tone",
    "options": [
     "Polite",
     "Firm"
    ]
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Message"
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "InputField3": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Body",
    "placeholder": "",
    "lines": 8
   },
   "bind": {
    "visible": "${= sent == false}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= sent == false}"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Discard",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "discard"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Send",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= to != \"\" && subject != \"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sent",
       "value": "${= true}"
      },
      {
       "type": "showToast",
       "message": "Email sent"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Email sent",
    "code": "",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.message": "Sent to ${sentTo}",
    "visible": "${= sent}"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Sent to\",sentTo],[\"Subject\",subject]]}",
    "visible": "${= sent}"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.text": "${= (\"Dear Mr. Alvarez,\\n\\nThe heating in apartment 4B has stopped working. \" + (tone == \"Firm\" ? \"Please confirm by Thursday when a repair will be carried out.\" : \"Could you please arrange for someone to take a look this week?\") + \"\\n\\nThank you,\\nAlex\")}",
    "visible": "${= sent}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "to",
    "type": "text",
    "value": "landlord@example.com"
   },
   {
    "name": "subject",
    "type": "text",
    "value": "Heating not working in apartment 4B"
   },
   {
    "name": "tone",
    "type": "text",
    "value": "Polite"
   },
   {
    "name": "sent",
    "type": "boolean",
    "value": false
   },
   {
    "name": "body",
    "type": "text",
    "value": "Dear Mr. Alvarez,\n\nThe heating in apartment 4B has stopped working. Could you please arrange for someone to take a look this week?\n\nThank you,\nAlex"
   },
   {
    "name": "draftKey",
    "type": "integer",
    "value": 0
   },
   {
    "name": "sentTo",
    "type": "text",
    "value": "landlord@example.com"
   }
  ]
 }
}