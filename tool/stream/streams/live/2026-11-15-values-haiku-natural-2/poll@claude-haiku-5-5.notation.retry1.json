{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Team lunch poll",
    "subtitle": "Friday",
    "icon": "how_to_vote",
    "status": "Open"
   },
   "children": [
    "Paragraph1",
    "OptionList1",
    "TotalBar1",
    "listView1",
    "text3"
   ]
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Where should we go for lunch on Friday?"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "pick",
    "options": [
     "Pho Saigon",
     "Taqueria Luz",
     "Green Bowl",
     "Napoli Pizza"
    ]
   },
   "bind": {
    "visible": "${= pick==\"\"}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Votes cast",
    "note": "Tap an option to vote",
    "cta": "Vote"
   },
   "bind": {
    "props.amount": "${= (length(votes))} votes",
    "props.enabled": "${= pick!=\"\"}",
    "visible": "${= pick==\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "votes",
       "value": "${= append(votes,pick)}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= [\"Pho Saigon\",\"Taqueria Luz\",\"Green Bowl\",\"Napoli Pizza\"]}",
    "visible": "${= pick!=\"\"}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "progressBar1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "fontFamily": "Inter",
     "letterSpacing": -0.1,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${item}${= item==pick ? ' (your vote)' : ''}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= round(100*count(votes,v=>v==item)/(length(votes)),0)}%"
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "max": 1,
    "borderRadius": 2,
    "color": "#FF2563EB",
    "backgroundColor": "#FFE5E7EB"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= (length(votes))} votes in total"
   },
   "bind": {
    "visible": "${= pick!=\"\"}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "pick",
    "type": "text",
    "value": ""
   },
   {
    "name": "votes",
    "type": "list",
    "value": [
     "Pho Saigon",
     "Pho Saigon",
     "Pho Saigon",
     "Pho Saigon",
     "Pho Saigon",
     "Taqueria Luz",
     "Taqueria Luz",
     "Taqueria Luz",
     "Taqueria Luz",
     "Taqueria Luz",
     "Taqueria Luz",
     "Taqueria Luz",
     "Taqueria Luz",
     "Green Bowl",
     "Green Bowl",
     "Green Bowl",
     "Napoli Pizza",
     "Napoli Pizza",
     "Napoli Pizza",
     "Napoli Pizza",
     "Napoli Pizza",
     "Napoli Pizza"
    ]
   }
  ]
 }
}