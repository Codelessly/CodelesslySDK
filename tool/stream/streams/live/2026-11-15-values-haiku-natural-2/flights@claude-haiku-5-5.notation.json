{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Flights to Lisbon",
    "subtitle": "Friday 20 Nov · 2 adults",
    "icon": "flight",
    "status": "3 direct",
    "tone": "accent"
   },
   "children": [
    "SectionLabel1",
    "FlightOption1",
    "FlightOption2",
    "FlightOption3",
    "Details1",
    "TotalBar1"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Choose a flight",
    "note": "per person"
   }
  },
  "FlightOption1": {
   "type": "FlightOption",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "name": "TAP Air Portugal",
    "depart": "07:15",
    "arrive": "09:50",
    "origin": "LON",
    "destination": "LIS",
    "duration": "2h 35m",
    "stops": "Direct",
    "price": "£128",
    "tag": "Best time"
   },
   "bind": {
    "props.selected": "${= pick==1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pick",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "FlightOption2": {
   "type": "FlightOption",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "name": "easyJet",
    "depart": "11:40",
    "arrive": "14:20",
    "origin": "LON",
    "destination": "LIS",
    "duration": "2h 40m",
    "stops": "Direct",
    "price": "£84",
    "tag": "Cheapest"
   },
   "bind": {
    "props.selected": "${= pick==2}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pick",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "FlightOption3": {
   "type": "FlightOption",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "name": "British Airways",
    "depart": "18:05",
    "arrive": "20:40",
    "origin": "LON",
    "destination": "LIS",
    "duration": "2h 35m",
    "stops": "Direct",
    "price": "£156"
   },
   "bind": {
    "props.selected": "${= pick==3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "pick",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "": ""
   },
   "bind": {
    "props.rows": "${= [[\"Price per person\",}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Total for 2 adults",
    "note": "Friday 20 Nov",
    "cta": "Confirm"
   },
   "bind": {
    "props.amount": "${= pick==1 ? \"£256\" : pick==2 ? \"£168\" : \"£312\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "confirm",
       "value": "${pick}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "pick",
    "type": "integer",
    "value": 1
   }
  ]
 }
}