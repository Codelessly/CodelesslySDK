{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": 390,
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Expense report",
    "subtitle": "4 expenses awaiting approval",
    "icon": "receipt_long",
    "status": "Pending"
   },
   "children": [
    "listView1",
    "text4",
    "TotalBar1",
    "Receipt1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${rows}",
    "visible": "${= !submitted}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "column1"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "Callout1",
    "row2"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "column2",
    "text3"
   ]
  },
  "column2": {
   "type": "column",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text1",
    "text2"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${item.merchant}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${item.category} · ${item.date}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= money(item.amount,\"$\",2)}"
   }
  },
  "Callout1": {
   "type": "Callout",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "No receipt attached",
    "message": "Attach a receipt before approving this expense.",
    "tone": "warn",
    "icon": "warning_amber"
   },
   "bind": {
    "visible": "${= !item.receipt}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "choiceChip1",
    "choiceChip2"
   ]
  },
  "choiceChip1": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Approve"
   },
   "bind": {
    "props.selected": "${= item.status == \"approved\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "rows",
       "value": "${= updateWhere(rows, x => x.id == item.id, x => with(x, \"status\", \"approved\"))}"
      }
     ]
    }
   ]
  },
  "choiceChip2": {
   "type": "choiceChip",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Reject"
   },
   "bind": {
    "props.selected": "${= item.status == \"rejected\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "rows",
       "value": "${= updateWhere(rows, x => x.id == item.id, x => with(x, \"status\", \"rejected\"))}"
      }
     ]
    }
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${= (length((filter(rows, r => r.status == \"approved\"))))} of 4 approved"
   },
   "bind": {
    "visible": "${= !submitted}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Approved total",
    "note": "Excludes rejected expenses",
    "cta": "Submit"
   },
   "bind": {
    "props.amount": "${= money((sum((filter(rows, r => r.status == \"approved\")), r => r.amount)),\"$\",2)}",
    "props.enabled": "${= (length((filter(rows, r => r.status == \"approved\")))) > 0}",
    "visible": "${= !submitted}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "submitted",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Submitted",
    "tone": "good",
    "icon": "check_circle"
   },
   "bind": {
    "props.message": "${= (length((filter(rows, r => r.status == \"approved\"))))} approved expenses totalling ${= money((sum((filter(rows, r => r.status == \"approved\")), r => r.amount)),\"$\",2)} were sent for payment.",
    "visible": "${= submitted}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "rows",
    "type": "list",
    "value": [
     {
      "id": 1,
      "merchant": "Delta Air Lines",
      "category": "Travel",
      "date": "Nov 3",
      "amount": 412.6,
      "receipt": true,
      "status": "pending"
     },
     {
      "id": 2,
      "merchant": "Blue Bottle Coffee",
      "category": "Meals",
      "date": "Nov 4",
      "amount": 18.4,
      "receipt": true,
      "status": "pending"
     },
     {
      "id": 3,
      "merchant": "Uber",
      "category": "Transport",
      "date": "Nov 5",
      "amount": 36.25,
      "receipt": false,
      "status": "pending"
     },
     {
      "id": 4,
      "merchant": "WeWork day pass",
      "category": "Office",
      "date": "Nov 6",
      "amount": 45.0,
      "receipt": true,
      "status": "pending"
     }
    ]
   },
   {
    "name": "submitted",
    "type": "boolean",
    "value": false
   }
  ]
 }
}