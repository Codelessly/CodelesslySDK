{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= running}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= elapsed + (1)}"
      },
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= min(total, done + 0)}"
      }
     ]
    },
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 2000,
      "when": "${= running}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= min(total, done + 1)}"
      },
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= done + 1 < total}"
      }
     ]
    }
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Blog migration",
    "subtitle": "Six steps, about 12 seconds",
    "icon": "swap_horiz",
    "status": "Ready"
   },
   "children": [
    "PlanStep1",
    "PlanStep2",
    "PlanStep3",
    "PlanStep4",
    "PlanStep5",
    "PlanStep6",
    "ProgressLine1",
    "ActionButton1",
    "ActionButton2",
    "Receipt1"
   ]
  },
  "PlanStep1": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Back up your content",
    "detail": "Export posts, pages and comments to a safe copy.",
    "index": 0
   },
   "bind": {
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "PlanStep2": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Set up the new host",
    "detail": "Create the new site and install the blog software.",
    "index": 1
   },
   "bind": {
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "PlanStep3": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Import posts",
    "detail": "Bring every post across with its dates and tags.",
    "index": 2
   },
   "bind": {
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "PlanStep4": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Move media",
    "detail": "Copy images and files to the new storage.",
    "index": 3
   },
   "bind": {
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "PlanStep5": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Redirect old URLs",
    "detail": "Point every old address at its new page.",
    "index": 4
   },
   "bind": {
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "PlanStep6": {
   "type": "PlanStep",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Final checks",
    "detail": "Test links, forms and search, then go live.",
    "index": 5
   },
   "bind": {
    "props.current": "${done}",
    "props.running": "${running}"
   }
  },
  "ProgressLine1": {
   "type": "ProgressLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${done} of 6 steps",
    "props.detail": "${elapsed} s elapsed",
    "props.value": "${= done/total}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Start",
    "tone": "primary",
    "icon": "play_arrow",
    "enabled": true
   },
   "bind": {
    "visible": "${= done == 0 && !running}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= true}"
      },
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= false}"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Pause",
    "tone": "quiet",
    "icon": "pause"
   },
   "bind": {
    "visible": "${= running}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "running",
       "value": "${= false}"
      },
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Migration complete",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.message": "Total time: ${elapsed} seconds.",
    "visible": "${= done == total}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "running",
    "type": "boolean",
    "value": false
   },
   {
    "name": "done",
    "type": "integer",
    "value": 0
   },
   {
    "name": "paused",
    "type": "boolean",
    "value": false
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "total",
    "type": "integer",
    "value": 6
   }
  ]
 }
}