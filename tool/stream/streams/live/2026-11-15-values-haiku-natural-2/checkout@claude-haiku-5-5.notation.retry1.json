{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Checkout",
    "icon": "shopping_bag",
    "status": "Secure",
    "tone": "accent"
   },
   "bind": {
    "props.subtitle": "Step ${step} of 3"
   },
   "children": [
    "SectionLabel1",
    "listView1",
    "Details1",
    "ActionButton1",
    "SectionLabel2",
    "InputField1",
    "InputField2",
    "InputField3",
    "InputField4",
    "InputField5",
    "row1",
    "SectionLabel3",
    "OptionList1",
    "Details2",
    "TotalBar1",
    "row2",
    "Receipt1",
    "Details3"
   ]
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Your cart"
   },
   "bind": {
    "visible": "${= step == 1}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${cart}",
    "visible": "${= step == 1}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "CartLine1"
   ]
  },
  "CartLine1": {
   "type": "CartLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.title": "${item.qty} × $${item.price}",
    "props.price": "${item.price}",
    "props.qty": "${item.qty}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "cart",
       "value": "${= updateWhere(cart, x => x.id == item.id, x => with(x, \"qty\", result))}"
      }
     ]
    }
   ]
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Subtotal\",}",
    "visible": "${= step == 1}"
   }
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Continue to shipping",
    "tone": "primary"
   },
   "bind": {
    "visible": "${= step == 1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Shipping address"
   },
   "bind": {
    "visible": "${= step == 2}"
   }
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Full name",
    "placeholder": "Jane Doe",
    "value": "name"
   },
   "bind": {
    "props.error": "${= (trim(name)==\"\" ? \"Name is required\" : \"\")}",
    "visible": "${= step == 2}"
   }
  },
  "InputField2": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Address",
    "placeholder": "12 Market Street",
    "value": "address"
   },
   "bind": {
    "props.error": "${= (trim(address)==\"\" ? \"Address is required\" : \"\")}",
    "visible": "${= step == 2}"
   }
  },
  "InputField3": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "City",
    "placeholder": "Bristol",
    "value": "city"
   },
   "bind": {
    "props.error": "${= (trim(city)==\"\" ? \"City is required\" : \"\")}",
    "visible": "${= step == 2}"
   }
  },
  "InputField4": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Postcode",
    "placeholder": "BS1 4DJ",
    "value": "postcode"
   },
   "bind": {
    "props.error": "${= (trim(postcode)==\"\" ? \"Postcode is required\" : \"\")}",
    "visible": "${= step == 2}"
   }
  },
  "InputField5": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Email",
    "placeholder": "you@example.com",
    "value": "email"
   },
   "bind": {
    "props.keyboard": "${email}",
    "props.error": "${= (trim(email)==\"\" ? \"Email is required\" : (contains(email, \"@\") ? \"\" : \"Enter a valid email\"))}",
    "visible": "${= step == 2}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step == 2}"
   },
   "children": [
    "ActionButton2",
    "ActionButton3"
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "ActionButton3": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Continue to payment",
    "tone": "primary"
   },
   "bind": {
    "props.enabled": "${= (trim(name) != \"\" && (trim(address) != \"\" && trim(city) != \"\" && trim(postcode) != \"\") && (trim(email) != \"\" && contains(email, \"@\")))}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 3}"
      }
     ]
    }
   ]
  },
  "SectionLabel3": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Delivery"
   },
   "bind": {
    "visible": "${= step == 3}"
   }
  },
  "OptionList1": {
   "type": "OptionList",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "How should we deliver?",
    "value": "delivery",
    "options": [
     "standard",
     "express"
    ],
    "details": [
     "3 to 5 working days",
     "Next working day"
    ],
    "prices": [
     "$4",
     "$12"
    ]
   },
   "bind": {
    "visible": "${= step == 3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "delivery",
       "value": "${= result}"
      }
     ]
    }
   ]
  },
  "Details2": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "": ""
   },
   "bind": {
    "props.rows": "${= [[\"Subtotal\",}",
    "visible": "${= step == 3}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Total",
    "cta": "Place order",
    "icon": "lock"
   },
   "bind": {
    "props.note": "Ships to ${name}",
    "props.amount": "${= money(((sum(cart, i => i.qty * i.price)) + (delivery == \"express\" ? 12 : 4)), \"$\", 2)}",
    "visible": "${= step == 3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "placed",
       "value": "${= true}"
      },
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 4}"
      }
     ]
    }
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= step == 3}"
   },
   "children": [
    "ActionButton4"
   ]
  },
  "ActionButton4": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Back",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "step",
       "value": "${= 2}"
      }
     ]
    }
   ]
  },
  "Receipt1": {
   "type": "Receipt",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Order placed",
    "codeLabel": "Order number",
    "tone": "good",
    "icon": "check"
   },
   "bind": {
    "props.message": "Thanks ${name}, a confirmation is on its way to ${email}.",
    "props.code": "${= (\"ORD-\" + fixed(length(cart) * 1371 + 40213, 0))}",
    "visible": "${= step == 4}"
   }
  },
  "Details3": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Name\",}",
    "visible": "${= step == 4}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "step",
    "type": "integer",
    "value": 1
   },
   {
    "name": "cart",
    "type": "list",
    "value": [
     {
      "id": 1,
      "name": "Espresso beans",
      "price": 24,
      "qty": 1
     },
     {
      "id": 2,
      "name": "Ceramic mug",
      "price": 12,
      "qty": 2
     },
     {
      "id": 3,
      "name": "Canvas tote",
      "price": 18,
      "qty": 1
     }
    ]
   },
   {
    "name": "name",
    "type": "text",
    "value": ""
   },
   {
    "name": "address",
    "type": "text",
    "value": ""
   },
   {
    "name": "city",
    "type": "text",
    "value": ""
   },
   {
    "name": "postcode",
    "type": "text",
    "value": ""
   },
   {
    "name": "email",
    "type": "text",
    "value": ""
   },
   {
    "name": "delivery",
    "type": "text",
    "value": "standard"
   },
   {
    "name": "placed",
    "type": "boolean",
    "value": false
   }
  ]
 }
}