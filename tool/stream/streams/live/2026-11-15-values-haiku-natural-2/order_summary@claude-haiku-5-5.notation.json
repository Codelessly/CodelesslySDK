{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Your grocery order",
    "subtitle": "Review before placing",
    "icon": "shopping_basket",
    "status": "Draft"
   },
   "children": [
    "text1",
    "listView1",
    "InputField1",
    "Details1",
    "row1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF111827"
    },
    "text": "${= length(lines)} items"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${lines}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "CartLine1"
   ]
  },
  "CartLine1": {
   "type": "CartLine",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "detail": "Picture placeholder",
    "kind": "box"
   },
   "bind": {
    "props.title": "${item.name}",
    "props.price": "${= money(item.price,\"$\",2)}",
    "props.qty": "${item.qty}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "lines",
       "value": "${= updateWhere(lines, x=>x.name==item.name, x=>with(x,\"qty\",result))}"
      }
     ]
    }
   ]
  },
  "InputField1": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Promo code",
    "placeholder": "Enter code",
    "value": "promo"
   }
  },
  "Details1": {
   "type": "Details",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.rows": "${= [[\"Subtotal\",}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "children": [
    "ActionButton1",
    "ActionButton2"
   ]
  },
  "ActionButton1": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Cancel",
    "tone": "quiet"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "cancel"
      },
      {
       "type": "showToast",
       "message": "Order cancelled"
      }
     ]
    }
   ]
  },
  "ActionButton2": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "props": {
    "label": "Confirm",
    "tone": "primary"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "confirm"
      },
      {
       "type": "showToast",
       "message": "Order placed"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "lines",
    "type": "list",
    "value": [
     {
      "name": "Bananas 1 kg",
      "price": 2.5,
      "qty": 1
     },
     {
      "name": "Whole milk 2 L",
      "price": 3.2,
      "qty": 2
     },
     {
      "name": "Sourdough loaf",
      "price": 4.5,
      "qty": 1
     },
     {
      "name": "Free-range eggs",
      "price": 5.0,
      "qty": 1
     },
     {
      "name": "Cheddar",
      "price": 7.0,
      "qty": 1
     }
    ]
   },
   {
    "name": "promo",
    "type": "text",
    "value": ""
   }
  ]
 }
}