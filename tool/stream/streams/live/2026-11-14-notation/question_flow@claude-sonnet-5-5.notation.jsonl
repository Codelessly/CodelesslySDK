{"meta":{"ui":"question_flow","model":"claude-sonnet-5-5","form":"notation","turn":"generate","prompt":"Help me pick a laptop with a short question flow, one question at a time: what I use it for, then a second question that depends on that answer, then budget. Show progress, let me go back, and end on one recommendation with the reasons and a start over button.","text":"state step=1\nstate use=\"\"\nstate detail=\"\"\nstate budget=500\n\nCard w:390 gap:16\n  Row between middle\n    Text.muted \"Step {min(step,3)} of 3\"\n    Text.caption \"Laptop picker\"\n  Progress value:=min(step,4)/4\n  if step==1\n    Text.title \"What will you use it for?\"\n    Column gap:8\n      ChoiceChip \"School or study\" -> use=\"study\"; detail=\"\"\n      ChoiceChip \"Work and office\" -> use=\"work\"; detail=\"\"\n      ChoiceChip \"Gaming\" -> use=\"gaming\"; detail=\"\"\n      ChoiceChip \"Creative projects\" -> use=\"creative\"; detail=\"\"\n    Button \"Next\" visible:=use!=\"\" -> step=2\n  if step==2\n    if use==\"study\"\n      Text.title \"What matters most for school?\"\n      Column gap:8\n        ChoiceChip \"Battery life\" -> detail=\"battery\"\n        ChoiceChip \"Light to carry\" -> detail=\"light\"\n        ChoiceChip \"Lowest price\" -> detail=\"cheap\"\n    if use==\"work\"\n      Text.title \"How do you work?\"\n      Column gap:8\n        ChoiceChip \"Mostly at a desk\" -> detail=\"desk\"\n        ChoiceChip \"Travel a lot\" -> detail=\"travel\"\n        ChoiceChip \"Video calls all day\" -> detail=\"calls\"\n    if use==\"gaming\"\n      Text.title \"What kind of games?\"\n      Column gap:8\n        ChoiceChip \"Esports and indie\" -> detail=\"casual\"\n        ChoiceChip \"Latest AAA titles\" -> detail=\"aaa\"\n        ChoiceChip \"Play on the go\" -> detail=\"portable\"\n    if use==\"creative\"\n      Text.title \"What do you create?\"\n      Column gap:8\n        ChoiceChip \"Photo editing\" -> detail=\"photo\"\n        ChoiceChip \"Video editing\" -> detail=\"video\"\n        ChoiceChip \"Music or design\" -> detail=\"design\"\n    Row gap:8\n      Button.outline \"Back\" -> step=1\n      Spacer grow\n      Button \"Next\" visible:=detail!=\"\" -> step=3\n  if step==3\n    Text.title \"What is your budget?\"\n    Text.heading \"\\${budget}\"\n    Slider =budget min:400 max:3000\n    Row gap:8\n      Button.outline \"Back\" -> step=2\n      Spacer grow\n      Button \"See my match\" -> step=4\n  if step==4\n    Text.title \"Your match\"\n    Card gap:8\n      if use==\"study\"\n        Text.heading \"Slim 14-inch Ultrabook\"\n        Text.body \"Long battery, light body and plenty of speed for notes, research and video lessons.\"\n      if use==\"work\"\n        Text.heading \"Business 15-inch Laptop\"\n        Text.body \"Reliable keyboard, good webcam and ports, built for long workdays and meetings.\"\n      if use==\"gaming\"\n        Text.heading \"Gaming Laptop with dedicated GPU\"\n        Text.body \"A strong graphics card and high refresh screen for smooth play.\"\n      if use==\"creative\"\n        Text.heading \"Creator 16-inch Laptop\"\n        Text.body \"Color-accurate display, fast processor and extra memory for editing.\"\n      Divider\n      Text.strong \"Why it fits\"\n      Text.small \"• Made for {use}, focused on {detail}\"\n      Text.small \"• Fits your budget of \\${budget}\"\n      if budget<800\n        Text.small \"• Entry-level pricing, so expect a solid but simple spec\"\n      if budget>=800\n        Text.small \"• Room in your budget for a better screen and more storage\"\n    Row gap:8\n      Button.outline \"Back\" -> step=3\n      Spacer grow\n      Button \"Start over\" -> step=1; use=\"\"; detail=\"\"; budget=500","usage":{"input_tokens":1526,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":1284,"service_tier":"standard","inference_geo":"global","speed":"standard","output_tok