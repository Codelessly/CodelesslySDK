{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "Screen1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "Screen1": {
   "type": "Screen",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "children": [
    "TopBar1",
    "ChartCard1",
    "StatTrio1",
    "SectionTitle1",
    "text1",
    "EmptyState1",
    "listView1",
    "column1"
   ]
  },
  "TopBar1": {
   "type": "TopBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Your progress",
    "subtitle": "Short sessions add up. Nice work so far.",
    "back": true
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "ChartCard1": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 356.0
   },
   "props": {
    "title": "Jumps per week",
    "unit": "jumps",
    "deltaLabel": "vs last week"
   },
   "bind": {
    "props.values": "${= map(weeks,w=>w.jumps)}",
    "props.labels": "${= map(weeks,w=>w.label)}"
   }
  },
  "StatTrio1": {
   "type": "StatTrio",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.values": "${= [sessionsThisWeek,streak,weeklyGoal]}",
    "props.labels": "${= [\"Sessions this week\",\"Session streak\",\"Weekly goal\"]}",
    "props.icons": "${= [\"check_circle\",\"local_fire_department\",\"flag\"]}"
   }
  },
  "SectionTitle1": {
   "type": "SectionTitle",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Past sessions"
   }
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B815122E"
    },
    "text": "Best run is the most jumps in a row without a miss."
   }
  },
  "EmptyState1": {
   "type": "EmptyState",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "No sessions yet",
    "message": "Your first short session takes about 8 minutes.",
    "cta": "Start a session"
   },
   "bind": {
    "visible": "${= length(sessions)==0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "start_session"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${sessions}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "SessionRow1"
   ]
  },
  "SessionRow1": {
   "type": "SessionRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "unit": "jumps"
   },
   "bind": {
    "props.title": "${item.name}",
    "props.detail": "${item.date} · ${item.minutes} min · best run ${item.best}",
    "props.value": "${item.jumps}",
    "props.share": "${= item.best/210}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_session",
       "value": "${item.date}"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "children": [
    "text2",
    "text3",
    "filledButton1"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 17,
     "fontWeight": 700,
     "letterSpacing": -0.2,
     "height": 1.25,
     "color": "#FF15122E"
    },
    "text": "Ready for the next one?"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B815122E"
    },
    "text": "${today.name}: ${today.rounds} rounds. Jump for ${today.work} seconds (work), then rest for ${today.rest} seconds. About ${today.minutes} minutes in all."
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Start today's session"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "start_session"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   }
  ]
 }
}