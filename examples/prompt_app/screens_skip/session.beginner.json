{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "Screen1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= !paused && !done}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= left>1?left-1:(phase==\"work\"?today.rest:today.work)}"
      },
      {
       "type": "setVariable",
       "variable": "frac",
       "value": "${= left>1?(phase==\"work\"?(today.work-left+1)/today.work:(today.rest-left+1)/today.rest):0}"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= (left<=1&&phase==\"rest\"&&round<today.rounds)?round+1:round}"
      },
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "${= left<=1?(phase==\"work\"?\"rest\":\"work\"):phase}"
      }
     ]
    }
   ]
  },
  "Screen1": {
   "type": "Screen",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "children": [
    "TopBar1",
    "column1",
    "column2",
    "row2",
    "column3"
   ]
  },
  "TopBar1": {
   "type": "TopBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Today's session",
    "back": true
   },
   "bind": {
    "props.subtitle": "${today.name}: ${today.rounds} rounds, about ${today.minutes} minutes"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "children": [
    "text1",
    "text2",
    "text3",
    "progressBar1",
    "text4"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11.5,
     "fontWeight": 700,
     "letterSpacing": 1.3,
     "height": 1.2,
     "color": "#FF9793B0"
    },
    "text": "${= phase==\"work\" ? \"Jump\" : \"Rest\"}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 96,
     "fontWeight": 700,
     "letterSpacing": -0.9,
     "height": 1.02,
     "color": "#FF15122E"
    },
    "text": "${left}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B815122E"
    },
    "text": "${= phase==\"work\" ? \"Jump for \" + today.work + \" seconds, then rest.\" : \"Catch your breath. Next round starts soon.\"}"
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "max": 1,
    "borderRadius": 2,
    "color": "#FF5B3DF5",
    "backgroundColor": "#FFE8E5F7"
   },
   "bind": {
    "props.value": "${frac}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 15,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF15122E"
    },
    "text": "Round ${round} of ${today.rounds}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "children": [
    "text5",
    "text6",
    "row1"
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF15122E"
    },
    "text": "Jumps so far"
   }
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 56,
     "fontWeight": 900,
     "letterSpacing": -2,
     "height": 1.0,
     "color": "#FF15122E"
    },
    "text": "${count}"
   }
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "outlinedButton1",
    "filledButton1"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "-1"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= max(0,count-1)}"
      }
     ]
    }
   ]
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Tap for each jump"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= count+1}"
      }
     ]
    }
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "filledButton2",
    "filledButton3"
   ]
  },
  "filledButton2": {
   "type": "filledButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "tonal": true
   },
   "bind": {
    "props.label": "${= paused ? \"Resume\" : \"Pause\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= !paused}"
      }
     ]
    }
   ]
  },
  "filledButton3": {
   "type": "filledButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Finish"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "finish_session",
       "value": "${count}"
      }
     ]
    }
   ]
  },
  "column3": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "children": [
    "text7",
    "text8"
   ]
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 15,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF15122E"
    },
    "text": "How it works"
   }
  },
  "text8": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B815122E"
    },
    "text": "Work is when you jump. Rest is a short break. Each round is one of each. Stopping early is fine."
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
