{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "Screen1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= started && !paused}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= left>1?left-1:0}"
      }
     ]
    }
   ]
  },
  "Screen1": {
   "type": "Screen",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "children": [
    "TopBar1",
    "column1",
    "column2",
    "filledButton2",
    "row1",
    "filledButton4",
    "text6"
   ]
  },
  "TopBar1": {
   "type": "TopBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Let's jump!",
    "back": true
   },
   "bind": {
    "props.subtitle": "Round ${round} of ${today.rounds}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "bind": {
    "decoration.fills[0].color": "${= phase==\"work\"?\"#FFFFB300\":\"#FF4FC3F7\"}"
   },
   "children": [
    "text1",
    "text2",
    "text3"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11.5,
     "fontWeight": 700,
     "letterSpacing": 1.3,
     "height": 1.2,
     "color": "#FF212121"
    },
    "text": "${= phase=='work' ? 'JUMP!' : 'REST'}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 96,
     "fontWeight": 800,
     "letterSpacing": -0.9,
     "height": 1.02,
     "color": "#FF212121"
    },
    "text": "${= started ? left : today.work}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 15,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF212121"
    },
    "text": "${= phase=='work' ? 'Go go go!' : 'Breathe. You rock!'}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "children": [
    "text4",
    "text5",
    "filledButton1"
   ]
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11.5,
     "fontWeight": 700,
     "letterSpacing": 1.3,
     "height": 1.2,
     "color": "#FF9793B0"
    },
    "text": "Your jumps"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 80,
     "fontWeight": 800,
     "letterSpacing": -0.9,
     "height": 1.02,
     "color": "#FF15122E"
    },
    "text": "${count}"
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Jump +1"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= count+1}"
      }
     ]
    }
   ]
  },
  "filledButton2": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Start"
   },
   "bind": {
    "visible": "${= !started}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "started",
       "value": "${= true}"
      },
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= today.work}"
      },
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "work"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= 1}"
      },
      {
       "type": "componentEvent",
       "event": "start_session"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= started}"
   },
   "children": [
    "outlinedButton1",
    "filledButton3"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= paused ? 'Resume' : 'Pause'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= !paused}"
      }
     ]
    }
   ]
  },
  "filledButton3": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "tonal": true,
    "label": "Next"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "${= (phase==\"work\")?\"rest\":\"work\"}"
      },
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= (phase==\"work\")?today.rest:today.work}"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= (phase==\"rest\")?round+1:round}"
      }
     ]
    }
   ]
  },
  "filledButton4": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "backgroundColor": "#FFDC2626",
     "foregroundColor": "#FFFFFFFF"
    },
    "label": "Finish"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "finish_session",
       "value": "${count}"
      }
     ]
    }
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 16,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FFF57C00"
    },
    "text": "Wow! 50 jumps! Star jumper!"
   },
   "bind": {
    "visible": "${= count>=50}"
   }
  }
 },
 "variables": {
  "screen": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   },
   {
    "name": "phase",
    "type": "text",
    "value": "work"
   },
   {
    "name": "round",
    "type": "integer",
    "value": 1
   },
   {
    "name": "left",
    "type": "integer",
    "value": 0
   },
   {
    "name": "count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "paused",
    "type": "boolean",
    "value": false
   },
   {
    "name": "started",
    "type": "boolean",
    "value": false
   }
  ]
 }
}