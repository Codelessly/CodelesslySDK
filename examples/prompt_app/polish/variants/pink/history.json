{
 "schema": 3,
 "roots": [
  "history"
 ],
 "nodes": {
  "history": {
   "type": "canvas",
   "slots": {
    "body": "Screen1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "Screen1": {
   "type": "Screen",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "children": [
    "TopBar1",
    "ChartCard1",
    "StatTrio1",
    "RecordCard1",
    "SectionTitle1",
    "column1"
   ]
  },
  "TopBar1": {
   "type": "TopBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Your progress",
    "subtitle": "Your weekly total is climbing. Nice work.",
    "back": true
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "ChartCard1": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 356.0
   },
   "props": {
    "title": "Jumps this week",
    "unit": "jumps",
    "deltaLabel": "vs last week"
   },
   "bind": {
    "props.values": "${= map(weeks,w=>w.jumps)}",
    "props.labels": "${= map(weeks,w=>w.label)}"
   }
  },
  "StatTrio1": {
   "type": "StatTrio",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "labels": [
     "Total jumps",
     "Minutes",
     "Sessions"
    ]
   },
   "bind": {
    "props.values": "${= [sum(sessions,s=>s.jumps),sum(sessions,s=>s.minutes),length(sessions)]}"
   }
  },
  "RecordCard1": {
   "type": "RecordCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Best run without a miss",
    "unit": "jumps in a row"
   },
   "bind": {
    "props.detail": "${= first(sortByDesc(sessions,s=>s.best)).name} · ${= first(sortByDesc(sessions,s=>s.best)).date}",
    "props.value": "${= first(sortByDesc(sessions,s=>s.best)).best}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_session",
       "value": "${= first(sortByDesc(sessions,s=>s.best)).date}"
      }
     ]
    }
   ]
  },
  "SectionTitle1": {
   "type": "SectionTitle",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Past sessions"
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "listView1"
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 12
   },
   "bind": {
    "data": "${sessions}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "SessionRow1"
   ]
  },
  "SessionRow1": {
   "type": "SessionRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "unit": "jumps"
   },
   "bind": {
    "props.title": "${item.name}",
    "props.detail": "${item.date} · ${item.minutes} min",
    "props.value": "${item.jumps}",
    "props.share": "${= item.jumps/max(map(sessions,x=>x.jumps))}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_session",
       "value": "${item.date}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "history": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   }
  ]
 }
}