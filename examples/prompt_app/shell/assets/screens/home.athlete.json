{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "Screen1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "Screen1": {
   "type": "Screen",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "children": [
    "TopBar1",
    "HeroSession1",
    "row1",
    "ChartCard1",
    "StatTrio1",
    "SectionTitle1",
    "listView1"
   ]
  },
  "TopBar1": {
   "type": "TopBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Today"
   },
   "bind": {
    "props.subtitle": "Session ${sessionsThisWeek}/${weeklyGoal} this week"
   }
  },
  "HeroSession1": {
   "type": "HeroSession",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "cta": "Start"
   },
   "bind": {
    "props.title": "${today.name}",
    "props.detail": "${today.rounds} x ${today.work}s work / ${today.rest}s rest",
    "props.minutes": "${today.minutes} min"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "start_session"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "StreakFlame1",
    "ProgressGoal1"
   ]
  },
  "StreakFlame1": {
   "type": "StreakFlame",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 176.0
   },
   "props": {
    "label": "day streak",
    "note": ""
   },
   "bind": {
    "props.count": "${streak}"
   }
  },
  "ProgressGoal1": {
   "type": "ProgressGoal",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 176.0
   },
   "props": {
    "title": "this week"
   },
   "bind": {
    "props.note": "${= weeklyGoal-sessionsThisWeek} left",
    "props.done": "${sessionsThisWeek}",
    "props.goal": "${weeklyGoal}"
   }
  },
  "ChartCard1": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 356.0
   },
   "props": {
    "title": "Jumps per week",
    "unit": "jumps",
    "deltaLabel": "vs prior week"
   },
   "bind": {
    "props.values": "${= map(weeks,w=>w.jumps)}",
    "props.labels": "${= map(weeks,w=>w.label)}"
   }
  },
  "StatTrio1": {
   "type": "StatTrio",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "labels": [
     "jumps",
     "minutes",
     "best streak"
    ],
    "icons": [
     "bolt",
     "timer",
     "emoji_events"
    ]
   },
   "bind": {
    "props.values": "${= [sum(sessions,s=>s.jumps),sum(sessions,s=>s.minutes),max(max(sessions[0].best,sessions[1].best),max(sessions[2].best,sessions[3].best))]}"
   }
  },
  "SectionTitle1": {
   "type": "SectionTitle",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Recent",
    "action": "History"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_history"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${sessions}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "SessionRow1"
   ]
  },
  "SessionRow1": {
   "type": "SessionRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "unit": "jumps"
   },
   "bind": {
    "props.title": "${item.name}",
    "props.detail": "${item.date} · ${item.minutes} min · best ${item.best}",
    "props.value": "${item.jumps}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_session",
       "value": "${item.date}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   }
  ]
 }
}