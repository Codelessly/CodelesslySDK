{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "Screen1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= (phase==\"set\"||phase==\"work\"||phase==\"rest\") && !paused}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= elapsed+(phase==\"set\"?0:1)}"
      },
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "${= left>1?phase:(phase!=\"work\"?\"work\":(round<today.rounds?\"rest\":\"done\"))}"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= (left<=1&&phase==\"work\")?round+1:round}"
      },
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= left>1?left-1:(phase==\"work\"?today.work:today.rest)}"
      }
     ]
    },
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= phase==\"done\" && !saved}"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "finish_session",
       "value": "${count}"
      },
      {
       "type": "setVariable",
       "variable": "saved",
       "value": "${= true}"
      }
     ]
    }
   ]
  },
  "Screen1": {
   "type": "Screen",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "children": [
    "SessionBar1",
    "Illustration1",
    "column1",
    "text5",
    "BigButton1",
    "SessionBar2",
    "SessionDial1",
    "TapPad1",
    "SessionControls1",
    "SessionSummary1",
    "BigButton2",
    "BigButton3"
   ]
  },
  "SessionBar1": {
   "type": "SessionBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 48.0
   },
   "props": {
    "title": "Today's session"
   },
   "bind": {
    "props.detail": "${today.minutes} minutes, ${today.rounds} rounds",
    "visible": "${= phase==\"ready\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "Illustration1": {
   "type": "Illustration",
   "layout": {
    "width": 200,
    "height": 200
   },
   "props": {
    "role": "hero"
   },
   "bind": {
    "visible": "${= phase==\"ready\"}"
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE3E3E6"
     }
    ],
    "radius": 17
   },
   "bind": {
    "visible": "${= phase==\"ready\"}"
   },
   "children": [
    "text1",
    "text2",
    "text3",
    "text4"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 23,
     "fontWeight": 600,
     "letterSpacing": -0.2,
     "height": 1.3,
     "color": "#FF15122E"
    },
    "text": "What will happen"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "You jump for ${today.work} seconds. That is your work time.",
    "style": {
     "fontSize": 15,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF15122E"
    }
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Then you rest for ${today.rest} seconds to catch your breath.",
    "style": {
     "fontSize": 15,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF15122E"
    }
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 15,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B815122E"
    },
    "text": "That repeats ${today.rounds} times. About ${today.minutes} minutes in all."
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 15,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B815122E"
    },
    "text": "Short and steady is enough. You have done ${sessionsThisWeek} of ${weeklyGoal} sessions this week."
   },
   "bind": {
    "visible": "${= phase==\"ready\"}"
   }
  },
  "BigButton1": {
   "type": "BigButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "label": "Start session",
    "icon": "play_arrow"
   },
   "bind": {
    "visible": "${= phase==\"ready\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "set"
      },
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= 3}"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "elapsed",
       "value": "${= 0}"
      },
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= false}"
      },
      {
       "type": "setVariable",
       "variable": "saved",
       "value": "${= false}"
      },
      {
       "type": "componentEvent",
       "event": "start_session"
      }
     ]
    }
   ]
  },
  "SessionBar2": {
   "type": "SessionBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 48.0
   },
   "bind": {
    "props.title": "${today.name}",
    "props.detail": "Round ${= round<1?1:round} of ${today.rounds}",
    "visible": "${= phase==\"set\"||phase==\"work\"||phase==\"rest\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "done"
      }
     ]
    }
   ]
  },
  "SessionDial1": {
   "type": "SessionDial",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 428.0
   },
   "props": {
    "note": "Jump while it is bright, rest while it is calm",
    "workLabel": "Jump",
    "restLabel": "Rest",
    "setLabel": "Get ready",
    "readyLabel": "Ready"
   },
   "bind": {
    "props.left": "${left}",
    "props.phase": "${phase}",
    "props.round": "${= round<1?1:round}",
    "props.rounds": "${today.rounds}",
    "props.work": "${today.work}",
    "props.rest": "${today.rest}",
    "props.paused": "${paused}",
    "visible": "${= phase==\"set\"||phase==\"work\"||phase==\"rest\"}"
   }
  },
  "TapPad1": {
   "type": "TapPad",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 172.0
   },
   "props": {
    "label": "Tap for every jump",
    "count": "count",
    "hint": "Tap each time you jump"
   },
   "bind": {
    "visible": "${= (phase==\"set\"||phase==\"work\"||phase==\"rest\") && (phase==\"work\")}"
   }
  },
  "SessionControls1": {
   "type": "SessionControls",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "paused": "paused",
    "pause": "Pause",
    "resume": "Keep going",
    "finish": "Finish"
   },
   "bind": {
    "visible": "${= phase==\"set\"||phase==\"work\"||phase==\"rest\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "done"
      }
     ]
    }
   ]
  },
  "SessionSummary1": {
   "type": "SessionSummary",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Well done",
    "detail": "Next: a rest day, then come back for your next short session.",
    "streakLabel": "sessions in a row",
    "unit": "jumps",
    "eyebrow": "Session complete"
   },
   "bind": {
    "props.jumps": "${count}",
    "props.best": "${= 0}",
    "props.rounds": "${round}",
    "props.of": "${today.rounds}",
    "props.seconds": "${elapsed}",
    "props.streak": "${streak}",
    "visible": "${= phase==\"done\"}"
   }
  },
  "BigButton2": {
   "type": "BigButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "label": "Back to home",
    "icon": "home"
   },
   "bind": {
    "visible": "${= phase==\"done\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "BigButton3": {
   "type": "BigButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "label": "See my progress",
    "icon": "show_chart",
    "tone": "quiet"
   },
   "bind": {
    "visible": "${= phase==\"done\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_history"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "screen": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   },
   {
    "name": "phase",
    "type": "text",
    "value": "ready"
   },
   {
    "name": "left",
    "type": "integer",
    "value": 3
   },
   {
    "name": "round",
    "type": "integer",
    "value": 0
   },
   {
    "name": "count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "paused",
    "type": "boolean",
    "value": false
   },
   {
    "name": "elapsed",
    "type": "integer",
    "value": 0
   },
   {
    "name": "saved",
    "type": "boolean",
    "value": false
   }
  ]
 }
}