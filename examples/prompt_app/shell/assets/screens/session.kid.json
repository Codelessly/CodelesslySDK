     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "done"
      }
     ]
    }
   ]
  },
  "SessionDial3": {
   "type": "SessionDial",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 428.0
   },
   "props": {
    "note": "Breathe. Shake it out!",
    "phase": "rest",
    "audience": "kid"
   },
   "bind": {
    "props.left": "${left}",
    "props.round": "${round}",
    "props.rounds": "${today.rounds}",
    "props.work": "${today.work}",
    "props.rest": "${today.rest}",
    "props.paused": "${paused}",
    "visible": "${= phase==\"rest\"}"
   }
  },
  "TapPad2": {
   "type": "TapPad",
   "layout": {
