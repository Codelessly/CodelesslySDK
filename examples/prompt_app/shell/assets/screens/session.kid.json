    "count": "count"
   },
   "bind": {
    "visible": "${= phase==\"work\"}"
   }
  },
  "SessionControls2": {
   "type": "SessionControls",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "paused": "paused"
   },
   "bind": {
    "visible": "${= phase==\"work\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "done"
      }
     ]
    }
   ]
  },
  "SessionBar3": {
   "type": "SessionBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 48.0
   },
   "props": {
    "title": "Rest"
   },
   "bind": {
    "props.detail": "${today.name}",
    "visible": "${= phase==\"rest\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
