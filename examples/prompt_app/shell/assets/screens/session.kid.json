  },
  "SessionDial2": {
   "type": "SessionDial",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 428.0
   },
   "props": {
    "note": "Jump jump jump!",
    "phase": "work",
    "audience": "kid"
   },
   "bind": {
    "props.left": "${left}",
    "props.round": "${round}",
