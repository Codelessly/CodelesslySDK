       "type": "setVariable",
       "variable": "phase",
       "value": "done"
      }
     ]
    }
   ]
  },
  "SessionSummary1": {
   "type": "SessionSummary",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "You did it!",
    "detail": "Great job. See you next time!",
    "streakLabel": "days in a row",
    "audience": "kid"
   },
   "bind": {
    "props.jumps": "${count}",
    "props.best": "${= 0}",
    "props.rounds": "${round}",
    "props.of": "${today.rounds}",
    "props.seconds": "${elapsed}",
    "props.streak": "${streak}",
    "visible": "${= phase==\"done\"}"
   }
  },
  "BigButton1": {
   "type": "BigButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "label": "Home",
    "icon": "home"
   },
   "bind": {
    "visible": "${= phase==\"done\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "BigButton2": {
   "type": "BigButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 64.0
   },
   "props": {
    "label": "See my jumps",
    "icon": "star",
    "tone": "quiet"
   },
   "bind": {
    "visible": "${= phase==\"done\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_history"
      }
     ]
    }
   ]
  }
 },
 "variables": {
