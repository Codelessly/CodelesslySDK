{
 "schema": 3,
 "roots": [
  "session"
 ],
 "nodes": {
  "session": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= started && !paused && !done}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "remaining",
       "value": "${= remaining>1?remaining-1:(phase==\"Jump\"?(today.rest):(today.work))}"
      },
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "${= remaining>1?phase:(phase==\"Jump\"?\"Rest\":\"Jump\")}"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= (remaining>1||phase==\"Jump\")?round:round+1}"
      },
      {
       "type": "setVariable",
       "variable": "done",
       "value": "${= (remaining<=1&&phase==\"Rest\"&&round>=today.rounds)}"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": true,
    "spacing": 16,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "column2",
    "filledButton1",
    "column3",
    "row2",
    "Banner1"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "BackButton1",
    "StatusBadge1"
   ]
  },
  "BackButton1": {
   "type": "BackButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Home"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "StatusBadge1": {
   "type": "StatusBadge",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "tone": "info"
   },
   "bind": {
    "props.label": "Round ${round} of ${today.rounds}"
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE2E3E5"
     }
    ],
    "radius": 15
   },
   "children": [
    "text1",
    "text2",
    "progressBar1"
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 26.5,
     "fontWeight": 700,
     "height": 1.2,
     "color": "#FF0F172A"
    },
    "text": "${= phase=='Jump' ? 'JUMP!' : 'Rest. Breathe!'}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 33,
     "fontWeight": 700,
     "height": 1.2,
     "color": "#FF0F172A"
    },
    "text": "${remaining}"
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "max": 1,
    "borderRadius": 2,
    "color": "#FF4F46E5",
    "backgroundColor": "#FFE2E3E5"
   },
   "bind": {
    "props.value": "${= 0}"
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Let's go!"
   },
   "bind": {
    "visible": "${= !started}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "started",
       "value": "${= true}"
      },
      {
       "type": "setVariable",
       "variable": "remaining",
       "value": "${= today.work}"
      },
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "Jump"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= 1}"
      },
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= 0}"
      },
      {
       "type": "componentEvent",
       "event": "start_session"
      }
     ]
    }
   ]
  },
  "column3": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE2E3E5"
     }
    ],
    "radius": 15
   },
   "bind": {
    "visible": "${= started}"
   },
   "children": [
    "text3",
    "text4",
    "filledButton2",
    "text5"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#B80F172A"
    },
    "text": "Your jumps"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 33,
     "fontWeight": 700,
     "height": 1.2,
     "color": "#FF0F172A"
    },
    "text": "${count}"
   }
  },
  "filledButton2": {
   "type": "filledButton",
   "layout": {
    "height": 80,
    "width": {
     "hug": 0
    }
   },
   "props": {
    "label": "Tap! +1"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= count+1}"
      }
     ]
    }
   ]
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FF059669"
    },
    "text": "Wow! 50 jumps! Keep going!"
   },
   "bind": {
    "visible": "${= count>=50}"
   }
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "bind": {
    "visible": "${= started}"
   },
   "children": [
    "outlinedButton1",
    "filledButton3"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= paused ? 'Resume' : 'Pause'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= !paused}"
      }
     ]
    }
   ]
  },
  "filledButton3": {
   "type": "filledButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "tonal": true,
    "label": "Finish"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "finish_session",
       "value": "${count}"
      }
     ]
    }
   ]
  },
  "Banner1": {
   "type": "Banner",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "You did it!",
    "message": "All rounds done. You are a star!",
    "tone": "success"
   },
   "bind": {
    "visible": "${= done}"
   }
  }
 },
 "variables": {
  "session": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   },
   {
    "name": "remaining",
    "type": "integer",
    "value": 40
   },
   {
    "name": "phase",
    "type": "text",
    "value": "Jump"
   },
   {
    "name": "round",
    "type": "integer",
    "value": 1
   },
   {
    "name": "count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "paused",
    "type": "boolean",
    "value": false
   },
   {
    "name": "started",
    "type": "boolean",
    "value": false
   },
   {
    "name": "done",
    "type": "boolean",
    "value": false
   }
  ]
 }
}