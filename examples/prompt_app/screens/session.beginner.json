{
 "schema": 3,
 "roots": [
  "session"
 ],
 "nodes": {
  "session": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "timer",
      "intervalMs": 1000,
      "when": "${= !paused && !done}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "left",
       "value": "${= left>1?left-1:(phase==\"work\"?today.rest:today.work)}"
      },
      {
       "type": "setVariable",
       "variable": "progress",
       "value": "${= 1-((left-1)/(phase==\"work\"?today.work:today.rest))}"
      },
      {
       "type": "setVariable",
       "variable": "phase",
       "value": "${= left>1?phase:(phase==\"work\"?\"rest\":\"work\")}"
      },
      {
       "type": "setVariable",
       "variable": "round",
       "value": "${= (left<=1 && phase==\"rest\")?min(round+1,today.rounds):round}"
      }
     ]
    }
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": true,
    "spacing": 16,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "text1",
    "text2",
    "column2",
    "column3",
    "row3",
    "text8"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "BackButton1",
    "StatusBadge1"
   ]
  },
  "BackButton1": {
   "type": "BackButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Home"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "StatusBadge1": {
   "type": "StatusBadge",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.label": "${= paused ? 'Paused' : (phase=='work' ? 'Jump' : 'Rest')}",
    "props.tone": "${= paused?\"warning\":(phase==\"work\"?\"success\":\"info\")}"
   }
  },
  "text1": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "letterSpacing": -0.2,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${today.name}"
   }
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${today.rounds} rounds, about ${today.minutes} minutes. Jump for ${today.work} seconds (work), then catch your breath for ${today.rest} seconds (rest)."
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text3",
    "text4",
    "text5",
    "progressBar1"
   ]
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Round ${round} of ${today.rounds}"
   }
  },
  "text4": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 30,
     "fontWeight": 700,
     "height": 1.2,
     "color": "#FF111827"
    },
    "text": "${left}"
   }
  },
  "text5": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "letterSpacing": -0.2,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "${= phase=='work' ? 'Jump!' : 'Rest and breathe'}"
   }
  },
  "progressBar1": {
   "type": "progressBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "max": 1,
    "borderRadius": 2,
    "color": "#FF2563EB",
    "backgroundColor": "#FFE5E7EB"
   },
   "bind": {
    "props.value": "${progress}"
   }
  },
  "column3": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text6",
    "text7",
    "filledButton1",
    "row2"
   ]
  },
  "text6": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4,
     "color": "#FF9CA3AF"
    },
    "text": "Jumps so far"
   }
  },
  "text7": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 30,
     "fontWeight": 700,
     "height": 1.2,
     "color": "#FF111827"
    },
    "text": "${count}"
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Tap for each jump"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= count+1}"
      }
     ]
    }
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "children": [
    "outlinedButton1",
    "outlinedButton2"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "-1"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= max(0,count-1)}"
      }
     ]
    }
   ]
  },
  "outlinedButton2": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "+10"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "count",
       "value": "${= count+10}"
      }
     ]
    }
   ]
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "children": [
    "filledButton2",
    "filledButton3"
   ]
  },
  "filledButton2": {
   "type": "filledButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "tonal": true
   },
   "bind": {
    "props.label": "${= paused ? 'Resume' : 'Pause'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "paused",
       "value": "${= !paused}"
      }
     ]
    }
   ]
  },
  "filledButton3": {
   "type": "filledButton",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Finish"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "finish_session",
       "value": "${count}"
      }
     ]
    }
   ]
  },
  "text8": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Short and steady counts. Finishing early is fine, you showed up."
   }
  }
 },
 "variables": {
  "session": [
   {
    "name": "streak",
    "type": "integer",
    "value": 4
   },
   {
    "name": "weeklyGoal",
    "type": "integer",
    "value": 5
   },
   {
    "name": "sessionsThisWeek",
    "type": "integer",
    "value": 3
   },
   {
    "name": "today",
    "type": "map",
    "value": {
     "name": "Intervals",
     "rounds": 8,
     "work": 40,
     "rest": 20,
     "minutes": 8
    }
   },
   {
    "name": "weeks",
    "type": "list",
    "value": [
     {
      "label": "W39",
      "jumps": 2100
     },
     {
      "label": "W40",
      "jumps": 2650
     },
     {
      "label": "W41",
      "jumps": 2400
     },
     {
      "label": "W42",
      "jumps": 3180
     }
    ]
   },
   {
    "name": "sessions",
    "type": "list",
    "value": [
     {
      "date": "Fri 13 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 912,
      "best": 148
     },
     {
      "date": "Wed 11 Nov",
      "name": "Endurance",
      "minutes": 12,
      "jumps": 1304,
      "best": 210
     },
     {
      "date": "Mon 9 Nov",
      "name": "Footwork",
      "minutes": 6,
      "jumps": 640,
      "best": 96
     },
     {
      "date": "Sat 7 Nov",
      "name": "Intervals",
      "minutes": 8,
      "jumps": 880,
      "best": 131
     }
    ]
   },
   {
    "name": "progress",
    "type": "integer",
    "value": 0
   },
   {
    "name": "count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "paused",
    "type": "boolean",
    "value": false
   },
   {
    "name": "left",
    "type": "integer",
    "value": 40
   },
   {
    "name": "phase",
    "type": "text",
    "value": "work"
   },
   {
    "name": "round",
    "type": "integer",
    "value": 1
   },
   {
    "name": "done",
    "type": "boolean",
    "value": false
   }
  ]
 }
}