   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "${today.minutes} minutes. Jump hard for ${today.work} seconds (work), then rest for ${today.rest} seconds. Repeat ${today.rounds} times."
   }
  },
  "filledButton1": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
