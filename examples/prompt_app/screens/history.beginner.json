      }
     ]
    }
   ]
  },
  "column4": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
