{
 "schema": 3,
 "roots": [
  "screen"
 ],
 "nodes": {
  "screen": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "padding": 16,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": true,
    "spacing": 16,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row1",
    "Banner1",
    "column2",
    "SectionHeader1",
    "text4",
    "listView1",
    "column4"
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "BackButton1",
    "text1"
   ]
  },
  "BackButton1": {
   "type": "BackButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Home"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "open_home"
      }
     ]
    }
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 20,
     "fontWeight": 600,
     "letterSpacing": -0.2,
     "height": 1.3,
     "color": "#FF111827"
    },
    "text": "Your progress"
   }
  },
  "Banner1": {
   "type": "Banner",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Nice work, keep it going",
    "tone": "success"
   },
   "bind": {
    "props.message": "You jumped on ${sessionsThisWeek} of ${weeklyGoal} days this week. Short sessions count."
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "padding": 12,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 8
   },
   "children": [
    "text2",
    "text3",
    "barChart1"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 14,
     "fontWeight": 600,
     "height": 1.4,
     "color": "#FF111827"
    },
    "text": "Jumps each week"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.5,
     "color": "#FF4B5563"
    },
    "text": "Your weekly total is climbing. This week: ${= weeks[3].jumps} jumps."
   }
  },
  "barChart1": {
   "type": "barChart",
   "layout": {
    "height": 140,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "color": "#FF2563EB"
   },
   "bind": {
    "props.values": "${= map(weeks,w=>w.jumps)}",
    "props.labels": "${= map(weeks,w=>w.label)}"
   }
  },
  "SectionHeader1": {
   "type": "SectionHeader",
   "layout": {
    "width": {
     "fill": 0
