{
 "schema": 2,
 "id": "PlansSection",
 "roots": [
  "plansSec"
 ],
 "widget": {
  "type": "PlansSection",
  "doc": "The seat estimator, the plan cards, the enterprise row and the disclaimer.",
  "props": [
   {
    "key": "annual",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "boolean"
     }
    },
    "default": ""
   }
  ]
 },
 "variables": {
  "plansSec": [
   {
    "name": "seats",
    "type": "integer",
    "value": 10
   },
   {
    "name": "seatsText",
    "type": "text",
    "value": "10"
   },
   {
    "name": "seatsValid",
    "type": "boolean",
    "formula": "matches(seatsText, '^[0-9]+$') && number(seatsText) >= 1 && number(seatsText) <= 500"
   }
  ]
 },
 "nodes": {
  "plansSec": {
   "type": "column",
   "children": [
    "plansIn"
   ],
   "layout": {
    "width": {
     "fill": 1440
    },
    "height": {
     "hug": 1400
    },
    "padding": [
     18,
     50,
     18,
     80
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#FF0A0F10"
     }
    ],
    "strokes": [
     {
      "color": "#FF1E2B28"
     }
    ],
    "strokeSides": "top"
   },
   "media": [
    {
     "minWidth": "tablet",
     "patch": {
      "layout": {
       "padding": [
        28,
        0,
        28,
        110
       ]
      }
     }
    },
    {
     "minWidth": "desktop",
     "patch": {
      "layout": {
       "padding": [
        40,
        0,
        40,
        110
       ]
      }
     }
    }
   ]
  },
  "plansIn": {
   "type": "column",
   "children": [
    "est",
    "cards",
    "ent",
    "disclaimer"
   ],
   "layout": {
    "width": {
     "fill": 1320
    },
    "height": {
     "hug": 1400
    },
    "constraints": {
     "maxWidth": 1320
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 20
   }
  },
  "est": {
   "type": "flex",
   "children": [
    "estText",
    "estCtl"
   ],
   "layout": {
    "width": {
     "fill": 1320
    },
    "height": {
     "hug": 174
    },
    "padding": [
     25,
     32,
     25,
     32
    ]
   },
   "props": {
    "direction": "vertical",
    "crossAxisAlignment": "start",
    "spacing": 24
   },
   "decoration": {
    "fills": [
     {
      "type": "linear",
      "begin": [
       -1,
       -1
      ],
      "end": [
       1,
       1
      ],
      "stops": [
       {
        "position": 0,
        "color": "#FF1C2E27"
       },
       {
        "position": 1,
        "color": "#FF1A2726"
       }
      ]
     }
    ],
    "strokes": [
     {
      "color": "#FF34503C"
     }
    ]
   },
   "media": [
    {
     "minWidth": "tablet",
     "patch": {
      "props": {
       "direction": "horizontal",
       "mainAxisAlignment": "spaceBetween"
      },
      "layout": {
       "padding": [
        35,
        36,
        35,
        36
       ]
      }
     }
    }
   ]
  },
  "estText": {
   "type": "column",
   "children": [
    "estEyebrow",
    "estTitle",
    "estBody"
   ],
   "layout": {
    "width": {
     "fill": 640
    },
    "height": {
     "hug": 100
    },
    "constraints": {
     "maxWidth": 640
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 10
   }
  },
  "estEyebrow": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 200
    },
    "height": {
     "hug": 16
    }
   },
   "props": {
    "text": "PLAN ESTIMATOR / LIVE",
    "style": {
     "fontFamily": "IBM Plex Mono",
     "fontSize": 12,
     "fontWeight": 500,
     "letterSpacing": 2.4,
     "color": "#FFB9F34C"
    }
   }
  },
  "estTitle": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 640
    },
    "height": {
     "hug": 36
    }
   },
   "props": {
    "text": "Plan for your response team.",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 28,
     "fontWeight": 700,
     "letterSpacing": -1.4,
     "height": 1.12,
     "color": "#FFF0F4ED"
    }
   },
   "media": [
    {
     "minWidth": "desktop",
     "patch": {
      "props": {
       "style": {
        "fontSize": 34,
        "letterSpacing": -1.8
       }
      }
     }
    }
   ]
  },
  "estBody": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 620
    },
    "height": {
     "hug": 40
    }
   },
   "props": {
    "text": "Adjust the number of people who can be assigned to an incident. View-only stakeholders do not count as responders.",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 13.5,
     "height": 1.5,
     "color": "#FFA2B0A9"
    }
   }
  },
  "estCtl": {
   "type": "column",
   "children": [
    "estLabel",
    "stepper",
    "estRange",
    "estError"
   ],
   "layout": {
    "width": {
     "hug": 176
    },
    "height": {
     "hug": 90
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 8
   }
  },
  "estLabel": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 90
    },
    "height": {
     "hug": 14
    }
   },
   "props": {
    "text": "RESPONDERS",
    "style": {
     "fontFamily": "IBM Plex Mono",
     "fontSize": 10,
     "fontWeight": 600,
     "letterSpacing": 1.4,
     "color": "#FFB9F34C"
    }
   }
  },
  "stepper": {
   "type": "row",
   "children": [
    "stepMinus",
    "seatCell",
    "stepPlus"
   ],
   "layout": {
    "width": 176,
    "height": 45
   },
   "decoration": {
    "fills": [
     {
      "color": "#FF101819"
     }
    ],
    "strokes": [
     {
      "color": "#FF4A6052"
     }
    ]
   }
  },
  "stepMinus": {
   "type": "row",
   "children": [
    "stepMinusIcon"
   ],
   "layout": {
    "width": 45,
    "height": {
     "fill": 45
    }
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "#FF4A6052"
     }
    ],
    "strokeSides": "right"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "seats",
       "value": "${= max(1, seats - 1)}"
      },
      {
       "type": "setVariable",
       "variable": "seatsText",
       "value": "${= text(seats)}"
      }
     ]
    }
   ]
  },
  "stepMinusIcon": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "remove",
    "color": "#FFF0F4ED"
   }
  },
  "seatCell": {
   "type": "row",
   "children": [
    "seatInput"
   ],
   "layout": {
    "width": {
     "fill": 86
    },
    "height": {
     "fill": 45
    }
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "strokes": [
     {
      "color": "#00000000"
     }
    ],
    "strokeWidth": 2
   },
   "bind": {
    "decoration.strokes[0].color": "${= seatsValid ? '#00000000' : '#FFFF9389'}"
   }
  },
  "seatInput": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 80
    },
    "height": 40
   },
   "props": {
    "keyboardType": "number",
    "textAlign": "center",
    "textAlignVertical": "center",
    "cursorColor": "#FFB9F34C",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 16,
     "fontWeight": 700,
     "color": "#FFF0F4ED"
    },
    "decoration": {
     "border": {
      "type": "none"
     },
     "enabledBorder": {
      "type": "none"
     },
     "focusedBorder": {
      "type": "none"
     },
     "isDense": true,
     "contentPadding": [
      0,
      10,
      0,
      10
     ]
    }
   },
   "bind": {
    "props.initialValue": "${seatsText}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "seatsText",
       "value": "${result}"
      },
      {
       "type": "if",
       "condition": {
        "left": "${seatsValid}",
        "op": "isTrue"
       },
       "then": [
        {
         "type": "setVariable",
         "variable": "seats",
         "value": "${= number(seatsText)}"
        }
       ]
      }
     ]
    }
   ]
  },
  "stepPlus": {
   "type": "row",
   "children": [
    "stepPlusIcon"
   ],
   "layout": {
    "width": 45,
    "height": {
     "fill": 45
    }
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "#FF4A6052"
     }
    ],
    "strokeSides": "left"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "seats",
       "value": "${= min(500, seats + 1)}"
      },
      {
       "type": "setVariable",
       "variable": "seatsText",
       "value": "${= text(seats)}"
      }
     ]
    }
   ]
  },
  "stepPlusIcon": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "add",
    "color": "#FFF0F4ED"
   }
  },
  "estRange": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 100
    },
    "height": {
     "hug": 14
    }
   },
   "props": {
    "text": "1–500 responders",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 10.5,
     "color": "#FF91A39A"
    }
   }
  },
  "estError": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 176
    },
    "height": {
     "hug": 14
    }
   },
   "props": {
    "text": "Enter a whole number from 1 to 500.",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 10.5,
     "color": "#FFFF9389"
    }
   },
   "bind": {
    "visible": "${= !seatsValid}"
   }
  },
  "cards": {
   "type": "gridView",
   "children": [
    "pc"
   ],
   "layout": {
    "width": {
     "fill": 1320
    },
    "height": {
     "hug": 1000
    },
    "margin": [
     0,
     0,
     0,
     0
    ]
   },
   "props": {
    "physics": "never",
    "minCrossAxisExtent": 240,
    "shrinkWrapRows": true,
    "crossAxisSpacing": 12,
    "mainAxisSpacing": 12
   },
   "bind": {
    "data": "${plans}"
   }
  },
  "ent": {
   "type": "flex",
   "children": [
    "entText",
    "entBtn"
   ],
   "layout": {
    "width": {
     "fill": 1320
    },
    "height": {
     "hug": 148
    },
    "padding": [
     30,
     32,
     30,
     32
    ]
   },
   "props": {
    "direction": "vertical",
    "crossAxisAlignment": "stretch",
    "spacing": 28
   },
   "decoration": {
    "fills": [
     {
      "color": "#FF162121"
     }
    ],
    "strokes": [
     {
      "color": "#FF2C3C38"
     }
    ]
   },
   "media": [
    {
     "minWidth": "tablet",
     "patch": {
      "props": {
       "direction": "horizontal",
       "mainAxisAlignment": "spaceBetween",
       "crossAxisAlignment": "center"
      },
      "layout": {
       "padding": [
        30,
        36,
        30,
        36
       ]
      }
     }
    }
   ]
  },
  "entText": {
   "type": "column",
   "children": [
    "entEyebrow",
    "entTitle",
    "entBody"
   ],
   "layout": {
    "width": {
     "fill": 700
    },
    "height": {
     "hug": 80
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 10
   }
  },
  "entEyebrow": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 160
    },
    "height": {
     "hug": 16
    }
   },
   "props": {
    "text": "ENTERPRISE / CUSTOM",
    "style": {
     "fontFamily": "IBM Plex Mono",
     "fontSize": 12,
     "fontWeight": 500,
     "letterSpacing": 2.4,
     "color": "#FFB9F34C"
    }
   }
  },
  "entTitle": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 700
    },
    "height": {
     "hug": 30
    }
   },
   "props": {
    "text": "Built for the way you operate.",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 25,
     "fontWeight": 700,
     "letterSpacing": -1.2,
     "height": 1.15,
     "color": "#FFF0F4ED"
    }
   }
  },
  "entBody": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 700
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "Dedicated support, SAML SSO, procurement support, and tailored rollout.",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 13.5,
     "height": 1.55,
     "color": "#FFA2B0A9"
    }
   }
  },
  "entBtn": {
   "type": "row",
   "children": [
    "entBtnLabel",
    "entBtnIcon"
   ],
   "layout": {
    "width": {
     "fill": 218
    },
    "height": 52,
    "padding": [
     20,
     0,
     20,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "spaceBetween"
   },
   "decoration": {
    "strokes": [
     {
      "color": "#FF2C3C38"
     }
    ]
   },
   "media": [
    {
     "minWidth": "tablet",
     "patch": {
      "layout": {
       "width": 218
      }
     }
    }
   ]
  },
  "entBtnLabel": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 130
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "text": "Contact enterprise",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 15,
     "fontWeight": 700,
     "color": "#FFF0F4ED"
    }
   }
  },
  "entBtnIcon": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "arrow_forward",
    "color": "#FFF0F4ED"
   }
  },
  "disclaimer": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 1320
    },
    "height": {
     "hug": 16
    },
    "margin": [
     0,
     6,
     0,
     0
    ]
   },
   "props": {
    "text": "Estimates exclude taxes and reflect list prices. Contact sales to discuss your exact team setup.",
    "style": {
     "fontFamily": "IBM Plex Mono",
     "fontSize": 11,
     "height": 1.5,
     "color": "#FF91A39A"
    }
   }
  },
  "pc": {
   "type": "PlanCard",
   "layout": {
    "width": {
     "fill": 432
    },
    "height": {
     "hug": 760
    }
   },
   "bind": {
    "props.plan": "${item}",
    "props.annual": "${props.annual}",
    "props.seats": "${seats}"
   }
  }
 }
}
