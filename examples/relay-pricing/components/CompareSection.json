    "cE"
   ],
   "layout": {
    "width": {
     "fill": 128
    },
    "height": {
     "hug": 820
    }
   },
   "props": {
    "scrollable": false
   },
   "bind": {
    "data": "${cmp}"
   }
  },
  "cE": {
   "type": "row",
   "children": [
    "cEi",
    "cEt"
   ],
   "layout": {
    "width": {
     "fill": 128
    },
    "height": 52,
    "padding": [
     18,
     0,
     8,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#FF121A1B"
     }
    ],
    "strokes": [
     {
      "color": "#FF1E2B28"
     }
    ],
    "strokeSides": "top"
   },
   "bind": {
    "layout.height": "${= item.s ? 41 : 52}",
    "decoration.fills[0].color": "${= item.s ? '#FF1E2A28' : '#FF121A1B'}"
   }
  },
  "cEi": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "check",
    "color": "#FFB9F34C"
   },
   "bind": {
    "visible": "${= item.s != true && item.v[3] == 'Yes'}"
   }
  },
  "cEt": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "${= item.s ? '' : item.v[3]}",
    "style": {
     "fontFamily": "Space Grotesk",
     "fontSize": 13.5,
     "color": "#FFA2B0A9"
    }
   },
   "bind": {
