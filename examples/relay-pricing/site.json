   "type": "list",
   "value": [
    {
     "q": "Can I change plans later?",
     "a": "Yes. Move between plans as your team changes. Your incident history and configuration stay in place."
    },
    {
     "q": "How does annual billing work?",
     "a": "Annual plans are billed once a year at the displayed per-responder monthly equivalent. The discount is approximately 20% compared with monthly billing."
    },
    {
     "q": "What counts as a responder?",
     "a": "A responder is someone who can be assigned to incidents and take response actions. View-only stakeholders are free."
    },
    {
     "q": "Can I try a plan before buying?",
     "a": "This reference site has no account creation or billing. Selecting a plan prepares a local-only contact request, so you can explore the plan discussion flow without payment details."
    },
    {
     "q": "Do you offer security reviews?",
     "a": "Yes. Contact sales for a security packet, deployment details, and a conversation with our team."
    },
    {
     "q": "Can I estimate a larger response team?",
     "a": "Yes. The estimator supports up to 500 responders. For larger rollouts, contact sales for a custom Enterprise proposal."
    },
    {
     "q": "Are view-only stakeholders billed?",
     "a": "No. People who only receive updates or view incident progress do not count as responders in these estimates."
    }
