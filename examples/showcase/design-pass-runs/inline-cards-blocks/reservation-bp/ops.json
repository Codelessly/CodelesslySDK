{"ops": [
 {"op":"patch","id":"column1","patch":{
   "layout":{"padding":[18,20,18,18]},
   "props":{"spacing":18,"crossAxisAlignment":"stretch"},
   "decoration":{"strokes":[{"color":"line"}],"strokeWidth":1,"effects":null},
   "bind":{"decoration.radius":"${theme.radii.card}","decoration.effects":"${theme.shadows.card}"}}},

 {"op":"set","id":"header","parent":"column1","index":0,"node":{"type":"row",
   "props":{"crossAxisAlignment":"center","spacing":12},
   "layout":{"width":{"fill":0},"height":{"hug":0}}}},
 {"op":"set","id":"headerMark","parent":"header","node":{"type":"row",
   "props":{"mainAxisAlignment":"center","crossAxisAlignment":"center"},
   "layout":{"width":40,"height":40},
   "decoration":{"fills":[{"color":"accentTint"}],"radius":12},
   "bind":{"decoration.radius":"${theme.radii.control}"}}},
 {"op":"set","id":"headerIcon","parent":"headerMark","node":{"type":"icon",
   "props":{"icon":"restaurant_rounded","size":20,"color":"accent"},
   "layout":{"width":20,"height":20}}},
 {"op":"move","id":"text1","parent":"header"},
 {"op":"patch","id":"text1","patch":{"props":{"style":{"from":"cardTitle"}}}},

 {"op":"set","id":"secDay","parent":"column1","index":1,"node":{"type":"column",
   "props":{"crossAxisAlignment":"stretch","spacing":10},
   "layout":{"width":{"fill":0},"height":{"hug":0}}}},
 {"op":"move","id":"text2","parent":"secDay"},
 {"op":"move","id":"grid1","parent":"secDay"},

 {"op":"set","id":"secParty","parent":"column1","index":2,"node":{"type":"column",
   "props":{"crossAxisAlignment":"stretch","spacing":10},
   "layout":{"width":{"fill":0},"height":{"hug":0}}}},
 {"op":"move","id":"text3","parent":"secParty"},
 {"op":"move","id":"grid2","parent":"secParty"},

 {"op":"set","id":"secTime","parent":"column1","index":3,"node":{"type":"column",
   "props":{"crossAxisAlignment":"stretch","spacing":10},
   "layout":{"width":{"fill":0},"height":{"hug":0}}}},
 {"op":"move","id":"text4","parent":"secTime"},
 {"op":"move","id":"grid3","parent":"secTime"},
 {"op":"move","id":"text5","parent":"secTime"},

 {"op":"patch","id":"text2","patch":{"props":{"style":{"from":"eyebrow","color":"inkSoft"}}}},
 {"op":"patch","id":"text3","patch":{"props":{"style":{"from":"eyebrow","color":"inkSoft"}}}},
 {"op":"patch","id":"text4","patch":{"props":{"style":{"from":"eyebrow","color":"inkSoft"}}}},
 {"op":"patch","id":"text5","patch":{"props":{"style":{"from":"meta","color":"inkFaint"}}}},

 {"op":"patch","id":"grid1","patch":{"props":{"crossAxisAlignment":"stretch"}}},
 {"op":"patch","id":"grid2","patch":{"props":{"crossAxisAlignment":"stretch"}}},
 {"op":"patch","id":"grid3","patch":{"props":{"crossAxisAlignment":"stretch"}}},
 {"op":"patch","id":"gridView1Item","patch":{"props":{"crossAxisAlignment":"stretch"}}},
 {"op":"patch","id":"gridView2Item","patch":{"props":{"crossAxisAlignment":"stretch"}}},
 {"op":"patch","id":"gridView3Item","patch":{"props":{"crossAxisAlignment":"stretch"}}},
 {"op":"patch","id":"choiceChip1","patch":{"layout":{"width":{"fill":0}}}},
 {"op":"patch","id":"choiceChip2","patch":{"layout":{"width":{"fill":0}}}},
 {"op":"patch","id":"choiceChip3","patch":{"layout":{"width":{"fill":0}}}},

 {"op":"remove","ids":["divider1"]},
 {"op":"set","id":"summary","parent":"column1","index":4,"node":{"type":"row",
   "props":{"crossAxisAlignment":"center","spacing":10},
   "layout":{"width":{"fill":0},"height":{"hug":0},"padding":[14,12,14,12]},
   "decoration":{"fills":[{"color":"tile"}],"radius":14},
   "bind":{"decoration.radius":"${theme.radii.tile}"}}},
 {"op":"set","id":"summaryIcon","parent":"summary","node":{"type":"icon",
   "props":{"icon":"event_available_rounded","size":18,"color":"inkSoft"},
   "layout":{"width":18,"height":18}}},
 {"op":"move","id":"text6","parent":"summary"},
 {"op":"move","id":"text7","parent":"summary"},
 {"op":"patch","id":"text6","patch":{"props":{"style":{"from":"meta","color":"inkSoft"}}}},
 {"op":"patch","id":"text7","patch":{"props":{"style":{"from":"rowTitle","color":"ink"}}}},

 {"op":"set","id":"confirmBtn","parent":"column1","node":{"type":"ActionButton",
   "props":{"label":"Confirm booking","tone":"primary","icon":"check_rounded","enabled":true},
   "layout":{"width":{"fill":0},"height":46},
   "bind":{"visible":"${= time!=\"\"}"},
   "actions":[{"trigger":{"type":"event","event":"onPressed"},"actions":[
     {"type":"componentEvent","event":"book","value":"${time}"},
     {"type":"showToast","message":"Booked: ${= days[day].l}, table for ${party} at ${time}"}]}]}},
 {"op":"remove","ids":["filledButton1"]}
]}