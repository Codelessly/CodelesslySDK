   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "fieldLabel"
    },
    "text": "Reply to ${cur.from}"
   }
  },
  "TextArea1": {
   "type": "TextArea",
   "layout": {
    "height": 130,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "placeholder": "Write your reply…",
    "value": "reply"
   }
  },
  "row12": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "mainAxisAlignment": "end",
    "crossAxisAlignment": "center"
   },
   "children": [
    "outlinedButton1",
    "filledButton2"
   ]
  },
  "outlinedButton1": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Close ticket"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "convos",
       "value": "${= updateWhere(convos,x=>x.id==cur.id,x=>with(x,\"status\",\"Resolved\"))}"
      },
      {
       "type": "setVariable",
       "variable": "cur",
       "value": "${= with(cur,\"status\",\"Resolved\")}"
      },
      {
       "type": "showToast",
       "message": "Ticket closed"
      }
     ]
    }
   ]
  },
  "filledButton2": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Send"
   },
   "bind": {
    "props.enabled": "${= trim(reply)!=\"\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "convos",
       "value": "${= updateWhere(convos,x=>x.id==cur.id,x=>with(x,\"status\",\"Waiting\"))}"
      },
      {
       "type": "setVariable",
       "variable": "cur",
       "value": "${= with(cur,\"status\",\"Waiting\")}"
      },
      {
       "type": "setVariable",
       "variable": "reply",
       "value": ""
      },
      {
       "type": "showToast",
       "message": "Reply sent"
      }
     ]
    }
   ]
  }
 },
