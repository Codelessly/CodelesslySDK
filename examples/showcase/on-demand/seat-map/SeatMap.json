{"schema":3,"id":"SeatMap","roots":["wrap"],
"widget":{"type":"SeatMap","doc":"A narrow-body cabin of rows A B C | D E F to pick seats from: SeatMap =seats occupied:[\"1A\",\"3C\"] extra:[6] maxSeats:2 keeps the chosen seat ids (\"7C\") in your list variable, ignores taps on occupied seats, lets the oldest choice give way past maxSeats (default 1), and fires onChanged with the seats joined by commas.",
"props":[
{"key":"value","type":{"kind":"variable","of":{"kind":"list","flutter":"List<String>","item":{"kind":"string","flutter":"String"}}},"default":[],"doc":"Your list variable: the chosen seat ids, such as 7C."},
{"key":"rows","type":{"kind":"number","flutter":"double"},"default":12,"doc":"How many rows the cabin has (12)."},
{"key":"startRow","type":{"kind":"number","flutter":"double"},"default":1,"doc":"The number of the first row (1)."},
{"key":"occupied","type":{"kind":"list","flutter":"List<String>","item":{"kind":"string","flutter":"String"}},"default":[],"doc":"Seat ids already taken; they cannot be chosen."},
{"key":"extra","type":{"kind":"list","flutter":"List<double>","item":{"kind":"number","flutter":"double"}},"default":[],"doc":"Row numbers with extra legroom (an exit row)."},
{"key":"maxSeats","type":{"kind":"number","flutter":"double"},"default":1,"doc":"How many seats may be held at once (1); a further tap replaces the oldest."},
{"key":"legend","type":{"kind":"boolean","flutter":"bool"},"default":true,"doc":"Show the legend over the cabin."}],
"events":[{"key":"onChanged","doc":"A seat was tapped; the value is the chosen seats joined by commas (7C,7D)."}]},
"previews":[{"name":"A320, two travelers","size":[380,660],"props":{"value":["7C","7D"],"maxSeats":2,"extra":[6],"occupied":["1A","1B","1F","2C","2D","3A","3E","4B","4C","4F","5D","5E","6A","7A","7F","8B","8C","8D","9E","9F","10A","10C","11D","12B","12E","12F"]}}],
"nodes":{
"wrap":{"type":"column","children":["legend","cabin"],"props":{"crossAxisAlignment":"stretch","spacing":12},"layout":{"width":{"fill":0},"height":{"hug":0}}},
"legend":{"type":"row","children":["lc1","lc2"],"props":{"mainAxisAlignment":"center","crossAxisAlignment":"start","spacing":24},"layout":{"width":{"fill":0},"height":{"hug":0}},"bind":{"visible":"${props.legend}"}},
"lc1":{"type":"column","children":["iA","iX"],"props":{"crossAxisAlignment":"start","spacing":7},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"lc2":{"type":"column","children":["iS","iO"],"props":{"crossAxisAlignment":"start","spacing":7},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"iA":{"type":"row","children":["lgA","ltA"],"props":{"crossAxisAlignment":"center","spacing":7},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"iS":{"type":"row","children":["lgS","ltS"],"props":{"crossAxisAlignment":"center","spacing":7},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"iX":{"type":"row","children":["lgX","ltX"],"props":{"crossAxisAlignment":"center","spacing":7},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"iO":{"type":"row","children":["lgO","ltO"],"props":{"crossAxisAlignment":"center","spacing":7},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"lgA":{"type":"box","layout":{"width":13,"height":13},"decoration":{"fills":[{"color":"card"}],"strokes":[{"color":"lineStrong"}],"strokeWidth":1.5,"radius":4}},
"ltA":{"type":"text","props":{"text":"Available","style":{"from":"meta","fontSize":11.5}},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"lgS":{"type":"box","layout":{"width":13,"height":13},"decoration":{"fills":[{"color":"accent"}],"radius":4}},
"ltS":{"type":"text","props":{"text":"Selected","style":{"from":"meta","fontSize":11.5}},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"lgX":{"type":"box","layout":{"width":13,"height":13},"decoration":{"fills":[{"color":"card"}],"strokes":[{"color":"gold"}],"strokeWidth":1.8,"radius":4}},
"ltX":{"type":"text","props":{"text":"Extra legroom","style":{"from":"meta","fontSize":11.5}},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"lgO":{"type":"box","layout":{"width":13,"height":13},"decoration":{"fills":[{"color":"tileDeep"}],"radius":4}},
"ltO":{"type":"text","props":{"text":"Occupied","style":{"from":"meta","fontSize":11.5}},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"cabin":{"type":"column","children":["front","list"],"props":{"crossAxisAlignment":"stretch","spacing":10},"layout":{"width":{"fill":0},"height":{"hug":0},"padding":[8,14,8,16]},"decoration":{"fills":[{"color":"tile"}],"radius":18},"bind":{"decoration.radius":"${theme.radii.panel}"}},
"front":{"type":"text","props":{"text":"FRONT","style":{"from":"eyebrow","color":"inkFaint"},"textAlign":"center"},"layout":{"width":{"fill":0},"height":{"hug":0}}},
"list":{"type":"listView","children":["rowWrap"],"props":{"scrollable":false,"spacing":6},"layout":{"width":{"fill":0},"height":{"hug":0}},"bind":{"data":"${= map(range(props.rows),r=>''+(props.startRow+r))}"}},
"rowWrap":{"type":"column","children":["exit","seatRow"],"props":{"crossAxisAlignment":"stretch","spacing":5},"layout":{"width":{"fill":0},"height":{"hug":0}}},
"exit":{"type":"text","props":{"text":"EXTRA LEGROOM","style":{"from":"eyebrow","fontSize":10,"color":"inkSoft"},"textAlign":"center"},"layout":{"width":{"fill":0},"height":{"hug":0},"padding":[0,6,0,0]},"bind":{"visible":"${= contains(props.extra,props.startRow+index)}"}},
"seatRow":{"type":"row","children":["sA","sB","sC","aisle","sD","sE","sF"],"props":{"mainAxisAlignment":"center","crossAxisAlignment":"center","spacing":4},"layout":{"width":{"fill":0},"height":{"hug":0}}},
"aisle":{"type":"row","children":["num"],"props":{"mainAxisAlignment":"center"},"layout":{"width":26,"height":36}},
"num":{"type":"text","props":{"text":"${item}","style":{"from":"numberSmall","fontSize":12,"color":"inkFaint"}},"layout":{"width":{"hug":0},"height":{"hug":0}}},
"sA":{"type":"row","children":["tA"],"props":{"mainAxisAlignment":"center"},"layout":{"width":32,"height":36},"decoration":{"fills":[{"color":"card"}],"strokes":[{"color":"lineStrong"}],"strokeWidth":1.5,"radius":9},"bind":{"decoration.radius":"${theme.radii.inner}","decoration.fills[0].color":"${= contains(props.value,item+'A')?theme.colors.accent:(contains(props.occupied,item+'A')?theme.colors.tileDeep:theme.colors.card)}","decoration.strokes[0].color":"${= contains(props.value,item+'A')?theme.colors.accent:(contains(props.occupied,item+'A')?theme.colors.tileDeep:(contains(props.extra,props.startRow+index)?theme.colors.gold:theme.colors.lineStrong))}"},"actions":[{"trigger":{"type":"click"},"actions":[{"type":"setVariable","variable":"props.value","value":"${= contains(props.occupied,item+'A')?props.value:(contains(props.value,item+'A')?without(props.value,item+'A'):append(length(props.value)>=props.maxSeats?slice(props.value,length(props.value)-props.maxSeats+1,length(props.value)):props.value,item+'A'))}"},{"type":"componentEvent","event":"onChanged","value":"${= join(props.value,',')}"}]}]},
