{
 "schema": 3,
 "roots": [
  "data_table"
 ],
 "nodes": {
  "data_table": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Invoices",
    "icon": "receipt_long_rounded",
    "tone": "warn"
   },
   "bind": {
    "props.subtitle": "${= length((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))))} of 12 shown",
    "props.status": "${= count(invoices,r=>r.status==\"Overdue\")} overdue"
   },
   "children": [
    "search",
    "status",
    "head",
    "listView1",
    "pager",
    "TotalBar1"
   ]
  },
  "search": {
   "type": "InputField",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "placeholder": "Search customer",
    "icon": "search_rounded",
    "value": "q"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "status": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "status",
    "options": [
     "All",
     "Paid",
     "Due",
     "Overdue"
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChanged"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "head": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "desc": "desc",
    "columns": [
     "No.",
     "Customer",
     "Date",
     "Amount",
     "Status"
    ],
    "keys": [
     "id",
     "customer",
     "date",
     "amount",
     "status"
    ],
    "widths": [
     5,
     8,
     5,
     6,
     6
    ],
    "selectable": true
   },
   "bind": {
    "props.checked": "${= length((slice(desc?sortByDesc((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort):sortBy((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort),page*5,page*5+5)))>0&&all((slice(desc?sortByDesc((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort):sortBy((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort),page*5,page*5+5)),r=>contains(sel,r.id))}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onToggleAll"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= result?unique(concat(sel,map((slice(desc?sortByDesc((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort):sortBy((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort),page*5,page*5+5)),r=>r.id))):removeWhere(sel,s=>any((slice(desc?sortByDesc((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort):sortBy((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort),page*5,page*5+5)),r=>r.id==s))}"
      }
     ]
    }
   ]
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= (slice(desc?sortByDesc((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort):sortBy((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),sort),page*5,page*5+5))}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "row"
   ]
  },
  "row": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "widths": [
     5,
     8,
     5,
     6,
     6
    ],
    "selectable": true
   },
   "bind": {
    "props.cells": "${= [item.id,item.customer,item.date,money(item.amount,\"$\",0)]}",
    "props.badge": "${item.status}",
    "props.checked": "${= contains(sel,item.id)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= contains(sel,item.id)?without(sel,item.id):append(sel,item.id)}"
      }
     ]
    }
   ]
  },
  "pager": {
   "type": "Pager",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "page"
   },
   "bind": {
    "props.count": "${= ceil(length((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))))/5)}"
   }
  },
  "TotalBar1": {
   "type": "TotalBar",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "cta": "Send reminders",
    "icon": "send_rounded"
   },
   "bind": {
    "props.label": "${= length(sel)} selected",
    "props.amount": "${= money(sum(filter(invoices,r=>contains(sel,r.id)),r=>r.amount),\"$\",0)}",
    "visible": "${= length(sel)>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "send_reminders",
       "value": "${sel}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "data_table": [
   {
    "name": "status",
    "type": "text",
    "value": "All"
   },
   {
    "name": "q",
    "type": "text",
    "value": ""
   },
   {
    "name": "sort",
    "type": "text",
    "value": "date"
   },
   {
    "name": "desc",
    "type": "boolean",
    "value": false
   },
   {
