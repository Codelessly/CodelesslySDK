{
 "schema": 3,
 "roots": [
  "comparison"
 ],
 "nodes": {
  "comparison": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Compare phone plans",
    "subtitle": "Lite and Max, side by side",
    "icon": "sim_card_rounded"
   },
   "bind": {
    "props.status": "${= picked==\"\"?\"2 plans\":picked+\" chosen\"}",
    "props.tone": "${= picked==\"\"?\"accent\":\"good\"}"
   },
   "children": [
    "table",
    "Recommendation1"
   ]
  },
  "table": {
   "type": "ComparisonTable",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "names": [
     "Lite",
     "Max"
    ],
    "prices": [
     "$25/mo",
     "$45/mo"
    ],
    "notes": [
     "Pay monthly",
     "Premium"
    ],
    "pick": "Max",
    "rows": [
     [
      "Price",
      "$25 a month",
      "$45 a month",
      1
     ],
     [
      "Data",
      "10 GB",
      "Unlimited",
      2
     ],
     [
      "Calls",
      "500 min",
      "Unlimited",
      2
     ],
     [
      "Roaming",
      "Not included",
      "EU and US",
      2
     ],
     [
      "Contract",
      "Monthly",
      "24 months",
      1
     ],
     [
      "Extras",
      "None",
      "Streaming, 5G",
      2
     ]
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChoose"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= result}"
      },
      {
       "type": "componentEvent",
       "event": "choose_plan",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "Recommendation1": {
   "type": "Recommendation",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Max is the better value",
    "why": "It wins four of six rows, and unlimited data with roaming is worth the extra $20 a month for most people.",
    "eyebrow": "Recommendation"
   }
  }
 },
 "variables": {
  "comparison": [
   {
    "name": "picked",
    "type": "text",
    "value": ""
   }
  ]
 }
}