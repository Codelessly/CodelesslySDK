{
 "schema": 3,
 "roots": [
  "comparison_wide"
 ],
 "nodes": {
  "comparison_wide": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFF3F4F6"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Four phone plans",
    "subtitle": "Swipe the columns · labels stay in place",
    "icon": "sim_card_rounded"
   },
   "bind": {
    "props.status": "${= picked==\"\"?\"4 plans\":picked+\" chosen\"}",
    "props.tone": "${= picked==\"\"?\"accent\":\"good\"}"
   },
   "children": [
    "table",
    "Recommendation1"
   ]
  },
  "table": {
   "type": "ComparisonTable",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "names": [
     "Lite",
     "Plus",
     "Max",
     "Family"
    ],
    "prices": [
     "$25/mo",
     "$35/mo",
     "$45/mo",
     "$70/mo"
    ],
    "notes": [
     "Pay monthly",
     "Most popular",
     "Premium",
     "Up to 4 lines"
    ],
    "pick": "Plus",
    "rows": [
     [
      "Data",
      "10 GB",
      "40 GB",
      "Unlimited",
      "Unlimited",
      3
     ],
     [
      "Calls",
      "500 min",
      "Unlimited",
      "Unlimited",
      "Unlimited",
      2
     ],
     [
      "Roaming",
      "Not included",
      "EU",
      "EU and US",
      "EU and US",
      3
     ],
     [
      "Contract",
      "Monthly",
      "12 months",
      "24 months",
      "24 months",
      1
     ],
     [
      "Extras",
      "None",
      "Streaming",
      "Streaming, 5G",
      "5G, 4 lines",
      3
     ],
     [
      "Per line",
      "$25",
      "$35",
      "$45",
      "$17.50",
      4
     ]
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onChoose"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "picked",
       "value": "${= result}"
      },
      {
       "type": "componentEvent",
       "event": "choose_plan",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "Recommendation1": {
   "type": "Recommendation",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Plus is the sweet spot",
    "why": "Unlimited calls and 40 GB for $10 more than Lite; Max only pays off if you roam outside the EU.",
    "eyebrow": "Recommendation"
   }
  }
 },
 "variables": {
  "comparison_wide": [
   {
    "name": "picked",
    "type": "text",
    "value": ""
   }
  ]
 }
}