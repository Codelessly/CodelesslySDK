{
 "schema": 3,
 "roots": [
  "weather"
 ],
 "nodes": {
  "weather": {
   "type": "canvas",
   "slots": {
    "body": "ChatCard1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFF3F4F6"
     }
    ]
   }
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "children": [
    "WeatherNow1",
    "SectionLabel1",
    "WeatherHours1",
    "SectionLabel2",
    "WeatherDay1",
    "WeatherDay2",
    "WeatherDay3",
    "alert"
   ]
  },
  "WeatherNow1": {
   "type": "WeatherNow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Lisbon",
    "detail": "Mostly sunny",
    "temp": "22",
    "high": "24",
    "low": "15",
    "kind": "partly"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Next 5 hours",
    "note": "Rain from 5 PM"
   }
  },
  "WeatherHours1": {
   "type": "WeatherHours",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "hours": [
     "1 PM",
     "2 PM",
     "3 PM",
     "4 PM",
     "5 PM"
    ],
    "temps": [
     23,
     24,
     24,
     23,
     21
    ],
    "kinds": [
     "sun",
     "sun",
     "partly",
     "cloud",
     "rain"
    ]
   }
  },
  "SectionLabel2": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Next 3 days"
   }
  },
  "WeatherDay1": {
   "type": "WeatherDay",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 30.0
   },
   "props": {
    "label": "Tue",
    "kind": "rain",
    "low": 14,
    "high": 20,
    "min": 13,
    "max": 25
   }
  },
  "WeatherDay2": {
   "type": "WeatherDay",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 30.0
   },
   "props": {
    "label": "Wed",
    "kind": "partly",
    "low": 13,
    "high": 18,
    "min": 13,
    "max": 25
   }
  },
  "WeatherDay3": {
   "type": "WeatherDay",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 30.0
   },
   "props": {
    "label": "Thu",
    "kind": "sun",
    "low": 15,
    "high": 25,
    "min": 13,
    "max": 25
   }
  },
  "alert": {
   "type": "ActionButton",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46.0
   },
   "bind": {
    "props.label": "${= alert?\"Rain alert is on\":\"Alert me before it rains\"}",
    "props.icon": "${= alert?\"notifications_active_rounded\":\"notifications_none_rounded\"}",
    "props.tone": "${= alert?\"good\":\"primary\"}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "alert",
       "value": "${= !alert}"
      },
      {
       "type": "componentEvent",
       "event": "rain_alert",
       "value": "${alert}"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "weather": [
   {
    "name": "alert",
    "type": "boolean",
    "value": false
   }
  ]
 }
}