    "icon": "tune_rounded",
    "size": 22,
    "color": "inkSoft"
   },
   "bind": {
    "props.icon": "${current.icon}"
   }
  },
  "otherTitle": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 200
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "text": "${section} settings",
    "textAlign": "center",
    "style": {
     "from": "blockTitle",
     "color": "ink"
    }
   }
  },
  "otherText": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 420
    },
    "height": {
     "hug": 40
    },
    "constraints": {
     "maxWidth": 420
    }
   },
   "props": {
    "text": "${current.empty}",
    "textAlign": "center",
    "style": {
     "from": "body",
     "color": "inkSoft"
    }
   }
  },
  "otherBack": {
   "type": "textButton",
   "layout": {
    "width": {
     "hug": 140
    },
    "height": 36
   },
   "props": {
    "label": "Back to Profile",
    "icon": "arrow_back_rounded",
    "style": {
     "foregroundColor": "accent",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": 600
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "section",
       "value": "Profile"
      }
     ]
    }
   ]
  },
  "bar": {
   "type": "column",
   "children": [
    "barInner"
   ],
   "layout": {
    "width": {
     "fill": 1032
    },
    "height": 64,
    "padding": [
     40,
     0,
     40,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "top"
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "layout": {
       "padding": [
        24,
        0,
        24,
        0
       ]
      }
     }
    }
   ]
  },
  "barInner": {
   "type": "row",
   "children": [
    "barDot",
    "barText",
    "cancelBtn",
    "saveBtn"
   ],
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 36
    },
    "constraints": {
     "maxWidth": 960
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   }
  },
  "barDot": {
   "type": "box",
   "layout": {
    "width": 8,
    "height": 8
   },
   "decoration": {
    "fills": [
     {
      "color": "good"
     }
    ],
    "shape": "circle"
   },
   "bind": {
    "decoration.fills[0].color": "${= length(bio) > 160 ? theme.colors.bad : dirty ? theme.colors.warn : theme.colors.good}"
   }
  },
  "barText": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 500
    },
    "height": {
     "hug": 17
    }
   },
   "props": {
    "text": "All changes saved",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "from": "meta",
     "color": "inkSoft"
    }
   },
   "bind": {
    "props.text": "${= length(bio) > 160 ? 'Bio is over 160 characters' : name == '' ? 'Display name is required' : dirty ? 'You have unsaved changes' : 'All changes saved'}"
   }
  },
  "cancelBtn": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 84
    },
    "height": 36
   },
   "props": {
    "label": "Cancel",
    "style": {
     "foregroundColor": "ink",
     "side": {
      "color": "lineStrong",
      "width": 1
     },
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": 600
     }
    }
   },
   "bind": {
    "props.enabled": "${dirty}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "name",
       "value": "${sName}"
      },
      {
       "type": "setVariable",
       "variable": "username",
       "value": "${sUsername}"
      },
      {
       "type": "setVariable",
       "variable": "bio",
       "value": "${sBio}"
      },
      {
       "type": "setVariable",
       "variable": "tz",
       "value": "${sTz}"
      },
      {
       "type": "setVariable",
       "variable": "isPublic",
       "value": "${sPublic}"
      },
      {
       "type": "setVariable",
       "variable": "avatar",
       "value": "${sAvatar}"
      },
      {
       "type": "setVariable",
       "variable": "notifs",
       "value": "${sNotifs}"
      }
     ]
    }
   ]
  },
  "saveBtn": {
   "type": "filledButton",
   "layout": {
    "width": {
     "hug": 128
    },
    "height": 36
   },
   "props": {
    "label": "Save changes",
    "style": {
     "backgroundColor": "tile",
     "foregroundColor": "inkFaint",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": 600
     }
    }
   },
   "bind": {
    "props.enabled": "${canSave}",
    "props.style.backgroundColor": "${= canSave ? theme.colors.accent : theme.colors.tile}",
    "props.style.foregroundColor": "${= canSave ? theme.colors.onAccent : theme.colors.inkFaint}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sName",
       "value": "${name}"
      },
      {
       "type": "setVariable",
       "variable": "sUsername",
       "value": "${username}"
      },
      {
       "type": "setVariable",
       "variable": "sBio",
       "value": "${bio}"
      },
      {
       "type": "setVariable",
       "variable": "sTz",
       "value": "${tz}"
      },
      {
       "type": "setVariable",
       "variable": "sPublic",
       "value": "${isPublic}"
      },
      {
       "type": "setVariable",
       "variable": "sAvatar",
       "value": "${avatar}"
      },
      {
       "type": "setVariable",
       "variable": "sNotifs",
       "value": "${notifs}"
      },
      {
       "type": "showToast",
       "message": "Changes saved"
      }
     ]
    }
   ]
  }
 },
