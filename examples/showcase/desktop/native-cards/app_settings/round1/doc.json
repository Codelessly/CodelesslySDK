{
 "schema": 3,
 "id": "PlumeSettings",
 "roots": [
  "settings"
 ],
 "nodes": {
  "settings": {
   "type": "canvas",
   "name": "Settings",
   "slots": {
    "body": "shell"
   },
   "layout": {
    "width": 1280,
    "height": 800
   },
   "decoration": {
    "fills": [
     {
      "color": "page"
     }
    ]
   }
  },
  "shell": {
   "type": "row",
   "children": [
    "side",
    "main"
   ],
   "layout": {
    "width": {
     "fill": 1280
    },
    "height": {
     "fill": 800
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   }
  },
  "side": {
   "type": "column",
   "children": [
    "brand",
    "sideEyebrow",
    "navList",
    "sideSpacer",
    "me"
   ],
   "layout": {
    "width": 248,
    "height": {
     "fill": 800
    },
    "padding": [
     14,
     20,
     14,
     14
    ]
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 2
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "right"
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "layout": {
       "width": 76,
       "padding": [
        12,
        20,
        12,
        14
       ]
      }
     }
    }
   ]
  },
  "brand": {
   "type": "row",
   "children": [
    "logo",
    "brandName"
   ],
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 30
    },
    "padding": [
     8,
     0,
     8,
     20
    ]
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "layout": {
       "padding": [
        0,
        0,
        0,
        20
       ]
      },
      "props": {
       "mainAxisAlignment": "center"
      }
     }
    }
   ]
  },
  "logo": {
   "type": "row",
   "children": [
    "logoIcon"
   ],
   "layout": {
    "width": 30,
    "height": 30
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "ink"
     }
    ],
    "radius": 9
   }
  },
  "logoIcon": {
   "type": "icon",
   "layout": {
    "width": 17,
    "height": 17
   },
   "props": {
    "icon": "history_edu_rounded",
    "size": 17,
    "color": "card"
   }
  },
  "brandName": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 22
    }
   },
   "props": {
    "text": "Plume",
    "style": {
     "from": "title",
     "fontSize": 18,
     "color": "ink"
    }
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "sideEyebrow": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 14
    },
    "padding": [
     10,
     4,
     10,
     8
    ]
   },
   "props": {
    "text": "SETTINGS",
    "style": {
     "from": "eyebrow",
     "color": "inkFaint"
    }
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "navList": {
   "type": "listView",
   "children": [
    "navItem"
   ],
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 230
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 2
   },
   "bind": {
    "data": "${sections}"
   }
  },
  "navItem": {
   "type": "row",
   "children": [
    "navIcon",
    "navLabel"
   ],
   "layout": {
    "width": {
     "fill": 220
    },
    "height": 36,
    "padding": [
     10,
     0,
     10,
     0
    ]
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "#00000000"
     }
    ],
    "strokeWidth": 1.2,
    "radius": 9
   },
   "inkWell": {
    "hoverColor": "hoverOverlay"
   },
   "tooltip": "${item.name}",
   "bind": {
    "decoration.fills[0].color": "${= section == item.name ? theme.colors.tile : '#00000000'}",
    "decoration.strokes[0].color": "${= section == item.name ? theme.colors.accentLine : '#00000000'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "section",
       "value": "${item.name}"
      }
     ]
    }
   ],
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "layout": {
       "padding": [
        0,
        0,
        0,
        0
       ]
      },
      "props": {
       "mainAxisAlignment": "center"
      }
     }
    }
   ]
  },
  "navIcon": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "person_outline_rounded",
    "size": 18,
    "color": "inkSoft"
   },
   "bind": {
    "props.icon": "${item.icon}",
    "props.color": "${= section == item.name ? theme.colors.accent : theme.colors.inkSoft}"
   }
  },
  "navLabel": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 16
    }
   },
   "props": {
    "text": "${item.name}",
    "maxLines": 1,
    "style": {
     "from": "controlMedium",
     "color": "ink"
    }
   },
   "bind": {
    "props.style.fontWeight": "${= section == item.name ? 600 : 500}"
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "sideSpacer": {
   "type": "spacer"
  },
  "me": {
   "type": "row",
   "children": [
    "meAvatar",
    "meText"
   ],
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 44
    },
    "padding": [
     8,
     14,
     8,
     2
    ]
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "top"
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "layout": {
       "padding": [
        0,
        14,
        0,
        2
       ]
      },
      "props": {
       "mainAxisAlignment": "center"
      }
     }
    }
   ]
  },
  "meAvatar": {
   "type": "row",
   "children": [
    "meInitials"
   ],
   "layout": {
    "width": 30,
    "height": 30
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "lilacMid"
     }
    ],
    "shape": "circle"
   },
   "bind": {
    "decoration.fills[0].color": "${= sAvatar == 0 ? theme.colors.lilacMid : sAvatar == 1 ? theme.colors.skyMid : sAvatar == 2 ? theme.colors.mintMid : theme.colors.sandMid}"
   }
  },
  "meInitials": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 12
    },
    "height": {
     "hug": 14
    }
   },
   "props": {
    "text": "${= upper(substring(sName, 0, 1))}",
    "style": {
     "from": "chip",
     "fontSize": 12.5,
     "color": "ink"
    }
   }
  },
  "meText": {
   "type": "column",
   "children": [
    "meName",
    "meMail"
   ],
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 34
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 1
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "meName": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 17
    }
   },
   "props": {
    "text": "${sName}",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "from": "panelTitle",
     "fontSize": 13,
     "color": "ink"
    }
   }
  },
  "meMail": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 16
    }
   },
   "props": {
    "text": "maya@plume.app",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "from": "bodySecondary",
     "color": "inkFaint"
    }
   }
  },
  "main": {
   "type": "column",
   "children": [
    "scroll",
    "bar"
   ],
   "layout": {
    "width": {
     "fill": 1032
    },
    "height": {
     "fill": 800
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   }
  },
  "scroll": {
   "type": "column",
   "children": [
    "rail"
   ],
   "layout": {
    "width": {
     "fill": 1032
    },
    "height": {
     "fill": 736
    },
    "padding": [
     40,
     36,
     40,
     56
    ]
   },
   "props": {
    "scrollable": true,
    "crossAxisAlignment": "center"
   },
   "media": [
    {
     "maxWidth": 900,
     "patch": {
      "layout": {
       "padding": [
        24,
        24,
        24,
        40
       ]
      }
     }
    }
   ]
  },
  "rail": {
   "type": "column",
   "children": [
    "head",
    "profileView",
    "otherView"
   ],
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 1200
    },
    "constraints": {
     "maxWidth": 960
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 32
   }
  },
  "head": {
   "type": "column",
   "children": [
    "crumb",
    "title",
    "lead"
   ],
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 80
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 6
   }
  },
  "crumb": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 17
    }
   },
   "props": {
    "text": "Settings  /  ${section}",
    "style": {
     "from": "meta",
     "color": "inkFaint"
    }
   }
  },
  "title": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 32
    }
   },
   "props": {
    "text": "${section}",
    "style": {
     "fontFamily": "Inter Display",
     "fontSize": 26,
     "fontWeight": 700,
     "height": 1.2,
     "letterSpacing": -0.5,
     "color": "ink"
    }
   }
  },
  "lead": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "text": "${current.lead}",
    "style": {
     "from": "lead",
     "color": "inkSoft"
    }
   }
  },
  "profileView": {
   "type": "column",
   "children": [
    "secProfile",
    "secNotif",
    "secDanger"
   ],
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 1000
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 40
   },
   "bind": {
    "visible": "${= section == 'Profile'}"
   }
  },
  "secProfile": {
   "type": "flex",
   "children": [
    "infoProfile",
    "cardProfile"
   ],
   "layout": {
    "width": {
     "fill": 952
    },
    "height": {
     "hug": 520
    }
   },
   "props": {
    "direction": "horizontal",
    "spacing": 32,
    "crossAxisAlignment": "start"
   },
   "media": [
    {
     "maxWidth": 1100,
     "patch": {
      "props": {
       "direction": "vertical",
       "spacing": 14
      }
     }
    }
   ]
  },
  "infoProfile": {
   "type": "column",
   "children": [
    "infoProfileT",
    "infoProfileD"
   ],
   "layout": {
    "width": 240,
    "height": {
     "hug": 60
    },
    "padding": [
     0,
     4,
     0,
     0
    ]
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 4
   },
   "media": [
    {
     "maxWidth": 1100,
     "patch": {
      "layout": {
       "width": {
        "fill": 640
       }
      }
     }
    }
   ]
  },
  "infoProfileT": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 240
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "text": "Public profile",
    "style": {
     "from": "blockTitle",
     "color": "ink"
    }
   }
  },
  "infoProfileD": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 240
    },
    "height": {
     "hug": 36
    }
   },
   "props": {
    "text": "Your name, handle and bio appear on published pieces and in shared drafts.",
    "style": {
     "from": "bodySecondary",
     "color": "inkSoft"
    }
   }
  },
  "cardProfile": {
   "type": "column",
   "children": [
    "avatarRow",
    "nameRow",
    "bioGroup",
    "tzGroup",
    "rule1",
    "publicRow"
   ],
   "layout": {
    "width": {
     "fill": 680
    },
    "height": {
     "hug": 520
    },
    "padding": 24
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 20
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "radius": 12
   }
  },
  "avatarRow": {
   "type": "row",
   "children": [
    "avatar",
    "avatarText",
    "changeBtn"
   ],
   "layout": {
    "width": {
     "fill": 632
    },
    "height": {
     "hug": 72
    }
   },
   "props": {
    "spacing": 16,
    "crossAxisAlignment": "center"
   }
  },
  "avatar": {
   "type": "row",
   "children": [
    "avatarInitials"
   ],
   "layout": {
    "width": 72,
    "height": 72
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "shape": "circle",
    "fills": [
     {
      "color": "lilacMid"
     },
     {
      "type": "radial",
      "center": [
       -0.45,
       -0.55
      ],
      "radius": 0.9,
      "stops": [
       {
        "position": 0,
        "color": "artShine"
       },
       {
        "position": 1,
        "color": "#00FFFFFF"
       }
      ]
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1
   },
   "bind": {
    "decoration.fills[0].color": "${= avatar == 0 ? theme.colors.lilacMid : avatar == 1 ? theme.colors.skyMid : avatar == 2 ? theme.colors.mintMid : theme.colors.sandMid}"
   }
  },
  "avatarInitials": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 24
    },
    "height": {
     "hug": 30
    }
   },
   "props": {
    "text": "${= upper(substring(name, 0, 1))}",
    "style": {
     "fontFamily": "Inter Display",
     "fontSize": 28,
     "fontWeight": 800,
     "height": 1.05,
     "color": "lilacInk"
    }
   },
   "bind": {
    "props.style.color": "${= avatar == 0 ? theme.colors.lilacInk : avatar == 1 ? theme.colors.skyInk : avatar == 2 ? theme.colors.mintInk : theme.colors.sandInk}"
   }
  },
  "avatarText": {
   "type": "column",
   "children": [
    "avatarTitle",
    "avatarHint"
   ],
   "layout": {
    "width": {
     "fill": 400
    },
    "height": {
     "hug": 40
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 2
   }
  },
  "avatarTitle": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 400
    },
    "height": {
     "hug": 19
    }
   },
   "props": {
    "text": "Profile picture",
    "style": {
     "from": "rowTitle",
     "fontSize": 14,
     "color": "ink"
    }
   }
  },
  "avatarHint": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 400
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "A monogram from your name. Change picks another ground.",
    "style": {
     "from": "bodySecondary",
     "color": "inkSoft"
    }
   }
  },
  "changeBtn": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 96
    },
    "height": 36
   },
   "props": {
    "label": "Change",
    "icon": "palette_outlined",
    "style": {
     "foregroundColor": "ink",
     "side": {
      "color": "lineStrong",
      "width": 1
     },
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": 600
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "avatar",
       "value": "${= (avatar + 1) % 4}"
      }
     ]
    }
   ]
  },
  "nameRow": {
   "type": "row",
   "children": [
    "nameGroup",
    "userGroup"
   ],
   "layout": {
    "width": {
     "fill": 632
    },
    "height": {
     "hug": 64
    }
   },
   "props": {
    "spacing": 16,
    "crossAxisAlignment": "start"
   }
  },
  "nameGroup": {
   "type": "column",
   "children": [
    "nameLabel",
    "nameField"
   ],
   "layout": {
    "width": {
     "fill": 308
    },
    "height": {
     "hug": 64
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 6
   }
  },
  "nameLabel": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 308
    },
    "height": {
     "hug": 15
    }
   },
   "props": {
    "text": "Display name",
    "style": {
     "from": "fieldLabel",
     "color": "inkSoft"
    }
   }
  },
  "nameField": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 308
    },
    "height": {
     "hug": 40
    }
   },
   "props": {
    "initialValue": "Maya Alvarez",
    "style": {
     "from": "inputText",
     "color": "ink"
    },
    "decoration": {
     "hintText": "Your name"
    }
   },
   "bind": {
    "props.initialValue": "${name}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "name",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "userGroup": {
   "type": "column",
   "children": [
    "userLabel",
    "userField"
   ],
   "layout": {
    "width": {
     "fill": 308
    },
    "height": {
     "hug": 64
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 6
   }
  },
  "userLabel": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 308
    },
    "height": {
     "hug": 15
    }
   },
   "props": {
    "text": "Username",
    "style": {
     "from": "fieldLabel",
     "color": "inkSoft"
    }
   }
  },
  "userField": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 308
    },
    "height": {
     "hug": 40
    }
   },
   "props": {
    "initialValue": "maya",
    "style": {
     "from": "inputText",
     "color": "ink"
    },
    "decoration": {
     "hintText": "handle",
     "prefixText": "plume.app/"
    }
   },
   "bind": {
    "props.initialValue": "${username}"
   },
   "actions": [
    {
     "trigger": {
