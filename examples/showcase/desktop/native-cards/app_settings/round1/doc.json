    "type": "integer",
    "formula": "count(notifs, n => n.on)"
   },
   {
    "name": "dirty",
    "type": "boolean",
    "formula": "name != sName || username != sUsername || bio != sBio || tz != sTz || isPublic != sPublic || avatar != sAvatar || notifKey != sNotifKey"
   },
   {
    "name": "canSave",
    "type": "boolean",
    "formula": "dirty && length(bio) <= 160 && name != ''"
   },
   {
    "name": "confirmDelete",
    "type": "boolean",
