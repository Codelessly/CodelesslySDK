   },
   "layout": {
    "width": {
     "hug": 70
    },
    "height": {
     "hug": 22
    }
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "navEyebrow": {
   "type": "text",
   "props": {
    "text": "WORKSPACE",
    "style": {
     "from": "eyebrow",
     "color": "inkFaint"
    }
   },
   "layout": {
    "width": {
     "fill": 204
    },
    "height": {
     "hug": 14
    },
    "padding": [
     10,
     18,
     0,
     6
    ]
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "navList": {
   "type": "listView",
   "children": [
    "navItem"
   ],
   "layout": {
    "width": {
     "fill": 204
    },
    "height": {
     "hug": 240
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 2
   },
   "bind": {
    "data": "${sections}"
   }
  },
  "navItem": {
   "type": "row",
   "children": [
    "navIcon",
    "navLabel",
    "navBadge"
   ],
   "layout": {
    "width": {
     "fill": 204
    },
    "height": 38,
    "padding": [
     10,
     0,
     10,
     0
    ]
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "radius": 9
   },
   "inkWell": {
    "overlayColor": "hoverOverlay"
   },
   "tooltip": "${item.label}",
   "bind": {
    "decoration.fills[0].color": "${= item.label == section ? theme.colors.tile : '#00000000'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "section",
       "value": "${item.label}"
      }
     ]
    }
   ],
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "padding": 0
      },
      "props": {
       "mainAxisAlignment": "center"
      }
     }
    }
   ]
  },
  "navIcon": {
   "type": "icon",
   "props": {
    "icon": "dashboard_outlined",
    "size": 18,
    "color": "inkSoft"
   },
   "layout": {
    "width": 18,
    "height": 18
   },
   "bind": {
    "props.icon": "${item.icon}",
    "props.color": "${= item.label == section ? theme.colors.accent : theme.colors.inkSoft}"
   }
  },
  "navLabel": {
   "type": "text",
   "props": {
    "text": "${item.label}",
    "style": {
     "from": "controlMedium",
     "color": "inkSoft"
    },
    "maxLines": 1
   },
   "layout": {
    "width": {
     "fill": 120
    },
    "height": {
     "hug": 16
    }
   },
   "bind": {
    "props.style.color": "${= item.label == section ? theme.colors.ink : theme.colors.inkSoft}",
    "props.style.fontWeight": "${= item.label == section ? 600 : 500}"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "navBadge": {
   "type": "row",
   "children": [
    "navBadgeText"
   ],
   "layout": {
    "width": {
     "hug": 26
    },
    "height": 20,
    "padding": [
     7,
     0,
     7,
     0
    ]
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "tileDeep"
     }
    ],
    "radius": 999
   },
   "bind": {
    "visible": "${= item.badge != ''}"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false,
      "bind": {
       "visible": null
      }
     }
    }
   ]
  },
  "navBadgeText": {
   "type": "text",
   "props": {
    "text": "${item.badge}",
    "style": {
     "from": "badge",
     "fontWeight": 600,
     "color": "inkSoft"
    }
   },
   "layout": {
    "width": {
     "hug": 12
    },
    "height": {
     "hug": 13
    }
   }
  },
  "sideSpacer": {
   "type": "spacer",
   "layout": {
    "width": {
     "fill": 204
    }
   }
  },
  "userRow": {
   "type": "row",
   "children": [
    "avatar",
    "userText",
    "userMore"
   ],
   "layout": {
    "width": {
     "fill": 204
    },
    "height": {
     "hug": 52
    },
    "padding": [
     10,
     10,
     8,
     10
    ]
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "radius": 12
   },
   "inkWell": {
    "overlayColor": "hoverOverlay"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "padding": [
        4,
        6,
        4,
        6
       ]
      },
      "props": {
       "mainAxisAlignment": "center"
      },
      "decoration": {
       "strokes": []
      }
     }
    }
   ]
  },
  "avatar": {
   "type": "row",
   "children": [
    "avatarText"
   ],
   "layout": {
    "width": 32,
    "height": 32
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "tileDeep"
     }
    ],
    "shape": "circle"
   }
  },
  "avatarText": {
   "type": "text",
   "props": {
    "text": "MO",
    "style": {
     "from": "chip",
     "fontSize": 11.5,
     "color": "ink"
    }
   },
   "layout": {
    "width": {
     "hug": 18
    },
    "height": {
     "hug": 14
    }
   }
  },
  "userText": {
   "type": "column",
   "children": [
    "userName",
    "userRole"
   ],
   "layout": {
    "width": {
     "fill": 120
    },
    "height": {
     "hug": 34
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 1
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "userName": {
   "type": "text",
   "props": {
    "text": "Maya Okafor",
    "style": {
     "from": "controlMedium",
     "fontWeight": 600,
     "color": "ink"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 120
    },
    "height": {
     "hug": 16
    }
   }
  },
  "userRole": {
   "type": "text",
   "props": {
    "text": "Ops lead \u00b7 Harbor Co.",
    "style": {
     "from": "bodySecondary",
     "color": "inkFaint"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 120
    },
    "height": {
     "hug": 16
    }
   }
  },
  "userMore": {
   "type": "icon",
   "props": {
    "icon": "unfold_more_rounded",
    "size": 16,
    "color": "inkFaint"
   },
   "layout": {
    "width": 16,
    "height": 16
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "main": {
   "type": "column",
   "children": [
    "topbar",
    "content"
   ],
   "layout": {
    "width": {
     "fill": 1048
    },
    "height": {
     "fill": 800
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   }
  },
  "topbar": {
   "type": "row",
   "children": [
    "titleBlock",
    "rangeSeg",
    "search",
    "newOrder"
   ],
   "layout": {
    "width": {
     "fill": 1048
    },
    "height": 64,
    "padding": [
     24,
     0,
     24,
     0
    ]
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "titleBlock": {
   "type": "column",
   "children": [
    "pageTitle",
    "pageSub"
   ],
   "layout": {
    "width": {
     "fill": 400
    },
    "height": {
     "hug": 44
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 1
   }
  },
  "pageTitle": {
   "type": "text",
   "props": {
    "text": "${section}",
    "style": {
     "from": "pageTitle",
     "color": "ink"
    },
    "maxLines": 1
   },
   "layout": {
    "width": {
     "fill": 400
    },
    "height": {
     "hug": 26
    }
   }
  },
  "pageSub": {
   "type": "text",
   "props": {
    "text": "Tue, 14 May \u00b7 All locations",
    "style": {
     "from": "bodySecondary",
     "color": "inkFaint"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 400
    },
    "height": {
     "hug": 18
    }
   }
  },
  "rangeSeg": {
   "type": "row",
   "children": [
    "rangeList"
   ],
   "layout": {
    "width": {
     "hug": 150
    },
    "height": 34,
    "padding": 3
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 10
   }
  },
  "rangeList": {
   "type": "listView",
   "children": [
    "rangeItem"
   ],
   "layout": {
    "width": 144,
    "height": 28
   },
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${ranges}"
   }
  },
  "rangeItem": {
   "type": "row",
   "children": [
    "rangeText"
   ],
   "layout": {
    "width": 48,
    "height": {
     "fill": 28
    }
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "#00000000"
     }
    ],
    "strokeWidth": 1.2,
    "radius": 8
   },
   "bind": {
    "decoration.fills[0].color": "${= item == range ? theme.colors.card : '#00000000'}",
    "decoration.strokes[0].color": "${= item == range ? theme.colors.accent : '#00000000'}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "range",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "rangeText": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "from": "controlCompact",
     "color": "inkSoft"
    }
   },
   "layout": {
    "width": {
     "hug": 24
    },
    "height": {
     "hug": 15
    }
   },
   "bind": {
    "props.style.color": "${= item == range ? theme.colors.ink : theme.colors.inkSoft}",
    "props.style.fontWeight": "${= item == range ? 600 : 500}"
   }
  },
  "search": {
   "type": "textField",
   "layout": {
    "width": 240,
    "height": {
     "hug": 36
    }
   },
   "props": {
    "decoration": {
     "hintText": "Search orders or customers",
     "prefixIcon": {
      "icon": "search",
      "size": 16
     }
    }
   },
   "bind": {
    "props.initialValue": "${search}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "search",
       "value": "${result}"
      }
     ]
    }
   ],
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "width": 170
      }
     }
    }
   ]
  },
  "newOrder": {
   "type": "filledButton",
   "layout": {
    "width": 124,
    "height": 36
   },
   "props": {
    "label": "New order",
    "icon": "add_rounded",
    "style": {
     "backgroundColor": "accent",
     "foregroundColor": "onAccent",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": 600
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "orders",
       "op": "insert",
       "index": 0,
       "value": "${= {num: 'HB-' + (10417 + length(orders)), customer: 'Draft order', status: 'Draft', total: '$0.00', date: 'Just now'}}"
      },
      {
       "type": "setVariable",
       "variable": "search",
       "value": ""
      },
      {
       "type": "showToast",
       "message": "Draft order created"
      }
     ]
    }
   ]
  },
  "content": {
   "type": "column",
   "children": [
    "statGrid",
    "insights",
    "ordersCard"
   ],
   "layout": {
    "width": {
     "fill": 1048
    },
    "height": {
     "fill": 736
    },
    "padding": 24
   },
   "props": {
    "scrollable": true,
    "spacing": 16,
    "crossAxisAlignment": "stretch"
   }
  },
  "statGrid": {
   "type": "gridView",
   "children": [
    "stat"
   ],
   "layout": {
    "width": {
     "fill": 1000
    },
    "height": {
     "hug": 120
    }
   },
   "props": {
    "crossAxisCount": 4,
    "crossAxisSpacing": 16,
    "mainAxisSpacing": 16,
    "shrinkWrapRows": true,
    "physics": "never"
   },
   "bind": {
    "data": "${stats}"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "props": {
       "crossAxisCount": 2
      }
     }
    }
   ]
  },
  "stat": {
   "type": "column",
   "children": [
    "statTop",
    "statValue",
    "statBottom"
   ],
   "layout": {
    "width": {
     "fill": 238
    },
    "height": {
     "hug": 120
    },
    "padding": [
     18,
     16,
     18,
     16
    ]
   },
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "radius": 14
   }
  },
  "statTop": {
   "type": "row",
   "children": [
    "statLabel",
    "statMark"
   ],
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 28
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   }
  },
  "statLabel": {
   "type": "text",
   "props": {
    "text": "${item.label}",
    "style": {
     "from": "meta",
     "color": "inkSoft"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 17
    }
   }
  },
  "statMark": {
   "type": "row",
   "children": [
    "statIcon"
   ],
   "layout": {
    "width": 28,
    "height": 28
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 8
   }
  },
  "statIcon": {
   "type": "icon",
   "props": {
    "icon": "payments_outlined",
    "size": 15,
    "color": "inkSoft"
   },
   "layout": {
    "width": 15,
    "height": 15
   },
   "bind": {
    "props.icon": "${item.icon}"
   }
  },
  "statValue": {
   "type": "text",
   "props": {
    "text": "${item.value}",
    "style": {
     "from": "numberLarge",
     "fontSize": 28,
     "color": "ink"
    },
    "maxLines": 1,
    "scaleDown": true
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 30
    },
    "padding": [
     0,
     8,
     0,
     10
    ]
   }
  },
  "statBottom": {
   "type": "row",
   "children": [
    "delta",
    "statNote"
   ],
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   }
  },
  "delta": {
   "type": "row",
   "children": [
    "deltaIcon",
    "deltaText"
   ],
   "layout": {
    "width": {
     "hug": 56
    },
    "height": {
     "hug": 20
    },
    "padding": [
     5,
     3,
     7,
     3
    ]
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "goodTint"
     }
    ],
    "radius": 999
   },
   "bind": {
    "decoration.fills[0].color": "${= (!startsWith(item.delta, '-')) != item.invert ? theme.colors.goodTint : theme.colors.badTint}"
   }
  },
  "deltaIcon": {
   "type": "icon",
   "props": {
    "icon": "arrow_upward_rounded",
    "size": 12,
    "color": "goodDeep"
   },
   "layout": {
    "width": 12,
    "height": 12
   },
   "bind": {
    "props.icon": "${= !startsWith(item.delta, '-') ? 'arrow_upward_rounded' : 'arrow_downward_rounded'}",
    "props.color": "${= (!startsWith(item.delta, '-')) != item.invert ? theme.colors.goodDeep : theme.colors.badDeep}"
   }
  },
  "deltaText": {
   "type": "text",
   "props": {
    "text": "${= replace(replace(item.delta, '+', ''), '-', '')}",
    "style": {
     "from": "chip",
