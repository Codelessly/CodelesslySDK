     "color": "inkSoft"
    }
   },
   "layout": {
    "width": 110,
    "height": {
     "hug": 18
    }
   }
  },
  "oCustomer": {
   "type": "text",
   "props": {
    "text": "${item.customer}",
    "style": {
     "from": "body",
     "fontWeight": 500,
     "color": "ink"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 20
    }
   }
  },
  "oStatusCell": {
   "type": "row",
   "children": [
    "oTag"
   ],
   "layout": {
    "width": 130,
    "height": {
     "hug": 22
    }
   }
  },
  "oTag": {
   "type": "row",
   "children": [
    "oTagDot",
    "oTagText"
   ],
   "layout": {
    "width": {
     "hug": 80
    },
    "height": 22,
    "padding": [
     8,
     0,
     9,
     0
    ]
   },
   "props": {
    "spacing": 6,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 999
   },
   "bind": {
    "decoration.fills[0].color": "${= item.status == 'Delivered' ? theme.colors.goodTint : item.status == 'Processing' ? theme.colors.warnTint : item.status == 'Refunded' ? theme.colors.badTint : theme.colors.tile}"
   }
  },
  "oTagDot": {
   "type": "box",
   "layout": {
    "width": 6,
    "height": 6
   },
   "decoration": {
    "fills": [
     {
      "color": "inkSoft"
     }
    ],
    "shape": "circle"
   },
   "bind": {
    "decoration.fills[0].color": "${= item.status == 'Delivered' ? theme.colors.good : item.status == 'Processing' ? theme.colors.warn : item.status == 'Refunded' ? theme.colors.bad : theme.colors.inkFaint}"
   }
  },
  "oTagText": {
   "type": "text",
   "props": {
    "text": "${item.status}",
    "style": {
     "from": "badge",
     "fontWeight": 600,
     "color": "inkSoft"
    }
   },
   "layout": {
    "width": {
     "hug": 50
    },
    "height": {
     "hug": 13
    }
   },
   "bind": {
    "props.style.color": "${= item.status == 'Delivered' ? theme.colors.goodDeep : item.status == 'Processing' ? theme.colors.warnDeep : item.status == 'Refunded' ? theme.colors.badDeep : theme.colors.inkSoft}"
   }
  },
  "oDate": {
   "type": "text",
   "props": {
    "text": "${item.date}",
    "style": {
     "from": "meta",
     "color": "inkSoft"
    }
   },
   "layout": {
    "width": 120,
    "height": {
     "hug": 17
    }
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "visible": false
     }
    }
   ]
  },
  "oTotal": {
   "type": "text",
   "props": {
    "text": "${item.total}",
    "textAlign": "right",
    "style": {
     "from": "numberSmall",
     "fontSize": 14,
     "color": "ink"
    }
   },
   "layout": {
    "width": 100,
    "height": {
     "hug": 17
    }
   }
  },
  "emptyText": {
   "type": "text",
   "props": {
    "text": "${= 'No orders match \u201c' + search + '\u201d'}",
    "textAlign": "center",
    "style": {
     "from": "body",
     "color": "inkFaint"
    }
   },
   "layout": {
    "width": {
     "fill": 960
    },
    "height": {
     "hug": 20
    },
    "padding": [
     0,
     28,
     0,
     28
    ]
   },
   "bind": {
    "visible": "${= length(shown) == 0}"
   }
  }
 },
