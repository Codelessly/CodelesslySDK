  "text11": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "“A queue is not a pipe. It is a promise about what happens when things go wrong.”",
    "style": {
     "from": "bodyWide",
     "fontSize": 22,
     "fontWeight": 600
    }
   }
  },
  "text12": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "mutedWide"
    },
    "text": "Maya Reyes, Platform Team"
   }
  },
  "text13": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "heading2Wide"
    },
    "text": "How we migrated without downtime"
   }
  },
  "text14": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "bodyWide"
    },
    "text": "We moved services one at a time, writing to both the old broker and the new queue until the consumers agreed. Each consumer declared its own partition key and its own retry budget in a small config file, like the one below."
   }
  },
  "CodeBlock1": {
   "type": "CodeBlock",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "queue.yaml",
    "code": "consumer: billing-invoices\npartition_key: account_id\nretries:\n  max: 5\n  backoff: exponential\ndead_letter: billing-invoices.dlq",
    "language": "yaml",
    "copyable": true
   }
  },
