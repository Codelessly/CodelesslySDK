  "text11": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "“The hard part was never the broker. It was agreeing, forty times over, on what a message is.”",
    "style": {
     "from": "body",
     "fontSize": 22,
     "fontWeight": 600,
     "color": "#FF312E81"
    }
   }
  },
  "text12": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "muted"
    },
    "text": "— Platform team retrospective"
   }
  },
  "Paragraph3": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "We started with a shared envelope: an id, a type, a version, a producer, and the payload. Every consumer reads the envelope first and can reject a version it does not understand without crashing."
   }
  },
  "CodeBlock1": {
   "type": "CodeBlock",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "envelope.ts",
    "code": "export interface Envelope<T> {\\n  id: string;          // ULID, sortable\\n  type: string;        // e.g. \"order.created\"\\n  version: number;     // schema version\\n  producer: string;    // service name\\n  sentAt: string;      // ISO 8601\\n  payload: T;\\n}\\n\\nawait queue.publish(\"orders\", {\\n  type: \"order.created\", version: 2, payload: order,\\n});",
    "language": "typescript",
    "copyable": true
   }
  },
  "text13": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "heading2"
    },
    "text": "What we would do differently"
   }
  },
  "Paragraph4": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "The migration took eleven months instead of the four we planned. Looking back, three decisions would have saved most of that time:"
   }
  },
