       0,
       2
      ],
      "blurRadius": 6
     }
    ]
   },
   "children": [
    "row13",
    "TableHeader1",
    "listView1"
   ]
  },
  "row13": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text12",
    "text13"
   ]
  },
  "text12": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "strong"
    },
    "text": "Latest orders"
   }
  },
  "text13": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "View all",
    "style": {
     "from": "body",
     "color": "primary"
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "tab",
       "value": "orders"
      }
     ]
    }
   ]
  },
  "TableHeader1": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "columns": [
     "Order",
     "Customer",
     "Total",
     "Date",
     "Status"
    ],
    "keys": [
     "id",
     "customer",
     "total",
     "date",
     "status"
    ]
   },
   "bind": {
    "props.desc": "${desc}"
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 8
   },
   "bind": {
    "data": "${= desc ? sortByDesc(orders,x=>x[sort]) : sortBy(orders,x=>x[sort])}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.cells": "${= [item.id,item.customer,money(item.total,\"$\",2),item.date]}",
    "props.badge": "${item.status}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "openOrder",
       "value": "${item.id}"
      }
     ]
    }
   ]
  }
 },
