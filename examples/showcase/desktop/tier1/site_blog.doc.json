    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "client.ts",
    "code": "const queue = connect({ name: 'orders' });\nawait queue.publish({\n  key: order.id,\n  type: 'order.created',\n  payload: order,\n  retries: 5,\n  deadLetter: 'orders.dlq'\n});",
    "language": "typescript",
    "copyable": true
   }
  },
