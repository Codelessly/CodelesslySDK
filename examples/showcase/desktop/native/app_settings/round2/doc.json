    "height": 56
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFEFF4FF"
     }
    ],
    "shape": "circle"
   }
  },
  "phIcon": {
   "type": "icon",
   "layout": {
    "width": 26,
    "height": 26
   },
   "props": {
    "icon": "palette_outlined",
    "color": "#FF2563EB",
    "size": 26
   },
   "bind": {
    "props.icon": "${sectionIcon}"
   }
  },
  "phTitle": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 200
    },
    "height": {
     "hug": 28
    }
   },
   "props": {
    "text": "${sectionLabel} is on its way",
    "textAlign": "center",
    "style": {
     "fontFamily": "Inter Display",
     "fontSize": 22,
     "fontWeight": 700,
     "letterSpacing": -0.44,
     "color": "#FF0F172A"
    }
   }
  },
  "phDesc": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 420
    },
    "height": {
     "hug": 46
    },
    "constraints": {
     "maxWidth": 440
    }
   },
   "props": {
    "text": "There is nothing to change here yet. Your profile, notifications and account options are under Profile.",
    "textAlign": "center",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 15,
     "height": 1.55,
     "color": "#FF64748B"
    }
   }
  },
  "phBtn": {
   "type": "textButton",
   "layout": {
    "width": 160,
    "height": 40
   },
   "props": {
    "label": "Back to Profile",
    "icon": "arrow_back",
    "style": {
     "foregroundColor": "#FF2563EB",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 14,
      "fontWeight": 600
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "section",
       "value": "profile"
      },
      {
       "type": "setVariable",
       "variable": "sectionLabel",
       "value": "Profile"
      },
      {
       "type": "setVariable",
       "variable": "sectionDesc",
       "value": "How you appear to readers and collaborators on Plume."
      },
      {
       "type": "setVariable",
       "variable": "sectionIcon",
       "value": "person_outline"
      }
     ]
    }
   ]
  },
  "bottomBar": {
   "type": "row",
   "children": [
    "barDot",
    "barText",
    "barSpacer",
    "cancelBtn",
    "saveBtn"
   ],
   "layout": {
    "width": {
     "fill": 1016
    },
    "height": 72,
    "padding": [
     40,
     0,
     40,
     0
    ]
   },
   "props": {
    "spacing": 10
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "strokeSides": "top",
    "effects": [
     {
      "type": "dropShadow",
      "color": "#080F172A",
      "offset": [
       0,
       -4
      ],
      "blurRadius": 16
     }
    ]
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "padding": [
        24,
        0,
        24,
        0
       ]
      }
     }
    }
   ]
  },
  "barDot": {
   "type": "box",
   "layout": {
    "width": 8,
    "height": 8
   },
   "decoration": {
    "shape": "circle",
    "fills": [
     {
      "color": "#FF16A34A"
     }
    ]
   },
   "bind": {
    "decoration.fills[0].color": "${= bioOver || name == '' ? '#FFDC2626' : (dirty ? '#FFF59E0B' : '#FF16A34A')}"
   }
  },
  "barText": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 200
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "text": "All changes saved",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 14,
     "fontWeight": 500,
     "color": "#FF475569"
    }
   },
   "bind": {
    "props.text": "${= bioOver ? 'Bio is over 160 characters' : (name == '' ? 'Your name is required' : (dirty ? 'You have unsaved changes' : 'All changes saved'))}"
   }
  },
  "barSpacer": {
   "type": "spacer"
  },
  "cancelBtn": {
   "type": "outlinedButton",
   "layout": {
    "width": 104,
    "height": 40
   },
   "props": {
    "label": "Cancel",
    "style": {
     "foregroundColor": "#FF334155",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 14,
      "fontWeight": 600
     }
    }
   },
   "bind": {
    "props.enabled": "${dirty}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "name",
       "value": "${savedName}"
      },
      {
       "type": "setVariable",
       "variable": "username",
       "value": "${savedUsername}"
      },
      {
       "type": "setVariable",
       "variable": "bio",
       "value": "${savedBio}"
      },
      {
       "type": "setVariable",
       "variable": "tz",
       "value": "${savedTz}"
      },
      {
       "type": "setVariable",
       "variable": "isPublic",
       "value": "${savedPublic}"
      },
      {
       "type": "setVariable",
       "variable": "avatar",
       "value": "${savedAvatar}"
      },
      {
       "type": "setVariable",
       "variable": "notifs",
       "value": "${= map(range(length(notifs)), i => set(notifs[i], 'on', savedNotifs[i]))}"
      },
      {
       "type": "showToast",
       "message": "Changes discarded"
      }
     ]
    }
   ]
  },
  "saveBtn": {
   "type": "filledButton",
   "layout": {
    "width": 140,
    "height": 40
   },
   "props": {
    "label": "Save changes",
    "style": {
     "backgroundColor": "#FF2563EB",
     "foregroundColor": "#FFFFFFFF",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 14,
      "fontWeight": 600
     }
    }
   },
   "bind": {
    "props.enabled": "${canSave}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "savedName",
       "value": "${name}"
      },
      {
       "type": "setVariable",
       "variable": "savedUsername",
       "value": "${username}"
      },
      {
       "type": "setVariable",
       "variable": "savedBio",
       "value": "${bio}"
      },
      {
       "type": "setVariable",
       "variable": "savedTz",
       "value": "${tz}"
      },
      {
       "type": "setVariable",
       "variable": "savedPublic",
       "value": "${isPublic}"
      },
      {
       "type": "setVariable",
       "variable": "savedAvatar",
       "value": "${avatar}"
      },
      {
       "type": "setVariable",
       "variable": "savedNotifs",
       "value": "${= map(notifs, n => n.on)}"
      },
      {
       "type": "showToast",
       "message": "Settings saved"
      }
     ]
    }
   ]
  }
 },
