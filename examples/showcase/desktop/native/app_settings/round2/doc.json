{
 "schema": 3,
 "roots": [
  "settings"
 ],
 "nodes": {
  "settings": {
   "type": "canvas",
   "name": "Plume settings",
   "slots": {
    "body": "shell"
   },
   "layout": {
    "width": 1280,
    "height": 800
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFF6F7F9"
     }
    ]
   }
  },
  "shell": {
   "type": "row",
   "children": [
    "sidebar",
    "main"
   ],
   "layout": {
    "width": {
     "fill": 1280
    },
    "height": {
     "fill": 800
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   }
  },
  "sidebar": {
   "type": "column",
   "children": [
    "brand",
    "navLabel",
    "navList",
    "sideSpacer",
    "sideUser"
   ],
   "layout": {
    "width": 264,
    "height": {
     "fill": 800
    },
    "padding": [
     16,
     20,
     16,
     16
    ]
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 4
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "strokeSides": "right"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "width": 216,
       "padding": [
        12,
        20,
        12,
        16
       ]
      }
     }
    }
   ]
  },
  "brand": {
   "type": "row",
   "children": [
    "brandMark",
    "brandName"
   ],
   "layout": {
    "width": {
     "fill": 232
    },
    "height": {
     "hug": 32
    },
    "padding": [
     8,
     0,
     8,
     20
    ]
   },
   "props": {
    "spacing": 10
   }
  },
  "brandMark": {
   "type": "row",
   "children": [
    "brandIcon"
   ],
   "layout": {
    "width": 30,
    "height": 30
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "radius": 9,
    "fills": [
     {
      "type": "linear",
      "begin": "topLeft",
      "end": "bottomRight",
      "stops": [
       {
        "position": 0,
        "color": "#FF2563EB"
       },
       {
        "position": 1,
        "color": "#FF7C3AED"
       }
      ]
     }
    ]
   }
  },
  "brandIcon": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "history_edu",
    "color": "#FFFFFFFF",
    "size": 18
   }
  },
  "brandName": {
   "type": "text",
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 24
    }
   },
   "props": {
    "text": "Plume",
    "style": {
     "fontFamily": "Inter Display",
     "fontSize": 19,
     "fontWeight": 700,
     "letterSpacing": -0.3,
     "color": "#FF0F172A"
    }
   }
  },
  "navLabel": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 232
    },
    "height": {
     "hug": 16
    },
    "padding": [
     12,
     4,
     12,
     8
    ]
   },
   "props": {
    "text": "SETTINGS",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 11,
     "fontWeight": 600,
     "letterSpacing": 1.2,
     "color": "#FF94A3B8"
    }
   }
  },
  "navList": {
   "type": "listView",
   "children": [
    "navItem"
   ],
   "layout": {
    "width": {
     "fill": 232
    },
    "height": {
     "hug": 260
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 2
   },
   "bind": {
    "data": "${sections}"
   }
  },
  "navItem": {
   "type": "row",
   "children": [
    "navIcon",
    "navText"
   ],
   "layout": {
    "width": {
     "fill": 232
    },
    "height": 40,
    "padding": [
     12,
     0,
     12,
     0
    ]
   },
   "props": {
    "spacing": 12
   },
   "decoration": {
    "fills": [
     {
      "color": "#00FFFFFF"
     }
    ],
    "radius": 10
   },
   "bind": {
    "selected": "${= section == item.id}"
   },
   "states": {
    "hovered": {
     "navItem": {
      "decoration": {
       "fills": [
        {
         "color": "#FFF3F4F6"
        }
       ]
      }
     }
    },
    "selected": {
     "navItem": {
      "decoration": {
       "fills": [
        {
         "color": "#FFEFF4FF"
        }
       ]
      }
     },
     "navIcon": {
      "props": {
       "color": "#FF2563EB"
      }
     },
     "navText": {
      "props": {
       "style": {
        "color": "#FF2563EB",
        "fontWeight": 600
       }
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "section",
       "value": "${item.id}"
      },
      {
       "type": "setVariable",
       "variable": "sectionLabel",
       "value": "${item.label}"
      },
      {
       "type": "setVariable",
       "variable": "sectionDesc",
       "value": "${item.desc}"
      },
      {
       "type": "setVariable",
       "variable": "sectionIcon",
       "value": "${item.icon}"
      },
      {
       "type": "scrollTo",
       "node": "${item.target}",
       "durationMs": 400,
       "when": {
        "left": "${item.target}",
        "op": "isNotEmpty"
       }
      }
     ]
    }
   ]
  },
  "navIcon": {
   "type": "icon",
   "layout": {
    "width": 20,
    "height": 20
   },
   "props": {
    "icon": "person_outline",
    "color": "#FF64748B",
    "size": 20
   },
   "bind": {
    "props.icon": "${item.icon}"
   }
  },
  "navText": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "text": "${item.label}",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 14,
     "fontWeight": 500,
     "color": "#FF334155"
    }
   }
  },
  "sideSpacer": {
   "type": "spacer"
  },
  "sideUser": {
   "type": "row",
   "children": [
    "userDot",
    "userCol"
   ],
   "layout": {
    "width": {
     "fill": 232
    },
    "height": {
     "hug": 52
    },
    "padding": 10
   },
   "props": {
    "spacing": 10
   },
   "decoration": {
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 12
   }
  },
  "userDot": {
   "type": "row",
   "children": [
    "userDotIcon"
   ],
   "layout": {
    "width": 32,
    "height": 32
   },
   "props": {
    "mainAxisAlignment": "center"
   },
   "decoration": {
    "shape": "circle",
    "fills": [
     {
      "color": "#FF2563EB"
     }
    ]
   },
   "bind": {
    "decoration.fills[0].color": "${= avatarColors[avatar % 4]}"
   }
  },
  "userDotIcon": {
   "type": "icon",
   "layout": {
    "width": 18,
    "height": 18
   },
   "props": {
    "icon": "person",
    "color": "#E6FFFFFF",
    "size": 18
   }
  },
  "userCol": {
   "type": "column",
   "children": [
    "userName",
    "userPlan"
   ],
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 36
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 1
   }
  },
  "userName": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "${savedName}",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF0F172A"
    }
   }
  },
  "userPlan": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 16
    }
   },
   "props": {
    "text": "Pro plan \u00b7 3 seats",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 12,
     "color": "#FF94A3B8"
    }
   }
  },
  "main": {
   "type": "column",
   "children": [
    "content",
    "bottomBar"
   ],
   "layout": {
    "width": {
     "fill": 1016
    },
    "height": {
     "fill": 800
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   }
  },
  "content": {
   "type": "column",
   "children": [
    "rail"
   ],
   "layout": {
    "width": {
     "fill": 1016
    },
    "height": {
     "fill": 728
    },
    "padding": [
     40,
     36,
     40,
     64
    ]
   },
   "props": {
    "scrollable": true
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "padding": [
        24,
        28,
        24,
        48
       ]
      }
     }
    }
   ]
  },
  "rail": {
   "type": "column",
   "children": [
    "pageHead",
    "formArea",
    "placeholder"
   ],
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 1400
    },
    "constraints": {
     "maxWidth": 960
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 32
   }
  },
  "pageHead": {
   "type": "column",
   "children": [
    "crumb",
    "pageTitle",
    "pageSub"
   ],
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 90
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 6
   }
  },
  "crumb": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "Settings  /  ${sectionLabel}",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 13,
     "fontWeight": 500,
     "color": "#FF94A3B8"
    }
   }
  },
  "pageTitle": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 34
    }
   },
   "props": {
    "text": "${sectionLabel}",
    "style": {
     "fontFamily": "Inter Display",
     "fontSize": 28,
     "fontWeight": 700,
     "height": 1.2,
     "letterSpacing": -0.56,
     "color": "#FF0F172A"
    }
   }
  },
  "pageSub": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 24
    }
   },
   "props": {
    "text": "${sectionDesc}",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 15,
     "height": 1.55,
     "color": "#FF64748B"
    }
   }
  },
  "formArea": {
   "type": "column",
   "children": [
    "grpProfile",
    "rule1",
    "grpNotif",
    "rule2",
    "grpDanger"
   ],
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 1200
    }
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 40
   },
   "bind": {
    "visible": "${= section == 'profile' || section == 'account' || section == 'notifications'}"
   }
  },
  "rule1": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 936
    },
    "height": 1
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFE5E7EB"
     }
    ]
   }
  },
  "rule2": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 936
    },
    "height": 1
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFE5E7EB"
     }
    ]
   }
  },
  "grpProfile": {
   "type": "flex",
   "children": [
    "gpHead",
    "gpCard"
   ],
   "layout": {
    "width": {
     "fill": 936
    },
    "height": {
     "hug": 600
    }
   },
   "props": {
    "direction": "horizontal",
    "spacing": 32,
    "crossAxisAlignment": "start"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "props": {
       "direction": "vertical",
       "spacing": 16,
       "crossAxisAlignment": "stretch"
      }
     }
    }
   ]
  },
  "gpHead": {
   "type": "column",
   "children": [
    "gpTitle",
    "gpDesc"
   ],
   "layout": {
    "width": 248,
    "height": {
     "hug": 80
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 4
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "width": {
        "fill": 504
       }
      }
     }
    }
   ]
  },
  "gpTitle": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 248
    },
    "height": {
     "hug": 22
    }
   },
   "props": {
    "text": "Personal details",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 16,
     "fontWeight": 600,
     "color": "#FF0F172A"
    }
   }
  },
  "gpDesc": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 248
    },
    "height": {
     "hug": 42
    }
   },
   "props": {
    "text": "Your picture, name and bio appear on published pieces and in shared drafts.",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 14,
     "height": 1.5,
     "color": "#FF64748B"
    }
   }
  },
  "gpCard": {
   "type": "column",
   "children": [
    "avatarRow",
    "nameRow",
    "bioBlock",
    "tzBlock",
    "publicRow"
   ],
   "layout": {
    "width": {
     "fill": 656
    },
    "height": {
     "hug": 560
    },
    "padding": 24
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 24
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ],
    "radius": 16,
    "effects": [
     {
      "type": "dropShadow",
      "color": "#0A0F172A",
      "offset": [
       0,
       6
      ],
      "blurRadius": 24
     }
    ]
   }
  },
  "avatarRow": {
   "type": "row",
   "children": [
    "avatar",
    "avatarCol"
   ],
   "layout": {
    "width": {
     "fill": 608
    },
    "height": {
     "hug": 72
    }
   },
   "props": {
    "spacing": 20
   }
  },
  "avatar": {
   "type": "stack",
   "children": [
    "avatarFill",
    "avatarGlyph"
   ],
   "layout": {
    "width": 72,
    "height": 72
   },
   "decoration": {
    "shape": "circle",
    "clip": "antiAlias",
    "strokes": [
     {
      "color": "#FFE5E7EB"
     }
    ]
   }
  },
  "avatarFill": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 72
    },
    "height": {
     "fill": 72
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#FF2563EB"
     },
     {
      "type": "linear",
      "begin": "topLeft",
      "end": "bottomRight",
      "stops": [
       {
        "position": 0,
        "color": "#40FFFFFF"
       },
       {
        "position": 1,
        "color": "#00FFFFFF"
       }
      ]
     }
    ]
   },
   "bind": {
    "decoration.fills[0].color": "${= avatarColors[avatar % 4]}"
   }
  },
  "avatarGlyph": {
   "type": "icon",
   "layout": {
    "width": 52,
    "height": 52,
    "x": {
     "align": 0
    },
    "y": {
     "end": -4
    }
   },
   "props": {
    "icon": "person",
    "color": "#E6FFFFFF",
    "size": 52
   }
  },
  "avatarCol": {
   "type": "column",
   "children": [
    "changeBtn",
    "avatarHint"
   ],
   "layout": {
    "width": {
     "fill": 500
    },
    "height": {
     "hug": 64
    }
   },
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 8
   }
  },
  "changeBtn": {
   "type": "outlinedButton",
   "layout": {
    "width": 116,
    "height": 36
   },
   "props": {
    "label": "Change",
    "icon": "photo_camera_outlined",
    "style": {
     "foregroundColor": "#FF0F172A",
     "textStyle": {
      "fontFamily": "Inter",
      "fontSize": 14,
      "fontWeight": 600
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "avatar",
       "value": "${= (avatar + 1) % 4}"
      }
     ]
    }
   ]
  },
  "avatarHint": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 500
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "JPG, PNG or GIF. Square works best, at least 400 px.",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 12,
     "height": 1.4,
     "color": "#FF94A3B8"
    }
   }
  },
  "nameRow": {
   "type": "row",
   "children": [
    "nameField",
    "userField"
   ],
   "layout": {
    "width": {
     "fill": 608
    },
    "height": {
     "hug": 96
    }
   },
   "props": {
    "wrap": true,
    "spacing": 16,
    "runSpacing": 16,
    "crossAxisAlignment": "start"
   }
  },
  "nameField": {
   "type": "column",
   "children": [
    "nameLabel",
    "nameInput"
   ],
   "layout": {
    "width": {
     "fill": 296
    },
    "height": {
     "hug": 76
    },
    "basis": 220
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 8
   }
  },
  "nameLabel": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 296
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "Full name",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF334155"
    }
   }
  },
  "nameInput": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 296
    },
    "height": {
     "hug": 44
    },
    "constraints": {
     "minHeight": 44
    }
   },
   "props": {
    "style": {
     "fontFamily": "Inter",
     "fontSize": 14,
     "color": "#FF0F172A"
    },
    "decoration": {
     "hintText": "Your name",
     "contentPadding": [
      12,
      12,
      12,
      12
     ]
    }
   },
   "bind": {
    "props.initialValue": "${name}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "name",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "userField": {
   "type": "column",
   "children": [
    "userLabel",
    "userInput",
    "userUrl"
   ],
   "layout": {
    "width": {
     "fill": 296
    },
    "height": {
     "hug": 96
    },
    "basis": 220
   },
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 8
   }
  },
  "userLabel": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 296
    },
    "height": {
     "hug": 18
    }
   },
   "props": {
    "text": "Username",
    "style": {
     "fontFamily": "Inter",
     "fontSize": 13,
     "fontWeight": 600,
     "color": "#FF334155"
    }
   }
  },
  "userInput": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 296
    },
    "height": {
     "hug": 44
    },
    "constraints": {
     "minHeight": 44
    }
   },
   "props": {
    "style": {
     "fontFamily": "Inter",
     "fontSize": 14,
     "color": "#FF0F172A"
    },
    "decoration": {
     "hintText": "username",
     "contentPadding": [
