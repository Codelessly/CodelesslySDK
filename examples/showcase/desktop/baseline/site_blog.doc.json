  "text19": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "code",
     "color": "onPrimary"
    },
    "text": "const queue = connect(${= topic: 'orders.created',\n  retries: 5,\n  deadLetter: 'orders.dlq',});\n\nqueue.consume(async (msg) => ${= await handle(msg.body);\n  await msg.ack();});"
   }
  },
  "text20": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Three habits made the difference between a smooth cutover and a painful one:",
    "style": {
     "from": "body",
     "fontSize": 17
    }
   }
  },
