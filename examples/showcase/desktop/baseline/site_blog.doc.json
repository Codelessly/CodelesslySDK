     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Alert on consumer lag per team, so ownership is obvious at 3 a.m.",
    "style": {
     "from": "body",
     "fontSize": 17
    }
   }
  },
  "text27": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Today one platform team runs the queue, and product teams ship consumers without opening a ticket. The graphs are quieter, and so are the pagers.",
    "style": {
     "from": "body",
     "fontSize": 17
    }
   }
  },
