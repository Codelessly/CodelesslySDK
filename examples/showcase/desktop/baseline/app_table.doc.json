      {
       "type": "showToast",
       "message": "Actions for ${item.name}"
      }
     ]
    }
   ]
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "visible": "${= (status==\"All\"||item.status==status)&&(view==\"All\"||item.mine)&&contains(lower(item.name+\" \"+item.company),lower(query))}"
   }
  },
  "row13": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "children": [
    "text10",
    "row14"
   ]
  },
  "text10": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "muted"
    },
    "text": "Rows ${= page*10+1}-${= page*10+10} of 248"
   }
  },
  "row14": {
   "type": "row",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 8,
    "crossAxisAlignment": "center"
   },
   "children": [
    "outlinedButton3",
    "outlinedButton4"
   ]
  },
  "outlinedButton3": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Previous"
   },
   "bind": {
    "props.enabled": "${= page>0}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= max(0,page-1)}"
      }
     ]
    }
   ]
  },
  "outlinedButton4": {
   "type": "outlinedButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Next"
   },
   "bind": {
    "props.enabled": "${= page<24}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "page",
       "value": "${= min(24,page+1)}"
      }
     ]
    }
   ]
  }
 },
