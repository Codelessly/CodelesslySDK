  "text11": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "“A shared queue does not remove complexity. It moves it to the one place where a single team can afford to own it.”",
    "style": {
     "from": "bodyWide",
     "fontSize": 22,
     "fontWeight": 600
    }
   }
  },
  "text12": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "captionWide"
    },
    "text": "Maya Reyes"
   }
  },
  "text13": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "heading2Wide"
    },
    "text": "Making the move safely"
   }
  },
  "Paragraph3": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "We moved services in waves of five, smallest traffic first. Each service published to both the old and the new queue for a week, and we compared what consumers received before cutting over."
   }
  },
