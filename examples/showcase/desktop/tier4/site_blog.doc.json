  "text9": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "leadWide"
    },
    "text": "A year ago every service of ours talked to its own broker. Today forty of them share one queue. This is what broke, what held and what we would do differently."
   }
  },
  "text10": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "heading2Wide"
    },
    "text": "Why one queue"
   }
  },
  "Paragraph1": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "We ran six brokers with six sets of dashboards, upgrade windows and failure modes. Every incident began with the question of which queue was involved, and the answer was often two of them at once."
   }
  },
  "Paragraph2": {
   "type": "Paragraph",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Consolidating promised one thing to monitor and one thing to scale. It also promised a new shared failure domain, and that trade is the subject of everything below."
   }
  },
  "column11": {
   "type": "column",
   "layout": {
    "padding": [
     24,
     20,
     24,
     20
    ],
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "decoration": {
