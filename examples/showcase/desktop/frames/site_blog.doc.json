   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "The hard part was never moving the messages. It was agreeing on what a message means.",
    "style": {
     "from": "body",
     "fontSize": 22,
     "fontWeight": 600
    }
   }
  },
  "text10": {
   "type": "text",
