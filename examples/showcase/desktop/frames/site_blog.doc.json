    },
    "text": "Priya Nair, platform lead"
   }
  },
  "text11": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "heading2"
    },
    "text": "What the migration looked like"
   }
  },
  "text12": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "We moved services in waves, starting with the ones that could lose a message without anyone noticing. Each service ran in shadow mode first, publishing to both brokers, so we could compare what arrived on each side before cutting over.",
    "style": {
     "from": "body"
    }
   }
  },
  "text13": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "The consumer wrapper below is the one piece of code every team adopted. It makes retries and idempotency the default instead of something to remember.",
    "style": {
     "from": "body"
    }
   }
  },
