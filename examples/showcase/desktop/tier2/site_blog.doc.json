    }
   }
  },
  "text22": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Keep a dead-letter queue per consumer, not one shared by everybody.",
    "style": {
     "from": "bodyWide"
    }
   }
  },
  "text23": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "If you are weighing a similar move, start with the retry policy. It is the part that hurts most when it is wrong.",
    "style": {
     "from": "bodyWide"
    }
   }
  },
