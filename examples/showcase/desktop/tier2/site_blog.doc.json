    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Migrate the least critical services first, and measure before each next wave.",
    "style": {
     "from": "bodyWide"
    }
   }
  },
  "row8": {
   "type": "row",
   "layout": {
