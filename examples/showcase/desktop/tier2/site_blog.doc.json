  },
  "text20": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "Give every message an id and a schema version from day one.",
    "style": {
     "from": "bodyWide"
    }
   }
  },
  "row9": {
   "type": "row",
   "layout": {
    "width": {
