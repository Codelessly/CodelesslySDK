<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug builds are signed to run locally (no team or provisioning
	     profile). Without the sandbox, Firebase Auth can keep its anonymous
	     user in the login keychain without the keychain-sharing entitlement,
	     which needs a team. Profile and Release keep the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
