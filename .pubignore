# What `dart pub publish` leaves out. (A .pubignore replaces .gitignore for
# publishing, so the local state is listed here too.)
.dart_tool/
build/
pubspec.lock
pubspec_overrides.yaml
doc/api/
coverage/
.flutter-plugins*
# Repository tooling, contributor docs, the guide (read on GitHub: pubspec
# `documentation`) and the test suite with its fixtures.
tool/
docs/
test/
CONTRIBUTING.md
PUBLISHING.md
# The example ships as source: `flutter create .` makes its platform folders.
/example/android/
/example/ios/
/example/linux/
/example/macos/
/example/web/
/example/windows/
/example/.metadata
