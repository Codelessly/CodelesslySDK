# What `dart pub publish` leaves out. (A .pubignore replaces .gitignore for
# publishing, so the local state is listed here too.)
.dart_tool/
build/
pubspec.lock
pubspec_overrides.yaml
doc/api/
coverage/
.flutter-plugins*
# Repository tooling, contributor docs, the guide (read on GitHub: pubspec
# `documentation`) and the test suite with its fixtures.
tool/
docs/
test/
# Demos, recordings and measurements: read on GitHub. (`example/`, singular, is
# the package's example and ships.)
/examples/
/benchmark/
CONTRIBUTING.md
PUBLISHING.md
# The example ships as source: `flutter create .` makes its platform folders.
/example/android/
/example/ios/
/example/linux/
/example/macos/
/example/web/
/example/windows/
/example/.metadata
# Desk's example pictures (10 MB): read on GitHub.
/design_systems/desk/examples/**/*.png
/design_systems/cards/examples/**/*.png
