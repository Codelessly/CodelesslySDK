   },
   {
    "name": "view",
    "type": "text",
    "value": "All mail"
   },
   {
    "name": "openId",
    "type": "text",
    "value": "m1"
   },
   {
    "name": "q",
    "type": "text",
    "value": ""
   },
   {
    "name": "reading",
    "type": "boolean",
    "value": false
   },
   {
    "name": "mail",
    "type": "list",
    "value": [
     {
      "id": "m1",
      "from": "Maya Chen",
      "subject": "Studio visit on Thursday",
      "snippet": "Hi Jamie, Thursday at 10:30 works for the studio visit. We'll meet you at the north entrance.",
      "time": "10:42 AM",
      "day": "Today",
      "unread": false,
      "starred": true,
      "files": true
     },
     {
      "id": "m2",
      "from": "Nora Patel",
      "subject": "November print invoice",
      "snippet": "Hi Jamie, here is the invoice for the November proofs, with the paper upgrade.",
      "time": "9:18 AM",
      "day": "Today",
      "unread": true,
      "files": true
     },
     {
      "id": "m3",
      "from": "Eli Vargas",
      "subject": "Homepage review notes",
      "snippet": "I left three notes on the homepage draft. The general direction is right.",
      "time": "8:54 AM",
      "day": "Today",
      "unread": true,
      "starred": true
     },
     {
      "id": "m4",
      "from": "Common Ground",
      "subject": "Your sample box has arrived",
      "snippet": "Your package is waiting at the front desk. We'll hold it for five days.",
      "time": "8:03 AM",
      "day": "Today",
      "unread": true
     },
     {
      "id": "m5",
      "from": "Amira Bello",
      "subject": "A few things for this week",
      "snippet": "Morning! I moved our production check-in to 2 PM so we can all make it.",
      "time": "4:36 PM",
      "day": "Yesterday"
     },
     {
      "id": "m6",
      "from": "Owen Brooks",
      "subject": "Harbor Street selects",
      "snippet": "The first edit is ready. I marked four selects from the shoot for review.",
      "time": "2:21 PM",
      "day": "Yesterday",
      "unread": true,
      "files": true
     },
     {
      "id": "m7",
      "from": "Ruth Kim",
      "subject": "Your material library loan",
      "snippet": "Just a reminder that the oak, ash and painted birch samples are due back.",
      "time": "11:08 AM",
      "day": "Yesterday"
     },
     {
      "id": "m8",
      "from": "Ben Okafor",
      "subject": "Re: Winter brief",
      "snippet": "The dates look good here. I'd leave one extra day between the two shoots.",
      "time": "9:42 AM",
      "day": "Yesterday"
     },
     {
      "id": "m9",
      "from": "June Ito",
      "subject": "Book launch next week",
      "snippet": "We're setting up a small table of early copies at the studio on Friday.",
      "time": "Nov 13",
      "day": "Earlier"
     }
    ]
   },
   {
    "name": "shown",
    "type": "list",
    "formula": "filter(mail, m => (view == 'All mail' || (view == 'Unread' && coalesce(m.unread, false)) || (view == 'Starred' && coalesce(m.starred, false))) && contains(lower(m.from + ' ' + m.subject), lower(q)))"
   },
   {
    "name": "cur",
    "type": "map",
    "formula": "coalesce(find(mail, 'id', openId), first(mail))"
   }
  ]
 }
