{
 "schema": 3,
 "id": "Account",
 "roots": [
  "account"
 ],
 "widget": {
  "type": "Account",
  "doc": "The signed-in person at a sidebar's foot or in a top bar: their avatar, name 13/500 and a line under it (an email, a role), a chevron for the account menu; the hover fill. Fires onTap as any line does.",
  "props": [
   {
    "key": "name",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Jamie Park",
    "required": true,
    "doc": "Their name."
   },
   {
    "key": "note",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A line under it (their email or role)."
   },
   {
    "key": "chevron",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "A chevron at its end (it opens a menu)."
   },
   {
    "key": "rail",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Folded to its icon (a collapsed sidebar); a tablet's width folds it too."
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    232,
    44
   ],
   "props": {
    "name": "Jamie Park",
    "note": "jamie@northline.design"
   }
  }
 ],
 "nodes": {
  "account": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "radius": 6
   },
   "bind": {
    "props.spacing": "${= (props.rail || (screen.width >= 700 && screen.width < 1024)) ? 0 : 10}",
    "layout.padding": "${= (props.rail || (screen.width >= 700 && screen.width < 1024)) ? [6, 6, 6, 6] : [8, 6, 8, 6]}"
   },
   "states": {
    "hovered": {
     "account": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "children": [
    "accountAvatar",
    "accountWords",
    "accountChevron"
   ]
  },
  "accountAvatar": {
   "type": "Avatar",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "size": "small"
   },
   "bind": {
    "props.name": "${props.name}"
   }
  },
  "accountWords": {
   "type": "column",
   "layout": {
    "flex": 1,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 0,
    "crossAxisAlignment": "start"
   },
   "bind": {
    "visible": "${= !(props.rail || (screen.width >= 700 && screen.width < 1024))}"
   },
   "children": [
    "accountName",
    "accountNote"
   ]
  },
  "accountName": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${props.name}",
    "style": {
     "from": "body",
     "fontSize": 13,
     "fontWeight": 500,
     "color": "ink"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   }
  },
  "accountNote": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${props.note}",
    "style": "meta",
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "bind": {
    "visible": "${= props.note != ''}"
   }
  },
  "accountChevron": {
   "type": "icon",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "unfold_more_outlined",
    "size": 16,
    "color": "ink4"
   },
   "bind": {
    "visible": "${= props.chevron && !(props.rail || (screen.width >= 700 && screen.width < 1024))}"
   }
  }
 }
}