{
 "schema": 3,
 "id": "BulkBar",
 "roots": [
  "bulk"
 ],
 "widget": {
  "type": "BulkBar",
  "doc": "What acts on the rows chosen in a table or a list: the count in the accent ink on the accent tint, Clear, and its lines under it (the actions: outline buttons, a destructive one last) at the end; on a phone the actions go on a line under the count. Show it while something is chosen.",
  "children": "list",
  "props": [
   {
    "key": "count",
    "type": {
     "kind": "integer",
     "flutter": "int"
    },
    "default": 0,
    "required": true,
    "doc": "How many are chosen."
   },
   {
    "key": "noun",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "selected",
    "doc": "What follows the count (selected, members selected)."
   }
  ],
  "events": [
   {
    "key": "onClear"
   }
  ]
 },
