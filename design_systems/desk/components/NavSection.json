{
 "schema": 3,
 "id": "NavSection",
 "roots": [
  "section"
 ],
 "widget": {
  "type": "NavSection",
  "doc": "The label over a group of sidebar items: small spaced capitals in the caption ink, with room above that parts the groups.",
  "props": [
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Section",
    "required": true,
    "doc": "The group's name (written as it reads; shown in capitals)."
   },
   {
    "key": "rail",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Folded to its icon (a collapsed sidebar); a tablet's width folds it too."
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    232,
    36
   ],
   "props": {
    "label": "Mailbox"
   }
  }
 ],
 "nodes": {
  "section": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "bind": {
    "layout.padding": "${= (props.rail || (screen.width >= 700 && screen.width < 1024)) ? [8, 10, 8, 10] : [10, 18, 10, 6]}"
   },
   "children": [
    "label",
    "rule"
   ]
  },
  "label": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "text": "${= upper(props.label)}",
    "style": "overline"
   },
   "bind": {
    "visible": "${= !(props.rail || (screen.width >= 700 && screen.width < 1024))}"
   }
  },
  "rule": {
   "type": "box",
   "layout": {
    "height": 1,
    "width": {
     "fill": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "line"
     }
    ]
   },
   "bind": {
    "visible": "${= (props.rail || (screen.width >= 700 && screen.width < 1024))}"
   }
  }
 }
}