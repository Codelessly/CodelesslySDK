   {
    "key": "done",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Mon",
     "Wed"
    ],
    "doc": "The days done this week: weekday names, or dates that start with one (\"Fri 13 Nov\").",
    "required": true
   },
   {
    "key": "today",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "Today, as a weekday name: it gets a ring until it is done (empty: none)."
   }
  ]
 },
