   "props": {
    "icon": "check_rounded",
    "size": 20,
    "color": "onBrand"
   },
   "layout": {
    "width": 20,
    "height": 20
   }
  },
  "dSun": {
   "type": "column",
   "children": [
    "lSun",
    "sSun"
   ],
   "props": {
    "spacing": 8
   },
   "layout": {
    "width": 36,
    "height": {
     "hug": 0
    }
   }
  },
  "lSun": {
   "type": "text",
   "props": {
    "text": "S",
    "style": {
     "from": "eyebrow",
     "letterSpacing": 0.4
    }
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= startsWith(lower(props.today), 'sun') ? theme.colors.brand : theme.colors.inkFaint}"
   }
  },
  "sSun": {
   "type": "stack",
   "children": [
    "oSun",
    "nSun",
    "cSun"
   ],
   "layout": {
    "width": 36,
    "height": 36
   }
  },
  "oSun": {
   "type": "box",
   "layout": {
    "width": 36,
    "height": 36,
    "x": 0,
    "y": 0
   },
   "decoration": {
    "fills": [
     {
      "color": "track"
     }
    ],
    "radius": 18
   },
   "bind": {
    "decoration.radius": "${= min(18, theme.radii.tile)}"
   }
  },
  "nSun": {
   "type": "row",
   "children": [
    "ndSun"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 36,
    "height": 36,
    "x": 0,
    "y": 0
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "brand"
     }
    ],
    "strokeWidth": 2.5,
    "radius": 18
   },
   "bind": {
    "decoration.radius": "${= min(18, theme.radii.tile)}",
    "visible": "${= startsWith(lower(props.today), 'sun') && !any(props.done, x => startsWith(lower(x), 'sun'))}"
   }
  },
  "ndSun": {
   "type": "box",
   "layout": {
    "width": 8,
    "height": 8
   },
   "decoration": {
    "fills": [
     {
      "color": "brand"
     }
    ],
    "radius": 4
   }
  },
  "cSun": {
   "type": "row",
   "children": [
    "ciSun"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 36,
    "height": 36,
    "x": 0,
    "y": 0
   },
   "decoration": {
    "fills": [
     {
      "type": "linear",
      "begin": "topLeft",
      "end": "bottomRight",
      "stops": [
       {
        "position": 0,
        "color": "brandBright"
       },
       {
        "position": 1,
        "color": "brand"
       }
      ]
     }
    ],
    "radius": 18
   },
   "bind": {
    "decoration.radius": "${= min(18, theme.radii.tile)}",
    "visible": "${= any(props.done, x => startsWith(lower(x), 'sun'))}"
   }
  },
  "ciSun": {
   "type": "icon",
   "props": {
    "icon": "check_rounded",
    "size": 20,
    "color": "onBrand"
   },
   "layout": {
    "width": 20,
    "height": 20
   }
  }
 }
}
