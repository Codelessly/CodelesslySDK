  "trio"
 ],
 "widget": {
  "type": "StatTrio",
  "doc": "Three small figures side by side as tiles: values and labels are lists of three, icons an optional list of Material icon names.",
  "props": [
   {
    "key": "values",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "3736",
     "34",
     "4"
    ],
    "doc": "Three figures (numbers get thousands separators; text is shown as written).",
    "required": true
   },
   {
    "key": "labels",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Total jumps",
     "Minutes",
     "Sessions"
    ],
    "doc": "What each figure counts.",
    "required": true
   },
   {
    "key": "icons",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "bolt_rounded",
     "timer_outlined",
     "event_available_rounded"
    ],
    "doc": "A Material icon per figure."
   }
  ]
 },
