{
 "schema": 3,
 "id": "Switch",
 "roots": [
  "row"
 ],
 "widget": {
  "type": "Switch",
  "doc": "An on/off toggle with an optional label, its value kept in your variable. Fires onChanged.",
  "props": [
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "boolean",
      "flutter": "bool"
     }
    },
    "default": "",
    "doc": "The name of your boolean variable."
   },
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "Text beside the switch."
   },
   {
    "key": "enabled",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "False: 50 % opacity."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "payload": {
     "kind": "boolean",
     "flutter": "bool"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "On",
   "size": [
    160,
    28
   ],
   "props": {
    "value": true,
    "label": "Notifications"
   }
  },
  {
   "name": "Off",
   "size": [
    160,
    28
   ],
   "props": {
    "label": "Notifications"
   }
  }
 ],
 "nodes": {
  "row": {
   "type": "row",
   "children": [
    "track",
    "label"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 9
   },
   "layout": {
    "width": {
     "hug": 120
    },
    "height": {
     "hug": 28
    },
    "constraints": {
     "minHeight": 24
    }
   },
   "bind": {
    "selected": "${= props.value == true}",
    "disabled": "${= !props.enabled}"
   },
   "states": {
    "hovered": {
     "track": {
      "decoration": {
       "fills": [
        {
         "color": "tertiaryText"
        }
       ]
      }
     }
    },
    "selected": {
     "track": {
      "decoration": {
       "fills": [
        {
         "color": "primary"
        }
       ]
      },
      "props": {
       "mainAxisAlignment": "end"
      }
     }
    },
    "disabled": {
     "row": {
      "opacity": 0.5
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click",
      "when": "props.enabled"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= !(props.value == true)}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${= props.value == true}"
      }
     ]
    }
   ]
  },
  "track": {
   "type": "row",
   "children": [
    "thumb"
   ],
   "props": {
    "mainAxisAlignment": "start",
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": 36,
    "height": 23,
    "padding": 2
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBorder"
     }
    ],
    "radius": 9999
   }
  },
  "thumb": {
   "type": "box",
   "layout": {
    "width": 16,
    "height": 16
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFFFFFFF"
     }
    ],
    "effects": [
     {
      "type": "dropShadow",
      "color": "#0D000000",
      "offset": [
       0,
       1
      ],
      "blurRadius": 2
     }
    ],
    "radius": 9999
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${props.label}",
    "style": "body"
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 19
    }
   },
   "bind": {
    "visible": "${= props.label != ''}"
   }
  }
 }
}
