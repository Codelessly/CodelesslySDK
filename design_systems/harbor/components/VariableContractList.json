{
 "schema": 3,
 "id": "VariableContractList",
 "roots": [
  "list"
 ],
 "widget": {
  "type": "VariableContractList",
  "doc": "The variables something takes and gives: each with its name, type, whether it is required, and what it is for. The chosen name is kept in your variable. Fires onSelected.",
  "props": [
   {
    "key": "names",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "customer_id",
     "amount",
     "note"
    ],
    "doc": "The variables' names.",
    "required": true
   },
   {
    "key": "types",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "string",
     "number",
     "string"
    ],
    "doc": "One type per variable."
   },
   {
    "key": "descriptions",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "What each is for (empty: none)."
   },
   {
    "key": "required",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "The names that are required."
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen name."
   },
   {
    "key": "emptyLabel",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "No variables.",
    "doc": "Shown with none."
   }
  ],
  "events": [
   {
    "key": "onSelected",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    300,
    140
   ],
   "props": {
    "descriptions": [
     "Who the invoice is for.",
     "In cents.",
     ""
    ],
    "required": [
     "customer_id",
     "amount"
    ],
    "value": "amount"
   }
  }
 ],
 "nodes": {
  "list": {
   "type": "column",
   "children": [
    "rows",
    "none"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 140
    }
   }
  },
  "rows": {
   "type": "listView",
   "children": [
    "row"
   ],
   "props": {
    "scrollable": false
   },
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 130
    }
   },
   "bind": {
    "data": "${props.names}"
   }
  },
  "row": {
   "type": "column",
   "children": [
    "meta",
    "description"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 3
   },
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 44
    },
    "padding": [
     14,
     10,
     14,
     10
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder",
      "visible": false
     }
    ],
    "strokeSides": "top"
   },
   "bind": {
    "selected": "${= item == props.value}",
    "decoration.strokes[0].visible": "${= index > 0}"
   },
   "states": {
    "hovered": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "selected": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "tertiaryBackground"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${item}"
      },
      {
       "type": "componentEvent",
       "event": "onSelected",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "meta": {
   "type": "row",
   "children": [
    "name",
    "type",
    "required"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 7
   },
   "layout": {
    "width": {
     "fill": 276
    },
    "height": {
     "hug": 20
    }
   }
  },
  "name": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "fontSize": 12.5,
     "fontWeight": 600,
     "height": 1.4,
     "color": "primaryText",
     "leadingDistribution": "even",
     "fontFamily": "monospace"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 16
    }
   }
  },
  "type": {
   "type": "Badge",
   "props": {
    "label": "string"
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 20
    }
   },
   "bind": {
    "props.label": "${= length(props.types) > index ? props.types[index] : ''}",
    "visible": "${= length(props.types) > index && props.types[index] != ''}"
   }
  },
  "required": {
   "type": "text",
   "props": {
    "text": "REQUIRED",
    "style": {
     "fontSize": 10,
     "fontWeight": 600,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even",
     "letterSpacing": 0.4
    }
   },
   "layout": {
    "width": {
     "hug": 50
    },
    "height": {
     "hug": 12
    }
   },
   "bind": {
    "visible": "${= contains(props.required, item)}"
   }
  },
  "description": {
   "type": "text",
   "props": {
    "text": "${= length(props.descriptions) > index ? props.descriptions[index] : ''}",
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.4,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "fill": 276
    },
    "height": {
     "hug": 16
    }
   },
   "bind": {
    "visible": "${= length(props.descriptions) > index && props.descriptions[index] != ''}"
   }
  },
  "none": {
   "type": "text",
   "props": {
    "text": "${props.emptyLabel}",
    "style": {
     "fontSize": 13,
     "fontWeight": 400,
     "height": 1.4,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "fill": 276
    },
    "height": {
     "hug": 17
    },
    "margin": [
     12,
     10,
     12,
     10
    ]
   },
   "bind": {
    "visible": "${= length(props.names) == 0}"
   }
  }
 }
}
