{
 "schema": 3,
 "id": "InlineStat",
 "roots": [
  "stat"
 ],
 "widget": {
  "type": "InlineStat",
  "doc": "One small figure with its icon (files, lines, stars): a muted 11 px icon and a bold 10.5 px value.",
  "props": [
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "description",
    "doc": "The icon's name."
   },
   {
    "key": "value",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "128",
    "doc": "The figure, already formatted.",
    "required": true
   }
  ]
 },
 "previews": [
  {
   "name": "Files",
   "size": [
    50,
    14
   ],
   "props": {
    "icon": "description",
    "value": "128"
   }
  }
 ],
 "nodes": {
  "stat": {
   "type": "row",
   "children": [
    "glyph",
    "value"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 5
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 14
    }
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "description",
    "color": "tertiaryText",
    "size": 11
   },
   "layout": {
    "width": 11,
    "height": 11
   },
   "bind": {
    "props.icon": "${props.icon}"
   }
  },
  "value": {
   "type": "text",
   "props": {
    "text": "${props.value}",
    "style": {
     "fontSize": 11.5,
     "fontWeight": 600,
     "height": 1.3,
     "color": "primaryText",
     "leadingDistribution": "even",
     "letterSpacing": -0.1
    }
   },
   "layout": {
    "width": {
     "hug": 24
    },
    "height": {
     "hug": 14
    }
   }
  }
 }
}
