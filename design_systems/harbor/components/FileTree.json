{
 "schema": 3,
 "id": "FileTree",
 "roots": [
  "tree"
 ],
 "widget": {
  "type": "FileTree",
  "doc": "A project's files as an outline: give each row its name and how deep it sits; a row with rows under it is a folder. The chosen file is kept in your variable. Fires onSelected with the name.",
  "props": [
   {
    "key": "names",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "lib",
     "main.dart",
     "assets",
     "logo.png",
     "README.md"
    ],
    "doc": "The rows, top to bottom.",
    "required": true
   },
   {
    "key": "depths",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "0",
     "1",
     "0",
     "1",
     "0"
    ],
    "doc": "How deep each row sits: 0 at the edge.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen file."
   }
  ],
  "events": [
   {
    "key": "onSelected",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    260,
    175
   ],
   "props": {
    "value": "main.dart"
   }
  }
 ],
 "nodes": {
  "tree": {
   "type": "listView",
   "children": [
    "row"
   ],
   "props": {
    "scrollable": false
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 175
    }
   },
   "bind": {
    "data": "${props.names}"
   }
  },
  "row": {
   "type": "row",
   "children": [
    "indent",
    "chevron",
    "glyph",
    "label"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 35
    },
    "padding": 9
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "radius": 12
   },
   "bind": {
    "selected": "${= item == props.value}"
   },
   "states": {
    "hovered": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "selected": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "primaryTint"
        }
       ]
      }
     },
     "label": {
      "props": {
       "style": {
        "fontWeight": 600
       }
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click",
      "when": "!(length(props.depths) > index + 1 && number(props.depths[index + 1]) > number(props.depths[index]))"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${item}"
      },
      {
       "type": "componentEvent",
       "event": "onSelected",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "indent": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 1
   },
   "bind": {
    "layout.width": "${= 16 * (length(props.depths) > index ? number(props.depths[index]) : 0)}"
   }
  },
  "chevron": {
   "type": "icon",
   "props": {
    "icon": "expand_more",
    "color": "secondaryText",
    "size": 18
   },
   "layout": {
    "width": 18,
    "height": 18,
    "margin": [
     0,
     0,
     4,
     0
    ]
   },
   "bind": {
    "opacity": "${= length(props.depths) > index + 1 && number(props.depths[index + 1]) > number(props.depths[index]) ? 1 : 0}"
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "description",
    "color": "secondaryText",
    "size": 18
   },
   "layout": {
    "width": 18,
    "height": 18,
    "margin": [
     0,
     0,
     8,
     0
    ]
   },
   "bind": {
    "props.icon": "${= length(props.depths) > index + 1 && number(props.depths[index + 1]) > number(props.depths[index]) ? 'folder' : (matches(lower(item), '\\\\.(png|jpe?g|gif|webp|svg)$') ? 'image' : (matches(lower(item), '\\\\.(dart|ts|tsx|js|py|go|rs)$') ? 'code' : 'description'))}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "fontSize": 15.5,
     "fontWeight": 400,
     "height": 1.35,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 19
    }
   }
  }
 }
}
