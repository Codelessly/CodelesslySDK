{
 "schema": 3,
 "id": "Tree",
 "roots": [
  "tree"
 ],
 "widget": {
  "type": "Tree",
  "doc": "An outline of nested rows: give each row its label and how deep it sits. A row followed by a deeper one shows a chevron. Fires onSelected with the label.",
  "props": [
   {
    "key": "labels",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "src",
     "components",
     "Button.tsx",
     "README.md"
    ],
    "doc": "The rows, top to bottom.",
    "required": true
   },
   {
    "key": "depths",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "0",
     "1",
     "2",
     "0"
    ],
    "doc": "How deep each row sits: 0 at the edge.",
    "required": true
   },
   {
    "key": "icons",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "One icon per row (empty: a folder for a row with rows under it, a file otherwise)."
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen label."
   }
  ],
  "events": [
   {
    "key": "onSelected",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    260,
    140
   ],
   "props": {
    "value": "Button.tsx"
   }
  }
 ],
 "nodes": {
  "tree": {
   "type": "listView",
   "children": [
    "row"
   ],
   "props": {
    "scrollable": false
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 140
    }
   },
   "bind": {
    "data": "${props.labels}"
   }
  },
  "row": {
   "type": "row",
   "children": [
    "indent",
    "chevron",
    "glyph",
    "label"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 35
    },
    "padding": 9
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "radius": 12
   },
   "bind": {
    "selected": "${= item == props.value}"
   },
   "states": {
    "hovered": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "selected": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "primaryTint"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${item}"
      },
      {
       "type": "componentEvent",
       "event": "onSelected",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "indent": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 1
   },
   "bind": {
    "layout.width": "${= 16 * (length(props.depths) > index ? number(props.depths[index]) : 0)}"
   }
  },
  "chevron": {
   "type": "icon",
   "props": {
    "icon": "expand_more",
    "color": "secondaryText",
    "size": 18
   },
   "layout": {
    "width": 18,
    "height": 18,
    "margin": [
     0,
     0,
     4,
     0
    ]
   },
   "bind": {
    "opacity": "${= length(props.depths) > index + 1 && number(props.depths[index + 1]) > number(props.depths[index]) ? 1 : 0}"
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "description",
    "color": "secondaryText",
    "size": 18
   },
   "layout": {
    "width": 18,
    "height": 18,
    "margin": [
     0,
     0,
     8,
     0
    ]
   },
   "bind": {
    "props.icon": "${= length(props.icons) > index && props.icons[index] != '' ? props.icons[index] : (length(props.depths) > index + 1 && number(props.depths[index + 1]) > number(props.depths[index]) ? 'folder' : 'description')}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "fontSize": 15.5,
     "fontWeight": 400,
     "height": 1.35,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 160
    },
    "height": {
     "hug": 19
    }
   }
  }
 }
}
