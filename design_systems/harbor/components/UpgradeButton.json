{
 "schema": 3,
 "id": "UpgradeButton",
 "roots": [
  "button"
 ],
 "widget": {
  "type": "UpgradeButton",
  "doc": "The call to upgrade a plan: a warm gradient button with a crown or sparkles. Fires onPressed.",
  "props": [
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Upgrade to Pro",
    "doc": "The words."
   },
   {
    "key": "variant",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "gradient",
      "primary"
     ]
    },
    "default": "gradient",
    "doc": "gradient: orange to pink. primary: solid orange."
   },
   {
    "key": "size",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "sm",
      "md",
      "lg"
     ]
    },
    "default": "md",
    "doc": "sm, md or lg."
   },
   {
    "key": "icon",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "crown",
      "sparkles"
     ]
    },
    "default": "crown",
    "doc": "Which icon."
   }
  ],
  "events": [
   {
    "key": "onPressed"
   }
  ]
 },
 "previews": [
  {
   "name": "Gradient",
   "size": [
    180,
    40
   ],
   "props": {}
  },
  {
   "name": "Small solid",
   "size": [
    150,
    32
   ],
   "props": {
    "variant": "primary",
    "size": "sm",
    "icon": "sparkles"
   }
  }
 ],
 "nodes": {
  "button": {
   "type": "row",
   "children": [
    "glyph",
    "label"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 9
   },
   "layout": {
    "width": {
     "hug": 170
    },
    "height": {
     "hug": 40
    },
    "padding": [
     18,
     9,
     18,
     9
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#FFF97316"
     },
     {
      "type": "linear",
      "begin": [
       -1,
       0
      ],
      "end": [
       1,
       0
      ],
      "stops": [
       {
        "color": "#FFF97316",
        "position": 0
       },
       {
        "color": "#FFDB2777",
        "position": 1
       }
      ]
     }
    ],
    "radius": 15,
    "effects": [
     {
      "type": "dropShadow",
      "color": "#66FB923C",
      "offset": [
       0,
       4
      ],
      "blurRadius": 12,
      "spreadRadius": -2
     }
    ]
   },
   "bind": {
    "layout.padding": "${= props.size == 'sm' ? [14, 7, 14, 7] : (props.size == 'md' ? [18, 9, 18, 9] : ([28, 14, 28, 14]))}",
    "decoration.fills[1].visible": "${= props.variant == 'gradient'}"
   },
   "states": {
    "hovered": {
     "button": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "button": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onPressed"
      }
     ]
    }
   ]
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "workspace_premium",
    "color": "#FFFFFFFF",
    "size": 20
   },
   "layout": {
    "width": 20,
    "height": 23
   },
   "bind": {
    "props.icon": "${= props.icon == 'crown' ? 'workspace_premium' : 'auto_awesome'}",
    "props.size": "${= props.size == 'sm' ? 16 : (props.size == 'md' ? 20 : (24))}",
    "layout.width": "${= props.size == 'sm' ? 16 : (props.size == 'md' ? 20 : (24))}",
    "layout.height": "${= props.size == 'sm' ? 16 : (props.size == 'md' ? 23 : (28))}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${props.label}",
    "style": {
     "fontSize": 17.5,
     "fontWeight": 600,
     "height": 1.5,
     "color": "#FFFFFFFF",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 110
    },
    "height": {
     "hug": 24
    }
   },
   "bind": {
    "props.style.fontSize": "${= props.size == 'sm' ? 15.5 : (props.size == 'md' ? 17.5 : (20))}"
   }
  }
 }
}
