{
 "schema": 3,
 "id": "ActionListItem",
 "roots": [
  "card"
 ],
 "widget": {
  "type": "ActionListItem",
  "doc": "Something you can act on, as a card: an icon panel, a title, a path and a note, with the call's actions at its end. Fires onPressed.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Action",
    "doc": "The title.",
    "required": true
   },
   {
    "key": "path",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A path or id under it, in monospace."
   },
   {
    "key": "meta",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A muted note under that."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "bolt",
    "doc": "The icon in the panel."
   },
   {
    "key": "enabled",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "False dims it."
   }
  ],
  "events": [
   {
    "key": "onPressed"
   }
  ],
  "slots": [
   "actions"
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    340,
    66
   ],
   "props": {
    "title": "Summarize new tickets",
    "path": "automations/summarize.yaml",
    "meta": "Last run 2h ago"
   }
  }
 ],
 "nodes": {
  "card": {
   "type": "row",
   "children": [
    "panel",
    "texts",
    "tail"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 9
   },
   "layout": {
    "width": {
     "fill": 340
    },
    "height": {
     "hug": 66
    },
    "padding": 1
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 9,
    "clip": "antiAlias",
    "effects": [
     {
      "type": "dropShadow",
      "color": "#0A0F172A",
      "offset": [
       0,
       1
      ],
      "blurRadius": 2
     }
    ]
   },
   "bind": {
    "opacity": "${= props.enabled ? 1 : 0.58}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click",
      "when": "props.enabled"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onPressed"
      }
     ]
    }
   ]
  },
  "panel": {
   "type": "row",
   "children": [
    "glyph"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 52,
    "height": {
     "hug": 40
    },
    "constraints": {
     "minHeight": 40
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "right"
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "bolt",
    "color": "primaryText",
    "size": 17
   },
   "layout": {
    "width": 17,
    "height": 17
   },
   "bind": {
    "props.icon": "${props.icon}"
   }
  },
  "texts": {
   "type": "column",
   "children": [
    "title",
    "path",
    "meta"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 50
    },
    "padding": [
     0,
     8,
     0,
     8
    ]
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "${props.title}",
    "style": {
     "fontSize": 14.5,
     "fontWeight": 600,
     "height": 1.3,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 17
    }
   }
  },
  "path": {
   "type": "text",
   "props": {
    "text": "${props.path}",
    "style": {
     "fontSize": 11.5,
     "fontWeight": 400,
     "height": 1.25,
     "color": "tertiaryText",
     "leadingDistribution": "even",
     "fontFamily": "monospace"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 13
    },
    "margin": [
     0,
     4,
     0,
     0
    ]
   },
   "bind": {
    "visible": "${= props.path != ''}"
   }
  },
  "meta": {
   "type": "text",
   "props": {
    "text": "${props.meta}",
    "style": {
     "fontSize": 11.5,
     "fontWeight": 400,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 14
    },
    "margin": [
     0,
     6,
     0,
     0
    ]
   },
   "bind": {
    "visible": "${= props.meta != ''}"
   }
  },
  "tail": {
   "type": "row",
   "children": [
    "actions"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 5
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 40
    },
    "padding": [
     0,
     7,
     9,
     7
    ]
   },
   "bind": {
    "visible": "${slots.actions}"
   }
  },
  "actions": {
   "type": "slot",
   "props": {
    "name": "actions"
   }
  }
 }
}
