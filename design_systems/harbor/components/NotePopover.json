{
 "schema": 3,
 "id": "NotePopover",
 "roots": [
  "column"
 ],
 "widget": {
  "type": "NotePopover",
  "doc": "Words with a dotted underline that show a short note under them when pressed.",
  "props": [
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "What is this?",
    "doc": "The words that open the note.",
    "required": true
   },
   {
    "key": "note",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The note.",
    "required": true
   },
   {
    "key": "open",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Whether the note shows at first."
   }
  ]
 },
 "variables": {
  "column": [
   {
    "name": "toggled",
    "type": "boolean",
    "value": false
   }
  ]
 },
 "previews": [
  {
   "name": "Open",
   "size": [
    240,
    60
   ],
   "props": {
    "label": "Why two keys?",
    "note": "One signs requests, the other reads results.",
    "open": true
   }
  }
 ],
 "nodes": {
  "column": {
   "type": "column",
   "children": [
    "trigger",
    "bubble"
   ],
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 7
   },
   "layout": {
    "width": {
     "hug": 240
    },
    "height": {
     "hug": 60
    }
   }
  },
  "trigger": {
   "type": "text",
   "props": {
    "text": "${props.label}",
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.4,
     "color": "secondaryText",
     "leadingDistribution": "even",
     "decoration": "underline",
     "decorationStyle": "dotted"
    }
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 16
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "toggled",
       "value": "${= !toggled}"
      }
     ]
    }
   ]
  },
  "bubble": {
   "type": "row",
   "children": [
    "note"
   ],
   "layout": {
    "width": {
     "hug": 240
    },
    "height": {
     "hug": 28
    },
    "padding": [
     10,
     7,
     10,
     7
    ],
    "constraints": {
     "maxWidth": 240
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 12,
    "effects": [
     {
      "type": "dropShadow",
      "color": "#1F000000",
      "offset": [
       0,
       4
      ],
      "blurRadius": 16,
      "spreadRadius": -2
     },
     {
      "type": "dropShadow",
      "color": "#0F000000",
      "offset": [
       0,
       1
      ],
      "blurRadius": 3
     }
    ]
   },
   "bind": {
    "visible": "${= props.open != toggled}",
    "decoration.effects": "${theme.shadows.level3}"
   }
  },
  "note": {
   "type": "text",
   "props": {
    "text": "${props.note}",
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.4,
     "color": "secondaryText",
     "leadingDistribution": "even",
     "letterSpacing": -0.1
    }
   },
   "layout": {
    "width": {
     "hug": 200
    },
    "height": {
     "hug": 16
    }
   }
  }
 }
}
