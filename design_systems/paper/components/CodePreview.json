{
 "schema": 3,
 "id": "CodePreview",
 "roots": [
  "preview"
 ],
 "widget": {
  "type": "CodePreview",
  "doc": "Text or code shown as it was written, in monospace, wrapping. With none, a quiet message in its place.",
  "props": [
   {
    "key": "code",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The text.",
    "required": true
   },
   {
    "key": "emptyTitle",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Nothing to preview",
    "doc": "The message's title when there is no text."
   },
   {
    "key": "emptySubtitle",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The line under it."
   }
  ]
 },
 "previews": [
  {
   "name": "Text",
   "size": [
    320,
    90
   ],
   "props": {
    "code": "name: nightly-export\nschedule: \"0 2 * * *\"\nsteps:\n  - run: export --all"
   }
  },
  {
   "name": "Empty",
   "size": [
    320,
    110
   ],
   "props": {
    "emptySubtitle": "Pick a file to see it here."
   }
  }
 ],
 "nodes": {
  "preview": {
   "type": "column",
   "children": [
    "code",
    "blank"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 320
    },
    "height": {
     "hug": 90
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ]
   }
  },
  "code": {
   "type": "text",
   "props": {
    "text": "${props.code}",
    "style": {
     "fontSize": 11.5,
     "fontWeight": 400,
     "height": 1.6,
     "color": "primaryText",
     "leadingDistribution": "even",
     "letterSpacing": -0.1,
     "fontFamily": "monospace"
    }
   },
   "layout": {
    "width": {
     "fill": 288
    },
    "height": {
     "hug": 18
    },
    "margin": 16
   },
   "bind": {
    "visible": "${= props.code != ''}"
   }
  },
  "blank": {
   "type": "column",
   "children": [
    "blankIcon",
    "blankTitle",
    "blankLine"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 320
    },
    "height": {
     "hug": 110
    },
    "padding": [
     16,
     24,
     16,
     24
    ]
   },
   "bind": {
    "visible": "${= props.code == ''}"
   }
  },
  "blankIcon": {
   "type": "icon",
   "props": {
    "icon": "code",
    "color": "tertiaryText",
    "size": 28
   },
   "layout": {
    "width": 28,
    "height": 28
   }
  },
  "blankTitle": {
   "type": "text",
   "props": {
    "text": "${props.emptyTitle}",
    "style": {
     "fontSize": 13,
     "fontWeight": 600,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 120
    },
    "height": {
     "hug": 17
    },
    "margin": [
     0,
     10,
     0,
     4
    ]
   }
  },
  "blankLine": {
   "type": "text",
   "props": {
    "text": "${props.emptySubtitle}",
    "style": {
     "fontSize": 12,
     "fontWeight": 400,
     "height": 1.4,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 160
    },
    "height": {
     "hug": 17
    }
   },
   "bind": {
    "visible": "${= props.emptySubtitle != ''}"
   }
  }
 }
}
