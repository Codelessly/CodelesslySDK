{
 "schema": 3,
 "id": "SlidingPanel",
 "roots": [
  "panel"
 ],
 "widget": {
  "type": "SlidingPanel",
  "doc": "The panel that rises from the foot of a pane: a header with a title, a subtitle and a button that lowers it, over the call's children. Fires onCollapse.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Details",
    "doc": "The title.",
    "required": true
   },
   {
    "key": "subtitle",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A muted line under it."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "An icon before the title (empty: none)."
   }
  ],
  "events": [
   {
    "key": "onCollapse"
   }
  ],
  "slots": [
   "actions"
  ],
  "children": "list"
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    340,
    110
   ],
   "props": {
    "title": "Run log",
    "subtitle": "42 lines",
    "icon": "terminal"
   }
  }
 ],
 "nodes": {
  "panel": {
   "type": "column",
   "children": [
    "header",
    "body"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 340
    },
    "height": {
     "hug": 110
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "top"
   }
  },
  "header": {
   "type": "row",
   "children": [
    "strut",
    "headerContent"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 340
    },
    "height": {
     "hug": 44
    },
    "padding": [
     14,
     0,
     8,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "strut": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 43
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "terminal",
    "color": "tertiaryText",
    "size": 13
   },
   "layout": {
    "width": 13,
    "height": 13
   },
   "bind": {
    "visible": "${= props.icon != ''}",
    "props.icon": "${props.icon}"
   }
  },
  "titles": {
   "type": "column",
   "children": [
    "title",
    "subtitle"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 3
   },
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 15
    }
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "${props.title}",
    "style": {
     "fontSize": 12,
     "fontWeight": 600,
     "height": 1.2,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 15
    }
   }
  },
  "subtitle": {
   "type": "text",
   "props": {
    "text": "${props.subtitle}",
    "style": {
     "fontSize": 10.5,
     "fontWeight": 400,
     "height": 1.2,
     "color": "tertiaryText",
     "leadingDistribution": "even",
     "letterSpacing": -0.1
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 220
    },
    "height": {
     "hug": 13
    }
   },
   "bind": {
    "visible": "${= props.subtitle != ''}"
   }
  },
  "actions": {
   "type": "slot",
   "props": {
    "name": "actions"
   }
  },
  "lower": {
   "type": "row",
   "children": [
    "chevron"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 28,
    "height": 28
   },
   "decoration": {
    "radius": 2
   },
   "tooltip": "Collapse",
   "states": {
    "hovered": {
     "lower": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onCollapse"
      }
     ]
    }
   ]
  },
  "chevron": {
   "type": "icon",
   "props": {
    "icon": "expand_more",
    "color": "tertiaryText",
    "size": 14
   },
   "layout": {
    "width": 14,
    "height": 14
   }
  },
  "body": {
   "type": "column",
   "children": [
    "content"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 340
    },
    "height": {
     "hug": 60
    }
   }
  },
  "content": {
   "type": "slot"
  },
  "headerContent": {
   "type": "row",
   "children": [
    "glyph",
    "titles",
    "actions",
    "lower"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 12
   },
   "layout": {
    "width": {
     "fill": 100
    },
    "height": {
     "hug": 16
    }
   }
  }
 }
}
