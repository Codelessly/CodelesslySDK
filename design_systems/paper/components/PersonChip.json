{
 "schema": 3,
 "id": "PersonChip",
 "roots": [
  "chip"
 ],
 "widget": {
  "type": "PersonChip",
  "doc": "A person, a bot or a team as a small pill: avatar and name. Fires onPressed and onRemove.",
  "props": [
   {
    "key": "name",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Ada Lovelace",
    "doc": "Whose.",
    "required": true
   },
   {
    "key": "image",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A photo URL (empty: initials, or the kind's glyph)."
   },
   {
    "key": "kind",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "human",
      "bot",
      "team"
     ]
    },
    "default": "human",
    "doc": "human: photo or initials. bot: a bot glyph. team: an accent tile."
   },
   {
    "key": "trailing",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "Muted words after the name (\"· git\")."
   },
   {
    "key": "removable",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "An x at the end that fires onRemove."
   }
  ],
  "events": [
   {
    "key": "onPressed"
   },
   {
    "key": "onRemove"
   }
  ]
 },
 "previews": [
  {
   "name": "Person",
   "size": [
    110,
    24
   ],
   "props": {
    "name": "Ada Lovelace"
   }
  },
  {
   "name": "Team",
   "size": [
    110,
    24
   ],
   "props": {
    "name": "Platform",
    "kind": "team"
   }
  },
  {
   "name": "Removable",
   "size": [
    120,
    24
   ],
   "props": {
    "name": "Grace Hopper",
    "removable": true
   }
  }
 ],
 "nodes": {
  "chip": {
   "type": "row",
   "children": [
    "avatar",
    "name",
    "trailing",
    "remove"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 5
   },
   "layout": {
    "width": {
     "hug": 100
    },
    "height": {
     "hug": 24
    },
    "padding": [
     2,
     2,
     8,
     2
    ]
   },
   "decoration": {
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 9999
   },
   "bind": {
    "layout.padding": "${= props.removable ? [2, 2, 3, 2] : [2, 2, 8, 2]}"
   },
   "states": {
    "hovered": {
     "chip": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onPressed",
       "value": "${props.name}"
      }
     ]
    }
   ]
  },
  "avatar": {
   "type": "row",
   "children": [
    "initials",
    "glyph"
   ],
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": 18,
    "height": 18
   },
   "decoration": {
    "fills": [
     {
      "color": "subtleFill"
     },
     {
      "type": "image",
      "image": {
       "url": "",
       "fit": "cover"
      },
      "visible": false
     }
    ],
    "radius": 9999,
    "clip": "antiAlias"
   },
   "bind": {
    "decoration.radius": "${= props.kind == 'team' ? 5 : 9999}",
    "decoration.fills[0].color": "${= props.kind == 'team' ? theme.colors.primaryTint : theme.colors.subtleFill}",
    "decoration.fills[1].image.url": "${props.image}",
    "decoration.fills[1].visible": "${= props.image != '' && props.kind != 'team'}"
   }
  },
  "initials": {
   "type": "text",
   "props": {
    "text": "${= upper(substring(props.name, 0, 1)) + (contains(props.name, ' ') ? upper(substring(split(props.name, ' ')[1], 0, 1)) : '')}",
    "style": {
     "fontSize": 8,
     "fontWeight": 600,
     "height": 1,
     "color": "secondaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 12
    },
    "height": {
     "hug": 8
    }
   },
   "bind": {
    "visible": "${= props.kind == 'human' && props.image == ''}"
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "smart_toy",
    "color": "secondaryText",
    "size": 13
   },
   "layout": {
    "width": 13,
    "height": 13
   },
   "bind": {
    "visible": "${= props.kind == 'team' || (props.kind == 'bot' && props.image == '')}",
    "props.icon": "${= props.kind == 'team' ? 'groups' : 'smart_toy'}",
    "props.size": "${= props.kind == 'team' ? 11 : 13}",
    "props.color": "${= props.kind == 'team' ? theme.primary : theme.colors.secondaryText}"
   }
  },
  "name": {
   "type": "text",
   "props": {
    "text": "${props.name}",
    "maxLines": 1,
    "overflow": "ellipsis",
    "style": {
     "fontSize": 11.5,
     "fontWeight": 400,
     "height": 1.565217391304348,
     "color": "primaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 18
    }
   }
  },
  "trailing": {
   "type": "text",
   "props": {
    "text": "${props.trailing}",
    "style": {
     "fontSize": 11.5,
     "fontWeight": 400,
     "height": 1.565217391304348,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 30
    },
    "height": {
     "hug": 18
    }
   },
   "bind": {
    "visible": "${= props.trailing != ''}"
   }
  },
  "remove": {
   "type": "row",
   "children": [
    "x"
   ],
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": 16,
    "height": 16
   },
   "decoration": {
    "radius": 9999
   },
   "bind": {
    "visible": "${props.removable}"
   },
   "states": {
    "hovered": {
     "remove": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onRemove",
       "value": "${props.name}"
      }
     ]
    }
   ]
  },
  "x": {
   "type": "icon",
   "props": {
    "icon": "close",
    "color": "tertiaryText",
    "size": 11
   },
   "layout": {
    "width": 11,
    "height": 11
   }
  }
 }
}
