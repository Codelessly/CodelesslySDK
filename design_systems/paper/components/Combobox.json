{
 "schema": 3,
 "id": "Combobox",
 "roots": [
  "column"
 ],
 "widget": {
  "type": "Combobox",
  "doc": "A choice from a list you can search: press it and a panel with a search box opens under it, in place. The choice is kept in your variable. Fires onChanged.",
  "props": [
   {
    "key": "options",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Apple",
     "Banana",
     "Cherry"
    ],
    "doc": "The choices.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the choice."
   },
   {
    "key": "placeholder",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Select an option...",
    "doc": "Shown with no choice."
   },
   {
    "key": "searchPlaceholder",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Search...",
    "doc": "Shown in the empty search box."
   },
   {
    "key": "size",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "small",
      "medium",
      "large"
     ]
    },
    "default": "medium",
    "doc": "small (32), medium (40) or large (48)."
   },
   {
    "key": "open",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Whether the panel shows at first."
   },
   {
    "key": "enabled",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "False dims it and stops presses."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "variables": {
  "column": [
   {
    "name": "toggled",
    "type": "boolean",
    "value": false
   },
   {
    "name": "query",
    "type": "text",
    "value": ""
   }
  ]
 },
 "previews": [
  {
   "name": "Closed",
   "size": [
    260,
    40
   ],
   "props": {
    "value": "Banana"
   }
  },
  {
   "name": "Open",
   "size": [
    260,
    220
   ],
   "props": {
    "value": "Banana",
    "open": true
   }
  }
 ],
 "nodes": {
  "column": {
   "type": "column",
   "children": [
    "trigger",
    "panel"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 4
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 40
    }
   },
   "bind": {
    "opacity": "${= props.enabled ? 1 : 0.5}"
   }
  },
  "trigger": {
   "type": "row",
   "children": [
    "strut",
    "triggerContent"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 40
    },
    "padding": [
     12,
     0,
     12,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 3
   },
   "bind": {
    "decoration.strokes[0].color": "${= (props.open != toggled) ? theme.primary : theme.colors.primaryBorder}"
   },
   "states": {
    "hovered": {
     "trigger": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click",
      "when": "props.enabled"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "toggled",
       "value": "${= !toggled}"
      }
     ]
    }
   ]
  },
  "strut": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 38
   },
   "bind": {
    "layout.height": "${= props.size == 'small' ? 30 : (props.size == 'medium' ? 38 : (46))}"
   }
  },
  "choice": {
   "type": "text",
   "props": {
    "text": "${= props.value != '' ? props.value : props.placeholder}",
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.4,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 20
    }
   },
   "bind": {
    "props.style.color": "${= props.value != '' ? theme.colors.primaryText : theme.colors.tertiaryText}",
    "props.style.fontSize": "${= props.size == 'small' ? 14 : (props.size == 'medium' ? 14 : (16))}"
   }
  },
  "chevron": {
   "type": "icon",
   "props": {
    "icon": "expand_more",
    "color": "tertiaryText",
    "size": 16
   },
   "layout": {
    "width": 16,
    "height": 16
   },
   "bind": {
    "props.icon": "${= (props.open != toggled) ? 'expand_less' : 'expand_more'}"
   }
  },
  "panel": {
   "type": "column",
   "children": [
    "searchRow",
    "list",
    "none"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 260
    },
    "height": {
     "hug": 170
    },
    "padding": 1
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 3,
    "clip": "antiAlias",
    "effects": [
     {
      "type": "dropShadow",
      "color": "#1F000000",
      "offset": [
       0,
       4
      ],
      "blurRadius": 16,
      "spreadRadius": -2
     },
     {
      "type": "dropShadow",
      "color": "#0F000000",
      "offset": [
       0,
       1
      ],
      "blurRadius": 3
     }
    ]
   },
   "bind": {
    "visible": "${= props.open != toggled}",
    "decoration.effects": "${theme.shadows.level3}"
   }
  },
  "searchRow": {
   "type": "row",
   "children": [
    "searchBox"
   ],
   "layout": {
    "width": {
     "fill": 258
    },
    "height": {
     "hug": 50
    },
    "padding": 8
   },
   "decoration": {
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "searchBox": {
   "type": "row",
   "children": [
    "searchIcon",
    "field"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 242
    },
    "height": {
     "hug": 34
    },
    "padding": [
     10,
     6,
     10,
     6
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 3
   }
  },
  "searchIcon": {
   "type": "icon",
   "props": {
    "icon": "search",
    "color": "tertiaryText",
    "size": 16
   },
   "layout": {
    "width": 16,
    "height": 16
   }
  },
  "field": {
   "type": "textField",
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 20
    }
   },
   "props": {
    "style": {
     "from": "inputText",
     "fontSize": 14
    },
    "decoration": {
     "isDense": true,
     "isCollapsed": true,
     "border": {
      "type": "none"
     },
     "hintStyle": {
      "from": "placeholder",
      "fontSize": 14
     }
    },
    "cursorColor": "primary"
   },
   "bind": {
    "props.initialValue": "${query}",
    "props.decoration.hintText": "${props.searchPlaceholder}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "query",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "list": {
   "type": "listView",
   "children": [
    "option"
   ],
   "props": {
    "scrollable": false
   },
   "layout": {
    "width": {
     "fill": 258
    },
    "height": {
     "hug": 108
    },
    "padding": [
     0,
     4,
     0,
     4
    ]
   },
   "bind": {
    "data": "${props.options}"
   }
  },
  "option": {
   "type": "row",
   "children": [
    "optionLabel",
    "tick"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 258
    },
    "height": {
     "hug": 36
    },
    "padding": [
     12,
     8,
     12,
     8
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ]
   },
   "bind": {
    "visible": "${= query == '' || contains(lower(item), lower(query))}",
    "selected": "${= item == props.value}",
    "layout.padding": "${= props.size == 'small' ? [12, 6, 12, 6] : (props.size == 'medium' ? [12, 8, 12, 8] : ([12, 12, 12, 12]))}"
   },
   "states": {
    "hovered": {
     "option": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "selected": {
     "option": {
      "decoration": {
       "fills": [
        {
         "color": "activeTint"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${item}"
      },
      {
       "type": "setVariable",
       "variable": "toggled",
       "value": "${= props.open}"
      },
      {
       "type": "setVariable",
       "variable": "query",
       "value": ""
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "optionLabel": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.4,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 20
    }
   },
   "bind": {
    "props.style.fontSize": "${= props.size == 'small' ? 14 : (props.size == 'medium' ? 14 : (16))}"
   }
  },
  "tick": {
   "type": "icon",
   "props": {
    "icon": "check",
    "color": "primary",
    "size": 16
   },
   "layout": {
    "width": 16,
    "height": 16
   },
   "bind": {
    "visible": "${= item == props.value}"
   }
  },
  "none": {
   "type": "row",
   "children": [
    "noneText"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 258
    },
    "height": {
     "hug": 52
    },
    "padding": 16
   },
   "bind": {
    "visible": "${= query != '' && !any(props.options, o => contains(lower(o), lower(query)))}"
   }
  },
  "noneText": {
   "type": "text",
   "props": {
    "text": "No options found",
    "style": {
     "fontSize": 14,
     "fontWeight": 400,
     "height": 1.4,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 110
    },
    "height": {
     "hug": 20
    }
   }
  },
  "triggerContent": {
   "type": "row",
   "children": [
    "choice",
    "chevron"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 100
    },
    "height": {
     "hug": 16
    }
   }
  }
 }
}
