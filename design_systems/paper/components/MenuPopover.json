{
 "schema": 3,
 "id": "MenuPopover",
 "roots": [
  "menu"
 ],
 "widget": {
  "type": "MenuPopover",
  "doc": "The surface of a menu: bordered, rounded, with a shadow and an optional heading. Its children are MenuItem calls.",
  "props": [
   {
    "key": "heading",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A small heading over the items (empty: none)."
   },
   {
    "key": "size",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "small",
      "medium"
     ]
    },
    "default": "medium",
    "doc": "small: radius 7. medium: radius 8."
   }
  ],
  "children": "list"
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    228,
    80
   ],
   "props": {
    "heading": "Automation actions"
   }
  }
 ],
 "nodes": {
  "menu": {
   "type": "column",
   "children": [
    "heading",
    "content"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 228
    },
    "height": {
     "hug": 80
    },
    "padding": 1
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 3,
    "clip": "antiAlias",
    "effects": [
     {
      "type": "dropShadow",
      "color": "#1F000000",
      "offset": [
       0,
       4
      ],
      "blurRadius": 16,
      "spreadRadius": -2
     },
     {
      "type": "dropShadow",
      "color": "#0F000000",
      "offset": [
       0,
       1
      ],
      "blurRadius": 3
     }
    ]
   },
   "bind": {
    "decoration.radius": "${= props.size == 'small' ? 7 : 8}",
    "decoration.effects": "${theme.shadows.level3}"
   }
  },
  "heading": {
   "type": "row",
   "children": [
    "headingText"
   ],
   "layout": {
    "width": {
     "fill": 226
    },
    "height": {
     "hug": 25
    },
    "padding": [
     8,
     6,
     8,
     6
    ]
   },
   "decoration": {
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   },
   "bind": {
    "visible": "${= props.heading != ''}"
   }
  },
  "headingText": {
   "type": "text",
   "props": {
    "text": "${props.heading}",
    "style": {
     "fontSize": 10,
     "fontWeight": 700,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 13
    }
   }
  },
  "content": {
   "type": "slot"
  }
 }
}
