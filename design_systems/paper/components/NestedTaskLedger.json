{
 "schema": 3,
 "id": "NestedTaskLedger",
 "roots": [
  "ledger"
 ],
 "widget": {
  "type": "NestedTaskLedger",
  "doc": "Work broken into nested tasks: each row with its state (pending, running, done or failed), a count and a small progress bar. Fires onSelected with the task's name.",
  "props": [
   {
    "key": "tasks",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Build",
     "Compile",
     "Bundle",
     "Deploy"
    ],
    "doc": "The tasks, top to bottom.",
    "required": true
   },
   {
    "key": "depths",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "0",
     "1",
     "1",
     "0"
    ],
    "doc": "How deep each row sits: 0 at the edge."
   },
   {
    "key": "statuses",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "running",
     "done",
     "running",
     "pending"
    ],
    "doc": "One state per task: pending, running, done or failed."
   },
   {
    "key": "counts",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "A short count per task (\"2/5\"; empty: none)."
   },
   {
    "key": "progress",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "How far each task is, 0 to 100 (empty: no bar)."
   }
  ],
  "events": [
   {
    "key": "onSelected",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    360,
    140
   ],
   "props": {
    "counts": [
     "1/2",
     "",
     "",
     ""
    ],
    "progress": [
     "50",
     "100",
     "40",
     ""
    ]
   }
  }
 ],
 "nodes": {
  "ledger": {
   "type": "listView",
   "children": [
    "row"
   ],
   "props": {
    "scrollable": false
   },
   "layout": {
    "width": {
     "fill": 360
    },
    "height": {
     "hug": 140
    }
   },
   "bind": {
    "data": "${props.tasks}"
   }
  },
  "row": {
   "type": "row",
   "children": [
    "strut",
    "rowContent"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 360
    },
    "height": {
     "hug": 34
    },
    "padding": [
     12,
     0,
     12,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   },
   "states": {
    "hovered": {
     "row": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onSelected",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "strut": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 33
   }
  },
  "indent": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 1
   },
   "bind": {
    "layout.width": "${= 14 * (length(props.depths) > index ? number(props.depths[index]) : 0)}"
   }
  },
  "chevron": {
   "type": "icon",
   "props": {
    "icon": "expand_more",
    "color": "tertiaryText",
    "size": 13
   },
   "layout": {
    "width": 13,
    "height": 13
   },
   "bind": {
    "opacity": "${= length(props.depths) > index + 1 && number(props.depths[index + 1]) > number(props.depths[index]) ? 1 : 0}"
   }
  },
  "spin": {
   "type": "circularProgressIndicator",
   "layout": {
    "width": 13,
    "height": 13,
    "margin": [
     1,
     0,
     1,
     0
    ]
   },
   "props": {
    "color": "primary",
    "strokeWidth": 1.5
   },
   "bind": {
    "visible": "${= (length(props.statuses) > index ? props.statuses[index] : 'pending') == 'running'}"
   }
  },
  "state": {
   "type": "icon",
   "props": {
    "icon": "radio_button_unchecked",
    "color": "tertiaryText",
    "size": 15
   },
   "layout": {
    "width": 15,
    "height": 15
   },
   "bind": {
    "visible": "${= (length(props.statuses) > index ? props.statuses[index] : 'pending') != 'running'}",
    "props.icon": "${= (length(props.statuses) > index ? props.statuses[index] : 'pending') == 'done' ? 'check_circle_outline' : ((length(props.statuses) > index ? props.statuses[index] : 'pending') == 'failed' ? 'highlight_off' : 'radio_button_unchecked')}",
    "props.color": "${= (length(props.statuses) > index ? props.statuses[index] : 'pending') == 'done' ? theme.success : ((length(props.statuses) > index ? props.statuses[index] : 'pending') == 'failed' ? theme.error : theme.colors.tertiaryText)}"
   }
  },
  "name": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "fontSize": 12.5,
     "fontWeight": 500,
     "height": 1.3,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 140
    },
    "height": {
     "hug": 17
    }
   }
  },
  "count": {
   "type": "text",
   "props": {
    "text": "${= length(props.counts) > index ? props.counts[index] : ''}",
    "style": {
     "fontSize": 11,
     "fontWeight": 500,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 20
    },
    "height": {
     "hug": 15
    }
   },
   "bind": {
    "visible": "${= length(props.counts) > index && props.counts[index] != ''}"
   }
  },
  "track": {
   "type": "row",
   "children": [
    "fill",
    "rest"
   ],
   "layout": {
    "width": 96,
    "height": 5
   },
   "bind": {
    "visible": "${= length(props.progress) > index && props.progress[index] != ''}"
   },
   "decoration": {
    "fills": [
     {
      "color": "tertiaryBackground"
     }
    ],
    "clip": "antiAlias",
    "radius": 9999
   }
  },
  "fill": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 48
    },
    "height": {
     "fill": 5
    },
    "flex": 1
   },
   "decoration": {
    "fills": [
     {
      "color": "primary"
     }
    ],
    "radius": 9999
   },
   "bind": {
    "visible": "${= (length(props.progress) > index ? clamp(number(props.progress[index]), 0, 100) : 0) > 0}",
    "layout.flex": "${= max(1, round((length(props.progress) > index ? clamp(number(props.progress[index]), 0, 100) : 0) * 10))}",
    "decoration.fills[0].color": "${= (length(props.statuses) > index ? props.statuses[index] : 'pending') == 'failed' ? theme.error : ((length(props.statuses) > index ? props.statuses[index] : 'pending') == 'done' ? theme.success : theme.primary)}"
   }
  },
  "rest": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 48
    },
    "height": {
     "fill": 5
    },
    "flex": 1
   },
   "bind": {
    "visible": "${= (length(props.progress) > index ? clamp(number(props.progress[index]), 0, 100) : 0) < 100}",
    "layout.flex": "${= max(1, round((100 - (length(props.progress) > index ? clamp(number(props.progress[index]), 0, 100) : 0)) * 10))}"
   }
  },
  "rowContent": {
   "type": "row",
   "children": [
    "indent",
    "chevron",
    "spin",
    "state",
    "name",
    "count",
    "track"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 100
    },
    "height": {
     "hug": 16
    }
   }
  }
 }
}
