{
 "schema": 3,
 "id": "ConnectionStatus",
 "roots": [
  "row"
 ],
 "widget": {
  "type": "ConnectionStatus",
  "doc": "Whether a live connection is up: a small plug in the state's color and its name.",
  "props": [
   {
    "key": "status",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "connecting",
      "connected",
      "reconnecting",
      "disconnected"
     ]
    },
    "default": "connected",
    "doc": "connecting, connected, reconnecting or disconnected."
   },
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "Other words than the state's own (empty: \"Connected\", \"Reconnecting…\"...)."
   }
  ]
 },
 "previews": [
  {
   "name": "Connected",
   "size": [
    80,
    14
   ],
   "props": {
    "status": "connected"
   }
  },
  {
   "name": "Reconnecting",
   "size": [
    90,
    14
   ],
   "props": {
    "status": "reconnecting"
   }
  }
 ],
 "nodes": {
  "row": {
   "type": "row",
   "children": [
    "glyph",
    "label"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 4
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 14
    }
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "power",
    "color": "success",
    "size": 11
   },
   "layout": {
    "width": 11,
    "height": 11
   },
   "bind": {
    "props.icon": "${= props.status == 'connected' ? 'power' : 'power_off'}",
    "props.color": "${= props.status == 'connected' ? theme.success : (props.status == 'reconnecting' ? theme.warning : (props.status == 'disconnected' ? theme.error : theme.colors.tertiaryText))}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${= props.label != '' ? props.label : (props.status == 'connected' ? 'Connected' : (props.status == 'reconnecting' ? 'Reconnecting…' : (props.status == 'disconnected' ? 'Disconnected' : 'Connecting…')))}",
    "style": {
     "fontSize": 10,
     "fontWeight": 600,
     "height": 1.3,
     "color": "secondaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 13
    }
   }
  }
 }
}
