{
 "schema": 3,
 "id": "IconSegmentedControl",
 "roots": [
  "well"
 ],
 "widget": {
  "type": "IconSegmentedControl",
  "doc": "A choice between a few views shown as icons in one well (list or grid, align left, center or right). The chosen icon's name is kept in your variable. Fires onChanged.",
  "props": [
   {
    "key": "icons",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "view_list",
     "grid_view"
    ],
    "doc": "The choices, each an icon.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen icon's name."
   },
   {
    "key": "density",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "compact",
      "toolbar"
     ]
    },
    "default": "compact",
    "doc": "compact: 28 high. toolbar: 24 high."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Two",
   "size": [
    62,
    28
   ],
   "props": {
    "value": "view_list"
   }
  }
 ],
 "nodes": {
  "well": {
   "type": "row",
   "children": [
    "list"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 62
    },
    "height": {
     "hug": 28
    },
    "padding": 2
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 2
   },
   "bind": {
    "layout.padding": "${= props.density == 'toolbar' ? 1 : 2}",
    "decoration.radius": "${= props.density == 'toolbar' ? 4 : 6}"
   }
  },
  "list": {
   "type": "listView",
   "children": [
    "option"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false
   },
   "layout": {
    "width": {
     "hug": 56
    },
    "height": 24
   },
   "bind": {
    "data": "${props.icons}",
    "layout.height": "${= props.density == 'toolbar' ? 22 : 24}"
   }
  },
  "option": {
   "type": "row",
   "children": [
    "glyph"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 28,
    "height": {
     "fill": 24
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder",
      "visible": false
     }
    ],
    "radius": 4,
    "effects": []
   },
   "bind": {
    "selected": "${= item == props.value}",
    "layout.width": "${= props.density == 'toolbar' ? 22 : 28}",
    "decoration.radius": "${= props.density == 'toolbar' ? 3 : 4}"
   },
   "states": {
    "hovered": {
     "option": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "selected": {
     "option": {
      "decoration": {
       "fills": [
        {
         "color": "primaryBackground"
        }
       ],
       "strokes": [
        {
         "color": "primaryBorder"
        }
       ],
       "effects": [
        {
         "type": "dropShadow",
         "color": "#0D000000",
         "offset": [
          0,
          1
         ],
         "blurRadius": 2
        }
       ]
      }
     },
     "glyph": {
      "props": {
       "color": "primaryText"
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${item}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "circle",
    "color": "tertiaryText",
    "size": 14
   },
   "layout": {
    "width": 14,
    "height": 14
   },
   "bind": {
    "props.icon": "${item}",
    "props.size": "${= props.density == 'toolbar' ? 12 : 14}",
    "layout.width": "${= props.density == 'toolbar' ? 12 : 14}",
    "layout.height": "${= props.density == 'toolbar' ? 12 : 14}"
   }
  }
 }
}
