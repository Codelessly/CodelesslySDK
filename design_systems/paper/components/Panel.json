{
 "schema": 3,
 "id": "Panel",
 "roots": [
  "panel"
 ],
 "widget": {
  "type": "Panel",
  "doc": "A bordered section with a header: a title, an optional icon and subtitle, the call's children below. Expandable opens and closes on its header. Fires onToggle.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Section",
    "doc": "The header's title (empty and not expandable: no header)."
   },
   {
    "key": "subtitle",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A muted line under the title."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "An icon before the title (empty: none)."
   },
   {
    "key": "variant",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "default",
      "expandable",
      "elevated"
     ]
    },
    "default": "default",
    "doc": "default: a header over the content. expandable: the header opens and closes it. elevated: with a shadow."
   },
   {
    "key": "open",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Expandable: whether the content shows at first."
   }
  ],
  "events": [
   {
    "key": "onToggle",
    "payload": {
     "kind": "boolean",
     "flutter": "bool"
    }
   }
  ],
  "slots": [
   "trailing"
  ],
  "children": "list"
 },
 "variables": {
  "panel": [
   {
    "name": "toggled",
    "type": "boolean",
    "value": false
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    280,
    90
   ],
   "props": {
    "title": "Billing",
    "subtitle": "Plan and invoices"
   }
  },
  {
   "name": "Expandable",
   "size": [
    280,
    40
   ],
   "props": {
    "title": "Advanced",
    "variant": "expandable"
   }
  }
 ],
 "nodes": {
  "panel": {
   "type": "column",
   "children": [
    "header",
    "body"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 280
    },
    "height": {
     "hug": 90
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 10,
    "clip": "antiAlias",
    "effects": []
   },
   "bind": {
    "decoration.effects": "${= props.variant == 'elevated' ? theme.shadows.level2 : []}"
   }
  },
  "header": {
   "type": "row",
   "children": [
    "glyph",
    "titles",
    "trailing",
    "chevron"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 280
    },
    "height": {
     "hug": 34
    },
    "padding": [
     14,
     10,
     14,
     10
    ]
   },
   "decoration": {
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   },
   "bind": {
    "visible": "${= props.title != '' || props.variant == 'expandable'}",
    "decoration.strokes[0].visible": "${= props.variant != 'expandable' || (props.open != toggled)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click",
      "when": "props.variant == 'expandable'"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "toggled",
       "value": "${= !toggled}"
      },
      {
       "type": "componentEvent",
       "event": "onToggle",
       "value": "${= (props.open != toggled)}"
      }
     ]
    }
   ]
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "settings",
    "color": "secondaryText",
    "size": 16
   },
   "layout": {
    "width": 16,
    "height": 16
   },
   "bind": {
    "visible": "${= props.icon != ''}",
    "props.icon": "${props.icon}"
   }
  },
  "titles": {
   "type": "column",
   "children": [
    "title",
    "subtitle"
   ],
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 2
   },
   "layout": {
    "width": {
     "fill": 200
    },
    "height": {
     "hug": 14
    }
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "${props.title}",
    "style": {
     "fontSize": 12,
     "fontWeight": 600,
     "height": 1.15,
     "color": "primaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 14
    }
   }
  },
  "subtitle": {
   "type": "text",
   "props": {
    "text": "${props.subtitle}",
    "style": {
     "fontSize": 10.5,
     "fontWeight": 400,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 14
    }
   },
   "bind": {
    "visible": "${= props.subtitle != ''}"
   }
  },
  "trailing": {
   "type": "slot",
   "props": {
    "name": "trailing"
   }
  },
  "chevron": {
   "type": "icon",
   "props": {
    "icon": "chevron_right",
    "color": "tertiaryText",
    "size": 15
   },
   "layout": {
    "width": 15,
    "height": 15
   },
   "bind": {
    "visible": "${= props.variant == 'expandable'}",
    "props.icon": "${= (props.open != toggled) ? 'expand_more' : 'chevron_right'}"
   }
  },
  "body": {
   "type": "column",
   "children": [
    "content"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 280
    },
    "height": {
     "hug": 40
    }
   },
   "bind": {
    "visible": "${= props.variant != 'expandable' || (props.open != toggled)}"
   }
  },
  "content": {
   "type": "slot"
  }
 }
}
