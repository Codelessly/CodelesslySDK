{
 "schema": 3,
 "id": "SelectableListRow",
 "roots": [
  "row"
 ],
 "widget": {
  "type": "SelectableListRow",
  "doc": "A row of a list you pick from: a title, a subtitle, a note at the end, selected or not. The call's children go under the text. Fires onSelected.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Item",
    "doc": "The title.",
    "required": true
   },
   {
    "key": "subtitle",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A line under it."
   },
   {
    "key": "subtitleMono",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "The subtitle in monospace (a path, an id)."
   },
   {
    "key": "trailing",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A short note at the end of the title's line (a time, a count)."
   },
   {
    "key": "selected",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Tinted as the chosen row."
   }
  ],
  "events": [
   {
    "key": "onSelected"
   }
  ],
  "slots": [
   "leading"
  ],
  "children": "list"
 },
 "previews": [
  {
   "name": "Selected",
   "size": [
    300,
    54
   ],
   "props": {
    "title": "Weekly digest",
    "subtitle": "Runs every Monday at 9",
    "trailing": "2h ago",
    "selected": true
   }
  },
  {
   "name": "Plain",
   "size": [
    300,
    54
   ],
   "props": {
    "title": "Nightly export",
    "subtitle": "jobs/export.yaml",
    "subtitleMono": true
   }
  }
 ],
 "nodes": {
  "row": {
   "type": "row",
   "children": [
    "leading",
    "texts"
   ],
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 9
   },
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 54
    },
    "padding": [
     12,
     9,
     12,
     10
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   },
   "bind": {
    "selected": "${props.selected}"
   },
   "states": {
    "hovered": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "selected": {
     "row": {
      "decoration": {
       "fills": [
        {
         "color": "primaryTint"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onSelected"
      }
     ]
    }
   ]
  },
  "leading": {
   "type": "slot",
   "props": {
    "name": "leading"
   }
  },
  "texts": {
   "type": "column",
   "children": [
    "line",
    "subtitle",
    "meta"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 2
   },
   "layout": {
    "width": {
     "fill": 240
    },
    "height": {
     "hug": 36
    }
   }
  },
  "line": {
   "type": "row",
   "children": [
    "title",
    "trailing"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 240
    },
    "height": {
     "hug": 18
    }
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "${props.title}",
    "style": {
     "fontSize": 12.5,
     "fontWeight": 600,
     "height": 1.44,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 180
    },
    "height": {
     "hug": 18
    }
   }
  },
  "trailing": {
   "type": "text",
   "props": {
    "text": "${props.trailing}",
    "style": {
     "fontSize": 10.5,
     "fontWeight": 400,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 14
    }
   },
   "bind": {
    "visible": "${= props.trailing != ''}"
   }
  },
  "subtitle": {
   "type": "text",
   "props": {
    "text": "${props.subtitle}",
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.4545454545454546,
     "color": "secondaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 240
    },
    "height": {
     "hug": 16
    }
   },
   "bind": {
    "visible": "${= props.subtitle != ''}",
    "props.style.fontFamily": "${= props.subtitleMono ? 'monospace' : theme.fontFamily}",
    "props.style.fontSize": "${= props.subtitleMono ? 10.5 : 11}"
   }
  },
  "meta": {
   "type": "column",
   "children": [
    "content"
   ],
   "props": {
    "crossAxisAlignment": "start",
    "spacing": 4
   },
   "layout": {
    "width": {
     "fill": 240
    },
    "height": {
     "hug": 0
    },
    "padding": [
     0,
     2,
     0,
     0
    ]
   }
  },
  "content": {
   "type": "slot"
  }
 }
}
