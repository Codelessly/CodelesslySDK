{
 "schema": 3,
 "id": "PaneToolbar",
 "roots": [
  "bar"
 ],
 "widget": {
  "type": "PaneToolbar",
  "doc": "The bar of a pane: an icon, a title, a muted note, the call's actions and a close button. Fires onTitle and onClose.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Pane",
    "doc": "The title.",
    "required": true
   },
   {
    "key": "meta",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A muted note after the title (a count, a branch)."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "An icon before the title (empty: none)."
   },
   {
    "key": "loading",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "A small spinner after the title."
   },
   {
    "key": "closable",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "A close button at the end."
   }
  ],
  "events": [
   {
    "key": "onTitle"
   },
   {
    "key": "onClose"
   }
  ],
  "slots": [
   "actions"
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    300,
    36
   ],
   "props": {
    "title": "Preview",
    "meta": "main",
    "icon": "visibility"
   }
  }
 ],
 "nodes": {
  "bar": {
   "type": "row",
   "children": [
    "strut",
    "barContent"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 36
    },
    "padding": [
     12,
     0,
     4,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "strut": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 35
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "visibility",
    "color": "tertiaryText",
    "size": 14
   },
   "layout": {
    "width": 14,
    "height": 14
   },
   "bind": {
    "visible": "${= props.icon != ''}",
    "props.icon": "${props.icon}"
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "${props.title}",
    "style": {
     "fontSize": 12,
     "fontWeight": 600,
     "height": 1.3,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 16
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onTitle"
      }
     ]
    }
   ]
  },
  "meta": {
   "type": "text",
   "props": {
    "text": "${props.meta}",
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 30
    },
    "height": {
     "hug": 15
    }
   },
   "bind": {
    "visible": "${= props.meta != ''}"
   }
  },
  "spin": {
   "type": "circularProgressIndicator",
   "layout": {
    "width": 11,
    "height": 11
   },
   "props": {
    "color": "tertiaryText",
    "strokeWidth": 1.5
   },
   "bind": {
    "visible": "${props.loading}"
   }
  },
  "gap": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 20
    },
    "height": 1
   }
  },
  "actions": {
   "type": "slot",
   "props": {
    "name": "actions"
   }
  },
  "close": {
   "type": "IconButton",
   "props": {
    "icon": "close",
    "size": "compact"
   },
   "layout": {
    "width": 28,
    "height": 28
   },
   "bind": {
    "visible": "${props.closable}"
   },
   "tooltip": "Close",
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onClose"
      }
     ]
    }
   ]
  },
  "barContent": {
   "type": "row",
   "children": [
    "glyph",
    "title",
    "meta",
    "spin",
    "gap",
    "actions",
    "close"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 6
   },
   "layout": {
    "width": {
     "fill": 100
    },
    "height": {
     "hug": 16
    }
   }
  }
 }
}
