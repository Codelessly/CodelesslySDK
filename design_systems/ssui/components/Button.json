{
 "schema": 3,
 "id": "Button",
 "roots": [
  "button"
 ],
 "widget": {
  "type": "Button",
  "doc": "A button on the control scale: primary (one per view), secondary, outline, ghost or destructive. Fires onPressed.",
  "props": [
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Button",
    "doc": "The text.",
    "required": true
   },
   {
    "key": "variant",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "primary",
      "secondary",
      "outline",
      "ghost",
      "destructive"
     ]
    },
    "default": "primary",
    "doc": "primary fills with the brand color; secondary a strong neutral; outline a hairline; ghost nothing; destructive red."
   },
   {
    "key": "size",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "xs",
      "compact",
      "small",
      "medium",
      "large"
     ]
    },
    "default": "compact",
    "doc": "The control scale: xs 24 (rows, dense panels), compact 28 (the default), small 32, medium 36, large 44."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A Material icon name shown before the label (empty: none)."
   },
   {
    "key": "enabled",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "False: 50 % opacity, not pressable."
   }
  ],
  "events": [
   {
    "key": "onPressed"
   }
  ]
 },
 "previews": [
  {
   "name": "Primary",
   "size": [
    96,
    28
   ],
   "props": {
    "label": "Save"
   }
  },
  {
   "name": "Outline",
   "size": [
    96,
    28
   ],
   "props": {
    "label": "Cancel",
    "variant": "outline"
   }
  }
 ],
 "nodes": {
  "button": {
   "type": "row",
   "children": [
    "strut",
    "buttonContent"
   ],
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "spacing": 0
   },
   "layout": {
    "width": {
     "hug": 72
    },
    "height": {
     "hug": 28
    },
    "padding": [
     10,
     0,
     10,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "primary"
     }
    ],
    "strokes": [
     {
      "color": "#00000000"
     }
    ],
    "radius": 7
   },
   "bind": {
    "layout.padding": "${= props.size == 'xs' ? [8, 0, 8, 0] : (props.size == 'compact' ? [10, 0, 10, 0] : (props.size == 'small' ? [12, 0, 12, 0] : (props.size == 'medium' ? [12, 0, 12, 0] : ([14, 0, 14, 0]))))}",
    "decoration.radius": "${= props.size == 'xs' ? theme.radii.inner : theme.radii.control}",
    "decoration.fills[0].color": "${= props.variant == 'primary' ? theme.primary : (props.variant == 'secondary' ? theme.colors.neutralFill : (props.variant == 'destructive' ? theme.error : '#00000000'))}",
    "decoration.strokes[0].color": "${= props.variant == 'outline' ? theme.colors.primaryBorder : '#00000000'}",
    "disabled": "${= !props.enabled}"
   },
   "states": {
    "hovered": {
     "button": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "button": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    },
    "disabled": {
     "button": {
      "opacity": 0.5
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click",
      "when": "props.enabled"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onPressed"
      }
     ]
    }
   ]
  },
  "strut": {
   "type": "box",
   "layout": {
    "width": 0,
    "height": 28
   },
   "bind": {
    "layout.height": "${= props.size == 'xs' ? 24 : (props.size == 'compact' ? 28 : (props.size == 'small' ? 32 : (props.size == 'medium' ? 36 : (44))))}"
   }
  },
  "icon": {
   "type": "icon",
   "props": {
    "icon": "add",
    "color": "onAccent",
    "size": 14
   },
   "layout": {
    "width": 14,
    "height": 14
   },
   "bind": {
    "visible": "${= props.icon != ''}",
    "props.icon": "${props.icon}",
    "props.size": "${= props.size == 'xs' ? 12 : (props.size == 'compact' ? 14 : (props.size == 'small' ? 14 : (props.size == 'medium' ? 16 : (18))))}",
    "layout.width": "${= props.size == 'xs' ? 12 : (props.size == 'compact' ? 14 : (props.size == 'small' ? 14 : (props.size == 'medium' ? 16 : (18))))}",
    "layout.height": "${= props.size == 'xs' ? 12 : (props.size == 'compact' ? 14 : (props.size == 'small' ? 14 : (props.size == 'medium' ? 16 : (18))))}",
    "props.color": "${= props.variant == 'primary' || props.variant == 'secondary' || props.variant == 'destructive' ? theme.colors.onAccent : theme.colors.primaryText}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${props.label}",
    "style": "controlCompact",
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 15
    }
   },
   "bind": {
    "props.style.fontSize": "${= props.size == 'xs' ? 11.5 : (props.size == 'compact' ? 12 : (props.size == 'small' ? 12.5 : (props.size == 'medium' ? 13 : (15))))}",
    "props.style.color": "${= props.variant == 'primary' || props.variant == 'secondary' || props.variant == 'destructive' ? theme.colors.onAccent : theme.colors.primaryText}"
   }
  },
  "buttonContent": {
   "type": "row",
   "children": [
    "icon",
    "label"
   ],
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "spacing": 6
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 16
    }
   },
   "bind": {
    "props.spacing": "${= props.size == 'xs' ? 6 : (props.size == 'compact' ? 6 : (props.size == 'small' ? 6 : (props.size == 'medium' ? 6 : (8))))}"
   }
  }
 }
}
