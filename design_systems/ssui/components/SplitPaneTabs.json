{
 "schema": 3,
 "id": "SplitPaneTabs",
 "roots": [
  "bar"
 ],
 "widget": {
  "type": "SplitPaneTabs",
  "doc": "The tabs over one pane of a split view: square, edge to edge, each with an x. The chosen one is kept in your variable. Fires onChanged and onClose with the label.",
  "props": [
   {
    "key": "tabs",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "index.ts",
     "styles.css"
    ],
    "doc": "The tabs' labels.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen label."
   },
   {
    "key": "closable",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "An x on each tab."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   },
   {
    "key": "onClose",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    300,
    32
   ],
   "props": {
    "value": "index.ts"
   }
  }
 ],
 "nodes": {
  "bar": {
   "type": "row",
   "children": [
    "list"
   ],
   "layout": {
    "width": {
     "fill": 300
    },
    "height": {
     "hug": 32
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "list": {
   "type": "listView",
   "children": [
    "tab"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false
   },
   "layout": {
    "width": {
     "hug": 200
    },
    "height": 31
   },
   "bind": {
    "data": "${props.tabs}"
   }
  },
  "tab": {
   "type": "row",
   "children": [
    "label",
    "close"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 4
   },
   "layout": {
    "width": {
     "hug": 90
    },
    "height": {
     "fill": 31
    },
    "padding": [
     12,
     0,
     6,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00000000"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "right"
   },
   "bind": {
    "selected": "${= item == props.value}"
   },
   "states": {
    "selected": {
     "tab": {
      "decoration": {
       "fills": [
        {
         "color": "primaryBackground"
        }
       ]
      }
     },
     "label": {
      "props": {
       "style": {
        "color": "primaryText"
       }
      }
     }
    },
    "hovered": {
     "tab": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${item}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "fontSize": 12,
     "fontWeight": 600,
     "height": 1.3,
     "color": "secondaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 16
    }
   }
  },
  "close": {
   "type": "row",
   "children": [
    "x"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 18,
    "height": 18
   },
   "decoration": {
    "radius": 4
   },
   "bind": {
    "visible": "${props.closable}"
   },
   "states": {
    "hovered": {
     "close": {
      "decoration": {
       "fills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     },
     "x": {
      "props": {
       "color": "primaryText"
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onClose",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "x": {
   "type": "icon",
   "props": {
    "icon": "close",
    "color": "tertiaryText",
    "size": 11
   },
   "layout": {
    "width": 11,
    "height": 11
   }
  }
 }
}
