{
 "schema": 3,
 "id": "RichTextToolbar",
 "roots": [
  "bar"
 ],
 "widget": {
  "type": "RichTextToolbar",
  "doc": "The formatting bar of a text editor: undo and redo, bold, italic, underline, code, heading, quote, lists, link and image. Fires onCommand with the button's name.",
  "props": [
   {
    "key": "active",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "The names of the buttons shown as on (Bold, Italic, Bulleted list...)."
   }
  ],
  "events": [
   {
    "key": "onCommand",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
