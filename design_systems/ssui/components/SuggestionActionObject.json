{
 "schema": 3,
 "id": "SuggestionActionObject",
 "roots": [
  "object"
 ],
 "widget": {
  "type": "SuggestionActionObject",
  "doc": "What a proposed change would do to a file: its name, whether it edits, creates or deletes, a summary and the proposed text.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "notes.md",
    "doc": "The file or item the change is for.",
    "required": true
   },
   {
    "key": "action",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "edit",
      "create",
      "delete"
     ]
    },
    "default": "edit",
    "doc": "edit, create or delete."
   },
   {
    "key": "summary",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "What the change does, in a line."
   },
   {
    "key": "body",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The proposed text."
   }
  ]
 },
 "previews": [
  {
   "name": "Edit",
   "size": [
    320,
    110
   ],
   "props": {
    "title": "brief.md",
    "summary": "Moves the launch date.",
    "body": "Launch: November 21"
   }
  }
 ],
 "nodes": {
