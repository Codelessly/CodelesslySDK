      "type": "dropShadow",
      "color": "#0A0F172A",
      "offset": [
       0,
       1
      ],
      "blurRadius": 2
     }
    ]
   }
  },
  "bar": {
   "type": "row",
   "children": [
    "strut",
    "barContent"
