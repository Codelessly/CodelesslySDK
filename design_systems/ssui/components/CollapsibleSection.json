{
 "schema": 3,
 "id": "CollapsibleSection",
 "roots": [
  "section"
 ],
 "widget": {
  "type": "CollapsibleSection",
  "doc": "A section under a header with a title and a count: its children, then a button that asks for the rest (\"View 6 more\") or folds them again. Fires onToggle with whether it is now open.",
  "props": [
   {
    "key": "title",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Section",
    "doc": "The title.",
    "required": true
   },
   {
    "key": "count",
    "type": {
     "kind": "number",
     "flutter": "double"
    },
    "default": 0,
    "doc": "How many items it holds, beside the title."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "An icon before the title (empty: none)."
   },
   {
    "key": "hiddenCount",
    "type": {
     "kind": "number",
     "flutter": "double"
    },
    "default": 0,
    "doc": "How many more there are to show (0: no button)."
   },
   {
    "key": "expanded",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "All are shown: the button reads \"Show less\"."
   }
  ],
  "events": [
   {
    "key": "onToggle",
    "payload": {
     "kind": "boolean",
     "flutter": "bool"
    }
   }
  ],
  "slots": [
   "actions"
  ],
  "children": "list"
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    320,
    80
   ],
   "props": {
    "title": "Images",
    "count": 14,
    "icon": "image",
    "hiddenCount": 6
   }
  }
 ],
 "nodes": {
  "section": {
   "type": "column",
   "children": [
    "header",
    "body",
    "more"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 320
    },
    "height": {
     "hug": 80
    }
   }
  },
  "header": {
   "type": "row",
   "children": [
    "glyph",
    "title",
    "count",
    "gap",
    "actions"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 320
    },
    "height": {
     "hug": 33
    },
    "padding": [
     10,
     8,
     10,
     8
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "image",
    "color": "secondaryText",
    "size": 14
   },
   "layout": {
    "width": 14,
    "height": 14
   },
   "bind": {
    "visible": "${= props.icon != ''}",
    "props.icon": "${props.icon}"
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "${props.title}",
    "style": {
     "fontSize": 12,
     "fontWeight": 600,
     "height": 1.3,
     "color": "primaryText",
     "leadingDistribution": "even"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 16
    }
   }
  },
  "count": {
   "type": "CountBadge",
   "props": {
    "count": 0,
    "showZero": true
   },
   "layout": {
    "width": {
     "hug": 18
    },
    "height": {
     "hug": 16
    }
   },
   "bind": {
    "props.count": "${props.count}"
   }
  },
  "gap": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 20
    },
    "height": 1
   }
  },
  "actions": {
   "type": "slot",
   "props": {
    "name": "actions"
   }
  },
  "body": {
   "type": "column",
   "children": [
    "content"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 320
    },
    "height": {
     "hug": 20
    }
   }
  },
  "content": {
   "type": "slot"
  },
  "more": {
   "type": "row",
   "children": [
    "moreIcon",
    "moreText"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center",
    "spacing": 6
   },
   "layout": {
    "width": {
     "fill": 320
    },
    "height": {
     "hug": 32
    },
    "padding": [
     0,
     8,
     0,
     8
    ]
   },
   "bind": {
    "visible": "${= props.hiddenCount > 0 || props.expanded}"
   },
   "states": {
    "hovered": {
     "moreText": {
      "props": {
       "style": {
        "color": "primaryText"
       }
      }
     },
     "moreIcon": {
      "props": {
       "color": "primaryText"
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onToggle",
       "value": "${= !props.expanded}"
      }
     ]
    }
   ]
  },
  "moreIcon": {
   "type": "icon",
   "props": {
    "icon": "expand_more",
    "color": "secondaryText",
    "size": 12
   },
   "layout": {
    "width": 12,
    "height": 12
   },
   "bind": {
    "props.icon": "${= props.expanded ? 'expand_less' : 'expand_more'}"
   }
  },
  "moreText": {
   "type": "text",
   "props": {
    "text": "${= props.expanded ? 'Show less' : 'View ' + text(props.hiddenCount) + ' more'}",
    "style": {
     "fontSize": 12,
     "fontWeight": 500,
     "height": 1.3,
     "color": "secondaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 16
    }
   }
  }
 }
}
