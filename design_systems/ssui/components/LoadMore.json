{
 "schema": 3,
 "id": "LoadMore",
 "roots": [
  "footer"
 ],
 "widget": {
  "type": "LoadMore",
  "doc": "The foot of a long list: a \"Load more\" link, a spinner while it loads, Retry after an error, or the end's label. Fires onLoadMore.",
  "props": [
   {
    "key": "hasMore",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "Whether more can be loaded."
   },
   {
    "key": "loading",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "A load is under way."
   },
   {
    "key": "error",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "Why the last load failed (empty: it did not)."
   },
   {
    "key": "loadLabel",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Load more",
    "doc": "The link's words."
   },
   {
    "key": "endLabel",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "What to say when there is no more (empty: nothing)."
   }
  ],
  "events": [
   {
    "key": "onLoadMore"
   }
  ]
 },
 "previews": [
  {
   "name": "More",
   "size": [
    240,
    32
   ],
   "props": {}
  },
  {
   "name": "Loading",
   "size": [
    240,
    32
   ],
   "props": {
    "loading": true
   }
  },
  {
   "name": "Error",
   "size": [
    240,
    32
   ],
   "props": {
    "error": "timeout"
   }
  }
 ],
 "nodes": {
  "footer": {
   "type": "row",
   "children": [
    "spinner",
    "words",
    "link"
   ],
   "props": {
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "spacing": 6
   },
   "layout": {
    "width": {
     "fill": 240
    },
    "height": 32
   }
  },
  "spinner": {
   "type": "circularProgressIndicator",
   "props": {
    "color": "primary",
    "strokeWidth": 1.5,
    "strokeCap": "round"
   },
   "layout": {
    "width": 11,
    "height": 11
   },
   "bind": {
    "visible": "${props.loading}"
   }
  },
  "words": {
   "type": "text",
   "props": {
    "text": "${= props.loading ? 'Loading more…' : (props.error != '' ? 'Couldn’t load more' : props.endLabel)}",
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.3,
     "color": "tertiaryText",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 80
    },
    "height": {
     "hug": 14
    }
   },
   "bind": {
    "visible": "${= props.loading || props.error != '' || (!props.hasMore && props.endLabel != '')}"
   }
  },
  "link": {
   "type": "row",
   "children": [
    "linkText"
   ],
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 18
    },
    "padding": [
     6,
     2,
     6,
     2
    ]
   },
   "decoration": {
    "radius": 4
   },
   "bind": {
    "visible": "${= !props.loading && (props.error != '' || props.hasMore)}"
   },
   "states": {
    "hovered": {
     "link": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "componentEvent",
       "event": "onLoadMore"
      }
     ]
    }
   ]
  },
  "linkText": {
   "type": "text",
   "props": {
    "text": "${= props.error != '' ? 'Retry' : props.loadLabel}",
    "style": {
     "fontSize": 11,
     "fontWeight": 400,
     "height": 1.3,
     "color": "primary",
     "leadingDistribution": "even"
    }
   },
   "layout": {
    "width": {
     "hug": 50
    },
    "height": {
     "hug": 14
    }
   }
  }
 }
}
