{
 "schema": 3,
 "id": "flight_picker",
 "roots": [
  "flight_picker"
 ],
 "variables": {
  "flight_picker": [
   {
    "name": "flights",
    "type": "list",
    "value": [
     {
      "id": "tp1351",
      "depart": "07:10",
      "arrive": "09:45",
      "airline": "TAP",
      "duration": "2h 35m",
      "stops": "Direct",
      "price": "£84"
     },
     {
      "id": "ba500",
      "depart": "11:55",
      "arrive": "14:35",
      "airline": "British Airways",
      "duration": "2h 40m",
      "stops": "Direct",
      "price": "£112"
     },
     {
      "id": "u2731",
      "depart": "16:20",
      "arrive": "20:50",
      "airline": "easyJet",
      "duration": "3h 30m",
      "stops": "1 stop",
      "price": "£61"
     }
    ]
   },
   {
    "name": "chosen",
    "type": "text",
    "value": ""
   },
   {
    "name": "confirmed",
    "type": "boolean",
    "value": false
   }
  ]
 },
 "nodes": {
  "flight_picker": {
   "type": "canvas",
   "name": "flight_picker",
   "slots": {
    "body": "page"
   },
   "layout": {
    "width": 390,
    "height": {
     "hug": 600
    }
   }
  },
  "page": {
   "type": "column",
   "children": [
    "card"
   ],
   "layout": {
    "width": {
     "fill": 390
    },
    "height": {
     "fill": 600
    },
    "padding": 16
   },
   "decoration": {
    "fills": [
     {
      "color": "secondaryBackground"
     }
    ]
   }
  },
  "card": {
   "type": "column",
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 358
    },
    "height": {
     "hug": 400
    },
    "padding": 12
   },
   "decoration": {
    "fills": [
     {
      "color": "primaryBackground"
     }
    ],
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 8
   },
   "children": [
    "head",
    "box",
    "done",
    "foot"
   ]
  },
  "head": {
   "type": "column",
   "children": [
    "title",
    "sub"
   ],
   "props": {
    "spacing": 2
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 40
    }
   }
  },
  "title": {
   "type": "text",
   "props": {
    "text": "Choose your flight",
    "style": "sectionTitle"
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 20
    }
   }
  },
  "sub": {
   "type": "text",
   "props": {
    "text": "London LHR to Lisbon LIS · Fri 21 Nov · 1 adult",
    "style": "bodySecondary"
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 18
    }
   }
  },
  "box": {
   "type": "column",
   "children": [
    "list"
   ],
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 150
    }
   },
   "decoration": {
    "strokes": [
     {
      "color": "primaryBorder"
     }
    ],
    "radius": 8,
    "clip": "antiAlias"
   }
  },
  "list": {
   "type": "listView",
   "children": [
    "flight"
   ],
   "props": {
    "scrollable": false
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 150
    }
   },
   "bind": {
    "data": "${flights}"
   }
  },
  "flight": {
   "type": "ListRow",
   "props": {
    "title": "Flight",
    "icon": "flight_takeoff"
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 52
    }
   },
   "slots": {
    "trailing": "price"
   },
   "bind": {
    "props.title": "${item.depart} – ${item.arrive}",
    "props.subtitle": "${item.airline} · ${item.duration} · ${item.stops}",
    "props.selected": "${= item.id == chosen}",
    "props.divider": "${= index < length(flights) - 1}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed",
      "when": "!confirmed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "chosen",
       "value": "${item.id}"
      }
     ]
    }
   ]
  },
  "price": {
   "type": "text",
   "props": {
    "text": "${item.price}",
    "style": {
     "from": "body",
     "fontWeight": 600
    }
   },
   "layout": {
    "width": {
     "hug": 40
    },
    "height": {
     "hug": 20
    }
   }
  },
  "done": {
   "type": "Banner",
   "props": {
    "tone": "success",
    "title": "Flight booked",
    "message": "Confirmation sent to your email."
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 56
    }
   },
   "bind": {
    "visible": "${confirmed}"
   }
  },
  "foot": {
   "type": "row",
   "children": [
    "cancel",
    "confirm"
   ],
   "props": {
    "mainAxisAlignment": "end",
    "spacing": 6
   },
   "layout": {
    "width": {
     "fill": 334
    },
    "height": {
     "hug": 28
    }
   }
  },
  "cancel": {
   "type": "Button",
   "props": {
    "label": "Cancel",
    "variant": "ghost"
   },
   "layout": {
    "width": {
     "hug": 60
    },
    "height": {
     "hug": 28
    }
   },
   "bind": {
    "visible": "${= !confirmed}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "cancel"
      }
     ]
    }
   ]
  },
  "confirm": {
   "type": "Button",
   "props": {
    "label": "Confirm",
    "icon": "check"
   },
   "layout": {
    "width": {
     "hug": 90
    },
    "height": {
     "hug": 28
    }
   },
   "bind": {
    "props.enabled": "${= chosen != '' && !confirmed}",
    "props.label": "${= chosen == '' ? 'Choose a flight' : 'Confirm ' + find(flights, f => f.id == chosen).price}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "confirmed",
       "value": "true"
      },
      {
       "type": "componentEvent",
       "event": "confirm",
       "value": {
        "flight": "${chosen}"
       }
      }
     ]
    }
   ]
  }
 }
}
