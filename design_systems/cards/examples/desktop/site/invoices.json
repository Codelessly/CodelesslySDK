   "props": {
    "compact": true,
    "tristate": true
   },
   "bind": {
    "props.value": "${= length(sel) > 0 && length(sel) == length(sortBy((slice((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),page*8,page*8+8)), replace(sort, '-', ''), startsWith(sort, '-') ? 'desc' : 'asc')) ? true : (length(sel) == 0 ? false : null)}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "sel",
       "value": "${= (length(sel) == length(sortBy((slice((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),page*8,page*8+8)), replace(sort, '-', ''), startsWith(sort, '-') ? 'desc' : 'asc')) ? [] : map(sortBy((slice((filter(invoices,r=>(status==\"All\"||r.status==status)&&contains(lower(r.customer),lower(q)))),page*8,page*8+8)), replace(sort, '-', ''), startsWith(sort, '-') ? 'desc' : 'asc'), x => coalesce(x.id, x)))}"
      }
     ]
    }
