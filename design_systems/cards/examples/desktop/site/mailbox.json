     "trigger": {
      "type": "keyDown",
      "key": "Escape",
      "when": "${= mailbox_pane>0 && screen.width<=759}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "mailbox_pane",
       "value": "${= mailbox_pane-1}"
      }
     ]
    },
    {
     "trigger": {
      "type": "backPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "mailbox_pane",
       "value": "${= mailbox_pane-1}"
