{
 "schema": 3,
 "roots": [
  "dashboard"
 ],
 "nodes": {
  "dashboard": {
   "type": "canvas",
   "slots": {
    "body": "column1"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "fill": 800.0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "page"
     }
    ]
   }
  },
  "column1": {
   "type": "column",
   "layout": {
    "height": {
     "fill": 0
    },
    "padding": 12,
    "width": {
     "fill": 0
    }
   },
   "props": {
    "scrollable": true,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "pageFill"
     }
    ]
   },
   "children": [
    "ChatCard1"
   ]
  },
  "ChatCard1": {
   "type": "ChatCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Product performance",
    "subtitle": "November so far",
    "icon": "insights_rounded",
    "status": "Live",
    "tone": "good"
   },
   "children": [
    "range",
    "grid1",
    "ChartCard1",
    "ChartCard2",
    "SectionLabel1",
    "head",
    "listView1"
   ]
  },
  "range": {
   "type": "Segments",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "value": "range",
    "options": [
     "7 days",
     "30 days",
     "90 days"
    ]
   }
  },
  "grid1": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "start"
   },
   "children": [
    "grid1Row1",
    "grid1Row2"
   ]
  },
  "grid1Row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "StatTile1",
    "StatTile2"
   ]
  },
  "StatTile1": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Revenue",
    "icon": "payments_rounded"
   },
   "bind": {
    "props.value": "${= (find(periods,p=>p.name==range)).revenue}",
    "props.delta": "${= (find(periods,p=>p.name==range)).revenueD}"
   }
  },
  "StatTile2": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Sign-ups",
    "icon": "person_add_rounded"
   },
   "bind": {
    "props.value": "${= (find(periods,p=>p.name==range)).signups}",
    "props.delta": "${= (find(periods,p=>p.name==range)).signupsD}"
   }
  },
  "grid1Row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 10,
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "StatTile3",
    "StatTile4"
   ]
  },
  "StatTile3": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Churn",
    "invert": true,
    "icon": "logout_rounded"
   },
   "bind": {
    "props.value": "${= (find(periods,p=>p.name==range)).churn}",
    "props.delta": "${= (find(periods,p=>p.name==range)).churnD}"
   }
  },
  "StatTile4": {
   "type": "StatTile",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 1
   },
   "props": {
    "label": "Active users",
    "icon": "groups_rounded"
   },
   "bind": {
    "props.value": "${= (find(periods,p=>p.name==range)).active}",
    "props.delta": "${= (find(periods,p=>p.name==range)).activeD}"
   }
  },
  "ChartCard1": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Revenue",
    "kind": "line"
   },
   "bind": {
    "props.value": "${= (find(periods,p=>p.name==range)).revenue}",
    "props.delta": "${= (find(periods,p=>p.name==range)).revenueD}",
    "props.values": "${= (find(periods,p=>p.name==range)).trend}",
    "props.labels": "${= (find(periods,p=>p.name==range)).days}"
   }
  },
  "ChartCard2": {
   "type": "ChartCard",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "title": "Sign-ups by channel",
    "labels": [
     "Organic",
     "Paid",
     "Referral",
     "Social",
     "Email"
    ],
    "kind": "bars"
   },
   "bind": {
    "props.value": "${= (find(periods,p=>p.name==range)).signups}",
    "props.values": "${= (find(periods,p=>p.name==range)).channels}"
   }
  },
  "SectionLabel1": {
   "type": "SectionLabel",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "label": "Top plans",
    "note": "Tap a column to sort"
   }
  },
  "head": {
   "type": "TableHeader",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36.0
   },
   "props": {
    "value": "sort",
    "desc": "desc",
    "columns": [
     "Plan",
     "Subs",
     "Revenue",
     "Churn"
    ],
    "keys": [
     "plan",
     "subs",
     "revenue",
     "churn"
    ]
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${= desc?sortByDesc(plans,sort):sortBy(plans,sort)}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "TableRow1"
   ]
  },
  "TableRow1": {
   "type": "TableRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.cells": "${= [item.plan,thousands(item.subs),money(item.revenue,\"$\",0),item.churn+\"%\"]}"
   }
  }
 },
