{
 "schema": 3,
 "roots": [
  "list",
  "list_sidebar"
 ],
 "nodes": {
  "list": {
   "type": "canvas",
   "slots": {
    "body": "row1"
   },
   "layout": {
    "width": 1440.0,
    "height": {
     "fill": 800.0
    }
   },
   "bind": {
    "props.blockBack": "${= list_pane>0 && screen.width<=803}"
   },
   "decoration": {
    "fills": [
     {
      "color": "surface"
     }
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "keyDown",
      "key": "Escape",
      "when": "${= list_pane>0 && screen.width<=803}"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "list_pane",
       "value": "${= list_pane-1}"
      }
     ]
    },
    {
     "trigger": {
      "type": "backPressed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "list_pane",
       "value": "${= list_pane-1}"
      }
     ]
    }
   ]
  },
  "row1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "column1",
    "column2",
    "column3"
   ]
  },
  "column1": {
   "type": "column",
   "layout": {
    "width": 240,
    "height": {
     "fill": 0
    },
    "padding": [
     12,
     16,
     12,
     12
    ]
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "sidebar"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "right"
   },
   "media": [
    {
     "maxWidth": 1023,
     "patch": {
      "layout": {
       "width": 64
      }
     }
    },
    {
     "maxWidth": 699,
     "patch": {
      "visible": false,
      "bind": {
       "visible": null
      }
     }
    }
   ],
   "children": [
    "Brand1",
    "NavItem1"
   ]
  },
  "Brand1": {
   "type": "Brand",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "name": "Postbox",
    "icon": "mail_outlined"
   }
  },
  "NavItem1": {
   "type": "NavItem",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 32.0
   },
   "props": {
    "label": "Inbox",
    "icon": "inbox_outlined",
    "badge": "2",
    "selected": true
   }
  },
  "column2": {
   "type": "column",
   "layout": {
    "flex": 1,
    "height": {
     "fill": 0
    },
    "width": 380
   },
   "props": {
    "scrollable": true,
    "crossAxisAlignment": "start"
   },
   "children": [
    "row2",
    "divider1",
    "listView1"
   ],
   "media": [
    {
     "maxWidth": 803,
     "patch": {
      "layout": {
       "width": {
        "fill": 0
       },
       "flex": 1
      },
      "bind": {
       "visible": "${= list_pane==0}",
       "animations[0].enabled": "${= true}",
       "animations[0].playKey": "${= list_pane==0 ? \"shown\" : \"\"}"
      }
     }
    }
   ],
   "animations": [
    {
     "id": "pane",
     "preset": "enter",
     "params": {
      "from": {
       "opacity": 0
      }
     },
     "enabled": false,
     "duration": 220
    }
   ]
  },
  "row2": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "padding": [
     24,
     14,
     24,
     14
    ],
    "height": {
     "hug": 0
    }
   },
   "props": {
    "mainAxisAlignment": "spaceBetween",
    "crossAxisAlignment": "center",
    "spacing": 24
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ]
   },
   "children": [
    "iconButton1",
    "text1"
   ],
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "props": {
       "spacing": 12
      }
     }
    }
   ]
  },
  "iconButton1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "menu_outlined"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "openModal",
       "to": "list_sidebar",
       "presentation": "dialog",
       "cover": true
      }
     ]
    }
   ],
   "media": [
    {
     "minWidth": 700,
     "patch": {
      "visible": false,
      "bind": {
       "visible": null
      }
     }
    }
   ]
  },
  "text1": {
   "type": "text",
   "layout": {
    "squeezable": true,
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "barTitle"
    },
    "text": "Inbox"
   },
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "layout": {
       "width": {
        "fill": 0
       },
       "flex": 1,
       "basis": 96
      }
     }
    }
   ]
  },
  "divider1": {
   "type": "divider",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "listView1": {
   "type": "listView",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "bind": {
    "data": "${mails}"
   },
   "children": [
    "listView1Item"
   ]
  },
  "listView1Item": {
   "type": "column",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "children": [
    "ListRow1"
   ]
  },
  "ListRow1": {
   "type": "ListRow",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "unread": true
   },
   "bind": {
    "props.title": "${item.from}",
    "props.subtitle": "${item.subject}",
    "props.meta": "${item.time}",
    "props.selected": "${= openId == item.id}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "openId",
       "value": "${= item.id}"
      },
      {
       "type": "setVariable",
       "variable": "list_pane",
       "value": "${= 1}"
      }
     ]
    }
   ]
  },
  "column3": {
   "type": "column",
   "layout": {
    "flex": 1,
    "height": {
     "fill": 0
    },
    "width": {
     "fill": 0
    }
   },
   "props": {
    "scrollable": true,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "left"
   },
   "children": [
    "list_paneBar1",
    "column4"
   ],
   "media": [
    {
     "maxWidth": 803,
     "patch": {
      "bind": {
       "visible": "${= list_pane==1}",
       "animations[0].enabled": "${= true}",
       "animations[0].playKey": "${= list_pane==1 ? \"shown\" : \"\"}"
      }
     }
    }
   ],
   "animations": [
    {
     "id": "pane",
     "preset": "enter",
     "params": {
      "from": {
       "opacity": 0,
       "translateX": 32
      }
     },
     "enabled": false,
     "duration": 220
    }
   ]
  },
  "column4": {
   "type": "column",
   "layout": {
    "padding": 32,
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "spacing": 12,
    "crossAxisAlignment": "start"
   },
   "children": [
    "text2",
    "text3"
   ]
  },
  "text2": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "pageTitle"
    },
    "text": "${= find(mails,'id',openId).subject}"
   }
  },
  "text3": {
   "type": "text",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "style": {
     "from": "reading"
    },
    "text": "From ${= find(mails,'id',openId).from}"
   }
  },
  "list_paneBar1": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "padding": [
     8,
     8,
     8,
     8
    ]
   },
   "props": {
    "spacing": 4,
    "crossAxisAlignment": "center"
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "bottom"
   },
   "visible": false,
   "media": [
    {
     "maxWidth": 803,
     "patch": {
      "visible": true
     }
    }
   ],
   "children": [
    "list_paneMenu1",
    "list_paneBack1"
   ]
  },
  "list_paneMenu1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "menu"
   },
   "tooltip": "Menu",
   "visible": false,
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "visible": true
     }
    }
   ],
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "openModal",
       "to": "list_sidebar",
       "presentation": "dialog",
       "cover": true
      }
     ]
    }
   ]
  },
  "list_paneBack1": {
   "type": "iconButton",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "icon": "arrow_back"
   },
   "tooltip": "Back",
   "visible": false,
   "media": [
    {
     "maxWidth": 803,
     "patch": {
      "visible": true
     }
    }
   ],
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "list_pane",
       "value": "${= 0}"
      }
     ]
    }
   ]
  },
  "list_sidebar": {
   "type": "canvas",
   "name": "list_sidebar",
   "slots": {
    "body": "row3"
   },
   "layout": {
    "width": 390.0,
    "height": {
     "fill": 800.0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "#00FFFFFF"
     }
    ]
   }
  },
  "row3": {
   "type": "row",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    }
   },
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "children": [
    "column5",
    "column6"
   ]
  },
  "column5": {
   "type": "column",
   "layout": {
    "width": 300,
    "height": {
     "fill": 0
    },
    "padding": [
     12,
     16,
     12,
     12
    ]
   },
   "props": {
    "spacing": 2,
    "crossAxisAlignment": "start"
   },
   "decoration": {
    "fills": [
     {
      "color": "sidebar"
     }
    ],
    "strokes": [
     {
      "color": "#00000000"
     }
    ],
    "strokeSides": "right"
   },
   "children": [
    "Brand2",
    "NavItem2"
   ]
  },
  "Brand2": {
   "type": "Brand",
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "props": {
    "name": "Postbox",
    "icon": "mail_outlined"
   }
  },
  "NavItem2": {
   "type": "NavItem",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 32.0
   },
   "props": {
    "label": "Inbox",
    "icon": "inbox_outlined",
    "badge": "2",
    "selected": true
   }
  },
  "column6": {
   "type": "column",
   "layout": {
    "flex": 1,
    "height": {
     "fill": 0
    },
    "width": {
     "fill": 0
    }
   },
   "props": {
    "crossAxisAlignment": "start"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "closeModal"
      }
     ]
    }
   ]
  }
 },
 "variables": {
  "page_variables": [
   {
    "name": "openId",
    "type": "text",
    "value": "a"
   },
   {
    "name": "mails",
    "type": "list",
    "value": [
     {
      "id": "a",
      "from": "Maya Chen",
      "subject": "Studio visit",
      "time": "10:42"
     },
     {
      "id": "b",
      "from": "Nora Patel",
      "subject": "Invoice",
      "time": "9:18"
     }
    ]
   },
   {
    "name": "list_pane",
    "type": "integer",
    "value": 0
   }
  ]
 }
}