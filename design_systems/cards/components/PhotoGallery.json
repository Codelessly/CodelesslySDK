{
 "schema": 3,
 "id": "PhotoGallery",
 "roots": [
  "gallery"
 ],
 "widget": {
  "type": "PhotoGallery",
  "doc": "A photo gallery with a built-in large view: PhotoGallery =open photos:[{\"kind\":\"harbor\",\"caption\":\"Harbour at sunrise\"},...] draws each photo as a scene (kind: mountain, harbor, skyline, dunes, forest, lagoon, market, festival, train, temple, bamboo; optional tone: dawn, day, dusk, night); layout is grid, strip (one row that scrolls sideways) or pages (full-width photos swiped one at a time, with dots); tapping a photo opens it large with its caption, a \"3 of 9\" counter, dots, arrows and a close button, and a swipe there goes to the next; your variable holds the photo in view (0: none open).",
  "props": [
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "number",
      "flutter": "double"
     }
    },
    "default": "",
    "doc": "The name of your number variable: 0 while the grid or strip shows, else the number of the photo in view (from 1)."
   },
   {
    "key": "photos",
    "type": {
     "kind": "list",
     "flutter": "List<dynamic>",
     "item": {
      "kind": "json",
      "flutter": "dynamic"
     }
    },
    "default": [
     {
      "kind": "harbor",
      "caption": "Harbour at sunrise"
     },
     {
      "kind": "mountain",
      "caption": "Mountain hut"
     },
     {
      "kind": "skyline",
      "caption": "Evening skyline"
     }
    ],
    "doc": "The photos: records with kind (a Media scene: mountain, harbor, skyline, dunes, forest, lagoon, market, festival, train, temple, bamboo), caption and optionally tone (dawn, day, dusk, night).",
    "required": true
   },
   {
    "key": "layout",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "grid",
      "strip",
      "pages"
     ]
    },
    "default": "grid",
    "doc": "grid (rows of thumbnails), strip (one row that scrolls sideways) or pages (one full-width photo at a time, swiped, with dots)."
   },
   {
    "key": "dots",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "Pagination dots under the paged and the large view."
   },
   {
    "key": "columns",
    "type": {
     "kind": "integer",
     "flutter": "int"
    },
    "default": 3,
    "doc": "Thumbnails per row of the grid."
   },
   {
    "key": "fade",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "The strip fades at the edge where there are more photos (false: a hard edge)."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "A photo was opened, changed or closed; the value is its number (0: closed)."
   }
  ]
 },
 "previews": [
  {
   "name": "Grid",
   "size": [
    360,
    350
   ],
   "props": {}
  },
  {
   "name": "Strip",
   "size": [
    360,
    150
   ],
   "props": {
    "layout": "strip"
   }
  },
  {
   "name": "Pages",
   "size": [
    360,
    290
   ],
   "props": {
    "layout": "pages"
   }
  }
 ],
 "nodes": {
  "gallery": {
   "type": "column",
   "children": [
    "grid",
    "strip",
    "paged",
    "veil"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "grid": {
   "type": "gridView",
   "children": [
    "cell"
   ],
   "props": {
    "crossAxisCount": 1,
    "crossAxisSpacing": 8,
    "mainAxisSpacing": 10,
    "shrinkWrapRows": true,
    "physics": "never"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "data": "${props.photos}",
    "props.crossAxisCount": "${props.columns}",
    "visible": "${= props.layout == 'grid' && props.value <= 0}"
   },
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "props": {
       "crossAxisCount": 2
      },
      "bind": {
       "props.crossAxisCount": null
      }
     }
    }
   ]
  },
  "cell": {
   "type": "column",
   "children": [
    "thumb",
    "caption"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 6
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "states": {
    "pressed": {
     "cell": {
      "opacity": 0.82
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= index + 1}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${= index + 1}"
      }
     ]
    }
   ]
  },
  "thumb": {
   "type": "Media",
   "props": {
    "kind": "mountain"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 92
   },
   "bind": {
    "props.kind": "${item.kind}",
    "props.tone": "${= coalesce(item.tone, 'auto')}"
   },
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "layout": {
       "height": 140
      }
     }
    }
   ]
  },
  "caption": {
   "type": "text",
   "props": {
    "text": "${= coalesce(item.caption, '')}",
    "style": {
     "from": "meta",
     "fontSize": 11.5,
     "height": 1.25,
     "color": "inkSoft"
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "props": {
       "maxLines": 2
      }
     }
    }
   ]
  },
  "strip": {
