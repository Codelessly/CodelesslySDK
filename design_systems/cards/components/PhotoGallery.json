   "bind": {
    "decoration.effects": "${theme.shadows.knob}"
   }
  },
  "nextI": {
   "type": "icon",
   "props": {
    "icon": "chevron_right_rounded",
    "size": 21,
    "color": "ink"
   },
   "layout": {
    "width": 21,
    "height": 21
   }
  },
  "foot": {
   "type": "text",
   "props": {
    "text": "${= coalesce(at(props.photos, clamp(props.value - 1, 0, max(0, length(props.photos) - 1))).caption, '')}",
    "style": {
     "from": "blockTitle",
     "color": "onBar"
    },
    "textAlign": "center",
    "maxLines": 2,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "vdots": {
   "type": "row",
   "children": [
    "vdotsList"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 22
   },
   "bind": {
    "visible": "${props.dots}"
   }
  },
  "vdotsList": {
   "type": "listView",
   "children": [
    "vdotsHit"
   ],
   "props": {
    "scrollable": false,
    "spacing": 0,
    "scrollDirection": "horizontal"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 22
   },
   "bind": {
    "data": "${= range(max(1, length(props.photos)))}"
   }
  },
  "vdotsHit": {
   "type": "row",
   "children": [
    "vdotsDot"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     3,
     0,
     3,
     0
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= index + 1}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${= index + 1}"
      }
     ]
    }
   ]
  },
  "vdotsDot": {
   "type": "box",
   "layout": {
    "width": 6,
    "height": 6
   },
   "decoration": {
    "fills": [
     {
      "color": "lineStrong"
     }
    ],
    "radius": 3
   },
   "bind": {
    "layout.width": "${= index == clamp(props.value - 1, 0, max(0, length(props.photos) - 1)) ? 20 : 6}",
    "decoration.fills[0].color": "${= index == clamp(props.value - 1, 0, max(0, length(props.photos) - 1)) ? theme.colors.onBar : theme.colors.onBarSoft}"
   }
  }
 }
}
