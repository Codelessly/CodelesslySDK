{
 "schema": 3,
 "id": "ChipTabs",
 "roots": [
  "row"
 ],
 "widget": {
  "type": "ChipTabs",
  "doc": "A row of pills to filter a list or switch between a few open items (All, Open, Closed; Draft, Review, Final), the chosen one outlined in the accent; an optional round + after them. Any number of pills: where they do not fit, the row scrolls sideways on one line. A page's views are Tabs; a choice of slots or sizes in a grid is ChoiceChips. The chosen label is kept in your variable. Fires onSelected with the label and onAdd.",
  "props": [
   {
    "key": "tabs",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Draft",
     "Review",
     "Final"
    ],
    "doc": "The pills' labels, any number.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen label."
   },
   {
    "key": "showAdd",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "A round + after the pills."
   }
  ],
  "events": [
   {
    "key": "onSelected",
    "doc": "A pill was chosen; the value is its label."
   },
   {
    "key": "onAdd",
    "doc": "The + was tapped."
   }
  ]
 },
 "previews": [
  {
   "name": "Three",
   "size": [
    300,
    36
   ],
   "props": {
    "value": "Review",
    "showAdd": true
   }
  }
 ],
 "nodes": {
  "row": {
   "type": "row",
   "children": [
    "scroll",
    "add"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "scroll": {
   "type": "row",
   "children": [
    "list"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0,
    "scrollable": true,
    "scrollDirection": "horizontal",
    "edgeFade": 24,
    "fillViewport": false
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "squeezable": true
   },
   "actions": [
    {
     "trigger": {
      "type": "load",
      "when": "indexOf(props.tabs, props.value) > 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "chip",
       "item": "${= indexOf(props.tabs, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 0
      }
     ]
    },
    {
     "trigger": {
      "type": "valueChanged",
      "variable": "props.value",
      "when": "indexOf(props.tabs, props.value) >= 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "chip",
       "item": "${= indexOf(props.tabs, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 240
      }
     ]
    }
   ]
  },
  "list": {
   "type": "listView",
   "children": [
    "chip"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false,
    "spacing": 8
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 36
   },
   "bind": {
    "data": "${props.tabs}",
    "layout.height": "${= screen.width < 700 ? 44 : 36}"
   }
  },
  "chip": {
   "type": "row",
   "children": [
    "pill"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    }
   },
   "states": {
    "hovered": {
     "pill": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "pill": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= item}"
      },
      {
       "type": "componentEvent",
       "event": "onSelected",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "pill": {
   "type": "row",
   "children": [
    "label"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 32,
    "padding": [
     14,
     0,
     14,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1,
    "radius": 999
   },
   "bind": {
    "decoration.fills[0].color": "${= item == props.value ? theme.colors.accentTint : theme.colors.card}",
    "decoration.strokes[0].color": "${= item == props.value ? theme.colors.accent : theme.colors.line}",
    "decoration.strokeWidth": "${= item == props.value ? 1.5 : 1}",
    "decoration.radius": "${theme.radii.chip}"
   },
   "transitions": [
    {
     "property": "decoration",
     "duration": 150
    }
   ]
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "from": "chip",
     "fontSize": 13
    },
    "maxLines": 1
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= item == props.value ? theme.colors.ink : theme.colors.inkSoft}"
   }
  },
  "add": {
   "type": "row",
   "children": [
    "addI"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 32,
    "height": 32
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 16.0
   },
   "bind": {
    "visible": "${props.showAdd}"
   },
   "states": {
    "pressed": {
     "add": {
      "opacity": 0.6
     }
    },
    "hovered": {
     "add": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onAdd"
      }
     ]
    }
   ]
  },
  "addI": {
   "type": "icon",
   "props": {
    "icon": "add_rounded",
    "size": 18,
    "color": "ink"
   },
   "layout": {
    "width": 18,
    "height": 18
   }
  }
 }
}
