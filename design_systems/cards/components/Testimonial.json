{
 "schema": 3,
 "id": "Testimonial",
 "roots": ["panel"],
 "widget": {
  "type": "Testimonial",
  "doc": "One customer quote as a page panel: Testimonial quote=\"…\" name=\"Elena Vasquez\" role=\"Owner, The Larkspur\" initials=\"EV\" rating=5 (0: no stars) align=\"center\" (default) or \"start\" for a grid of quotes; with no initials the round mark shows a person icon.",
  "props": [
   {"key": "quote", "type": {"kind": "string", "flutter": "String"}, "default": "It changed how we run the front desk.", "doc": "The words, without quotation marks.", "required": true},
   {"key": "name", "type": {"kind": "string", "flutter": "String"}, "default": "Elena Vasquez", "doc": "Who said it.", "required": true},
   {"key": "role", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "Their role and company (empty: none)."},
   {"key": "rating", "type": {"kind": "number", "flutter": "double"}, "default": 0, "doc": "Stars out of five, rounded (0: no stars)."},
   {"key": "align", "type": {"kind": "string", "flutter": "String"}, "default": "center", "doc": "center (a lone quote) or start (quotes in a grid)."},
   {"key": "initials", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "One or two letters in the round mark (empty: a person icon)."}
  ]
 },
 "previews": [
  {"name": "Centered", "size": [880, 330], "props": {"quote": "We stopped juggling three spreadsheets and an inbox. Direct bookings went up the first month.", "name": "Elena Vasquez", "role": "Owner, The Larkspur", "rating": 5, "initials": "EV"}},
  {"name": "Grid cell", "size": [360, 340], "props": {"quote": "Channel sync alone saved us two double bookings a week.", "name": "Maren Olsen", "role": "Owner, Saltmarsh Lodge", "rating": 4, "align": "start", "initials": "MO"}}
 ],
 "nodes": {
  "panel": {
   "type": "column",
   "media": [{"maxWidth": 699, "patch": {"layout": {"padding": [20, 20, 20, 20]}, "props": {"spacing": 12}}}],
   "children": ["mark", "stars", "quote", "person"],
   "props": {"crossAxisAlignment": "center", "spacing": 18},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [32, 32, 32, 32]},
   "decoration": {"fills": [{"color": "card"}], "strokes": [{"color": "line"}], "strokeWidth": 1, "radius": 16},
   "bind": {
    "props.crossAxisAlignment": "${= props.align == 'start' ? 'start' : 'center'}",
    "decoration.radius": "${theme.radii.cardWide}",
    "decoration.fills[0].color": "${theme.colors.card}",
    "decoration.strokes[0].color": "${theme.colors.line}",
    "decoration.effects": "${theme.shadows.cardWide}"
   }
  },
  "mark": {
   "type": "icon",
   "props": {"icon": "format_quote_rounded", "size": 40, "color": "accent"},
   "layout": {"width": 40, "height": 40}
  },
  "stars": {
   "type": "row",
   "children": ["s1", "s2", "s3", "s4", "s5"],
   "props": {"crossAxisAlignment": "center", "spacing": 2},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}},
   "bind": {"visible": "${= props.rating > 0}"}
  },
  "s1": {"type": "icon", "props": {"icon": "star_rounded", "size": 20, "color": "gold"}, "layout": {"width": 20, "height": 20}, "bind": {"props.color": "${= round(props.rating, 0) >= 1 ? theme.colors.gold : theme.colors.lineStrong}"}},
  "s2": {"type": "icon", "props": {"icon": "star_rounded", "size": 20, "color": "gold"}, "layout": {"width": 20, "height": 20}, "bind": {"props.color": "${= round(props.rating, 0) >= 2 ? theme.colors.gold : theme.colors.lineStrong}"}},
  "s3": {"type": "icon", "props": {"icon": "star_rounded", "size": 20, "color": "gold"}, "layout": {"width": 20, "height": 20}, "bind": {"props.color": "${= round(props.rating, 0) >= 3 ? theme.colors.gold : theme.colors.lineStrong}"}},
  "s4": {"type": "icon", "props": {"icon": "star_rounded", "size": 20, "color": "gold"}, "layout": {"width": 20, "height": 20}, "bind": {"props.color": "${= round(props.rating, 0) >= 4 ? theme.colors.gold : theme.colors.lineStrong}"}},
  "s5": {"type": "icon", "props": {"icon": "star_rounded", "size": 20, "color": "gold"}, "layout": {"width": 20, "height": 20}, "bind": {"props.color": "${= round(props.rating, 0) >= 5 ? theme.colors.gold : theme.colors.lineStrong}"}},
  "quote": {
   "type": "text",
   "media": [{"maxWidth": 699, "patch": {"props": {"style": {"fontSize": 18, "height": 1.35}}}}],
   "props": {
    "text": "${props.quote}",
    "style": {"from": "heading3Wide", "fontSize": 22, "height": 1.42, "color": "ink"},
    "textAlign": "center"
   },
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [0, 0, 0, 6]},
   "bind": {"props.textAlign": "${= props.align == 'start' ? 'start' : 'center'}"}
  },
  "person": {
   "type": "row",
   "children": ["avatar", "who"],
   "props": {"crossAxisAlignment": "center", "spacing": 12},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "avatar": {
   "type": "row",
   "children": ["avatarText", "avatarIcon"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": 44, "height": 44},
   "decoration": {"fills": [{"color": "iconTile"}], "radius": 22},
   "bind": {"decoration.fills[0].color": "${theme.colors.iconTile}"}
  },
  "avatarText": {
   "type": "text",
   "props": {
    "text": "${= upper(props.initials)}",
    "style": {"from": "strongWide", "fontSize": 15, "color": "accent"},
    "maxLines": 1
   },
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}},
   "bind": {"visible": "${= props.initials != ''}"}
  },
  "avatarIcon": {
   "type": "icon",
   "props": {"icon": "person_rounded", "size": 22, "color": "accent"},
   "layout": {"width": 22, "height": 22},
   "bind": {"visible": "${= props.initials == ''}"}
  },
  "who": {
   "type": "column",
   "children": ["name", "role"],
   "props": {"crossAxisAlignment": "start", "spacing": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "name": {
   "type": "text",
   "props": {"text": "${props.name}", "style": "strongWide", "maxLines": 1, "overflow": "ellipsis"},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "role": {
   "type": "text",
   "props": {"text": "${props.role}", "style": "mutedWide", "maxLines": 2},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}},
   "bind": {"visible": "${= props.role != ''}"}
  }
 }
}