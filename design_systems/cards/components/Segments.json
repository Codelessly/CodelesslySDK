{
 "schema": 3,
 "id": "Segments",
 "roots": [
  "place"
 ],
 "widget": {
  "type": "Segments",
  "doc": "A small switch between two to four short options in one track, as wide as its place (a period, a tone, a status filter; not a page's tabs: those are Tabs): write Segments bind=range options=[\"7 days\",\"30 days\"] and it keeps the chosen option's text in your variable; onChanged fires with it. The segments are equally wide while they fit; where they do not, the track scrolls sideways on one line.",
  "props": [
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable: it holds the chosen option (declare it with the starting option)."
   },
   {
    "key": "options",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "7 days",
     "30 days",
     "90 days"
    ],
    "doc": "Two to four short options (a word or two each).",
    "required": true
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "An option was chosen; the value is its text."
   }
  ]
 },
