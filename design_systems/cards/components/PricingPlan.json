{
 "schema": 3,
 "id": "PricingPlan",
 "roots": ["tile"],
 "widget": {
  "type": "PricingPlan",
  "doc": "One plan of a pricing page as a tile in a Grid cols:3 gap:24: PricingPlan name:\"Team\" price:\"$29\" period:\"/mo\" note:\"For growing teams\" features:[...] cta:\"Start free trial\" featured:true badge:\"Most popular\" -> chosen=result (onChoose reports the name; period defaults to /mo).",
  "props": [
   {"key": "name", "type": {"kind": "string", "flutter": "String"}, "default": "Team", "doc": "The plan's name.", "required": true},
   {"key": "price", "type": {"kind": "string", "flutter": "String"}, "default": "$29", "doc": "The price as text, currency included.", "required": true},
   {"key": "period", "type": {"kind": "string", "flutter": "String"}, "default": "/mo", "doc": "The period beside the price (/mo, /yr; empty: none)."},
   {"key": "note", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "One line on who the plan is for."},
   {"key": "features", "type": {"kind": "list", "flutter": "List<String>", "item": {"kind": "string", "flutter": "String"}}, "default": [], "doc": "The features, one checked line each."},
   {"key": "cta", "type": {"kind": "string", "flutter": "String"}, "default": "Get started", "doc": "The action's label."},
   {"key": "featured", "type": {"kind": "boolean", "flutter": "bool"}, "default": false, "doc": "The recommended plan: accent border, filled action."},
   {"key": "badge", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "A pill beside the name (Most popular; empty: none)."}
  ],
  "events": [
   {"key": "onChoose", "doc": "The action was pressed; the value is the plan's name."}
  ]
 },
 "previews": [
  {
   "name": "Featured",
   "size": [360, 500],
   "props": {
    "name": "Team",
    "price": "$29",
    "note": "For growing businesses that share the books with a team.",
    "features": ["Up to 5 users", "Everything in Solo", "Multi-currency accounts", "Payroll for up to 10 staff", "Priority chat support"],
    "cta": "Start free trial",
    "featured": true,
    "badge": "Most popular"
   }
  }
 ],
 "nodes": {
  "tile": {
   "type": "column",
   "children": ["head", "note", "priceRow", "cta", "rule", "list"],
   "props": {"crossAxisAlignment": "stretch", "spacing": 0},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [28, 28, 28, 30]},
   "decoration": {"fills": [{"color": "card"}], "strokes": [{"color": "line"}], "strokeWidth": 1, "radius": 16},
   "bind": {
    "decoration.radius": "${theme.radii.cardWide}",
    "decoration.strokes[0].color": "${= props.featured ? theme.colors.accent : theme.colors.line}",
    "decoration.strokeWidth": "${= props.featured ? 2 : 1}"
   }
  },
  "head": {
   "type": "row",
   "children": ["name", "badge"],
   "props": {"crossAxisAlignment": "center", "spacing": 10},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "name": {
   "type": "text",
   "props": {"text": "${props.name}", "style": "heading3Wide", "maxLines": 1, "overflow": "ellipsis"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "badge": {
   "type": "row",
   "children": ["badgeText"],
   "props": {"crossAxisAlignment": "center"},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}, "padding": [10, 4, 10, 4]},
   "decoration": {"fills": [{"color": "activeTint"}], "radius": 999},
   "bind": {"visible": "${= props.badge != ''}"}
  },
  "badgeText": {
   "type": "text",
   "props": {"text": "${props.badge}", "style": {"from": "captionWide", "fontWeight": 600, "color": "accent"}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "note": {
   "type": "text",
   "props": {"text": "${props.note}", "style": "mutedWide"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [0, 12, 0, 0]},
   "bind": {"visible": "${= props.note != ''}"}
  },
  "priceRow": {
   "type": "row",
   "children": ["price", "period"],
   "props": {"crossAxisAlignment": "end", "spacing": 6},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [0, 22, 0, 24]}
  },
  "price": {
   "type": "text",
   "props": {"text": "${props.price}", "style": {"from": "numberHero", "fontSize": 48}, "maxLines": 1, "scaleDown": true},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "period": {
   "type": "text",
   "props": {"text": "${props.period}", "style": "mutedWide", "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}, "padding": [0, 0, 0, 9]},
   "bind": {"visible": "${= props.period != ''}"}
  },
  "cta": {
   "type": "row",
   "children": ["ctaText"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": {"fill": 0}, "height": 44},
   "decoration": {"fills": [{"color": "card"}], "strokes": [{"color": "lineStrong"}], "strokeWidth": 1, "radius": 10},
   "bind": {
    "decoration.radius": "${theme.radii.controlMedium}",
    "decoration.fills[0].color": "${= props.featured ? theme.colors.accent : theme.colors.card}",
    "decoration.strokes[0].color": "${= props.featured ? theme.colors.accent : theme.colors.lineStrong}"
   },
   "states": {"pressed": {"cta": {"opacity": 0.82}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onChoose", "value": "${props.name}"}]}
   ]
  },
  "ctaText": {
   "type": "text",
   "props": {"text": "${props.cta}", "style": {"from": "strongWide", "color": "ink"}, "maxLines": 1, "overflow": "ellipsis"},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}},
   "bind": {"props.style.color": "${= props.featured ? theme.colors.onAccent : theme.colors.ink}"}
  },
  "rule": {
   "type": "box",
   "layout": {"width": {"fill": 0}, "height": 1, "margin": [0, 24, 0, 22]},
   "decoration": {"fills": [{"color": "line"}]},
   "bind": {"visible": "${= length(props.features) > 0}"}
  },
  "list": {
   "type": "listView",
   "children": ["feat"],
   "props": {"scrollable": false, "spacing": 12},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}},
   "bind": {"data": "${props.features}"}
  },
  "feat": {
   "type": "row",
   "children": ["featIcon", "featText"],
   "props": {"crossAxisAlignment": "start", "spacing": 10},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "featIcon": {
   "type": "icon",
   "props": {"icon": "check_circle_rounded", "size": 18, "color": "good"},
   "layout": {"width": 18, "height": 18, "margin": [0, 2, 0, 0]}
  },
  "featText": {
   "type": "text",
   "props": {"text": "${item}", "style": "bodyWide"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  }
 }
}