{
 "schema": 3,
 "id": "SortMenu",
 "roots": [
  "sort"
 ],
 "widget": {
  "type": "SortMenu",
  "doc": "A closed control that picks what a list is sorted by (a dropdown: its menu opens on a tap) and which way (the arrow beside it). The choice and the direction (asc or desc) are kept in your variables. Fires onChanged and onDirectionChanged.",
  "props": [
   {
    "key": "options",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Name",
     "Date modified",
     "Size"
    ],
    "doc": "What it can sort by.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the choice."
   },
   {
    "key": "direction",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding asc or desc."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   },
   {
    "key": "onDirectionChanged",
    "payload": {
     "kind": "string",
     "flutter": "String"
    }
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    216,
    36
   ],
   "props": {
    "value": "Name",
    "direction": "asc"
   }
  }
 ],
 "nodes": {
  "sort": {
   "type": "row",
   "children": [
    "choice",
    "flip"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 4
   },
   "layout": {
    "width": {
     "hug": 216
    },
    "height": {
     "hug": 36
    }
   }
  },
  "choice": {
   "type": "dropdown",
   "layout": {
    "width": 184,
    "height": 36
   },
   "props": {
    "style": "inputText",
    "hint": "Sort by"
   },
   "bind": {
    "props.items": "${props.options}",
    "props.value": "${props.value}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${result}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${result}"
      }
     ]
    }
   ]
  },
  "flip": {
   "type": "row",
   "children": [
    "arrow"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 28,
    "height": 28
   },
   "decoration": {
    "radius": 9
   },
   "tooltip": "${= props.direction == 'desc' ? 'Descending' : 'Ascending'}",
   "states": {
    "hovered": {
     "flip": {
      "decoration": {
       "fills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": "click",
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.direction",
       "value": "${= props.direction == 'desc' ? 'asc' : 'desc'}"
      },
      {
       "type": "componentEvent",
       "event": "onDirectionChanged",
       "value": "${props.direction}"
      }
     ]
    }
   ]
  },
  "arrow": {
   "type": "icon",
   "props": {
    "icon": "arrow_upward",
    "color": "tertiaryText",
    "size": 15
   },
   "layout": {
    "width": 15,
    "height": 15
   },
   "bind": {
    "props.icon": "${= props.direction == 'desc' ? 'arrow_downward' : 'arrow_upward'}"
   }
  }
 }
}
