{
 "schema": 3,
 "id": "SegmentedControl",
 "roots": [
  "track"
 ],
 "widget": {
  "type": "SegmentedControl",
  "doc": "The same small switch as TabToggle with finer sizes: two to four short options in a track only as wide as they are (a view switch, a period), the choice in your variable. Fires onChanged. Where its options do not fit it scrolls sideways on one line.",
  "props": [
   {
    "key": "options",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Day",
     "Week",
     "Month"
    ],
    "doc": "Two to four short options.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the choice."
   },
   {
    "key": "size",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "xs",
      "compact",
      "small",
      "medium",
      "large"
     ]
    },
    "default": "compact",
    "doc": "xs, compact, small, medium or large."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "An option was chosen; the value is its text."
   }
  ]
 },
 "previews": [
  {
   "name": "Week",
   "size": [
    240,
    32
   ],
   "props": {
    "options": [
     "Day",
     "Week",
     "Month"
    ],
    "value": "Week"
   }
  }
 ],
 "nodes": {
  "track": {
   "type": "row",
   "children": [
    "scroll"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "subtleFill"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1,
    "radius": 12,
    "clip": "antiAlias"
   },
   "bind": {
    "decoration.radius": "${theme.radii.control}"
   }
  },
  "scroll": {
   "type": "row",
   "children": [
    "list"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0,
    "scrollable": true,
    "scrollDirection": "horizontal",
    "edgeFade": 24,
    "fillViewport": false
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "squeezable": true,
    "padding": [
     1.5,
     0,
     1.5,
     0
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "load",
      "when": "indexOf(props.options, props.value) > 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "option",
       "item": "${= indexOf(props.options, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 0
      }
     ]
    },
    {
     "trigger": {
      "type": "valueChanged",
      "variable": "props.value",
      "when": "indexOf(props.options, props.value) >= 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "option",
       "item": "${= indexOf(props.options, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 240
      }
     ]
    }
   ]
  },
  "list": {
   "type": "listView",
   "children": [
    "option"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false,
    "spacing": 0
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 32
   },
   "bind": {
    "data": "${props.options}",
    "layout.height": "${= props.size == 'xs' ? 28 : (props.size == 'compact' ? 32 : (props.size == 'small' ? 34 : (props.size == 'medium' ? 36 : (44))))}"
   },
   "media": [
    {
     "maxWidth": 699,
     "patch": {
      "layout": {
       "height": 44
      },
      "bind": {
       "layout.height": null
      }
     }
    }
   ]
  },
  "option": {
   "type": "row",
   "children": [
    "optionKnob"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     1.5,
     3,
     1.5,
     3
    ]
   },
   "states": {
    "hovered": {
     "optionKnob": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "optionKnob": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= item}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "optionKnob": {
   "type": "row",
   "children": [
    "optionText"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     14,
     0,
     14,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00FFFFFF"
     }
    ],
    "radius": 9
   },
   "bind": {
    "decoration.fills[0].color": "${= item == props.value ? theme.colors.raisedBackground : '#00FFFFFF'}",
    "decoration.effects": "${= item == props.value ? theme.shadows.knob : []}",
    "decoration.radius": "${= max(0, theme.radii.control - 3)}",
    "layout.padding": "${= [props.size == 'xs' ? 8 : (props.size == 'compact' ? 10 : (props.size == 'small' ? 12 : (props.size == 'medium' ? 12 : (14)))), 0, props.size == 'xs' ? 8 : (props.size == 'compact' ? 10 : (props.size == 'small' ? 12 : (props.size == 'medium' ? 12 : (14)))), 0]}"
   },
   "transitions": [
    {
     "property": "decoration",
     "duration": 150
    }
   ]
  },
  "optionText": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "from": "chip",
     "fontSize": 13
    },
    "maxLines": 1
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= item == props.value ? theme.colors.ink : theme.colors.inkSoft}",
    "props.style.fontSize": "${= props.size == 'xs' ? 11.5 : (props.size == 'compact' ? 12 : (props.size == 'small' ? 12.5 : (props.size == 'medium' ? 13 : (15))))}"
   }
  }
 }
}
