{
 "schema": 3,
 "id": "WideScroll",
 "roots": [
  "frame"
 ],
 "widget": {
  "type": "WideScroll",
  "doc": "A frame that scrolls sideways for content wider than the card (a table with many columns): write WideScroll width=640 and the wide blocks indented under it (TableHeader, each row, TableRow) are laid out that wide and scroll together; its edges fade where there is more to scroll to (fade=false turns that off).",
  "props": [
   {
    "key": "width",
    "type": {
     "kind": "number",
     "flutter": "double"
    },
    "default": 640,
    "doc": "How wide the content inside is laid out, in pixels (wider than the card).",
    "required": true
   },
   {
    "key": "fade",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "The edges fade where there is more to scroll to (false: a hard edge)."
   }
  ],
  "children": "list"
 },
 "previews": [
  {
   "name": "Frame",
   "size": [
    340,
    40
   ],
   "props": {}
  }
 ],
 "nodes": {
  "frame": {
   "type": "column",
   "children": [
    "scroller"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "scroller": {
   "type": "row",
   "children": [
    "inner"
   ],
   "props": {
    "scrollable": true,
    "scrollDirection": "horizontal",
    "crossAxisAlignment": "start",
    "edgeFade": 12
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.edgeFade": "${= props.fade ? 12 : 0}"
   }
  },
  "inner": {
   "type": "column",
   "children": [
    "slot"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 0
   },
   "layout": {
    "width": 640,
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "layout.width": "${props.width}"
   }
  },
  "slot": {
   "type": "slot"
  }
 }
}
