{
 "schema": 3,
 "id": "BrowserTabs",
 "roots": [
  "bar"
 ],
 "widget": {
  "type": "BrowserTabs",
  "doc": "Open documents as tabs in a browser's or an editor's manner: each with an x to close it, an optional + to open another (files, reports, chats open side by side; a page's own views are Tabs). Any number: where they do not fit, the row scrolls sideways on one line. The chosen one is kept in your variable. Fires onChanged, onClose with the label, and onAdd.",
  "props": [
   {
    "key": "tabs",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Overview",
     "Report.pdf",
     "Notes"
    ],
    "doc": "The tabs' labels, any number.",
    "required": true
   },
   {
    "key": "icons",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "One icon per tab (empty: none)."
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the chosen label."
   },
   {
    "key": "closable",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "An x on each tab."
   },
   {
    "key": "showAdd",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "A + after the tabs."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "A tab was chosen; the value is its label."
   },
   {
    "key": "onClose",
    "doc": "A tab's x was tapped; the value is its label."
   },
   {
    "key": "onAdd",
    "doc": "The + was tapped."
   }
  ]
 },
 "previews": [
  {
   "name": "Default",
   "size": [
    340,
    36
   ],
   "props": {
    "value": "Report.pdf",
    "showAdd": true
   }
  }
 ],
 "nodes": {
  "bar": {
   "type": "row",
   "children": [
    "scroll",
    "add"
   ],
   "props": {
    "crossAxisAlignment": "end",
    "spacing": 4
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "bottom"
   }
  },
  "scroll": {
   "type": "row",
   "children": [
    "list"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0,
    "scrollable": true,
    "scrollDirection": "horizontal",
    "edgeFade": 24,
    "fillViewport": false
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "squeezable": true
   },
   "actions": [
    {
     "trigger": {
      "type": "load",
      "when": "indexOf(props.tabs, props.value) > 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "tab",
       "item": "${= indexOf(props.tabs, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 0
      }
     ]
    },
    {
     "trigger": {
      "type": "valueChanged",
      "variable": "props.value",
      "when": "indexOf(props.tabs, props.value) >= 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "tab",
       "item": "${= indexOf(props.tabs, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 240
      }
     ]
    }
   ]
  },
  "list": {
   "type": "listView",
   "children": [
    "tab"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false,
    "spacing": 2
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 36
   },
   "bind": {
    "data": "${props.tabs}",
    "layout.height": "${= screen.width < 700 ? 44 : 36}"
   }
  },
  "tab": {
   "type": "row",
   "children": [
    "glyph",
    "label",
    "close"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 6
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     12,
     0,
     8,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "hoverOverlay"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeSides": "top",
    "radius": [
     10,
     10,
     0,
     0
    ]
   },
   "bind": {
    "decoration.fills[0].color": "${= item == props.value ? theme.colors.primaryBackground : theme.colors.hoverOverlay}"
   },
   "states": {
    "hovered": {
     "tab": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "tab": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "transitions": [
    {
     "property": "decoration",
     "duration": 150
    }
   ],
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= item}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "glyph": {
   "type": "icon",
   "props": {
    "icon": "description",
    "size": 15,
    "color": "inkFaint"
   },
   "layout": {
    "width": 15,
    "height": 15
   },
   "bind": {
    "visible": "${= (length(props.icons) > index && props.icons[index] != '')}",
    "props.icon": "${= (length(props.icons) > index && props.icons[index] != '') ? props.icons[index] : 'description'}",
    "props.color": "${= item == props.value ? theme.colors.ink : theme.colors.inkFaint}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "from": "chip",
     "fontSize": 13,
     "fontWeight": 500
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "constraints": {
     "maxWidth": 200
    }
   },
   "bind": {
    "props.style.color": "${= item == props.value ? theme.colors.ink : theme.colors.inkFaint}"
   }
  },
  "close": {
   "type": "row",
   "children": [
    "x"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 20,
    "height": 20
   },
   "decoration": {
    "radius": 999
   },
   "bind": {
    "visible": "${props.closable}"
   },
   "states": {
    "hovered": {
     "close": {
      "decoration": {
       "fills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onClose",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "x": {
   "type": "icon",
   "props": {
    "icon": "close_rounded",
    "size": 13,
    "color": "inkFaint"
   },
   "layout": {
    "width": 13,
    "height": 13
   }
  },
  "add": {
   "type": "row",
   "children": [
    "plus"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 28,
    "height": 28,
    "margin": [
     0,
     0,
     0,
     4
    ]
   },
   "decoration": {
    "radius": 999
   },
   "bind": {
    "visible": "${props.showAdd}"
   },
   "tooltip": "New tab",
   "states": {
    "hovered": {
     "add": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "add": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onAdd"
      }
     ]
    }
   ]
  },
  "plus": {
   "type": "icon",
   "props": {
    "icon": "add_rounded",
    "size": 16,
    "color": "inkSoft"
   },
   "layout": {
    "width": 16,
    "height": 16
   }
  }
 }
}
