{
 "schema": 3,
 "id": "LogoStrip",
 "roots": ["band"],
 "widget": {
  "type": "LogoStrip",
  "doc": "A band of up to eight customer wordmarks under a hero, written directly under Page: LogoStrip \"Trusted by independent hotels\" names=[\"Harbor House\",\"The Larkspur\"] icons=[\"anchor_rounded\",\"local_florist_rounded\"] (icons optional, one Material icon per name; empty: names alone), evenly spread and wrapping when the window is narrow.",
  "props": [
   {"key": "label", "type": {"kind": "string", "flutter": "String"}, "default": "Trusted by teams everywhere", "doc": "The small line over the names (empty: none)."},
   {"key": "names", "type": {"kind": "list", "flutter": "List<String>", "item": {"kind": "string", "flutter": "String"}}, "default": ["Northwind", "Acme", "Globex", "Initech", "Umbrella"], "doc": "The customers, one wordmark each (the first eight are shown).", "required": true},
   {"key": "icons", "type": {"kind": "list", "flutter": "List<String>", "item": {"kind": "string", "flutter": "String"}}, "default": [], "doc": "A Material icon per name, drawn as its small mark (optional)."}
  ]
 },
 "previews": [
  {
   "name": "Hotels",
   "size": [1280, 190],
   "props": {
    "label": "Trusted by independent hotels",
    "names": ["Harbor House", "The Larkspur", "Salt & Pine", "Casa Marisol", "Northgate Inn"],
    "icons": ["anchor_rounded", "local_florist_rounded", "park_rounded", "wb_sunny_rounded", "cottage_rounded"]
   }
  }
 ],
 "nodes": {
  "band": {
   "type": "column",
   "children": ["wrap"],
   "props": {"crossAxisAlignment": "stretch"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [32, 52, 32, 56]},
   "decoration": {"fills": [{"color": "band"}], "strokes": [{"color": "line"}], "strokeWidth": 1},
   "bind": {"decoration.fills[0].color": "${theme.colors.band}", "decoration.strokes[0].color": "${theme.colors.line}"}
  },
  "wrap": {
   "type": "column",
   "children": ["label", "row"],
   "props": {"crossAxisAlignment": "stretch", "spacing": 26},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "label": {
   "type": "text",
   "props": {"text": "${props.label}", "style": {"from": "smallWide", "color": "inkSoft"}, "textAlign": "center"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}},
   "bind": {"visible": "${= props.label != ''}"}
  },
  "row": {
   "type": "row",
   "children": ["m0", "m1", "m2", "m3", "m4", "m5", "m6", "m7"],
   "props": {"wrap": true, "spacing": 16, "runSpacing": 20, "mainAxisAlignment": "spaceEvenly", "crossAxisAlignment": "center"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "m0": {"type": "row", "children": ["i0", "t0"], "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center", "spacing": 8}, "layout": {"width": {"fill": 1}, "basis": 170, "height": 32}, "bind": {"visible": "${= length(props.names) > 0}"}},
  "i0": {"type": "icon", "props": {"icon": "circle", "size": 20, "color": "inkSoft"}, "layout": {"width": 20, "height": 20}, "bind": {"visible": "${= length(props.icons) > 0 && at(props.icons, 0) != ''}", "props.icon": "${= length(props.icons) > 0 ? at(props.icons, 0) : 'circle'}"}},
  "t0": {"type": "text", "props": {"text": "${= length(props.names) > 0 ? at(props.names, 0) : ''}", "style": {"from": "headingWide", "fontSize": 19, "fontWeight": 700, "letterSpacing": -0.4, "color": "inkSoft"}, "maxLines": 1, "overflow": "ellipsis"}, "layout": {"width": {"hug": 0}, "height": {"hug": 0}}},
  "m1": {"type": "row", "children": ["i1", "t1"], "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center", "spacing": 8}, "layout": {"width": {"fill": 1}, "basis": 170, "height": 32}, "bind": {"visible": "${= length(props.names) > 1}"}},
