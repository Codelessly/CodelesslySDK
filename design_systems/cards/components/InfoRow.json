{
 "schema": 3,
 "id": "InfoRow",
 "roots": [
  "row"
 ],
 "widget": {
  "type": "InfoRow",
  "doc": "One label and its value on a line (a price row, a detail such as Folder or Rating): the label, then the value text at the right; strong:true makes it the total row.",
  "props": [
   {
    "key": "label",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Subtotal",
    "doc": "What the value is, at the left.",
    "required": true
   },
   {
    "key": "text",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The value, at the right."
   },
   {
    "key": "icon",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A small Material icon before the label (empty: none)."
   },
   {
    "key": "strong",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "True for a total: larger, with a rule above."
   }
  ]
 },
 "previews": [
  {
   "name": "Row",
   "size": [
    340,
    34
   ],
   "props": {
    "label": "Delivery",
    "text": "$4.99"
   }
  },
  {
   "name": "Total",
   "size": [
    340,
    44
   ],
   "props": {
    "label": "Total",
    "text": "$30.94",
    "strong": true
   }
  }
 ],
 "nodes": {
  "row": {
   "type": "row",
   "children": [
    "icon",
    "label",
    "value"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 10
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "padding": [
     0,
     7,
     0,
     7
    ]
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1,
    "strokeSides": "top"
   },
   "bind": {
    "layout.padding": "${= props.strong ? [0, 12, 0, 2] : [0, 7, 0, 7]}",
    "decoration.strokeWidth": "${= props.strong ? 1 : 0}"
   }
  },
  "icon": {
   "type": "icon",
   "props": {
    "icon": "folder_rounded",
    "size": 17,
    "color": "inkFaint"
   },
   "layout": {
    "width": 17,
    "height": 17
   },
   "bind": {
    "props.icon": "${props.icon}",
    "visible": "${= props.icon != ''}"
   }
  },
  "label": {
   "type": "text",
   "props": {
    "text": "${props.label}",
    "style": "lead",
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style": "${= props.strong ? 'blockTitle' : 'lead'}"
   }
  },
  "value": {
   "type": "text",
   "props": {
    "text": "${props.text}",
    "style": "rowTitle",
    "textAlign": "right",
    "maxLines": 2,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "constraints": {
     "maxWidth": 230
    }
   },
   "bind": {
    "props.style": "${= props.strong ? 'number' : 'figure'}"
   }
  }
 }
}
