{
 "schema": 3,
 "id": "CallToAction",
 "roots": ["band"],
 "widget": {
  "type": "CallToAction",
  "doc": "The closing band of a landing page on the hero gradient: CallToAction \"Ready to start?\" \"One line of reassurance.\" primary:\"Start free\" secondary:\"Talk to sales\" (empty secondary: one button), firing onPrimary and onSecondary; place it in a Section and it fills the section's width.",
  "props": [
   {"key": "title", "type": {"kind": "string", "flutter": "String"}, "default": "Ready to get started?", "doc": "The headline.", "required": true},
   {"key": "text", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "One line under the headline (empty: none)."},
   {"key": "primary", "type": {"kind": "string", "flutter": "String"}, "default": "Get started", "doc": "The label of the main action.", "required": true},
   {"key": "secondary", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "The label of a quiet second action (empty: none)."}
  ],
  "events": [
   {"key": "onPrimary", "doc": "The main action was pressed."},
   {"key": "onSecondary", "doc": "The second action was pressed."}
  ]
 },
 "previews": [
  {
   "name": "Tidewater",
   "size": [1120, 300],
   "props": {
    "title": "Ready to fill every room?",
    "text": "Set up in two minutes. Free for 14 days.",
    "primary": "Start free",
    "secondary": "Talk to sales"
   }
  }
 ],
 "nodes": {
  "band": {
   "type": "column",
   "children": ["title", "text", "actions"],
   "props": {"crossAxisAlignment": "center", "spacing": 0},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [40, 64, 40, 64]},
   "decoration": {"radius": 16},
   "bind": {"decoration.radius": "${theme.radii.cardWide}"},
   "customPaint": {
    "painter": [
     {
      "op": "rrect",
      "rect": [0, 0, "${size.width}", "${size.height}"],
      "radius": "${theme.radii.cardWide}",
      "paint": "${= {'shader': {'type': 'linear', 'begin': 'topLeft', 'end': 'bottomRight', 'stops': [{'position': 0, 'color': theme.colors.heroA}, {'position': 1, 'color': theme.colors.heroB}]}}}"
     }
    ]
   }
  },
  "title": {
   "type": "text",
   "props": {"text": "${props.title}", "style": {"from": "heading2Wide", "color": "onHero"}, "textAlign": "center"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "text": {
   "type": "text",
   "props": {"text": "${props.text}", "style": {"from": "leadWide", "color": "onHeroSoft"}, "textAlign": "center"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [0, 14, 0, 0]},
   "bind": {"visible": "${= props.text != ''}"}
  },
  "actions": {
   "type": "row",
   "children": ["primary", "secondary"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center", "spacing": 12, "runSpacing": 12, "wrap": true},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [0, 32, 0, 0]}
  },
  "primary": {
   "type": "row",
   "children": ["primaryLabel", "primaryIcon"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center", "spacing": 8},
   "layout": {"width": {"hug": 0}, "height": 44, "padding": [22, 0, 20, 0]},
   "decoration": {"fills": [{"color": "onHero"}], "radius": 10},
   "bind": {"decoration.radius": "${theme.radii.controlMedium}"},
   "states": {"pressed": {"primary": {"opacity": 0.85}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onPrimary", "value": "${props.primary}"}]}
   ]
  },
  "primaryLabel": {
   "type": "text",
   "props": {"text": "${props.primary}", "style": {"from": "strongWide", "color": "heroA"}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "primaryIcon": {
   "type": "icon",
   "props": {"icon": "arrow_forward_rounded", "size": 18, "color": "heroA"},
   "layout": {"width": 18, "height": 18}
  },
  "secondary": {
   "type": "row",
   "children": ["secondaryLabel"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": {"hug": 0}, "height": 44, "padding": [22, 0, 22, 0]},
   "decoration": {"fills": [{"color": "heroChip"}], "strokes": [{"color": "heroLine"}], "strokeWidth": 1.2, "radius": 10},
   "bind": {"visible": "${= props.secondary != ''}", "decoration.radius": "${theme.radii.controlMedium}"},
   "states": {"pressed": {"secondary": {"opacity": 0.8}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onSecondary", "value": "${props.secondary}"}]}
   ]
  },
  "secondaryLabel": {
   "type": "text",
   "props": {"text": "${props.secondary}", "style": {"from": "strongWide", "color": "onHero"}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  }
 }
}