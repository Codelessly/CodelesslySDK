{
 "schema": 3,
 "id": "TabToggle",
 "roots": [
  "track"
 ],
 "widget": {
  "type": "TabToggle",
  "doc": "A small switch between two to four views as a track only as wide as its options, the chosen one raised (List or Grid in a toolbar, Monthly or Yearly over prices); Segments is the same switch as wide as its place, and a page's tabs are Tabs. The choice is kept in your variable. Fires onChanged. Where its options do not fit it scrolls sideways on one line.",
  "props": [
   {
    "key": "options",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "List",
     "Grid"
    ],
    "doc": "Two to four short options.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable holding the choice."
   },
   {
    "key": "size",
    "type": {
     "kind": "enumeration",
     "flutter": "String",
     "values": [
      "sm",
      "md",
      "lg"
     ]
    },
    "default": "md",
    "doc": "sm, md or lg."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "An option was chosen; the value is its text."
   }
  ]
 },
 "previews": [
  {
   "name": "Two",
   "size": [
    160,
    36
   ],
   "props": {
    "options": [
     "List",
     "Grid"
    ],
    "value": "List"
   }
  }
 ],
 "nodes": {
  "track": {
   "type": "row",
   "children": [
    "scroll"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "subtleFill"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1,
    "radius": 12,
    "clip": "antiAlias"
   },
   "bind": {
    "decoration.radius": "${theme.radii.control}"
   }
  },
  "scroll": {
   "type": "row",
   "children": [
    "list"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0,
    "scrollable": true,
    "scrollDirection": "horizontal",
    "edgeFade": 24,
    "fillViewport": false
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    },
    "squeezable": true,
    "padding": [
     1.5,
     0,
     1.5,
     0
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "load",
      "when": "indexOf(props.options, props.value) > 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "option",
       "item": "${= indexOf(props.options, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 0
      }
     ]
    },
    {
     "trigger": {
      "type": "valueChanged",
      "variable": "props.value",
      "when": "indexOf(props.options, props.value) >= 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "option",
       "item": "${= indexOf(props.options, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 240
      }
     ]
    }
   ]
  },
  "list": {
   "type": "listView",
   "children": [
    "option"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false,
    "spacing": 0
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 36
   },
   "bind": {
    "data": "${props.options}",
    "layout.height": "${= screen.width < 700 ? 44 : (props.size == 'sm' ? 32 : (props.size == 'md' ? 36 : (44)))}"
   }
  },
  "option": {
   "type": "row",
   "children": [
    "optionKnob"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     1.5,
     3,
     1.5,
     3
    ]
   },
   "states": {
    "hovered": {
     "optionKnob": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "optionKnob": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= item}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "optionKnob": {
   "type": "row",
   "children": [
    "optionText"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     14,
     0,
     14,
     0
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00FFFFFF"
     }
    ],
    "radius": 9
   },
   "bind": {
    "decoration.fills[0].color": "${= item == props.value ? theme.colors.raisedBackground : '#00FFFFFF'}",
    "decoration.effects": "${= item == props.value ? theme.shadows.knob : []}",
    "decoration.radius": "${= max(0, theme.radii.control - 3)}",
    "layout.padding": "${= [props.size == 'sm' ? 10 : (props.size == 'md' ? 14 : (18)), 0, props.size == 'sm' ? 10 : (props.size == 'md' ? 14 : (18)), 0]}"
   },
   "transitions": [
    {
     "property": "decoration",
     "duration": 150
    }
   ]
  },
  "optionText": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": {
     "from": "chip",
     "fontSize": 13
    },
    "maxLines": 1
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= item == props.value ? theme.colors.ink : theme.colors.inkSoft}",
    "props.style.fontSize": "${= props.size == 'sm' ? 12.5 : (props.size == 'md' ? 13 : (14))}"
   }
  }
 }
}
