{
 "schema": 3,
 "id": "TableRow",
 "roots": [
  "row"
 ],
 "widget": {
  "type": "TableRow",
  "doc": "One row of a table under a TableHeader: cells:=[r.plan,r.subs,money(r.revenue,\"$\",0)] in column order, badge a status pill as a last column (Paid, Due, Overdue are colored); selectable:true with checked:=contains(picked,r.id) adds a tick box, and a tap fires onPressed (toggle the tick).",
  "props": [
   {
    "key": "cells",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Pro",
     "1,340",
     "$38.9k"
    ],
    "doc": "The cell texts, in column order (up to five).",
    "required": true
   },
   {
    "key": "badge",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A status pill in one more column at the end (Paid is green, Due amber, Overdue red; empty: none)."
   },
   {
    "key": "widths",
    "type": {
     "kind": "list",
     "flutter": "List<double>",
     "item": {
      "kind": "number",
      "flutter": "double"
     }
    },
    "default": [],
    "doc": "Relative column widths, as the TableHeader's."
   },
   {
    "key": "selectable",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "True shows a tick box before the cells."
   },
   {
    "key": "checked",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Whether its box is ticked (the row is tinted)."
   }
  ],
  "events": [
   {
    "key": "onPressed",
    "doc": "The row was tapped."
   }
  ]
 },
 "previews": [
  {
   "name": "Row",
   "size": [
    360,
    44
   ],
   "props": {
    "badge": "Paid"
   }
  }
 ],
 "nodes": {
  "row": {
   "type": "row",
   "children": [
    "tickBox",
    "c0",
    "c1",
    "c2",
    "c3",
    "c4",
    "badge"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 8
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "padding": [
     10,
     11,
     10,
     11
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "#00FFFFFF"
     }
    ],
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1,
    "strokeSides": "bottom"
   },
   "bind": {
    "decoration.fills[0].color": "${= props.checked ? theme.colors.accentTint : '#00FFFFFF'}"
   },
   "states": {
    "pressed": {
     "row": {
      "opacity": 0.82
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onPressed"
      }
     ]
    }
   ]
  },
  "tickBox": {
   "type": "row",
   "children": [
    "tick"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 20,
    "height": 20
   },
   "bind": {
    "visible": "${props.selectable}"
   }
  },
  "tick": {
   "type": "row",
   "children": [
    "tickI"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 20,
    "height": 20
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "lineStrong"
     }
    ],
    "strokeWidth": 1.5,
    "radius": 6
   },
   "bind": {
    "decoration.fills[0].color": "${= props.checked ? theme.colors.accent : theme.colors.card}",
    "decoration.strokes[0].color": "${= props.checked ? theme.colors.accent : theme.colors.lineStrong}"
   }
  },
  "tickI": {
   "type": "icon",
   "props": {
    "icon": "check_rounded",
    "size": 14,
    "color": "onAccent"
   },
   "layout": {
    "width": 14,
    "height": 14
   },
   "bind": {
    "visible": "${= props.checked}"
   }
  },
  "badge": {
   "type": "row",
   "children": [
    "badgePill"
   ],
   "props": {
    "mainAxisAlignment": "end"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 2
   },
   "bind": {
    "visible": "${= props.badge != ''}",
    "layout.flex": "${= length(props.widths) > length(props.cells) ? at(props.widths, length(props.cells)) : 2}"
   }
  },
  "badgePill": {
   "type": "row",
   "children": [
    "badgeText"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "padding": [
     4,
     3,
     4,
     3
    ]
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 999
   },
   "bind": {
    "decoration.fills[0].color": "${= contains(['paid', 'active', 'done', 'sent', 'ok', 'complete', 'completed'], lower(props.badge)) ? theme.colors.goodTint : contains(['overdue', 'failed', 'late', 'error', 'cancelled'], lower(props.badge)) ? theme.colors.badTint : contains(['due', 'pending', 'draft', 'open', 'trial'], lower(props.badge)) ? theme.colors.warnTint : theme.colors.tile}"
   }
  },
  "badgeText": {
   "type": "text",
   "props": {
    "text": "${props.badge}",
    "style": {
     "from": "chip",
     "fontSize": 10.5
    },
    "textAlign": "center",
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= contains(['paid', 'active', 'done', 'sent', 'ok', 'complete', 'completed'], lower(props.badge)) ? theme.colors.goodDeep : contains(['overdue', 'failed', 'late', 'error', 'cancelled'], lower(props.badge)) ? theme.colors.badDeep : contains(['due', 'pending', 'draft', 'open', 'trial'], lower(props.badge)) ? theme.colors.warnDeep : theme.colors.inkSoft}"
   }
  },
  "c0": {
   "type": "text",
   "props": {
    "text": "${= length(props.cells) > 0 ? at(props.cells, 0) : \"\"}",
    "style": {
     "from": "figure",
     "fontWeight": 600
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 2
   },
   "bind": {
    "visible": "${= length(props.cells) > 0}",
    "layout.flex": "${= length(props.widths) > 0 ? at(props.widths, 0) : 3}",
    "props.textAlign": "${= (0 == length(props.cells) - 1 && 0 > 0 && props.badge == '') ? 'right' : 'left'}",
    "props.style.color": "${= theme.colors.ink}"
   }
  },
  "c1": {
   "type": "text",
   "props": {
    "text": "${= length(props.cells) > 1 ? at(props.cells, 1) : \"\"}",
    "style": {
     "from": "figure",
     "fontSize": 13
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 2
   },
   "bind": {
    "visible": "${= length(props.cells) > 1}",
    "layout.flex": "${= length(props.widths) > 1 ? at(props.widths, 1) : 2}",
    "props.textAlign": "${= (1 == length(props.cells) - 1 && 1 > 0 && props.badge == '') ? 'right' : 'left'}",
    "props.style.color": "${= theme.colors.inkSoft}"
   }
  },
  "c2": {
   "type": "text",
   "props": {
    "text": "${= length(props.cells) > 2 ? at(props.cells, 2) : \"\"}",
    "style": {
     "from": "figure",
     "fontSize": 13
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 2
   },
   "bind": {
    "visible": "${= length(props.cells) > 2}",
    "layout.flex": "${= length(props.widths) > 2 ? at(props.widths, 2) : 2}",
    "props.textAlign": "${= (2 == length(props.cells) - 1 && 2 > 0 && props.badge == '') ? 'right' : 'left'}",
    "props.style.color": "${= theme.colors.inkSoft}"
   }
  },
  "c3": {
   "type": "text",
   "props": {
    "text": "${= length(props.cells) > 3 ? at(props.cells, 3) : \"\"}",
    "style": {
     "from": "figure",
     "fontSize": 13
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 2
   },
   "bind": {
    "visible": "${= length(props.cells) > 3}",
    "layout.flex": "${= length(props.widths) > 3 ? at(props.widths, 3) : 2}",
    "props.textAlign": "${= (3 == length(props.cells) - 1 && 3 > 0 && props.badge == '') ? 'right' : 'left'}",
    "props.style.color": "${= theme.colors.inkSoft}"
   }
  },
  "c4": {
   "type": "text",
   "props": {
    "text": "${= length(props.cells) > 4 ? at(props.cells, 4) : \"\"}",
    "style": {
     "from": "figure",
     "fontSize": 13
    },
    "maxLines": 1,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    },
    "flex": 2
   },
   "bind": {
    "visible": "${= length(props.cells) > 4}",
    "layout.flex": "${= length(props.widths) > 4 ? at(props.widths, 4) : 2}",
    "props.textAlign": "${= (4 == length(props.cells) - 1 && 4 > 0 && props.badge == '') ? 'right' : 'left'}",
    "props.style.color": "${= theme.colors.inkSoft}"
   }
  }
 }
}
