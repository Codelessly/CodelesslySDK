{
 "schema": 3,
 "id": "Carousel",
 "roots": [
  "wrap"
 ],
 "widget": {
  "type": "Carousel",
  "doc": "A real carousel of products: Carousel =i items:=shoes slides one ProductTile per record (name, detail, price, rating, kind, tone) sideways by swipe, showing the edge of the next (peek), and keeps the position (from 0) in your number variable; dots, arrows, counter (\"2 of 6\") and thumbs are switches; a tap on an item fires onPressed with its position (-> open=true), and Pager or PageDots on the same variable drive it too.",
  "props": [
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "number",
      "flutter": "double"
     }
    },
    "default": "",
    "doc": "The name of your number variable: the item in view, from 0."
   },
   {
    "key": "items",
    "type": {
     "kind": "list",
     "flutter": "List<dynamic>",
     "item": {
      "kind": "json",
      "flutter": "dynamic"
     }
    },
    "default": [
     {
      "name": "Aero Runner",
      "detail": "Road",
      "price": "$120",
      "rating": "4.8",
      "tone": "lilac"
     },
     {
      "name": "Trail Scout",
      "detail": "Trail",
      "price": "$135",
      "rating": "4.6",
      "tone": "mint"
     }
    ],
    "doc": "The items: records with name, detail, price, rating (texts) and optionally kind, tone and badge (as ProductTile).",
    "required": true
   },
   {
    "key": "kind",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "shoe",
    "doc": "The Media kind drawn for an item that names none."
   },
   {
    "key": "peek",
    "type": {
     "kind": "number",
     "flutter": "double"
    },
    "default": 0.86,
    "doc": "The share of the width one item takes: under 1 shows the edge of the next (1: one full item)."
   },
   {
    "key": "dots",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "Pagination dots under the strip."
   },
   {
    "key": "arrows",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "Previous and next buttons."
   },
   {
    "key": "counter",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "A \"2 of 6\" count under the strip."
   },
   {
    "key": "thumbs",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "A strip of small drawn thumbnails to tap."
   },
   {
    "key": "cta",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A small pill on each picture that invites a tap, such as Details (empty: none)."
   },
   {
    "key": "height",
    "type": {
     "kind": "number",
     "flutter": "double"
    },
    "default": 196,
    "doc": "The pictures' height."
   },
   {
    "key": "fade",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": true,
    "doc": "The peeking next item fades at the edge (false: a hard edge)."
   }
  ],
  "events": [
   {
    "key": "onPressed",
    "doc": "An item was tapped; the value is its position."
   },
   {
    "key": "onChanged",
    "doc": "The position changed; the value is the new position."
   }
  ]
 },
 "previews": [
  {
   "name": "Strip",
   "size": [
    360,
    340
   ],
   "props": {
    "value": 0
   }
  }
 ],
 "nodes": {
  "wrap": {
   "type": "column",
   "children": [
    "pages",
    "thumbs",
    "bar"
   ],
   "props": {
    "crossAxisAlignment": "stretch",
    "spacing": 10
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "pages": {
   "type": "pageView",
   "children": [
    "page"
   ],
   "props": {
    "viewportFraction": 0.86,
    "scrollDirection": "horizontal",
    "padEnds": false,
    "edgeFade": 12
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 290
   },
   "bind": {
    "props.initialPage": "${props.value}",
    "data": "${props.items}",
    "props.viewportFraction": "${props.peek}",
    "props.edgeFade": "${= props.fade && props.peek < 1 ? 12 : 0}",
    "layout.height": "${= props.height + 94}"
   },
   "actions": [
    {
     "trigger": {
      "type": "changed"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${result.index}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${result.index}"
      }
     ]
    }
   ]
  },
  "page": {
   "type": "column",
   "children": [
    "tile"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     0,
     0,
     10,
     0
    ]
   },
   "bind": {
    "layout.padding": "${= props.peek < 1 ? [0, 0, 10, 0] : [0, 0, 0, 0]}"
   }
  },
  "tile": {
   "type": "ProductTile",
   "props": {
    "name": ""
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.name": "${= coalesce(item.name, '')}",
    "props.detail": "${= coalesce(item.detail, '')}",
    "props.price": "${= coalesce(item.price, '')}",
    "props.rating": "${= coalesce(item.rating, '')}",
    "props.kind": "${= coalesce(item.kind, props.kind)}",
    "props.tone": "${= coalesce(item.tone, 'auto')}",
    "props.badge": "${= coalesce(item.badge, '')}",
    "props.cta": "${props.cta}",
    "props.height": "${props.height}"
   },
   "actions": [
    {
     "trigger": {
      "type": "event",
      "event": "onPressed"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onPressed",
       "value": "${index}"
      }
     ]
    }
   ]
  },
  "thumbs": {
   "type": "gridView",
   "children": [
    "thumb"
   ],
   "props": {
    "crossAxisCount": 1,
    "crossAxisSpacing": 8,
    "mainAxisSpacing": 8,
    "shrinkWrapRows": true,
    "physics": "never"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "data": "${props.items}",
    "props.crossAxisCount": "${= max(1, length(props.items))}",
    "visible": "${props.thumbs}"
   }
  },
  "thumb": {
   "type": "stack",
   "children": [
    "thumbArt"
   ],
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 48
   },
   "decoration": {
    "radius": 13,
    "strokes": [
     {
      "color": "accent"
     }
    ],
    "strokeWidth": 0,
    "strokeAlign": "outside"
   },
   "bind": {
    "decoration.strokeWidth": "${= index == props.value ? 2.5 : 0}",
    "opacity": "${= index == props.value ? 1 : 0.72}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= index}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${props.value}"
      }
     ]
    }
   ]
  },
  "thumbArt": {
   "type": "Media",
   "props": {
    "kind": "shoe"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "fill": 0
    },
    "x": {
     "start": 0,
     "end": 0
    },
    "y": {
     "start": 0,
     "end": 0
    }
   },
   "bind": {
    "props.kind": "${= coalesce(item.kind, props.kind)}",
    "props.tone": "${= coalesce(item.tone, 'auto')}"
   }
  },
  "bar": {
   "type": "row",
   "children": [
    "prev",
    "mid",
    "next"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 10
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "visible": "${= props.arrows || props.dots || props.counter}"
   }
  },
  "prev": {
   "type": "row",
   "children": [
    "prevI"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 36,
    "height": 36
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 18.0
   },
   "bind": {
    "visible": "${props.arrows}",
    "opacity": "${= props.value > 0 ? 1 : 0.35}"
   },
   "states": {
    "pressed": {
     "prev": {
      "opacity": 0.6
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= max(0, props.value - 1)}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${props.value}"
      }
     ]
    }
   ]
  },
  "prevI": {
   "type": "icon",
   "props": {
    "icon": "arrow_back_rounded",
    "size": 20,
    "color": "ink"
   },
   "layout": {
    "width": 20,
    "height": 20
   }
  },
  "next": {
   "type": "row",
   "children": [
    "nextI"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": 36,
    "height": 36
   },
   "decoration": {
    "fills": [
     {
      "color": "tile"
     }
    ],
    "radius": 18.0
   },
   "bind": {
    "visible": "${props.arrows}",
    "opacity": "${= props.value < length(props.items) - 1 ? 1 : 0.35}"
   },
   "states": {
    "pressed": {
     "next": {
      "opacity": 0.6
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= min(length(props.items) - 1, props.value + 1)}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${props.value}"
      }
     ]
    }
   ]
  },
  "nextI": {
   "type": "icon",
   "props": {
    "icon": "arrow_forward_rounded",
    "size": 20,
    "color": "ink"
   },
   "layout": {
    "width": 20,
    "height": 20
   }
  },
  "mid": {
   "type": "column",
   "children": [
    "dots",
    "count"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 2
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "dots": {
   "type": "row",
   "children": [
    "dotsList"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 22
   },
   "bind": {
    "visible": "${props.dots}"
   }
  },
  "dotsList": {
   "type": "listView",
   "children": [
    "dotsHit"
   ],
   "props": {
    "scrollable": false,
    "spacing": 0,
    "scrollDirection": "horizontal"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 22
   },
   "bind": {
    "data": "${= range(max(1, length(props.items)))}"
   }
  },
  "dotsHit": {
   "type": "row",
   "children": [
    "dotsDot"
   ],
   "props": {
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    },
    "padding": [
     3,
     0,
     3,
     0
    ]
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= index}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${props.value}"
      }
     ]
    }
   ]
  },
  "dotsDot": {
   "type": "box",
   "layout": {
    "width": 6,
    "height": 6
   },
   "decoration": {
    "fills": [
     {
      "color": "lineStrong"
     }
    ],
    "radius": 3
   },
   "bind": {
    "layout.width": "${= index == props.value ? 20 : 6}",
    "decoration.fills[0].color": "${= index == props.value ? theme.colors.accent : theme.colors.lineStrong}"
   }
  },
  "count": {
   "type": "text",
   "props": {
    "text": "${= props.value + 1} of ${= length(props.items)}",
    "style": {
     "from": "meta",
     "fontWeight": 600
    }
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "visible": "${props.counter}"
   }
  }
 }
}
