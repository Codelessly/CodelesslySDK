  "type": "MapPanel",
  "doc": "A drawn map (an illustration: blocks, streets, a park, water, a dot for you) with numbered pins: MapPanel bind=pick count=5 shows pins 1 to 5 and keeps the tapped pin's number in your variable (0: none), the same variable the PlaceRow lines use.",
  "props": [
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "number",
      "flutter": "double"
     }
    },
    "default": "",
    "doc": "The name of your number variable: the number of the pin chosen (0: none)."
   },
   {
    "key": "count",
    "type": {
     "kind": "integer",
     "flutter": "int"
    },
    "default": 5,
    "doc": "How many numbered pins (up to 8).",
    "required": true
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "A pin was tapped; the value is its number (0: cleared)."
   }
  ]
 },
