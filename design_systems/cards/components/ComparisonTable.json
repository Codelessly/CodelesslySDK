 "widget": {
  "type": "ComparisonTable",
  "doc": "Two or three options compared side by side: names and prices head the columns, rows is a list of [label, value per column..., winner] where winner is the winning column's number (1, 2, 3; 0 a tie) and gets a check; pick names the recommended column (tinted); the Choose button under each column fires onChoose with that name as result.",
  "props": [
   {
    "key": "names",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Lite",
     "Max"
    ],
    "doc": "The two or three things compared, one column each.",
    "required": true
   },
   {
    "key": "prices",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "The headline figure under each name ($25/mo)."
   },
   {
    "key": "notes",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "A quiet line under each figure (optional)."
   },
   {
    "key": "rows",
    "type": {
     "kind": "list",
     "flutter": "List<dynamic>",
     "item": {
      "kind": "json",
      "flutter": "dynamic"
     }
    },
    "default": [
     [
      "Data",
      "10 GB",
      "Unlimited",
      2
     ]
    ],
    "doc": "One list per row: the label, a value per column, then the winning column (1, 2 or 3; 0 for a tie).",
    "required": true
   },
   {
    "key": "pick",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The recommended name: its column is tinted and its button filled (empty: none)."
   },
   {
    "key": "pickLabel",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Best value",
    "doc": "The small label over the recommended column."
   },
   {
    "key": "cta",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "Choose",
    "doc": "The label of the button under each column."
   },
   {
    "key": "corner",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "A small caps label in the top-left corner (optional)."
   }
  ],
  "events": [
   {
    "key": "onChoose",
    "doc": "A column's button was tapped; the value is its name."
   }
  ]
 },
