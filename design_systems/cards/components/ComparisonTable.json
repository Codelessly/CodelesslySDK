    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "visible": "${= length(props.notes) > 4}"
   }
  },
  "cells4": {
   "type": "listView",
   "children": [
    "c4"
   ],
   "props": {
    "scrollable": false,
    "spacing": 0
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "data": "${props.rows}"
   }
  },
  "c4": {
   "type": "row",
   "children": [
    "ct4",
    "cw4"
   ],
   "props": {
    "spacing": 5
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 46,
    "padding": [
     10,
     0,
     6,
     0
    ]
   },
   "decoration": {
    "strokes": [
     {
      "color": "line"
     }
    ],
    "strokeWidth": 1,
    "strokeSides": "top"
   }
  },
  "ct4": {
   "type": "text",
   "props": {
    "text": "${= length(item) > 6 ? at(item, 5) : \"\"}",
    "style": {
     "from": "figure",
     "fontSize": 13,
     "height": 1.25
    },
    "maxLines": 2,
    "overflow": "ellipsis"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= (at(item, length(item) - 1) == 5) ? theme.colors.ink : theme.colors.inkSoft}",
    "props.style.fontWeight": "${= (at(item, length(item) - 1) == 5) ? 600 : 400}"
   }
  },
  "cw4": {
   "type": "icon",
   "props": {
    "icon": "check_circle_rounded",
    "size": 16,
    "color": "good"
   },
   "layout": {
    "width": 16,
    "height": 16
   },
   "bind": {
    "visible": "${= (at(item, length(item) - 1) == 5)}"
   }
  },
  "f4": {
   "type": "column",
   "children": [
    "fb4"
   ],
   "props": {
    "crossAxisAlignment": "stretch"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 58,
    "padding": [
     8,
     6,
     8,
     10
    ]
   }
  },
  "fb4": {
   "type": "row",
   "children": [
    "fbT4"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0,
    "mainAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 40
   },
   "decoration": {
    "fills": [
     {
      "color": "card"
     }
    ],
    "strokes": [
     {
      "color": "lineStrong"
     }
    ],
    "strokeWidth": 1.2,
    "radius": 12
   },
   "bind": {
    "decoration.fills[0].color": "${= (length(props.names) > 4 && at(props.names, 4) == props.pick) ? theme.colors.accent : theme.colors.card}",
    "decoration.strokes[0].color": "${= (length(props.names) > 4 && at(props.names, 4) == props.pick) ? theme.colors.accent : theme.colors.lineStrong}",
    "decoration.effects": "${= (length(props.names) > 4 && at(props.names, 4) == props.pick) ? theme.shadows.cta : []}",
    "decoration.radius": "${theme.radii.control}"
   },
   "states": {
    "pressed": {
     "fb4": {
      "opacity": 0.82
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onChoose",
       "value": "${= at(props.names, 4)}"
      }
     ]
    }
   ]
  },
  "fbT4": {
   "type": "text",
   "props": {
    "text": "${props.cta}",
    "style": {
     "from": "cta",
     "fontSize": 13.5
    },
    "maxLines": 1
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= (length(props.names) > 4 && at(props.names, 4) == props.pick) ? theme.colors.onAccent : theme.colors.ink}"
   }
  }
 }
}
