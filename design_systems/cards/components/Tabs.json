{
 "schema": 3,
 "id": "Tabs",
 "roots": [
  "bar"
 ],
 "widget": {
  "type": "Tabs",
  "doc": "The tabs of a page or a card: labels on a hairline, the open one underlined in the accent, switching what is shown under them. Write Tabs @tab tabs=[\"Overview\",\"Activity\",\"Settings\"] with state tab=\"Overview\", then one if tab==\"Overview\" block per tab under it. Any number of tabs: where they do not fit, the row scrolls sideways on one line and brings the open tab into view. For a small switch of two to four options use Segments, for filter pills ChipTabs. Fires onChanged with the label.",
  "props": [
   {
    "key": "tabs",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Overview",
     "Activity",
     "Settings"
    ],
    "doc": "The tabs' labels, any number.",
    "required": true
   },
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable: it holds the open tab's label (declare it with the tab to start on: state tab=\"Overview\"; left empty, the first tab shows as open)."
   }
  ],
  "events": [
   {
    "key": "onChanged",
    "doc": "A tab was opened; the value is its label."
   }
  ]
 },
 "previews": [
  {
   "name": "Three",
   "size": [
    360,
    44
   ],
   "props": {
    "value": "Activity"
   }
  }
 ],
 "nodes": {
  "bar": {
   "type": "stack",
   "children": [
    "rule",
    "scroll"
   ],
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   }
  },
  "rule": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 1,
    "x": {
     "start": 0
    },
    "y": {
     "end": 0
    }
   },
   "decoration": {
    "fills": [
     {
      "color": "line"
     }
    ]
   }
  },
  "scroll": {
   "type": "row",
   "children": [
    "list"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "spacing": 0,
    "scrollable": true,
    "scrollDirection": "horizontal",
    "edgeFade": 24,
    "fillViewport": true
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "load",
      "when": "indexOf(props.tabs, props.value) > 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "tab",
       "item": "${= indexOf(props.tabs, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 0
      }
     ]
    },
    {
     "trigger": {
      "type": "valueChanged",
      "variable": "props.value",
      "when": "indexOf(props.tabs, props.value) >= 0"
     },
     "actions": [
      {
       "type": "scrollTo",
       "node": "tab",
       "item": "${= indexOf(props.tabs, props.value)}",
       "axis": "horizontal",
       "alignment": 0.5,
       "curve": "easeOutCubic",
       "durationMs": 240
      }
     ]
    }
   ]
  },
  "list": {
   "type": "listView",
   "children": [
    "tab"
   ],
   "props": {
    "scrollDirection": "horizontal",
    "scrollable": false,
    "spacing": 4
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 44
   },
   "bind": {
    "data": "${props.tabs}"
   }
  },
  "tab": {
   "type": "column",
   "children": [
    "tabTop",
    "tabBody",
    "tabLine"
   ],
   "props": {
    "crossAxisAlignment": "center",
    "mainAxisAlignment": "spaceBetween"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "fill": 0
    }
   },
   "states": {
    "hovered": {
     "tabBody": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "hoverOverlay"
        }
       ]
      }
     }
    },
    "pressed": {
     "tabBody": {
      "decoration": {
       "foregroundFills": [
        {
         "color": "pressedOverlay"
        }
       ]
      }
     }
    }
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "setVariable",
       "variable": "props.value",
       "value": "${= item}"
      },
      {
       "type": "componentEvent",
       "event": "onChanged",
       "value": "${item}"
      }
     ]
    }
   ]
  },
  "tabTop": {
   "type": "box",
   "layout": {
    "width": 1,
    "height": 2
   }
  },
  "tabBody": {
   "type": "row",
   "children": [
    "tabText"
   ],
   "props": {
    "crossAxisAlignment": "center"
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": 32,
    "padding": [
     12,
     0,
     12,
     0
    ]
   },
   "decoration": {
    "radius": 8
   },
   "bind": {
    "decoration.radius": "${= max(0, theme.radii.control - 4)}"
   },
   "transitions": [
    {
     "property": "decoration",
     "duration": 150
    }
   ]
  },
  "tabText": {
   "type": "text",
   "props": {
    "text": "${item}",
    "style": "controlMedium",
    "maxLines": 1
   },
   "layout": {
    "width": {
     "hug": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= (props.value == item || (props.value == '' && index == 0)) ? theme.colors.ink : theme.colors.inkFaint}"
   }
  },
  "tabLine": {
   "type": "box",
   "layout": {
    "width": {
     "fill": 0
    },
    "height": 2
   },
   "decoration": {
    "fills": [
     {
      "color": "#00FFFFFF"
     }
    ],
    "radius": [
     2,
     2,
     0,
     0
    ]
   },
   "bind": {
    "decoration.fills[0].color": "${= (props.value == item || (props.value == '' && index == 0)) ? theme.colors.accent : '#00FFFFFF'}"
   },
   "transitions": [
    {
     "property": "decoration",
     "duration": 150
    }
   ]
  }
 }
}
