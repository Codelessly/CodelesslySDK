   "layout": {
    "width": {
     "fill": 0
    },
    "height": 36,
    "flex": 2
   },
   "bind": {
    "visible": "${= length(props.columns) > 0}",
    "layout.flex": "${= length(props.widths) > 0 ? at(props.widths, 0) : 3}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "if",
       "condition": {
        "left": "${= (props.value == (length(props.keys) > 0 ? at(props.keys, 0) : lower(at(props.columns, 0))))}",
        "op": "isTrue"
       },
       "then": [
        {
         "type": "setVariable",
         "variable": "props.desc",
         "op": "toggle"
        }
       ],
       "else": [
        {
         "type": "setVariable",
         "variable": "props.value",
         "value": "${= (length(props.keys) > 0 ? at(props.keys, 0) : lower(at(props.columns, 0)))}"
        },
