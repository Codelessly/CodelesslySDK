{
 "schema": 3,
 "id": "TableHeader",
 "roots": [
  "head"
 ],
 "widget": {
  "type": "TableHeader",
  "doc": "The header of a sortable table: columns are the titles, keys the fields they sort by; tapping a title sets your sort variable to its key and flips desc on a second tap, so write state desc=false, TableHeader bind:sort desc:desc columns:[...] keys:[...] and show sortBy or sortByDesc(rows,sort). selectable:true adds a tick-all box that fires onToggleAll.",
  "props": [
   {
    "key": "value",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": "",
    "doc": "The name of your text variable: the key of the column sorted by (empty: none)."
   },
   {
    "key": "desc",
    "type": {
     "kind": "variable",
     "of": {
      "kind": "boolean",
      "flutter": "bool"
     }
    },
    "default": "",
    "doc": "The name of your boolean variable: true when the sort is high to low. Declare it (state desc=false) and write desc:desc."
   },
   {
    "key": "columns",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [
     "Plan",
     "Subs",
     "Revenue"
    ],
    "doc": "The column titles (up to seven).",
    "required": true
   },
   {
    "key": "keys",
    "type": {
     "kind": "list",
     "flutter": "List<String>",
     "item": {
      "kind": "string",
      "flutter": "String"
     }
    },
    "default": [],
    "doc": "The field each column sorts by, e.g. [\"plan\",\"subs\",\"revenue\"] (default: the title in lower case)."
   },
   {
    "key": "widths",
    "type": {
     "kind": "list",
     "flutter": "List<double>",
     "item": {
      "kind": "number",
      "flutter": "double"
     }
    },
    "default": [],
    "doc": "Relative column widths, e.g. [3,2,2] (default: the first wider); give TableRow the same."
   },
   {
    "key": "selectable",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "True shows a tick-all box before the titles."
   },
   {
    "key": "checked",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "Whether the tick-all box is ticked."
   }
  ],
  "events": [
   {
    "key": "onToggleAll",
    "doc": "The tick-all box was tapped; the value is the new state."
   },
   {
    "key": "onSort",
    "doc": "A title was tapped; the value is its key."
   }
  ]
 },
 "previews": [
  {
   "name": "Header",
   "size": [
    360,
    36
   ],
   "props": {
    "value": "revenue",
    "desc": true
   }
  }
