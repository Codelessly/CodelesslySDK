         "type": "setVariable",
         "variable": "props.desc",
         "value": "${= false}"
        }
       ]
      },
      {
       "type": "componentEvent",
       "event": "onSort",
       "value": "${= (length(props.keys) > 0 ? at(props.keys, 0) : lower(at(props.columns, 0)))}"
      }
     ]
    }
