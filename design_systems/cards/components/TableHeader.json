   },
   "layout": {
    "width": 20,
    "height": 36
   },
   "bind": {
    "visible": "${props.selectable}"
   },
   "actions": [
    {
     "trigger": {
      "type": "click"
     },
     "actions": [
      {
       "type": "componentEvent",
       "event": "onToggleAll",
       "value": "${= !props.checked}"
      }
     ]
    }
   ]
  },
  "tick": {
   "type": "row",
   "children": [
    "tickI"
   ],
