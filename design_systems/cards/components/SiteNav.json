{
 "schema": 3,
 "id": "SiteNav",
 "roots": ["band"],
 "widget": {
  "type": "SiteNav",
  "doc": "A website's top bar, written first under Page: SiteNav brand:\"Tidewater\" icon:\"waves\" links:[\"Features\",\"Pricing\"] active:=page secondary:\"Sign in\" cta:\"Start free\" -> page=result (onNavigate gives the link's name; onCta and onSecondary fire on the buttons; an empty label hides its button, and an empty active marks no link). On a phone the menu opens all links and the secondary action; the CTA stays in the bar.",
  "props": [
   {"key": "brand", "type": {"kind": "string", "flutter": "String"}, "default": "Tidewater", "doc": "The product's name, at the left.", "required": true},
   {"key": "icon", "type": {"kind": "string", "flutter": "String"}, "default": "waves", "doc": "A Material icon on the small accent mark before the name (empty: no mark)."},
   {"key": "links", "type": {"kind": "list", "flutter": "List<String>", "item": {"kind": "string", "flutter": "String"}}, "default": ["Features", "Pricing", "Customers", "Docs"], "doc": "The page links, centered in the bar.", "required": true},
   {"key": "active", "type": {"kind": "string", "flutter": "String"}, "default": "", "doc": "The current page's link name; it is marked in the accent (empty: none)."},
   {"key": "secondary", "type": {"kind": "string", "flutter": "String"}, "default": "Sign in", "doc": "The quiet action's label (empty: hidden)."},
   {"key": "cta", "type": {"kind": "string", "flutter": "String"}, "default": "Start free", "doc": "The one primary action's label (empty: hidden)."}
  ],
  "events": [
   {"key": "onNavigate", "doc": "A link was chosen; the value is its name (the brand gives an empty name: home)."},
   {"key": "onCta", "doc": "The primary action was pressed."},
   {"key": "onSecondary", "doc": "The quiet action was pressed."}
  ]
 },
 "previews": [
  {"name": "Tidewater", "size": [1280, 65], "props": {"brand": "Tidewater", "icon": "waves", "links": ["Features", "Pricing", "Customers", "Docs"], "active": "Pricing", "secondary": "Sign in", "cta": "Start free"}}
 ],
 "nodes": {
  "band": {
   "type": "column",
   "children": ["inner", "mobileLinks", "rule"],
   "props": {"crossAxisAlignment": "center", "spacing": 0},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}},
   "decoration": {"fills": [{"color": "pageFill"}]}
  },
  "inner": {
   "type": "row",
   "media": [{"maxWidth": 699, "patch": {"layout": {"padding": [20, 12, 20, 12]}, "props": {"spacing": 12}}}],
   "children": ["brandRow", "linksWrap", "actions"],
   "props": {"crossAxisAlignment": "center", "spacing": 24},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "constraints": {"maxWidth": 1184}, "padding": [32, 12, 32, 12]}
  },
  "rule": {
   "type": "box",
   "layout": {"width": {"fill": 0}, "height": 1},
   "decoration": {"fills": [{"color": "line"}]}
  },
  "brandRow": {
   "type": "row",
   "children": ["mark", "brandName"],
   "props": {"crossAxisAlignment": "center", "spacing": 10},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}},
   "states": {"pressed": {"brandRow": {"opacity": 0.75}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onNavigate", "value": ""}]}
   ]
  },
  "mark": {
   "type": "row",
   "children": ["markIcon"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": 30, "height": 30},
   "decoration": {"fills": [{"color": "accent"}], "radius": 9},
   "bind": {"decoration.radius": "${theme.radii.inner}", "visible": "${= props.icon != ''}"}
  },
  "markIcon": {
   "type": "icon",
   "props": {"icon": "waves", "size": 18, "color": "onAccent"},
   "layout": {"width": 18, "height": 18},
   "bind": {"props.icon": "${props.icon}"}
  },
  "brandName": {
   "type": "text",
   "props": {"text": "${props.brand}", "style": {"from": "headingWide", "fontSize": 18, "fontWeight": 700}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "linksWrap": {
   "type": "row",
   "children": ["links"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "links": {
   "type": "listView",
   "media": [{"maxWidth": 699, "patch": {"visible": false}}],
   "children": ["link"],
   "props": {"scrollable": false, "scrollDirection": "horizontal", "wrap": true, "wrapSpacing": 2, "runSpacing": 2, "wrapAlignment": "center", "wrapCrossAlignment": "center", "stretchItems": false},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}},
   "bind": {"data": "${props.links}"}
  },
  "link": {
   "type": "row",
   "children": ["linkText"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": {"hug": 0}, "height": 36, "padding": [12, 0, 12, 0]},
   "decoration": {"fills": [{"color": "pageFill"}], "radius": 10},
   "bind": {
    "decoration.radius": "${theme.radii.controlMedium}",
    "decoration.fills[0].color": "${= props.active == item ? theme.colors.activeTint : theme.colors.pageFill}"
   },
   "states": {"pressed": {"link": {"opacity": 0.7}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onNavigate", "value": "${item}"}]}
   ]
  },
  "linkText": {
   "type": "text",
   "props": {"text": "${item}", "style": {"from": "mutedWide", "color": "inkSoft", "fontWeight": 500}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}},
   "bind": {
    "props.style.color": "${= props.active == item ? theme.colors.accent : theme.colors.inkSoft}",
    "props.style.fontWeight": "${= props.active == item ? 600 : 500}"
   }
  },
  "actions": {
   "type": "row",
   "children": ["menuButton", "second", "cta"],
   "props": {"crossAxisAlignment": "center", "spacing": 8},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "second": {
   "type": "row",
   "media": [{"maxWidth": 699, "patch": {"visible": false, "bind": {"visible": null}}}],
   "children": ["secondText"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": {"hug": 0}, "height": 40, "padding": [14, 0, 14, 0]},
   "decoration": {"fills": [{"color": "pageFill"}], "radius": 10},
   "bind": {"visible": "${= props.secondary != ''}", "decoration.radius": "${theme.radii.controlMedium}"},
   "states": {"pressed": {"second": {"opacity": 0.6}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onSecondary", "value": "${props.secondary}"}]}
   ]
  },
  "secondText": {
   "type": "text",
   "props": {"text": "${props.secondary}", "style": {"from": "strongWide", "fontSize": 14, "color": "ink"}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "cta": {
   "type": "row",
   "children": ["ctaText"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": {"hug": 0}, "height": 40, "padding": [18, 0, 18, 0]},
   "decoration": {"fills": [{"color": "accent"}], "radius": 10},
   "bind": {"visible": "${= props.cta != ''}", "decoration.radius": "${theme.radii.controlMedium}"},
   "states": {"pressed": {"cta": {"opacity": 0.85}}},
   "actions": [
    {"trigger": {"type": "click"}, "actions": [{"type": "componentEvent", "event": "onCta", "value": "${props.cta}"}]}
   ]
  },
  "ctaText": {
   "type": "text",
   "props": {"text": "${props.cta}", "style": {"from": "strongWide", "fontSize": 14, "color": "onAccent"}, "maxLines": 1},
   "layout": {"width": {"hug": 0}, "height": {"hug": 0}}
  },
  "menuButton": {
   "type": "row",
   "visible": false,
   "media": [{"maxWidth": 699, "patch": {"visible": true}}],
   "children": ["menuIcon"],
   "props": {"mainAxisAlignment": "center", "crossAxisAlignment": "center"},
   "layout": {"width": 40, "height": 40},
   "states": {"pressed": {"menuButton": {"opacity": 0.7}}},
   "actions": [{"trigger": {"type": "click"}, "actions": [{"type": "setVariable", "variable": "menu", "op": "toggle"}]}]
  },
  "menuIcon": {
   "type": "icon",
   "props": {"icon": "menu_rounded", "size": 24, "color": "ink"},
   "layout": {"width": 24, "height": 24},
   "bind": {"props.icon": "${= menu ? 'close_rounded' : 'menu_rounded'}"}
  },
  "mobileLinks": {
   "type": "column",
   "visible": false,
   "media": [{"maxWidth": 699, "patch": {"bind": {"visible": "${menu}"}}}],
   "children": ["mobileList", "mobileSecond"],
   "props": {"crossAxisAlignment": "stretch"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}, "padding": [20, 0, 20, 16]}
  },
  "mobileList": {
   "type": "listView",
   "children": ["mobileLink"],
   "props": {"scrollable": false, "scrollDirection": "vertical"},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}},
   "bind": {"data": "${props.links}"}
  },
  "mobileLink": {
   "type": "row",
   "children": ["mobileLinkText"],
   "props": {"crossAxisAlignment": "center"},
   "layout": {"width": {"fill": 0}, "height": 44, "padding": [12, 0, 12, 0]},
   "actions": [{"trigger": {"type": "click"}, "actions": [{"type": "setVariable", "variable": "menu", "value": "${= false}"}, {"type": "componentEvent", "event": "onNavigate", "value": "${item}"}]}]
  },
  "mobileLinkText": {
   "type": "text",
   "props": {"text": "${item}", "style": {"from": "bodyWide", "color": "inkSoft"}},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  },
  "mobileSecond": {
   "type": "row",
   "children": ["mobileSecondText"],
   "props": {"crossAxisAlignment": "center"},
   "layout": {"width": {"fill": 0}, "height": 44, "padding": [12, 0, 12, 0]},
   "bind": {"visible": "${= props.secondary != ''}"},
   "actions": [{"trigger": {"type": "click"}, "actions": [{"type": "setVariable", "variable": "menu", "value": "${= false}"}, {"type": "componentEvent", "event": "onSecondary", "value": "${props.secondary}"}]}]
  },
  "mobileSecondText": {
   "type": "text",
   "props": {"text": "${props.secondary}", "style": {"from": "strongWide", "color": "ink"}},
   "layout": {"width": {"fill": 0}, "height": {"hug": 0}}
  }
 },
 "variables": {"band": [{"name": "menu", "type": "boolean", "value": false}]}
}
