{
 "schema": 3,
 "id": "Paragraph",
 "roots": [
  "text"
 ],
 "widget": {
  "type": "Paragraph",
  "doc": "A sentence or two of body text in the card's own type and color (what will happen, a description): use it instead of Text for prose.",
  "props": [
   {
    "key": "text",
    "type": {
     "kind": "string",
     "flutter": "String"
    },
    "default": "",
    "doc": "The sentence or two.",
    "required": true
   },
   {
    "key": "strong",
    "type": {
     "kind": "boolean",
     "flutter": "bool"
    },
    "default": false,
    "doc": "True for the darker ink."
   }
  ]
 },
 "previews": [
  {
   "name": "Text",
   "size": [
    340,
    44
   ],
   "props": {
    "text": "Nothing is removed until you approve."
   }
  }
 ],
 "nodes": {
  "text": {
   "type": "text",
   "props": {
    "text": "${props.text}",
    "style": "lead"
   },
   "layout": {
    "width": {
     "fill": 0
    },
    "height": {
     "hug": 0
    }
   },
   "bind": {
    "props.style.color": "${= props.strong ? theme.colors.ink : theme.colors.inkSoft}"
   },
   "media": [
    {
     "minWidth": 700,
     "patch": {
      "layout": {
       "constraints": {
        "maxWidth": 720
       }
      }
     }
    }
   ]
  }
 }
}
