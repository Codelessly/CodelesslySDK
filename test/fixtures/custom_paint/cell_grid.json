        "type": "radial",
        "stops": [
         {
          "position": 0.35,
          "color": "#FFF3E7B8"
         },
         {
          "position": 1,
          "color": "#FFD9C27A"
         }
        ]
       }
      }
     },
     {
      "op": "repeat",
      "count": 25,
      "ops": [
       {
        "op": "line",
        "p1": [
         "${index}",
         0
        ],
        "p2": [
         "${index}",
         16
        ],
        "paint": {
         "color": "#22000000",
         "style": "stroke",
         "strokeWidth": 1,
         "scaleStroke": false
        }
       }
      ]
     },
     {
      "op": "repeat",
      "count": 17,
      "ops": [
       {
        "op": "line",
        "p1": [
         0,
         "${index}"
        ],
        "p2": [
         24,
         "${index}"
        ],
        "paint": {
         "color": "#22000000",
         "style": "stroke",
         "strokeWidth": 1,
         "scaleStroke": false
        }
       }
      ]
     },
     {
      "op": "repeat",
      "each": "${cells}",
      "ops": [
       {
        "op": "rrect",
        "when": "${= item != 0}",
        "rect": [
         "${= index % 24 + 0.08}",
         "${= floor(index / 24) + 0.08}",
         0.84,
         0.84
        ],
        "radius": 0.2,
        "paint": "${pal[item]}",
        "hit": "cell"
       }
      ]
     }
    ]
   }
  }
