  "plot": {
   "type": "box",
   "name": "Function plot",
   "layout": {
    "width": 320,
    "height": 200
   },
   "customPaint": {
    "painter": [
     {
      "op": "rrect",
      "id": "sheet",
      "rect": [
       0,
       0,
       "${size.width}",
       "${size.height}"
      ],
      "radius": 6,
      "paint": "#FFFFFFFF"
     },
     {
      "op": "group",
      "id": "data",
      "translate": [
       20,
       100
      ],
      "scale": [
       40,
       -60
      ],
      "ops": [
       {
        "op": "repeat",
        "count": 8,
        "ops": [
         {
          "op": "line",
          "p1": [
           "${index}",
           -1.5
          ],
          "p2": [
           "${index}",
           1.5
          ],
          "paint": {
           "color": "#FFE3E7EA",
           "style": "stroke",
           "strokeWidth": 1,
           "scaleStroke": false
          }
         }
        ]
       },
       {
        "op": "repeat",
        "count": 7,
        "ops": [
         {
          "op": "line",
          "p1": [
           0,
           "${= index * 0.5 - 1.5}"
          ],
          "p2": [
           7,
           "${= index * 0.5 - 1.5}"
          ],
          "paint": {
           "color": "#FFE3E7EA",
           "style": "stroke",
           "strokeWidth": 1,
           "scaleStroke": false
          }
         }
        ]
       },
       {
        "op": "line",
        "id": "xAxis",
        "p1": [
         0,
         0
        ],
        "p2": [
         7,
         0
        ],
        "paint": {
         "color": "#FF263238",
         "style": "stroke",
         "strokeWidth": 1.5,
         "scaleStroke": false
        }
       },
       {
        "op": "line",
        "id": "yAxis",
        "p1": [
         0,
         -1.5
        ],
        "p2": [
         0,
         1.5
        ],
        "paint": {
         "color": "#FF263238",
         "style": "stroke",
         "strokeWidth": 1.5,
         "scaleStroke": false
        }
       },
       {
        "op": "path",
        "id": "curve",
        "points": "${curve}",
        "hit": "curve",
        "paint": {
         "color": "#FF1E88E5",
         "style": "stroke",
         "strokeWidth": 2.5,
         "strokeJoin": "round",
         "strokeCap": "round",
         "scaleStroke": false
        }
       }
      ]
     },
     {
      "op": "repeat",
      "count": 8,
      "ops": [
       {
        "op": "paragraph",
        "text": "${index}",
        "offset": [
         "${= 20 + index * 40}",
         104
        ],
        "anchor": [
         0,
         -1
        ],
        "style": {
         "fontSize": 10,
         "color": "#FF607D8B",
         "fontFamily": "Roboto"
        }
       }
      ]
     },
     {
      "op": "paragraph",
      "text": "y = 1.2 sin x",
      "offset": [
       300,
       12
      ],
      "anchor": [
       1,
       -1
      ],
      "style": {
       "fontSize": 12,
       "color": "#FF1E88E5",
       "fontFamily": "Roboto"
      }
     }
    ]
   }
  }
 },
